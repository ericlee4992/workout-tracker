# Xcode
DerivedData/
build/
*.xcuserstate
xcuserdata/
*.xccheckout
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3

# Swift Package Manager
.build/
.swiftpm/

# macOS
.DS_Store

# Python (catalog generator)
__pycache__/

# Per-developer signing identity (see Config/Local.xcconfig.example)
Config/Local.xcconfig

# Scanner accuracy corpus: photos of real name plates stay local (D34 spirit);
# only the manifest (URLs + labels) and reports are committed.
work-record/scanner-accuracy/corpus/*
!work-record/scanner-accuracy/corpus/manifest.json

# Anthropic API key for the scanner LLM experiment (read by
# work-record/scanner-accuracy/tools/llm_reader.py); never committed.
Config/anthropic.key
# UI redesign: xcresult bundles are large and reproducible; the PNGs are committed
work-record/ui-redesign/results/

# Agent work record (work-record/): the tickets, reviews and screenshots are committed; raw
# terminal dumps, terminal handles and the seeded design-canvas pages (regenerable from the
# .dc.html working files with the design skill's helper) are not.
work-record/**/*.err
work-record/**/*.out
work-record/**/*-terminal.txt
work-record/ui-redesign/canvas/*/muscle-family-icons.html
work-record/ui-redesign/canvas/*/start-screen-directions.html
work-record/ui-redesign/canvas/*/board*.html
