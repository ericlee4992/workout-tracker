// Stacked's backend (public beta ticket 03). Secrets are NOT here — this repository is public. Set them with
// `wrangler secret put` (see README): APPLE_KEY_ID, APPLE_PRIVATE_KEY, TOKEN_ENC_KEY, OPENAI_API_KEY.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stacked-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  // Workers Logs keep only the server's own console lines (counts, outcomes, error names). Invocation logs are off:
  // checked 2026-10-15 (ticket 08), each stored the client IP, its city/postcode/coordinates, network provider and
  // user agent — the privacy policy says these logs hold none of that, so turning them on makes it false. Traces off
  // for the same reason.
  "observability": { "enabled": true, "logs": { "invocation_logs": false }, "traces": { "enabled": false } },
  // Hourly: retry Apple token revocations that failed during an account deletion (codex-review-03 #5); sweep feedback
  // screenshots left without a row and old feedback rate-limit counters (ticket 07).
  "triggers": { "crons": ["23 * * * *"] },
  "vars": {
    // Sign in with Apple's audience: the app's bundle ID (D60: kept as is).
    "APPLE_CLIENT_ID": "com.ericlee4992.workouttracker",
    // The paid team's ID (not secret; it is in every signed build): the issuer of the client-secret JWT.
    "APPLE_TEAM_ID": "X68M8SR6NA",
    // Ticket 04: the Google iOS OAuth client (project "Stacked", not secret; the same ID is in the app's
    // WT_GOOGLE_CLIENT_ID): the ID token's required `aud`/`azp`.
    "GOOGLE_CLIENT_ID": "469208403829-t81d4qhqr5p4amtlm0s47mo8p25bsf3b.apps.googleusercontent.com"
  },
  // Feedback screenshots (ticket 07). Created by `wrangler r2 bucket create stacked-feedback` before the first deploy.
  "r2_buckets": [
    { "binding": "FEEDBACK", "bucket_name": "stacked-feedback" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stacked",
      // Filled in by `wrangler d1 create stacked` before the first deploy (README). Local dev and tests ignore it.
      "database_id": "3652ad5c-7c0b-4b75-874b-6ab2ad7ce8ec",
      "migrations_dir": "migrations"
    }
  ]
}
