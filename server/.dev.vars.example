# Copy to .dev.vars (git-ignored) for `wrangler dev`. Never commit real values; the repository is public.
APPLE_KEY_ID=
# The Sign in with Apple key (.p8) contents, PEM, with newlines as \n.
APPLE_PRIVATE_KEY=
# 32 random bytes, base64 (e.g. `openssl rand -base64 32`): encrypts Apple refresh tokens at rest.
TOKEN_ENC_KEY=
# The developer's OpenAI key (ticket 06). Leave empty locally unless you mean to spend on a live call; the AI routes
# then answer 503 server_not_configured.
OPENAI_API_KEY=
