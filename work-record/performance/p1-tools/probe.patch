--- /dev/null
+++ WorkoutTracker/App/P1Probe.swift
@@ -0,0 +1,58 @@
+// [DEBUG-p1] Temporary measurement probe for performance ticket P1. Remove before commit.
+import QuartzCore
+import Foundation
+
+@MainActor
+final class P1Probe: NSObject {
+    static let shared = P1Probe()
+    static let isOn = ProcessInfo.processInfo.environment["P1_PROBE"] != nil
+    private var link: CADisplayLink?
+    private var last: CFTimeInterval = 0
+    private var counts: [String: Int] = [:]
+    private var spent: [String: Double] = [:]
+    private var reportStart = CACurrentMediaTime()
+
+    nonisolated(unsafe) static let fileURL = URL.temporaryDirectory.appending(path: "p1probe.log")
+    nonisolated(unsafe) static var handle: FileHandle? = {
+        FileManager.default.createFile(atPath: fileURL.path, contents: nil)
+        return try? FileHandle(forWritingTo: fileURL)
+    }()
+    nonisolated static func emit(_ s: String) {
+        let line = Data("[DEBUG-p1] \(String(format: "%.3f", CACurrentMediaTime())) \(s)\n".utf8)
+        FileHandle.standardError.write(line)
+        handle?.write(line)
+    }
+    func start() {
+        guard Self.isOn, link == nil else { return }
+        let link = CADisplayLink(target: self, selector: #selector(tick(_:)))
+        link.add(to: .main, forMode: .common)
+        self.link = link
+        Self.emit("probe on")
+    }
+    @objc private func tick(_ link: CADisplayLink) {
+        if last > 0 {
+            let gap = link.timestamp - last
+            if gap > 0.034 { Self.emit("hitch \(Int(gap * 1000)) ms") }
+        }
+        last = link.timestamp
+        let now = CACurrentMediaTime()
+        if now - reportStart >= 5 {
+            let line = counts.sorted { $0.key < $1.key }
+                .map { "\($0.key)=\($0.value)" + (spent[$0.key].map { String(format: "/%.0fms", $0 * 1000) } ?? "") }
+                .joined(separator: " ")
+            Self.emit("5s bodies: \(line)")
+            counts = [:]; spent = [:]; reportStart = now
+        }
+    }
+    static func body(_ name: String) {
+        guard isOn else { return }
+        shared.counts[name, default: 0] += 1
+    }
+    static func time<T>(_ name: String, _ work: () -> T) -> T {
+        guard isOn else { return work() }
+        let t = CACurrentMediaTime(); let r = work()
+        shared.counts[name, default: 0] += 1
+        shared.spent[name, default: 0] += CACurrentMediaTime() - t
+        return r
+    }
+}
