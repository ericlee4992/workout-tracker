<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Public beta ticket 01 (D60): export compliance for App Store Connect.
	     The app's only encryption is the system's HTTPS (URLSession), which is
	     exempt; without this key every TestFlight upload stops at a manual
	     compliance question before testers can install it. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Public beta ticket 07: the server's base URL from the WT_SERVER_URL build setting (Config/Shared.xcconfig);
	     empty when the build has none. Read by ServerConfig.baseURL. -->
	<key>WTServerURL</key>
	<string>$(WT_SERVER_URL)</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Record distance, pace and your route during outdoor cardio workouts.</string>
	<key>NSMotionUsageDescription</key>
	<string>Estimate indoor walking and running distance and pace when supported.</string>
	<!-- Partial Info.plist, MERGED with the generated one.

	     GENERATE_INFOPLIST_FILE stays YES: every usage-description string and
	     the scene manifest still live in build settings, exactly as before.
	     This file exists for one key that build settings cannot express.

	     Xcode's plist generator only writes an allowlist of INFOPLIST_KEY_*
	     settings, and array-valued keys are not on it. Setting
	     INFOPLIST_KEY_UIBackgroundModes = audio is silently accepted, appears
	     in -showBuildSettings, and never reaches the built plist — verified
	     2026-08-24 with `plutil -extract` on the built app.

	     Why the app needs it: the rest alarm plays real audio so the sound
	     reaches AirPods (a UNNotificationSound does not). The moment that
	     matters most is the screen being off mid-workout, and starting
	     playback from the background requires this mode. Without it
	     AVAudioSession activation fails there and the alarm is silent again —
	     the exact bug it was added to fix. -->
	<!-- Live Activities (milestone 8, ticket 05). Without this the app can
	     compile against ActivityKit, request an activity, and silently get
	     nothing — the same shape as the UIBackgroundModes trap below. -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<!-- Plays the rest alarm while the app is backgrounded. -->
		<string>audio</string>
		<!-- No `workout-processing` (removed 2026-10-13, public beta 01b): App Store
		     Connect rejects it for an iPhone app ("UIBackgroundModes contains an
		     invalid value: 'workout-processing'"), so no TestFlight build can carry
		     it. It was added 2026-08-25 among the attempts at the silent screen-off
		     alarm; the design that worked queues each rest's [silence][beep] track
		     when the rest starts, so nothing has to run at the deadline (D46). The
		     `audio` mode plays that track and, between rests, an inaudible loop
		     (RestAlarmSound). Whether heart-rate samples keep arriving in the
		     background without the removed mode is a device question, recorded in
		     ticket 01b. -->
		<string>location</string>
	</array>
</dict>
</plist>
