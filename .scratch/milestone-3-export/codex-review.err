   229	    // MARK: - CSV content
   230	
   231	    @Test func csvRowCarriesFullEquipmentContext() throws {
   232	        let row = csvRows(makeSnapshot())[2]  // the 135 lb working set
   233	        #expect(try column("workoutID", of: row) == ID.workout.uuidString)
   234	        #expect(try column("workoutName", of: row) == "Push Day")
   235	        #expect(try column("gymName", of: row) == "Gold's Gym, Gangnam")
   236	        #expect(try column("exerciseName", of: row) == "Seated Chest Press")
   237	        #expect(try column("loadType", of: row) == "weighted")
   238	        #expect(try column("machineLabel", of: row) == "Chest Press #2")
   239	        #expect(try column("manufacturer", of: row) == "Life Fitness")
   240	        #expect(try column("modelName", of: row) == "Insignia Chest Press")
   241	        #expect(try column("modelID", of: row) == ID.model.uuidString)
   242	        #expect(try column("setType", of: row) == "working")
   243	        #expect(try column("reps", of: row) == "8")
   244	        #expect(try column("completed", of: row) == "true")
   245	    }
   246	
   247	    /// D29 — three columns, no conversion, no ≈ anywhere in the file.
   248	    @Test func csvKeepsAsEnteredAndNormalizedWeights() throws {
   249	        let text = ExportCSV.render(makeSnapshot())
   250	        #expect(!text.contains("≈"))
   251	
   252	        let pounds = csvRows(makeSnapshot())[2]
   253	        #expect(try column("weight", of: pounds) == "135.0")
   254	        #expect(try column("unit", of: pounds) == "lb")
   255	        let kg = try #require(Double(try column("weightKg", of: pounds)))
   256	        #expect(abs(kg - 135 * WeightMath.kilogramsPerPound) < 1e-9)
   257	
   258	        // A fractional kg entry keeps its `.` separator whatever the locale of
   259	        // the machine running this — `storageNumber` is not locale-formatted.
   260	        let dumbbell = csvRows(makeSnapshot())[3]
   261	        #expect(try column("weight", of: dumbbell) == "22.5")
   262	        #expect(try column("weightKg", of: dumbbell) == "22.5")
   263	    }
   264	
   265	    /// D30 — the draft set is a row, flagged, with empty rather than invented
   266	    /// values; the running workout has an empty `workoutFinishedAt`.
   267	    @Test func csvKeepsDraftSetsFlaggedRatherThanDroppingThem() throws {
   268	        let row = csvRows(makeSnapshot())[4]
   269	        #expect(try column("setID", of: row) == ID.draftSet.uuidString)
   270	        #expect(try column("completed", of: row) == "false")
   271	        #expect(try column("completedAt", of: row) == "")
   272	        #expect(try column("reps", of: row) == "")
   273	        #expect(try column("weight", of: row) == "")
   274	        #expect(try column("weightKg", of: row) == "")
   275	        #expect(try column("workoutFinishedAt", of: row) == "")
   276	        // A machineless entry states its free-weight tag and nothing else.
   277	        #expect(try column("equipmentTag", of: row) == "bodyweight")
   278	        #expect(try column("machineID", of: row) == "")
   279	        #expect(try column("gymName", of: row) == "")
   280	    }
   281	
   282	    @Test func csvTimestampsCarryTheirUTCOffset() throws {
   283	        let row = csvRows(makeSnapshot())[1]
   284	        let started = try column("workoutStartedAt", of: row)
   285	        #expect(started == "1970-01-01T09:15:00+09:00")
   286	        #expect(try column("completedAt", of: row).hasSuffix("+09:00"))
   287	    }
   288	
   289	    /// The export uses storage serialization, not display formatting: under a
   290	    /// comma-decimal locale the *display* helper would write "22,5" — which in
   291	    /// a comma-separated file is not a rounding nuisance but a shifted column.
   292	    @Test func csvNumbersAreStorageSerializedNotLocaleFormatted() throws {
   293	        let commaLocale = Locale(identifier: "de_DE")
   294	        #expect(WeightMath.displayNumber(22.5, locale: commaLocale) == "22,5")
   295	
   296	        let text = ExportCSV.render(makeSnapshot())
   297	        #expect(!text.contains("22,5"))
   298	        #expect(try column("weight", of: csvRows(makeSnapshot())[3]) == "22.5")
   299	    }
   300	
   301	    // MARK: - CSV escaping (D32)
   302	
   303	    @Test func csvQuotesOnlyWhatMustBeQuoted() {
   304	        #expect(ExportCSV.escaped("Push Day") == "Push Day")
   305	        #expect(ExportCSV.escaped("Gold's Gym, Gangnam") == "\"Gold's Gym, Gangnam\"")
   306	        #expect(ExportCSV.escaped("said \"go\"") == "\"said \"\"go\"\"\"")
   307	        #expect(ExportCSV.escaped("two\nlines") == "\"two\nlines\"")
   308	        #expect(ExportCSV.escaped("") == "")
   309	    }
   310	
   311	    @Test func csvNotesWithQuotesAndCommasSurviveARoundTrip() throws {
   312	        let row = csvRows(makeSnapshot())[1]
   313	        #expect(try column("workoutNotes", of: row)
   314	            == "Felt strong; said \"one more\", then did three.")
   315	        #expect(try column("gymName", of: row) == "Gold's Gym, Gangnam")
   316	    }
   317	
   318	    /// D32 — user text goes in verbatim. A note that begins with `=` is the
   319	    /// user's note, not ours to rewrite.
   320	    @Test func csvDoesNotRewriteFormulaLookingText() throws {
   321	        var snapshot = makeSnapshot()
   322	        snapshot.workouts[0].notes = "=2+2 felt easy"
   323	        let row = csvRows(snapshot)[1]
   324	        #expect(try column("workoutNotes", of: row) == "=2+2 felt easy")
   325	    }
