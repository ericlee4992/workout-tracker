     1	import XCTest
     2	
     3	/// Milestone 3, ticket 03 — the export is reachable and really produces a file.
     4	///
     5	/// Deliberately short: the store starts empty (`-uiTestReset`), so this proves
     6	/// the wiring (tap → build → share sheet holding a named file) without paying
     7	/// for a second full logging walkthrough. What the file *contains* is covered
     8	/// by `ExportTests` and `ExportFidelityTests`, where it can be asserted
     9	/// precisely and in a second rather than a minute.
    10	final class ExportUITests: XCTestCase {
    11	    private var app: XCUIApplication!
    12	
    13	    override func setUp() {
    14	        super.setUp()
    15	        continueAfterFailure = false
    16	        app = XCUIApplication()
    17	        app.launchArguments = ["-uiTestReset"]
    18	        app.launch()
    19	    }
    20	
    21	    func testExportSectionProducesAShareableFile() {
    22	        app.tabBars.buttons["Gyms"].tap()
    23	
    24	        let summary = app.staticTexts["exportSummary"]
    25	        XCTAssertTrue(
    26	            summary.waitForExistence(timeout: 5),
    27	            "The Gyms screen should carry the export section")
    28	        XCTAssertEqual(
    29	            summary.label, "0 workouts · 0 sets",
    30	            "An empty store should say so rather than showing nothing")
    31	
    32	        let exportCSV = app.buttons["exportCSV"]
    33	        XCTAssertTrue(exportCSV.waitForExistence(timeout: 5))
    34	        exportCSV.tap()
    35	
    36	        // The share sheet names the file it is about to share.
    37	        let named = app.descendants(matching: .any).matching(
    38	            NSPredicate(format: "label BEGINSWITH %@", "workout-tracker-")).firstMatch
    39	        XCTAssertTrue(
    40	            named.waitForExistence(timeout: 10),
    41	            "Exporting should present the share sheet with the written file")
    42	
    43	        // Dismissing returns to the app with no error surfaced.
    44	        let close = app.buttons["Close"]
    45	        if close.waitForExistence(timeout: 3) {
    46	            close.tap()
    47	        } else {
    48	            app.swipeDown(velocity: .fast)
    49	        }
    50	        XCTAssertTrue(summary.waitForExistence(timeout: 5))
    51	        XCTAssertFalse(
    52	            app.staticTexts["exportFailure"].exists,
    53	            "A completed export must not report a failure")
    54	    }
    55	}

