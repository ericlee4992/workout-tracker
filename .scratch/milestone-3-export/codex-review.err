    19	
    20	    /// Canonical kg value for `(value, unit)`. kg passes through untouched so
    21	    /// `normalizedKg == value` exactly for kg entries.
    22	    static func normalizedKg(value: Double, unit: WeightUnit) -> Double {
    23	        switch unit {
    24	        case .kg: value
    25	        case .lb: value * kilogramsPerPound
    26	        }
    27	    }
    28	
    29	    /// Full-precision conversion between units. Identity when units match.
    30	    static func convert(
    31	        _ value: Double, from source: WeightUnit, to target: WeightUnit
    32	    ) -> Double {
    33	        guard source != target else { return value }
    34	        switch target {
    35	        case .kg: return value * kilogramsPerPound
    36	        case .lb: return value / kilogramsPerPound
    37	        }
    38	    }
