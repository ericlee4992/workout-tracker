     1	import Foundation
     2	
     3	// Milestone 3, ticket 01 — the export's value-type layer. Pure: no UI, no
     4	// SwiftData. `ExportCollector` builds one of these from a `ModelContext`;
     5	// `ExportJSON` and `ExportCSV` render it.
     6	//
     7	// Everything the user created is in here (D30) — including draft sets and an
     8	// unfinished workout. What is *not* in here: the shipped seeded catalog beyond
     9	// the rows the user's data actually references (D28), and anything derived
    10	// (PRs, e1RM, volume — SPEC: derived, never source-of-truth).
    11	//
    12	// Timestamps are already-formatted ISO 8601 strings with a UTC offset (D31),
    13	// not `Date`s. Formatting once, at collection time, is what makes the two
    14	// renderers agree to the character and makes a JSON round-trip exact — an
    15	// ISO 8601 `Date` round-trip silently truncates sub-second precision.
    16	
    17	struct ExportSnapshot: Codable, Equatable {
    18	    /// Bumped on any breaking shape change. A consumer that does not
    19	    /// recognise the version should refuse the file rather than guess.
    20	    static let currentSchemaVersion = 1
    21	
    22	    var schemaVersion: Int = ExportSnapshot.currentSchemaVersion
    23	    var exportedAt: String
    24	    /// Marketing version + build, e.g. `1.0 (3)`. Empty when unavailable.
    25	    var appVersion: String
    26	    /// D28: which catalog the omitted seeded rows can be reproduced from.
    27	    var seededCatalogVersion: Int
    28	    var counts: Counts
    29	    var preferences: Preferences?
    30	    var gyms: [Gym] = []
    31	    var machines: [Machine] = []
    32	    var exercises: [Exercise] = []
    33	    var equipmentModels: [EquipmentModel] = []
    34	    var templates: [Template] = []
    35	    var workouts: [Workout] = []
    36	    var gymExerciseMemory: [GymMemory] = []
    37	    var exerciseRestOverrides: [RestOverride] = []
    38	}
    39	
    40	// MARK: - Counts
    41	
    42	extension ExportSnapshot {
    43	    /// Header numbers, so a consumer (and the export screen) can see at a
    44	    /// glance whether the file holds what it should.
    45	    struct Counts: Codable, Equatable {
    46	        var workouts: Int = 0
    47	        var entries: Int = 0
