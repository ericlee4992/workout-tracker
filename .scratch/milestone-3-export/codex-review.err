   136	
   137	    private func csvRows(_ snapshot: ExportSnapshot) -> [[String]] {
   138	        TestCSV.rows(ExportCSV.render(snapshot))
   139	    }
   140	
   141	    private func column(_ name: String, of row: [String]) throws -> String {
   142	        try #require(TestCSV.value(name, in: row), "unknown column \(name)")
   143	    }
   144	
   145	    // MARK: - JSON
   146	
   147	    @Test func jsonRoundTripsExactly() throws {
   148	        let snapshot = makeSnapshot()
   149	        let decoded = try ExportJSON.decode(try ExportJSON.data(snapshot))
   150	        #expect(decoded == snapshot)
   151	    }
   152	
   153	    @Test func jsonCarriesVersionAndOmitsNilRatherThanNull() throws {
   154	        let text = try #require(
   155	            String(data: try ExportJSON.data(makeSnapshot()), encoding: .utf8))
   156	        #expect(text.contains("\"schemaVersion\" : 1"))
   157	        #expect(!text.contains("null"), "nil optionals must be omitted, not encoded as null")
   158	        // Sorted keys make the file diffable: `appVersion` precedes `counts`.
   159	        let appVersion = try #require(text.range(of: "\"appVersion\""))
   160	        let counts = try #require(text.range(of: "\"counts\""))
   161	        #expect(appVersion.lowerBound < counts.lowerBound)
   162	    }
   163	
   164	    /// D30 — the running workout and its uncompleted set are in the file.
   165	    @Test func jsonKeepsTheActiveWorkoutAndItsDraftSet() throws {
   166	        let decoded = try ExportJSON.decode(try ExportJSON.data(makeSnapshot()))
   167	        let active = try #require(decoded.workouts.first { $0.id == ID.activeWorkout })
   168	        #expect(active.finishedAt == nil)
   169	        let draft = try #require(active.entries.first?.sets.first)
   170	        #expect(draft.completedAt == nil)
   171	        #expect(draft.reps == nil)
   172	        #expect(draft.weight == nil)
   173	    }
   174	
   175	    /// D29 — weights survive as entered *and* normalized, at full precision.
   176	    @Test func jsonKeepsAsEnteredAndNormalizedWeights() throws {
   177	        let decoded = try ExportJSON.decode(try ExportJSON.data(makeSnapshot()))
   178	        let entry = try #require(decoded.workouts.first?.entries.first)
   179	        let pounds = try #require(entry.sets.first { $0.unit == .lb })
   180	        #expect(pounds.weight == 135)
   181	        #expect(pounds.weightKg == 135 * WeightMath.kilogramsPerPound)
   182	    }
   183	
   184	    // MARK: - CSV shape
   185	
   186	    @Test func csvHeaderIsTheDocumentedColumnsInOrder() throws {
   187	        let rows = csvRows(makeSnapshot())
   188	        #expect(rows.first == ExportCSV.header)
   189	        #expect(ExportCSV.header.count == 27)
   190	        #expect(ExportCSV.header.first == "workoutID")
   191	        #expect(ExportCSV.header.last == "completedAt")
   192	    }
   193	
   194	    @Test func csvHasOneRowPerSetInSnapshotOrder() throws {
   195	        let rows = csvRows(makeSnapshot())
   196	        let ids = try rows.dropFirst().map { try column("setID", of: $0) }
   197	        #expect(ids == [
   198	            ID.set1.uuidString, ID.set2.uuidString, ID.freeSet.uuidString,
   199	            ID.draftSet.uuidString,
   200	        ])
   201	    }
   202	
   203	    @Test func csvUsesCRLFAndAUTF8BOM() throws {
   204	        let snapshot = makeSnapshot()
   205	        let text = ExportCSV.render(snapshot)
   206	        #expect(text.hasSuffix(ExportCSV.lineTerminator))
   207	        // Byte-level, because Swift reads CRLF as one Character: every LF byte
   208	        // must be preceded by a CR byte, and there must be one pair per row.
   209	        let bytes = Array(text.utf8)
   210	        let lineFeeds = bytes.enumerated().filter { $0.element == 0x0A }
   211	        #expect(lineFeeds.count == 5, "header + four set rows")
   212	        #expect(lineFeeds.allSatisfy { $0.offset > 0 && bytes[$0.offset - 1] == 0x0D })
   213	        let data = ExportCSV.data(snapshot)
   214	        #expect(data.prefix(3) == Data([0xEF, 0xBB, 0xBF]))
   215	    }
   216	
   217	    @Test func csvIsDeterministic() throws {
   218	        #expect(ExportCSV.render(makeSnapshot()) == ExportCSV.render(makeSnapshot()))
   219	    }
   220	
   221	    @Test func emptySnapshotExportsAHeaderOnlyFile() throws {
   222	        let empty = ExportSnapshot(
   223	            exportedAt: stamp(0), appVersion: "", seededCatalogVersion: 0,
   224	            counts: ExportSnapshot.Counts(), preferences: nil)
   225	        #expect(csvRows(empty) == [ExportCSV.header])
   226	        #expect(try ExportJSON.decode(try ExportJSON.data(empty)) == empty)
   227	    }
