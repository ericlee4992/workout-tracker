   169	    /// The catalog's links, in catalog order, followed by the user-added ones
   170	    /// the store already had, in their existing order.
   171	    private static func merged(
   172	        seeded: [UUID], existing: [UUID], preserving userIDs: Set<UUID>
   173	    ) -> [UUID] {
