    34	/// operations. History display remains snapshot-driven; the sole operation
    35	/// allowed to rewrite historical equipment context is an explicit
    36	/// `.applyToPast` model correction (D10).
    37	struct EquipmentLifecycle {
    38	    let context: ModelContext
    39	
    40	    init(context: ModelContext) {
    41	        self.context = context
    42	    }
    43	
    44	    func rename(_ gym: Gym, to name: String) throws {
    45	        gym.name = try validated(name)
    46	        try context.save()
    47	    }
    48	
    49	    func rename(_ machine: MachineInstance, to label: String) throws {
    50	        machine.label = try validated(label)
    51	        try context.save()
    52	    }
    53	
    54	    func rename(_ model: EquipmentModel, manufacturer: String, modelName: String) throws {
    55	        guard !model.isSeeded else {
    56	            throw EquipmentLifecycleError.seededCatalogRowIsReadOnly
    57	        }
    58	        model.manufacturer = try validated(manufacturer)
    59	        model.modelName = try validated(modelName)
    60	        try context.save()
    61	    }
    62	
    63	    func rename(_ exercise: Exercise, to name: String) throws {
    64	        guard !exercise.isSeeded else {
    65	            throw EquipmentLifecycleError.seededCatalogRowIsReadOnly
    66	        }
    67	        exercise.name = try validated(name)
    68	        try context.save()
    69	    }
    70	
    71	    /// Creates a user-owned exercise (`isSeeded == false`, D24's user ID
    72	    /// space) and optionally links it to `model` by appending its id to the
    73	    /// model's `exerciseIDs` — which is what makes an unlisted movement on a
    74	    /// known station selectable there next time (D7, ticket 19).
    75	    ///
    76	    /// Linking to a *seeded* model is deliberately allowed: the station the
    77	    /// user is standing at is usually a catalog one. `exerciseIDs` is an
    78	    /// allowlisted seeded field (D24), so `CatalogSeeder` re-merges these
    79	    /// user-added links on a catalog version bump rather than dropping them.
    80	    @discardableResult
    81	    func createExercise(
    82	        name: String,
    83	        loadType: LoadType = .weighted,
    84	        equipmentTypeTags: [EquipmentTag] = [],
    85	        muscleGroup: String? = nil,
    86	        linkedTo model: EquipmentModel? = nil
    87	    ) throws -> Exercise {
    88	        let exercise = Exercise(
    89	            name: try validated(name),
    90	            loadType: loadType,
    91	            equipmentTypeTags: equipmentTypeTags,
    92	            muscleGroup: normalized(muscleGroup),
    93	            isSeeded: false)
    94	        context.insert(exercise)
