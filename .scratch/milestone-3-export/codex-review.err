   485	extension AppPreferences {
   486	    /// Canonical row among duplicates: latest `updatedAt`, ties broken by
   487	    /// `id` (app-side upsert — no unique constraints under CloudKit).
   488	    static func canonical(of rows: [AppPreferences]) -> AppPreferences? {
   489	        rows.canonical
   490	    }
   491	
   492	    /// Canonical AppPreferences row for `context`, inserting a fresh row when
   493	    /// none exists yet (first launch).
   494	    static func canonical(in context: ModelContext) throws -> AppPreferences {
   495	        if let canonical = canonical(of: try context.fetch(FetchDescriptor<AppPreferences>())) {
   496	            return canonical
   497	        }
   498	        let fresh = AppPreferences()
   499	        context.insert(fresh)
   500	        return fresh
   501	    }
   502	
   503	    /// First-launch unit-preference resolution: when unset, derive the default
   504	    /// from the locale measurement system (US → lb, else kg) and persist it.
   505	    /// Idempotent — an already-set preference is never overwritten.
   506	    @discardableResult
   507	    static func ensureUnitPreference(
   508	        in context: ModelContext,
   509	        measurementSystem: Locale.MeasurementSystem = Locale.current.measurementSystem
   510	    ) throws -> AppPreferences {
   511	        let preferences = try canonical(in: context)
   512	        if preferences.unitPreference == nil {
   513	            preferences.unitPreference = UnitPrecedence.firstLaunchDefault(for: measurementSystem)
   514	            preferences.updatedAt = .now
   515	        }
   516	        if context.hasChanges {
   517	            try context.save()
   518	        }
   519	        return preferences
   520	    }
   521	}
