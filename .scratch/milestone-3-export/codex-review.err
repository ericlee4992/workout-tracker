    11	    /// Exact by international definition (D25): 1 lb = 0.45359237 kg.
    12	    static let kilogramsPerPound = 0.45359237
    13	
    14	    /// A weight input is storable iff it is finite and non-negative.
    15	    /// Zero is legal (bodyweight sets).
    16	    static func isValidInput(_ value: Double) -> Bool {
