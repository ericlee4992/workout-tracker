   327	    // MARK: - Filenames
   328	
   329	    @Test func exportFilenamesAreSortableAndFormatted() {
   330	        let date = Date(timeIntervalSince1970: 1_786_000_000)
   331	        let csv = ExportFileWriter.filename(format: .csv, at: date, dateFormat: dateFormat)
   332	        let json = ExportFileWriter.filename(format: .json, at: date, dateFormat: dateFormat)
   333	        #expect(csv == "workout-tracker-2026-08-06-1606.csv")
   334	        #expect(json == "workout-tracker-2026-08-06-1606.json")
   335	    }
   336	
   337	    @Test func writingAnExportReplacesTheStagedDirectory() throws {
   338	        let directory = FileManager.default.temporaryDirectory
   339	            .appending(path: "export-test-\(UUID().uuidString)")
   340	        defer { try? FileManager.default.removeItem(at: directory) }
   341	
   342	        let first = try ExportFileWriter.write(
   343	            Data("a".utf8), format: .csv, at: Date(timeIntervalSince1970: 0),
   344	            dateFormat: dateFormat, in: directory)
   345	        let second = try ExportFileWriter.write(
   346	            Data("b".utf8), format: .json, at: Date(timeIntervalSince1970: 86_400),
   347	            dateFormat: dateFormat, in: directory)
   348	
   349	        #expect(!FileManager.default.fileExists(atPath: first.path))
   350	        #expect(try Data(contentsOf: second) == Data("b".utf8))
   351	        #expect(try FileManager.default.contentsOfDirectory(atPath: directory.path).count == 1)
   352	    }
   353	}

