   239	    /// Equipment choice (D19). Pass a machine, a free-weight tag, or neither.
   240	    /// While the entry is a draft (no set ever completed) the choice edits it
   241	    /// in place. Once frozen, choosing different equipment starts a NEW entry
   242	    /// right after it: uncompleted draft rows move over, completed sets and
   243	    /// the old entry's snapshot stay untouched. Returns the entry now holding
   244	    /// the draft rows (the new entry when a split happened).
   245	    @discardableResult
   246	    func chooseEquipment(
   247	        for entry: ExerciseEntry,
   248	        machine: MachineInstance?,
   249	        freeWeightTag: EquipmentTag?
   250	    ) throws -> ExerciseEntry {
   251	        let tag = machine == nil ? freeWeightTag : nil
   252	        if entry.machine?.id == machine?.id && entry.freeWeightTag == tag {
   253	            return entry // no change
   254	        }
   255	        guard entry.snapshotCapturedAt != nil else {
   256	            entry.machine = machine
   257	            entry.freeWeightTag = tag
   258	            try context.save()
   259	            return entry
   260	        }
   261	
   262	        // Frozen: split into a new entry ordered right after the old one.
   263	        guard let workout = entry.workout, let exercise = entry.exercise else {
   264	            return entry
   265	        }
   266	        var entries = Self.orderedEntries(of: workout)
   267	        let newEntry = ExerciseEntry(
   268	            order: 0,
   269	            freeWeightTag: tag,
   270	            workout: workout,
   271	            exercise: exercise,
   272	            machine: machine,
   273	            snapshotExerciseID: exercise.id,
   274	            snapshotLoadType: exercise.loadType,
   275	            snapshotExerciseName: exercise.name)
   276	        context.insert(newEntry)
   277	        if let position = entries.firstIndex(where: { $0.id == entry.id }) {
   278	            entries.insert(newEntry, at: position + 1)
   279	        } else {
   280	            entries.append(newEntry)
   281	        }
   282	        renumber(entries)
   283	
   284	        // Draft rows move to the new entry, preserving relative order;
   285	        // completed sets stay behind.
   286	        let drafts = Self.orderedSets(of: entry).filter { $0.completedAt == nil }
   287	        for (offset, draft) in drafts.enumerated() {
   288	            draft.entry = newEntry
   289	            draft.order = offset
   290	        }
   291	        renumber(sets: Self.orderedSets(of: entry))
   292	        if drafts.isEmpty {
   293	            let set = SetRecord(
   294	                order: 0, weightUnit: defaultUnit(for: newEntry), entry: newEntry)
   295	            context.insert(set)
   296	        }
   297	        try context.save()
   298	        return newEntry
