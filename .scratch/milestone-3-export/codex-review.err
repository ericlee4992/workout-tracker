   119	    // MARK: - Referenced catalog rows (D28)
   120	
   121	    private struct ReferencedCatalog {
   122	        var exerciseIDs: Set<UUID> = []
   123	        var modelIDs: Set<UUID> = []
   124	    }
   125	
   126	    private func referencedCatalogIDs(
   127	        machines: [MachineInstance],
   128	        workouts: [ExportSnapshot.Workout],
   129	        templates: [WorkoutTemplate],
   130	        memories: [GymExerciseMemory],
   131	        overrides: [ExerciseRestOverride]
   132	    ) -> ReferencedCatalog {
   133	        var referenced = ReferencedCatalog()
   134	        for machine in machines {
   135	            if let modelID = machine.model?.id { referenced.modelIDs.insert(modelID) }
   136	        }
   137	        for workout in workouts {
   138	            for entry in workout.entries {
   139	                referenced.exerciseIDs.insert(entry.exerciseID)
   140	                if let modelID = entry.modelID { referenced.modelIDs.insert(modelID) }
   141	            }
   142	        }
   143	        for item in templates.flatMap({ $0.items ?? [] }) {
   144	            if let exerciseID = item.exercise?.id { referenced.exerciseIDs.insert(exerciseID) }
   145	        }
   146	        for memory in memories { referenced.exerciseIDs.insert(memory.exerciseID) }
   147	        for override in overrides { referenced.exerciseIDs.insert(override.exerciseID) }
   148	        return referenced
   149	    }
