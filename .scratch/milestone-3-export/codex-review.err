   476	    /// ever blocks the completing direction; an already-completed row can
   477	    /// always be un-completed.
   478	    func toggleCompletion(of set: SetRecord, at date: Date = .now) throws {
   479	        if set.completedAt == nil {
   480	            guard Self.isLoggable(set) else {
   481	                throw WorkoutSessionError.setNotLoggable
   482	            }
   483	            set.completedAt = date
   484	            if let entry = set.entry {
