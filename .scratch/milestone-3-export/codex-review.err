   138	        gym.archived = true
   139	        try context.save()
   140	    }
   141	
   142	    /// Corrects a machine's model. Applying to past workouts rewrites both
   143	    /// the grouping UUID and display string on snapshots for this machine;
   144	    /// all other snapshot fields remain frozen.
   145	    func correctModel(
   146	        of machine: MachineInstance,
   147	        to newModel: EquipmentModel?,
   148	        scope: ModelCorrectionScope
   149	    ) throws {
   150	        if scope == .applyToPast {
   151	            let machineID = machine.id
   152	            let entries = try context.fetch(FetchDescriptor<ExerciseEntry>(
   153	                predicate: #Predicate { $0.snapshotMachineID == machineID }
   154	            ))
   155	            for entry in entries {
   156	                entry.snapshotModelID = newModel?.id
   157	                entry.snapshotModelName = newModel?.displayName
   158	            }
   159	        }
