    69	    /// Logs `sets` (weight, reps, type) on the rig's machine and finishes the
    70	    /// workout, exactly as the app's own flow would.
    71	    @discardableResult
    72	    private func logWorkout(
    73	        _ rig: Rig,
    74	        sets: [(weight: Double, reps: Int, type: SetType)],
    75	        startingAt start: Date = Date(timeIntervalSince1970: 1_000_000)
    76	    ) throws -> Workout {
    77	        let workout = try rig.session.startWorkout(at: rig.gym, on: start)
    78	        let entry = try rig.session.addEntry(
    79	            for: rig.exercise, to: workout, machine: rig.machine)
    80	        for (index, plan) in sets.enumerated() {
    81	            let set: SetRecord
    82	            if index == 0 {
    83	                // Every entry arrives with one draft row already.
    84	                set = try #require(WorkoutSession.orderedSets(of: entry).first)
    85	            } else {
    86	                set = try rig.session.addSet(to: entry)
    87	            }
    88	            try rig.session.setType(plan.type, of: set)
    89	            try rig.session.commitWeight(String(plan.weight), for: set)
    90	            try rig.session.commitReps(String(plan.reps), for: set)
    91	            try rig.session.toggleCompletion(
    92	                of: set, at: start.addingTimeInterval(Double(index + 1) * 60))
    93	        }
    94	        _ = try rig.session.finish(
    95	            workout, at: start.addingTimeInterval(Double(sets.count + 1) * 60))
    96	        return workout
    97	    }
