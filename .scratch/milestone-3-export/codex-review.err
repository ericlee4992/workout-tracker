     1	import Foundation
     2	
     3	// Milestone 3, ticket 01 — the spreadsheet export: one row per logged set,
     4	// fully denormalized. Pure `ExportSnapshot → String`; no UI, no SwiftData.
     5	//
     6	// This is the format Strong's export would be if it were honest: it carries the
     7	// four things theirs cannot express (SPEC line 88) — an explicit unit per set,
     8	// stable UUIDs, set types, and the full equipment context the set was performed
     9	// in. Every context column is the entry's D23 snapshot, so a gym renamed today
    10	// does not rewrite last year's rows.
    11	
    12	enum ExportCSV {
    13	
    14	    /// The 27 columns, in order. `../spec.md` documents each one's source; the
    15	    /// order is part of the format — appending is safe, reordering is not.
    16	    static let header = [
    17	        "workoutID", "workoutStartedAt", "workoutFinishedAt", "workoutName", "workoutNotes",
    18	        "gymID", "gymName",
    19	        "entryID", "entryOrder", "exerciseID", "exerciseName", "loadType", "equipmentTag",
    20	        "machineID", "machineLabel", "modelID", "manufacturer", "modelName",
    21	        "setID", "setOrder", "setType", "reps", "weight", "unit", "weightKg",
    22	        "completed", "completedAt",
    23	    ]
    24	
    25	    /// RFC 4180 line terminator. Excel on Windows still wants CRLF; every
    26	    /// other reader tolerates it.
    27	    static let lineTerminator = "\r\n"
    28	
    29	    /// The file as text, without the BOM. Rows are ordered exactly as the
    30	    /// snapshot is (workout `startedAt` → id → entry `order` → set `order`),
    31	    /// so re-exporting unchanged data reproduces the same bytes.
    32	    static func render(_ snapshot: ExportSnapshot) -> String {
    33	        var lines = [row(header)]
    34	        for workout in snapshot.workouts {
    35	            for entry in workout.entries {
    36	                for set in entry.sets {
    37	                    lines.append(row(fields(workout: workout, entry: entry, set: set)))
    38	                }
    39	            }
    40	        }
    41	        // Trailing terminator: a text file's last line ends, and appending to
    42	        // the file later cannot glue two rows together.
    43	        return lines.joined(separator: lineTerminator) + lineTerminator
    44	    }
    45	
    46	    /// UTF-8 bytes with a byte-order mark (D32). The BOM is for Excel, which
    47	    /// otherwise decodes a UTF-8 CSV as the system code page and mojibakes any
    48	    /// gym or exercise name that is not ASCII.
    49	    static func data(_ snapshot: ExportSnapshot) -> Data {
    50	        Data("\u{FEFF}".utf8) + Data(render(snapshot).utf8)
    51	    }
    52	
    53	    // MARK: - Rows
    54	
    55	    private static func fields(
    56	        workout: ExportSnapshot.Workout,
    57	        entry: ExportSnapshot.Entry,
    58	        set: ExportSnapshot.SetRow
    59	    ) -> [String] {
    60	        [
    61	            workout.id.uuidString,
    62	            workout.startedAt,
    63	            workout.finishedAt ?? "",
    64	            workout.sourceTemplateName ?? "",
    65	            workout.notes,
    66	            entry.gymID?.uuidString ?? "",
    67	            entry.gymName ?? "",
    68	            entry.id.uuidString,
    69	            String(entry.order),
    70	            entry.exerciseID.uuidString,
    71	            entry.exerciseName,
    72	            entry.loadType.rawValue,
    73	            entry.freeWeightTag?.rawValue ?? "",
    74	            entry.machineID?.uuidString ?? "",
    75	            entry.machineLabel ?? "",
    76	            entry.modelID?.uuidString ?? "",
    77	            entry.modelManufacturer ?? "",
    78	            entry.modelName ?? "",
    79	            set.id.uuidString,
    80	            String(set.order),
    81	            set.type.rawValue,
    82	            set.reps.map(String.init) ?? "",
    83	            // As entered and normalized, both at full precision, both with a
    84	            // locale-independent decimal point (D29/D25). No converted value
    85	            // and no ≈ ever reaches a file.
    86	            set.weight.map(WeightMath.storageNumber) ?? "",
    87	            set.unit.rawValue,
    88	            set.weightKg.map(WeightMath.storageNumber) ?? "",
    89	            set.completedAt == nil ? "false" : "true",
    90	            set.completedAt ?? "",
    91	        ]
    92	    }
    93	
    94	    private static func row(_ fields: [String]) -> String {
    95	        fields.map(escaped).joined(separator: ",")
    96	    }
    97	
    98	    /// RFC 4180 quoting: quote a field only when it must be quoted, and double
    99	    /// any quote inside it. User text goes in verbatim otherwise — no
   100	    /// formula-injection prefixing (D32): silently editing the user's own notes
   101	    /// to protect them from their own spreadsheet is the wrong trade in a file
   102	    /// whose entire job is to be a faithful copy.
   103	    static func escaped(_ field: String) -> String {
   104	        let needsQuoting = field.contains(where: { $0 == "\"" || $0 == "," || $0 == "\n" || $0 == "\r" })
   105	        guard needsQuoting else { return field }
   106	        return "\"" + field.replacingOccurrences(of: "\"", with: "\"\"") + "\""
   107	    }
   108	}
     1	import Foundation
     2	
     3	// Milestone 3, ticket 01 — the machine-readable export: the whole object
     4	// graph, versioned. Pure `ExportSnapshot → Data`; no UI, no SwiftData.
     5	//
     6	// Written so it can be read back: stable UUIDs throughout, no derived values,
     7	// nothing collapsed. Restoring from it is milestone 3's sequel, not milestone 3.
     8	
     9	enum ExportJSON {
    10	
    11	    enum Failure: Error, LocalizedError {
    12	        case encodingFailed(underlying: Error)
    13	
    14	        var errorDescription: String? {
    15	            switch self {
    16	            case .encodingFailed(let underlying):
    17	                "Could not encode the export: \(underlying.localizedDescription)"
    18	            }
    19	        }
    20	    }
    21	
    22	    static func data(_ snapshot: ExportSnapshot) throws -> Data {
    23	        let encoder = JSONEncoder()
    24	        // Sorted keys + pretty printing: the file is meant to be opened, read
    25	        // and diffed by a human as well as parsed. Determinism also means two
    26	        // exports of unchanged data differ only in `exportedAt`.
    27	        encoder.outputFormatting = [.prettyPrinted, .sortedKeys, .withoutEscapingSlashes]
    28	        // Dates are already ISO 8601 strings in the snapshot (D31); nothing
    29	        // here re-formats them. Nil optionals are omitted by Swift's synthesized
    30	        // `encodeIfPresent`, so an absent value is absent rather than `null`.
    31	        do {
    32	            return try encoder.encode(snapshot)
    33	        } catch {
    34	            throw Failure.encodingFailed(underlying: error)
    35	        }
    36	    }
    37	
    38	    /// Reads back a snapshot this app wrote. Present so the format's
    39	    /// round-trip is testable now, and so a future importer has one decoder to
    40	    /// share rather than two that drift.
    41	    static func decode(_ data: Data) throws -> ExportSnapshot {
    42	        try JSONDecoder().decode(ExportSnapshot.self, from: data)
    43	    }
    44	}
     1	import Foundation
     2	
     3	// Milestone 3, ticket 02 — what an export is called and where it is written.
     4	// Domain rather than feature code: naming is part of the format, and the
     5	// filename is the only label the user will see once the file is in Files.
     6	
     7	enum ExportFormat: String, CaseIterable, Identifiable {
     8	    case csv
     9	    case json
    10	
    11	    var id: String { rawValue }
    12	    var fileExtension: String { rawValue }
    13	    var label: String { rawValue.uppercased() }
    14	}
    15	
    16	enum ExportFileWriter {
    17	
    18	    /// `workout-tracker-2026-08-11-1830.csv` — local time (D31's reasoning
    19	    /// applies to the name too), zero-padded so the files sort chronologically
    20	    /// in Files.
    21	    static func filename(
    22	        format: ExportFormat, at date: Date, dateFormat: ExportDateFormat = ExportDateFormat()
    23	    ) -> String {
    24	        "workout-tracker-\(dateFormat.fileStamp(from: date)).\(format.fileExtension)"
    25	    }
    26	
    27	    /// Default staging directory: a dedicated temp subdirectory, so clearing
    28	    /// old exports can never touch anything else.
    29	    static var defaultDirectory: URL {
    30	        FileManager.default.temporaryDirectory
    31	            .appending(path: "Exports", directoryHint: .isDirectory)
    32	    }
    33	
    34	    /// Writes `data` as a fresh export file and returns its URL.
    35	    ///
    36	    /// The directory is emptied first: an export is a snapshot of *now*, and a
    37	    /// share sheet listing three files from the same afternoon is a way to hand
    38	    /// someone the wrong one. Nothing here is the backup — the file the user
    39	    /// saves out of the share sheet is.
    40	    ///
    41	    /// Safe against a share in flight because the share sheet is modal: the
    42	    /// export buttons cannot be reached again until it is dismissed, so no
    43	    /// second write can pull the file out from under a running activity.
    44	    @discardableResult
    45	    static func write(
    46	        _ data: Data,
    47	        format: ExportFormat,
    48	        at date: Date = .now,
    49	        dateFormat: ExportDateFormat = ExportDateFormat(),
    50	        in directory: URL? = nil
    51	    ) throws -> URL {
    52	        let directory = directory ?? defaultDirectory
    53	        try? FileManager.default.removeItem(at: directory)
    54	        try FileManager.default.createDirectory(
    55	            at: directory, withIntermediateDirectories: true)
    56	        let url = directory.appending(
    57	            path: filename(format: format, at: date, dateFormat: dateFormat))
    58	        try data.write(to: url, options: .atomic)
    59	        return url
    60	    }
    61	}

