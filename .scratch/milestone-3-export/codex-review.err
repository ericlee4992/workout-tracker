    45	            snapshotCapturedAt: stamp(1_000),
    46	            exerciseID: ID.exercise, exerciseName: "Seated Chest Press",
    47	            loadType: .weighted, freeWeightTag: nil,
    48	            machineID: ID.machine, machineLabel: "Chest Press #2",
    49	            modelID: ID.model, modelName: "Insignia Chest Press",
    50	            modelManufacturer: "Life Fitness",
    51	            gymID: ID.gym, gymName: "Gold's Gym, Gangnam",
    52	            sets: [
    53	                ExportSnapshot.SetRow(
    54	                    id: ID.set1, order: 0, type: .warmup, reps: 12, weight: 40,
    55	                    unit: .kg, weightKg: 40, completedAt: stamp(1_000)),
    56	                ExportSnapshot.SetRow(
    57	                    id: ID.set2, order: 1, type: .working, reps: 8, weight: 135,
    58	                    unit: .lb, weightKg: 135 * WeightMath.kilogramsPerPound,
    59	                    completedAt: stamp(1_200)),
    60	            ])
    61	        let freeEntry = ExportSnapshot.Entry(
    62	            id: ID.freeEntry, order: 1,
    63	            snapshotCapturedAt: stamp(1_400),
    64	            exerciseID: ID.exercise, exerciseName: "Dumbbell Row",
    65	            loadType: .weighted, freeWeightTag: .dumbbell,
    66	            machineID: nil, machineLabel: nil, modelID: nil, modelName: nil,
    67	            modelManufacturer: nil, gymID: ID.gym, gymName: "Gold's Gym, Gangnam",
    68	            sets: [
    69	                ExportSnapshot.SetRow(
    70	                    id: ID.freeSet, order: 0, type: .drop, reps: 6, weight: 22.5,
    71	                    unit: .kg, weightKg: 22.5, completedAt: stamp(1_400)),
    72	            ])
    73	        let finished = ExportSnapshot.Workout(
    74	            id: ID.workout, startedAt: stamp(900), finishedAt: stamp(1_500),
    75	            notes: "Felt strong; said \"one more\", then did three.",
    76	            sourceTemplateID: nil, sourceTemplateName: "Push Day",
    77	            gymID: ID.gym, gymName: "Gold's Gym, Gangnam",
    78	            entries: [machineEntry, freeEntry])
    79	        // D30: still running, one uncompleted draft set.
    80	        let active = ExportSnapshot.Workout(
    81	            id: ID.activeWorkout, startedAt: stamp(9_000), finishedAt: nil,
    82	            notes: "", sourceTemplateID: nil, sourceTemplateName: nil,
    83	            gymID: nil, gymName: nil,
    84	            entries: [
    85	                ExportSnapshot.Entry(
    86	                    id: ID.activeEntry, order: 0, snapshotCapturedAt: nil,
    87	                    exerciseID: ID.exercise, exerciseName: "Pull-up",
    88	                    loadType: .bodyweight, freeWeightTag: .bodyweight,
    89	                    machineID: nil, machineLabel: nil, modelID: nil, modelName: nil,
    90	                    modelManufacturer: nil, gymID: nil, gymName: nil,
    91	                    sets: [
    92	                        ExportSnapshot.SetRow(
    93	                            id: ID.draftSet, order: 0, type: .working, reps: nil,
    94	                            weight: nil, unit: .kg, weightKg: nil, completedAt: nil),
