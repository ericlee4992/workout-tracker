    40	    // MARK: Display formatting (D25)
    41	
    42	    /// Display-time number formatting: at most 2 decimals, half-up rounding,
    43	    /// trailing zeros trimmed (`60`, `62.5`, `61.23`), decimal separator from
    44	    /// `locale`. Never used for storage.
    45	    static func displayNumber(_ value: Double, locale: Locale = .current) -> String {
    46	        let formatter = NumberFormatter()
    47	        formatter.locale = locale
    48	        formatter.numberStyle = .decimal
    49	        formatter.usesGroupingSeparator = false
    50	        formatter.minimumFractionDigits = 0
