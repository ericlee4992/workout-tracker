     3	
     4	/// Scope selected when correcting the catalog model attached to a machine.
     5	enum ModelCorrectionScope: Sendable, Equatable {
     6	    /// Change the live machine only. Existing snapshots keep their original
     7	    /// model id/name and therefore remain in the original history layer.
     8	    case futureOnly
     9	    /// Change the live machine and rewrite snapshots belonging to this exact
    10	    /// machine. Other machines using the old model are intentionally ignored.
    11	    case applyToPast
    12	}
