   549	// MARK: - Store
   550	
   551	enum WorkoutTrackerStore {
   552	    /// Every model in the app schema — keep exhaustive.
   553	    static let modelTypes: [any PersistentModel.Type] = [
   554	        Exercise.self,
   555	        EquipmentModel.self,
   556	        Gym.self,
   557	        MachineInstance.self,
   558	        WorkoutTemplate.self,
   559	        TemplateItem.self,
   560	        Workout.self,
   561	        ExerciseEntry.self,
   562	        SetRecord.self,
   563	        GymExerciseMemory.self,
   564	        AppPreferences.self,
   565	        ExerciseRestOverride.self,
   566	    ]
   567	
   568	    static var schema: Schema { Schema(modelTypes) }
   569	
   570	    /// On-disk container. `url` overrides the store location (tests);
   571	    /// nil uses the default application-support location.
   572	    static func makeContainer(url: URL? = nil) throws -> ModelContainer {
   573	        let schema = Self.schema
   574	        let configuration: ModelConfiguration
   575	        if let url {
   576	            configuration = ModelConfiguration(schema: schema, url: url)
   577	        } else {
   578	            configuration = ModelConfiguration(schema: schema, isStoredInMemoryOnly: false)
   579	        }
   580	        return try ModelContainer(for: schema, configurations: [configuration])
   581	    }
   582	
   583	    /// Launch argument that makes the app start from an empty store, so
   584	    /// XCUITest runs are deterministic (`WorkoutTrackerUITests`).
   585	    static let uiTestResetArgument = "-uiTestReset"
   586	
   587	    static var isUITestReset: Bool {
   588	        ProcessInfo.processInfo.arguments.contains(uiTestResetArgument)
   589	    }
   590	
   591	    /// Throwaway UI-test store: a dedicated on-disk location wiped on every
   592	    /// launch. On-disk (not in-memory) so the app exercises the real
   593	    /// SwiftData persistence path the tests are meant to drive.
   594	    static func makeUITestContainer() throws -> ModelContainer {
   595	        let directory = URL.cachesDirectory.appending(
   596	            path: "UITestStore", directoryHint: .isDirectory)
   597	        try? FileManager.default.removeItem(at: directory)
   598	        try FileManager.default.createDirectory(
   599	            at: directory, withIntermediateDirectories: true)
   600	        return try makeContainer(url: directory.appending(path: "UITestStore.store"))
   601	    }
   602	}

