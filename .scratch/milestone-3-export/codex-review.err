     1	import SwiftData
     2	import SwiftUI
     3	
     4	/// Milestone 3, ticket 02 — the export block, rendered as one `Section` on the
     5	/// Gyms screen beside `AppSettingsSection` (where app-level settings already
     6	/// live). Tapping a format builds the file on the spot and hands it to the
     7	/// system share sheet; "Save to Files → iCloud Drive" is the backup this
     8	/// milestone exists for.
     9	struct ExportSection: View {
    10	    @Environment(\.modelContext) private var modelContext
    11	    @State private var pendingFile: PendingExport?
    12	    @State private var failure: String?
    13	    @State private var summary: Summary?
    14	
    15	    /// The written file awaiting its share sheet. Identity is per-export, not
    16	    /// per-URL, so exporting the same minute twice still presents.
    17	    private struct PendingExport: Identifiable {
    18	        let id = UUID()
    19	        let url: URL
    20	    }
    21	
    22	    private struct Summary {
    23	        var workouts: Int
    24	        var sets: Int
    25	        var completedSets: Int
    26	
    27	        /// "87 workouts · 1,234 sets logged" — enough to see at a glance that
    28	        /// the export is not empty before sharing it.
    29	        var text: String {
    30	            let workoutLabel = workouts == 1 ? "workout" : "workouts"
    31	            let setLabel = sets == 1 ? "set" : "sets"
    32	            return "\(workouts.formatted()) \(workoutLabel) · \(sets.formatted()) \(setLabel)"
    33	                + (completedSets == sets ? "" : " (\(completedSets.formatted()) completed)")
    34	        }
    35	    }
    36	
    37	    var body: some View {
    38	        Section {
    39	            Text(summary?.text ?? "Counting…")
    40	                .font(.footnote)
    41	                .foregroundStyle(.secondary)
    42	                .accessibilityIdentifier("exportSummary")
    43	                .task { refreshSummary() }
    44	                // Presentation hangs off a row, not off the `Section`: a
    45	                // `.sheet` attached to a Section inside a List never fires
    46	                // (verified — the file was written and nothing appeared).
    47	                .sheet(item: $pendingFile) { pending in
    48	                    ShareSheet(url: pending.url)
    49	                }
    50	
    51	            ForEach(ExportFormat.allCases) { format in
    52	                Button {
    53	                    export(format)
    54	                } label: {
    55	                    Label("Export \(format.label)", systemImage: "square.and.arrow.up")
    56	                }
    57	                .accessibilityIdentifier("export\(format.label)")
    58	            }
    59	
    60	            if let failure {
    61	                Label(failure, systemImage: "exclamationmark.triangle")
    62	                    .font(.footnote)
    63	                    .foregroundStyle(.red)
    64	                    .accessibilityIdentifier("exportFailure")
    65	            }
    66	        } header: {
    67	            Text("Export")
    68	        } footer: {
    69	            Text("Everything you have logged, including sets still in progress. CSV is one row per set, for spreadsheets; JSON keeps the whole structure with stable IDs. Your training history exists only on this iPhone — until you save an export somewhere else, there is no backup.")
    70	        }
    71	    }
    72	
    73	    // MARK: - Actions
    74	
    75	    private func export(_ format: ExportFormat) {
    76	        failure = nil
    77	        do {
    78	            let snapshot = try ExportCollector().snapshot(from: modelContext)
    79	            let data =
    80	                switch format {
    81	                case .csv: ExportCSV.data(snapshot)
    82	                case .json: try ExportJSON.data(snapshot)
    83	                }
    84	            pendingFile = PendingExport(
    85	                url: try ExportFileWriter.write(data, format: format))
    86	            summary = Summary(
    87	                workouts: snapshot.counts.workouts,
    88	                sets: snapshot.counts.sets,
    89	                completedSets: snapshot.counts.completedSets)
    90	        } catch {
    91	            // Never a silent no-op: an export that quietly fails is how a
    92	            // person finds out there was no backup when they needed one.
    93	            failure = "Export failed: \(error.localizedDescription)"
    94	        }
    95	    }
    96	
    97	    /// Counts straight from the store — cheaper than materialising every set
    98	    /// row into a `@Query` on a screen that is mostly about gyms. Re-runs each
    99	    /// time the Gyms tab is selected (SwiftUI restarts `.task` on reappearance)
   100	    /// and again after an export, which is every moment the number is looked at;
   101	    /// logging happens in a full-screen cover, so it cannot go stale on screen.
   102	    private func refreshSummary() {
   103	        do {
   104	            let completed = FetchDescriptor<SetRecord>(
   105	                predicate: #Predicate { $0.completedAt != nil })
   106	            summary = Summary(
   107	                workouts: try modelContext.fetchCount(FetchDescriptor<Workout>()),
   108	                sets: try modelContext.fetchCount(FetchDescriptor<SetRecord>()),
   109	                completedSets: try modelContext.fetchCount(completed))
   110	        } catch {
   111	            failure = "Could not count what there is to export: \(error.localizedDescription)"
   112	        }
   113	    }
   114	}
     1	import SwiftUI
     2	import UIKit
     3	
     4	/// The system share sheet, presented for an already-written file.
     5	///
     6	/// Not `ShareLink`: that evaluates its item when the *view* is built, so the
     7	/// whole export would run on every re-render of the screen it sits on. The
     8	/// export is built when the user asks for it, then handed to this.
     9	struct ShareSheet: UIViewControllerRepresentable {
    10	    let url: URL
    11	
    12	    func makeUIViewController(context: Context) -> UIActivityViewController {
    13	        UIActivityViewController(activityItems: [url], applicationActivities: nil)
    14	    }
    15	
    16	    func updateUIViewController(_ controller: UIActivityViewController, context: Context) {}
    17	}
