   228	    /// Moves `entry` to `index` within its workout's ordered entries.
   229	    func moveEntry(_ entry: ExerciseEntry, toIndex index: Int) throws {
   230	        guard let workout = entry.workout else { return }
   231	        var entries = Self.orderedEntries(of: workout)
   232	        guard let from = entries.firstIndex(where: { $0.id == entry.id }) else { return }
   233	        entries.remove(at: from)
   234	        entries.insert(entry, at: max(0, min(index, entries.count)))
   235	        renumber(entries)
   236	        try context.save()
   237	    }
