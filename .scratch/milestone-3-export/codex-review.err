    96	            ])
    97	
    98	        return ExportSnapshot(
    99	            exportedAt: stamp(10_000),
   100	            appVersion: "1.0 (3)",
   101	            seededCatalogVersion: 4,
   102	            counts: ExportSnapshot.Counts(
   103	                workouts: 2, entries: 3, sets: 4, completedSets: 3,
   104	                gyms: 1, machines: 1, exercises: 1, equipmentModels: 1, templates: 0),
   105	            preferences: ExportSnapshot.Preferences(
   106	                unitPreference: .kg, driftPromptSuppressed: false,
   107	                globalWorkingRestSeconds: 120, globalWarmupRestSeconds: 60,
   108	                seededCatalogVersion: 4, notificationPermissionRequested: true,
   109	                selectedGymID: ID.gym, updatedAt: stamp(2_000)),
   110	            gyms: [
   111	                ExportSnapshot.Gym(
   112	                    id: ID.gym, name: "Gold's Gym, Gangnam", city: "Seoul",
   113	                    defaultUnit: .kg, notes: "", archived: false),
   114	            ],
   115	            machines: [
   116	                ExportSnapshot.Machine(
   117	                    id: ID.machine, label: "Chest Press #2", gymID: ID.gym,
   118	                    modelID: ID.model, defaultUnit: nil, archived: false),
   119	            ],
   120	            exercises: [
   121	                ExportSnapshot.Exercise(
   122	                    id: ID.exercise, name: "Seated Chest Press", loadType: .weighted,
   123	                    equipmentTypeTags: [.machine], muscleGroup: "Chest", isSeeded: true),
   124	            ],
