   218	// MARK: - Timestamps (D31)
   219	
   220	/// ISO 8601 with the exporting device's UTC offset — `2026-08-11T18:30:00+09:00`.
   221	///
   222	/// Not bare UTC: a workout log is a record of local time-of-day, and a 6 a.m.
   223	/// session in Seoul must not read as the previous evening. The offset keeps
   224	/// both the instant and the wall clock.
   225	struct ExportDateFormat {
   226	    private let formatter: ISO8601DateFormatter
   227	
   228	    init(timeZone: TimeZone = .current) {
   229	        let formatter = ISO8601DateFormatter()
   230	        formatter.formatOptions = [.withInternetDateTime]
   231	        formatter.timeZone = timeZone
   232	        self.formatter = formatter
   233	    }
   234	
   235	    func string(from date: Date) -> String {
   236	        formatter.string(from: date)
   237	    }
   238	
   239	    /// Optional passthrough — nil stays nil (an absent timestamp is a fact:
   240	    /// an unfinished workout, an uncompleted set).
   241	    func optionalString(from date: Date?) -> String? {
   242	        guard let date else { return nil }
   243	        return formatter.string(from: date)
   244	    }
   245	
   246	    /// Filename stamp: `2026-08-11-1830`, local time, sorts chronologically.
   247	    func fileStamp(from date: Date) -> String {
   248	        let formatter = DateFormatter()
   249	        formatter.locale = Locale(identifier: "en_US_POSIX")
   250	        formatter.timeZone = self.formatter.timeZone
   251	        formatter.dateFormat = "yyyy-MM-dd-HHmm"
   252	        return formatter.string(from: date)
   253	    }
   254	}

