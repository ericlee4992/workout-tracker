     1	import Foundation
     2	
     3	@testable import WorkoutTracker
     4	
     5	/// A minimal RFC 4180 reader for the export tests, so they read the CSV the
     6	/// way a spreadsheet would rather than by re-implementing the writer's
     7	/// assumptions (a bug shared by writer and test is invisible).
     8	enum TestCSV {
     9	
    10	    /// Splits a rendered export into rows of fields. Handles quoted fields
    11	    /// containing commas, doubled quotes, and embedded newlines.
    12	    static func rows(_ text: String) -> [[String]] {
    13	        var rows: [[String]] = []
    14	        var fields: [String] = []
    15	        var current = ""
    16	        var quoted = false
    17	        var characters = Array(text)
    18	        var index = 0
    19	
    20	        func endField() {
    21	            fields.append(current)
    22	            current = ""
    23	        }
    24	        func endRow() {
    25	            endField()
    26	            rows.append(fields)
    27	            fields = []
    28	        }
    29	
    30	        while index < characters.count {
    31	            let character = characters[index]
    32	            if quoted {
    33	                if character == "\"" {
    34	                    if index + 1 < characters.count, characters[index + 1] == "\"" {
    35	                        current.append("\"")
    36	                        index += 1
    37	                    } else {
    38	                        quoted = false
    39	                    }
    40	                } else {
    41	                    current.append(character)
    42	                }
    43	            } else {
    44	                switch character {
    45	                case "\"":
    46	                    quoted = true
    47	                case ",":
    48	                    endField()
    49	                // Swift reads CRLF as a *single* Character, so the pair has to
    50	                // be matched as one — checking for "\r" alone silently never
    51	                // fires and glues the whole file into one row.
    52	                case "\r\n", "\r", "\n":
    53	                    endRow()
    54	                default:
    55	                    current.append(character)
    56	                }
    57	            }
    58	            index += 1
    59	        }
    60	        // A file ending in a terminator leaves nothing pending; anything else
    61	        // is a final unterminated row.
    62	        if !current.isEmpty || !fields.isEmpty {
    63	            endRow()
    64	        }
    65	        return rows
    66	    }
    67	
    68	    /// Field value by column name, using `ExportCSV.header` for the mapping.
    69	    static func value(_ column: String, in row: [String]) -> String? {
    70	        guard let index = ExportCSV.header.firstIndex(of: column),
    71	              index < row.count
    72	        else { return nil }
    73	        return row[index]
    74	    }
    75	}
