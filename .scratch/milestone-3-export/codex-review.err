    26	    /// An in-memory store carrying the shipped catalog (D24 reconciliation, the
    27	    /// same call the app makes at launch), one gym, and one machine whose model
    28	    /// is a real catalog row linked to a real weighted exercise.
    29	    private func makeRig() throws -> Rig {
    30	        let schema = WorkoutTrackerStore.schema
    31	        let container = try ModelContainer(
    32	            for: schema,
    33	            configurations: [ModelConfiguration(schema: schema, isStoredInMemoryOnly: true)])
    34	        let context = ModelContext(container)
    35	        try CatalogSeeder.reconcile(try SeedCatalog.bundled(), in: context)
    36	
    37	        let exercises = try context.fetch(FetchDescriptor<Exercise>())
    38	        let exercisesByID = Dictionary(
    39	            exercises.map { ($0.id, $0) }, uniquingKeysWith: { first, _ in first })
    40	        // A catalog model whose first linked exercise is weighted — volume (D21)
    41	        // only counts weighted work, and this rig's whole point is to reconcile
    42	        // exported rows against it.
    43	        let model = try #require(
    44	            try context.fetch(FetchDescriptor<EquipmentModel>())
    45	                .sorted { $0.displayName < $1.displayName }
    46	                .first {
    47	                    guard let first = $0.exerciseIDs.first else { return false }
    48	                    return exercisesByID[first]?.loadType == .weighted
    49	                },
    50	            "the seeded catalog must contain a weighted machine")
    51	        let exerciseID = try #require(model.exerciseIDs.first)
    52	        let exercise = try #require(exercisesByID[exerciseID])
    53	
    54	        let gym = Gym(name: "Gold's Gym, Gangnam", city: "Seoul", defaultUnit: .kg)
    55	        let machine = MachineInstance(label: "Chest Press #2", gym: gym, model: model)
    56	        context.insert(gym)
    57	        context.insert(machine)
    58	        try context.save()
    59	
    60	        return Rig(
    61	            context: context,
    62	            session: WorkoutSession(context: context),
    63	            gym: gym, machine: machine, model: model, exercise: exercise,
    64	            collector: ExportCollector(
    65	                dateFormat: ExportDateFormat(timeZone: TimeZone(secondsFromGMT: 9 * 3_600)!),
    66	                appVersion: "test"))
    67	    }
