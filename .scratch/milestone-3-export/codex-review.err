    18	
    19	extension Gym {
    20	    /// The machines a picker may offer at this gym, label-sorted (ticket 10).
    21	    /// An archived gym offers none — archiving a gym archives its pickable
    22	    /// inventory with it, the same way an archived machine disappears. Every
    23	    /// machine list goes through here so that rule cannot be forgotten at one
    24	    /// call site; history stays visible because it reads snapshots, not this.
    25	    var activeMachines: [MachineInstance] {
    26	        guard !archived else { return [] }
    27	        return (machines ?? [])
    28	            .filter { !$0.archived }
    29	            .sorted { $0.label < $1.label }
