   121	    /// consequences (D10), owned by `correctModel(of:to:scope:)`.
   122	    func update(
   123	        _ machine: MachineInstance,
   124	        label: String,
   125	        defaultUnit: WeightUnit?
   126	    ) throws {
   127	        machine.label = try validated(label)
   128	        machine.defaultUnit = defaultUnit
