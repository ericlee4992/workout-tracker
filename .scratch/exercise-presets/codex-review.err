    13	    /// A fresh on-disk store URL in the test sandbox's temp directory.
    14	    private func makeStoreURL() -> URL {
    15	        FileManager.default.temporaryDirectory
    16	            .appendingPathComponent("schema-test-\(UUID().uuidString)")
    17	            .appendingPathExtension("store")
    18	    }
    19	
    20	    private func removeStore(at url: URL) {
    21	        for suffix in ["", "-wal", "-shm"] {
    22	            try? FileManager.default.removeItem(
    23	                at: URL(fileURLWithPath: url.path + suffix))
    24	        }
    25	    }
    26	
    27	    private func fetchOne<T: PersistentModel>(
    28	        _ type: T.Type, id: UUID, in context: ModelContext,
    29	        matching predicate: Predicate<T>
    30	    ) throws -> T {
    31	        let results = try context.fetch(FetchDescriptor<T>(predicate: predicate))
    32	        try #require(results.count == 1, "expected exactly one \(T.self) with id \(id)")
    33	        return results[0]
    34	    }
