    55	
    56	    private func makeRig() throws -> Rig {
    57	        let schema = WorkoutTrackerStore.schema
    58	        let container = try ModelContainer(
    59	            for: schema,
    60	            configurations: [ModelConfiguration(schema: schema, isStoredInMemoryOnly: true)])
    61	        let context = ModelContext(container)
    62	
    63	        let exercise = Exercise(name: "Seated Cable Row", loadType: .weighted)
    64	        let wide = ExercisePreset(name: "Wide grip", order: 0, exercise: exercise)
    65	        let narrow = ExercisePreset(name: "Narrow grip", order: 1, exercise: exercise)
    66	        let model = EquipmentModel(
    67	            manufacturer: "Life Fitness", modelName: "Insignia Row",
    68	            exerciseIDs: [exercise.id])
    69	        let gym = Gym(name: "Gold's", defaultUnit: .kg)
    70	        let machine = MachineInstance(label: "Cable Row #2", gym: gym, model: model)
    71	        for object in [exercise, wide, narrow, model, gym, machine] as [any PersistentModel] {
    72	            context.insert(object)
    73	        }
    74	        try context.save()
    75	        return Rig(
    76	            context: context, session: WorkoutSession(context: context),
    77	            gym: gym, machine: machine, exercise: exercise, wide: wide, narrow: narrow)
    78	    }
    79	
    80	    @discardableResult
    81	    private func logSet(
    82	        _ rig: Rig, on entry: ExerciseEntry, weight: Double, reps: Int, at date: Date
    83	    ) throws -> SetRecord {
    84	        let set = try #require(WorkoutSession.orderedSets(of: entry).last { $0.completedAt == nil })
    85	        try rig.session.commitWeight(String(weight), for: set)
    86	        try rig.session.commitReps(String(reps), for: set)
    87	        try rig.session.toggleCompletion(of: set, at: date)
    88	        return set
    89	    }
