   294	    private func addFifteen() {
   295	        do { showRestTimer(try restTimer.add(seconds: 15, to: workout)) }
   296	        catch { assertionFailure("Failed to extend rest timer: \(error)") }
   297	    }
   298	
   299	    private func skipRest() {
   300	        do {
   301	            try restTimer.skip(workout)
   302	            restEnd = nil
   303	        } catch {
   304	            assertionFailure("Failed to skip rest timer: \(error)")
   305	        }
   306	    }
   307	
   308	    private func refreshRest() {
   309	        do { showRestTimer(try restTimer.currentState(for: workout)) }
   310	        catch { assertionFailure("Failed to restore rest timer: \(error)") }
   311	    }
   312	
   313	    /// Drives the rest bar from a timer state. The progress denominator is the
   314	    /// state's *total* duration — using the remaining time would make a bar
   315	    /// restored mid-rest jump straight back to full.
   316	    private func showRestTimer(_ state: RestTimerState?) {
   317	        restEnd = state?.end
   318	        if let state { restTotal = max(1, state.total) }
   319	    }
   320	}
