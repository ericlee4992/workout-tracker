     4	/// Snapshot-keyed layered performance: this exact equipment context can
     5	/// prefill; same-model-at-another-gym and exercise-wide history are clearly
     6	/// labeled reference only (D1/D11/D23).
     7	struct PreviousPerformanceSheet: View {
     8	    @Environment(\.modelContext) private var modelContext
     9	    @Environment(\.dismiss) private var dismiss
    10	    var entry: ExerciseEntry
    11	    @State private var layers: [PerformanceLayerResult] = []
    12	    @State private var recordSummaries: [PerformanceLayerKind: RecordLayerSummary] = [:]
    13	
    14	    var body: some View {
    15	        NavigationStack {
    16	            List {
    17	                ForEach(layers) { layer in
    18	                    Section {
    19	                        if let snapshot = layer.snapshot {
    20	                            snapshotView(snapshot)
    21	                        } else {
    22	                            Text(emptyMessage(for: layer.kind))
    23	                                .font(.subheadline)
    24	                                .foregroundStyle(.secondary)
    25	                        }
    26	                        Divider()
    27	                        recordsView(for: layer.kind)
    28	                    } header: {
    29	                        header(for: layer.kind)
    30	                    } footer: {
    31	                        footer(for: layer.kind)
    32	                    }
    33	                }
    34	            }
    35	            .navigationTitle(entry.isDeleted ? "" : (entry.exercise?.name ?? entry.snapshotExerciseName))
    36	            .navigationBarTitleDisplayMode(.inline)
    37	            .toolbar {
    38	                ToolbarItem(placement: .topBarTrailing) {
    39	                    Button("Done") { dismiss() }
    40	                }
    41	            }
    42	            .task(id: queryIdentity) {
    43	                loadLayers()
    44	            }
    45	        }
    46	    }
    47	
    48	    private func snapshotView(_ snapshot: PreviousPerformanceSnapshot) -> some View {
    49	        VStack(alignment: .leading, spacing: 7) {
    50	            HStack {
    51	                Text(snapshot.equipmentLabel)
    52	                    .font(.subheadline.weight(.medium))
    53	                Spacer()
    54	                Text(snapshot.workoutDate, style: .date)
    55	                    .font(.caption)
    56	                    .foregroundStyle(.secondary)
    57	            }
    58	            if let gymName = snapshot.gymName {
    59	                Text(gymName)
    60	                    .font(.caption)
    61	                    .foregroundStyle(.secondary)
