   130	    @discardableResult
   131	    private func finishInPlace(
   132	        _ workout: Workout, at date: Date
   133	    ) throws -> WorkoutFinishOutcome {
   134	        // Ending the workout ends its rest: clearing the persisted timer and
   135	        // cancelling the pending notification are one operation, owned by the
   136	        // rest-timer service.
   137	        try restTimer.skip(workout)
   138	        var survivors = 0
   139	        for entry in workout.entries ?? [] {
   140	            let sets = entry.sets ?? []
   141	            let completed = sets.filter { $0.completedAt != nil }
   142	            for draft in sets where draft.completedAt == nil {
   143	                context.delete(draft)
   144	            }
   145	            if completed.isEmpty {
   146	                context.delete(entry)
   147	            } else {
   148	                survivors += 1
   149	            }
   150	        }
   151	        // A2: Start → Finish with nothing logged used to leave a permanent
   152	        // empty row in History. Nothing survived cleanup → nothing happened.
   153	        guard survivors > 0 else {
   154	            context.delete(workout)
   155	            return .discardedEmpty
   156	        }
   157	        workout.finishedAt = date
   158	        return .saved
   159	    }
