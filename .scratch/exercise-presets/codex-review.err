   574	    /// D23: stable UUIDs + loadType + freeWeightTag + display strings, taken
   575	    /// from the live relationships at first completion and never rewritten.
   576	    private func captureSnapshot(of entry: ExerciseEntry, at date: Date) {
   577	        entry.snapshotCapturedAt = date
   578	        entry.snapshotExerciseID = entry.exercise?.id ?? entry.snapshotExerciseID
   579	        entry.snapshotMachineID = entry.machine?.id
   580	        entry.snapshotModelID = entry.machine?.model?.id
   581	        entry.snapshotGymID = entry.workout?.gym?.id
   582	        entry.snapshotLoadType = entry.exercise?.loadType ?? entry.snapshotLoadType
   583	        entry.snapshotFreeWeightTag = entry.freeWeightTag
   584	        entry.snapshotExerciseName = entry.exercise?.name ?? entry.snapshotExerciseName
   585	        entry.snapshotMachineLabel = entry.machine?.label
   586	        entry.snapshotModelName = entry.machine?.model?.displayName
   587	        entry.snapshotGymName = entry.workout?.gym?.name
   588	        entry.snapshotPresetID = entry.preset?.id
   589	        entry.snapshotPresetName = entry.preset?.name
   590	    }
   591	
   592	    /// App-level upsert (no unique constraints under CloudKit): among
   593	    /// existing (gym, exercise) rows the latest `updatedAt` wins (ties by id)
   594	    /// and is updated in place — duplicates are never added to.
   595	    private func upsertMemory(for entry: ExerciseEntry, at date: Date) {
   596	        guard let gymID = entry.workout?.gym?.id,
   597	              let exerciseID = entry.exercise?.id else { return }
   598	        let machineID = entry.machine?.id
   599	        let rows = (try? context.fetch(FetchDescriptor<GymExerciseMemory>(
   600	            predicate: #Predicate { $0.gymID == gymID && $0.exerciseID == exerciseID }
   601	        ))) ?? []
   602	        if let canonical = rows.canonical {
   603	            canonical.machineID = machineID
   604	            canonical.updatedAt = date
   605	        } else {
   606	            context.insert(GymExerciseMemory(
   607	                gymID: gymID, exerciseID: exerciseID, machineID: machineID,
   608	                updatedAt: date))
   609	        }
   610	    }
