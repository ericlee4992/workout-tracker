     7	// Exercise presets (D36–D38) — the rules that decide which sets are comparable
     8	// to which. A preset that splits records is only as good as its boundaries: get
     9	// them wrong and a wide-grip PR quietly becomes a narrow-grip PR, which is the
    10	// same class of damage as attaching a set to the wrong machine (D23).
    11	
    12	struct ExercisePresetTests {
    13	
    14	    // MARK: - Naming rules (pure)
    15	
    16	    @Test func namesAreTrimmedAndDuplicatesRejectedCaseInsensitively() {
    17	        #expect(ExercisePresets.cleanedName("  Wide grip \n") == "Wide grip")
    18	        let existing = ["Wide grip", "Narrow grip"]
    19	        #expect(ExercisePresets.isDuplicate("wide grip", among: existing))
    20	        #expect(ExercisePresets.isDuplicate("  WIDE   GRIP  ", among: existing))
    21	        #expect(!ExercisePresets.isDuplicate("Neutral grip", among: existing))
    22	        // Two presets that read identically would split a rep-count table
    23	        // across rows the user cannot tell apart.
    24	        #expect(!ExercisePresets.isValid("wide grip", existing: existing))
    25	        #expect(!ExercisePresets.isValid("   ", existing: existing))
    26	        #expect(ExercisePresets.isValid("Single leg", existing: existing))
    27	    }
    28	
    29	    @Test func orderingAppendsAndRenumbers() {
    30	        #expect(ExercisePresets.nextOrder(after: []) == 0)
    31	        #expect(ExercisePresets.nextOrder(after: [0, 1, 2]) == 3)
    32	        // Gaps do not confuse it — a delete leaves them behind.
    33	        #expect(ExercisePresets.nextOrder(after: [0, 5]) == 6)
    34	        #expect(ExercisePresets.renumbered(3) == [0, 1, 2])
    35	    }
    36	
    37	    @Test func suggestionsAreOfferedButNeverSeeded() {
    38	        #expect(ExercisePresets.suggestions.contains("Wide grip"))
    39	        #expect(ExercisePresets.suggestions.contains("Single leg"))
    40	        // They are strings in the app, not catalog rows: nothing here has an id.
    41	        #expect(ExercisePresets.suggestions.allSatisfy { !$0.isEmpty })
    42	    }
