    41	            equipment = "\(machineLabel) · \(snapshotModelName ?? "unknown model")"
    42	        } else {
    43	            equipment = snapshotFreeWeightTag?.label ?? "No equipment"
    44	        }
    45	        // The variation is part of what was performed (D36), and it is
