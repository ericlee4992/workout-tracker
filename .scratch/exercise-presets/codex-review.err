   388	final class SetRecord {
   389	    var id: UUID = UUID()
   390	    /// Scalar ordering within the entry — never implicit to-many order.
   391	    var order: Int = 0
   392	    var type: SetType = SetType.working
   393	    /// Draft optionality: reps/weightValue/normalizedKg stay nil until completed.
   394	    var reps: Int?
   395	    var weightValue: Double?
   396	    var weightUnit: WeightUnit = WeightUnit.kg
   397	    /// Recomputed atomically from (weightValue, weightUnit) on any edit (D25).
   398	    var normalizedKg: Double?
   399	    /// nil = not completed; only completed sets feed records/volume/prefill.
   400	    var completedAt: Date?
   401	
   402	    var entry: ExerciseEntry?
   403	
   404	    init(
   405	        id: UUID = UUID(),
   406	        order: Int,
   407	        type: SetType = .working,
   408	        reps: Int? = nil,
   409	        weightValue: Double? = nil,
   410	        weightUnit: WeightUnit = .kg,
   411	        normalizedKg: Double? = nil,
   412	        completedAt: Date? = nil,
   413	        entry: ExerciseEntry? = nil
   414	    ) {
   415	        self.id = id
