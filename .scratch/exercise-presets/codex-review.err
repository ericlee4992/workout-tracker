    66	/// Ticket 17 E1–E3 — the words a history row is made of, kept here so they
    67	/// can be tested without a view. Rows used to be headlined by the gym (every
    68	/// workout at one gym indistinguishable), count "1 exercises", and flatten
    69	/// every sub-minute workout to "0 min".
    70	enum HistoryRendering {
    71	
    72	    /// Headline for a workout with nothing to name it after.
    73	    static let untitledWorkout = "Workout"
    74	
    75	    /// E1: what a workout is called in History. The template it started from
    76	    /// names it; otherwise the exercises performed do ("Chest Press +2"); a
    77	    /// workout with neither gets the neutral fallback. The gym is the
    78	    /// subtitle, never the title — it is what workouts have in common, not
    79	    /// what tells them apart.
    80	    ///
    81	    /// `templateName` and `exercises` must both come from SNAPSHOTS (D23), so
    82	    /// a later rename, deletion, or model correction cannot retitle a finished
    83	    /// workout. Repeats are collapsed by snapshot exercise ID, never by
    84	    /// display name — two distinct exercises may legitimately share one.
    85	    static func title(templateName: String?, exercises: [HistoryExercise]) -> String {
    86	        if let templateName {
    87	            let trimmed = templateName.trimmingCharacters(in: .whitespacesAndNewlines)
    88	            if !trimmed.isEmpty { return trimmed }
    89	        }
    90	        var seen = Set<UUID>()
    91	        let names = exercises
    92	            .filter { seen.insert($0.id).inserted }
    93	            .map { $0.name.trimmingCharacters(in: .whitespacesAndNewlines) }
    94	            .filter { !$0.isEmpty }
    95	        guard let first = names.first else { return untitledWorkout }
    96	        return names.count == 1 ? first : "\(first) +\(names.count - 1)"
    97	    }
    98	
    99	    /// E2: a count that agrees with its noun — never "1 exercises".
   100	    static func pluralized(_ count: Int, _ singular: String, _ plural: String) -> String {
