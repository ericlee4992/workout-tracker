   103	
   104	    /// E3: sub-minute workouts are not all "0 min" — a 14-second mistake and
   105	    /// a 45-second finisher have to be tellable apart. Minutes above a minute.
   106	    static func durationLabel(_ duration: TimeInterval) -> String {
   107	        let seconds = max(0, Int(duration))
