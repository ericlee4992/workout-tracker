   541	    /// A1: completing an empty (or under-specified) row throws
   542	    /// `WorkoutSessionError.setNotLoggable` — an unlogged set is honest, a set
   543	    /// reading `— × —` in history and feeding records is not. The guard only
   544	    /// ever blocks the completing direction; an already-completed row can
   545	    /// always be un-completed.
   546	    func toggleCompletion(of set: SetRecord, at date: Date = .now) throws {
   547	        if set.completedAt == nil {
   548	            guard Self.isLoggable(set) else {
   549	                throw WorkoutSessionError.setNotLoggable
   550	            }
   551	            set.completedAt = date
