     4	struct WorkoutDetailView: View {
     5	    var workout: Workout
     6	    /// Whole-view convert toggle (D9): nil shows every weight as entered;
     7	    /// a unit renders everything in that unit with conversions ≈-marked.
     8	    /// Display-only — storage is never touched.
     9	    @State private var displayUnit: WeightUnit?
    10	
    11	    var body: some View {
