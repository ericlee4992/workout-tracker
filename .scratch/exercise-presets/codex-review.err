     1	import Foundation
     2	import SwiftData
     3	
     4	// Versioned, idempotent catalog seeding (D24). Runs on every launch:
     5	// - inserts seeded rows missing from the store, keyed by fixed catalog UUID
     6	//   (heals partial stores at any version, never duplicates);
     7	// - when the bundled catalog version is newer than the last reconciled one,
     8	//   rewrites the allowlisted seeded fields (name, links, metadata) of
     9	//   existing seeded rows — seeded rows are not user-editable, so this is the
    10	//   only writer;
    11	// - never deletes seeded rows absent from the catalog (historical references
    12	//   must keep resolving) and never touches user-created rows
    13	//   (`isSeeded == false`).
    14	
    15	enum CatalogSeeder {
    16	
    17	    /// Reconciles `catalog` into the store behind `context`, saving only when
    18	    /// something actually changed.
    19	    static func reconcile(_ catalog: SeedCatalog, in context: ModelContext) throws {
    20	        let preferences = try AppPreferences.canonical(in: context)
    21	        let fingerprint = catalog.fingerprint
    22	
    23	        // What the store was last reconciled against. Equal fingerprints mean
    24	        // the catalog's *content* is unchanged since that run — which the
    25	        // version number alone cannot say, because a content edit that forgets
    26	        // the bump (or a rebuilt bundle at the same version) looks identical.
    27	        let contentAlreadyApplied =
    28	            preferences.seededCatalogFingerprint == fingerprint
    29	        let applyUpdates = catalog.version > preferences.seededCatalogVersion
    30	            || (catalog.version == preferences.seededCatalogVersion && !contentAlreadyApplied)
    31	
    32	        // Fast path (ticket 20: the catalog is ~1900 rows and this runs on every
    33	        // launch). Skipping the diff is only sound when the store still holds
    34	        // exactly the catalog's seeded rows, so that is what is checked — the
    35	        // set of seeded ids, not their number. A count check passes a store that
    36	        // lost one seeded row and gained an unrelated one, and would leave the
    37	        // lost row missing forever (codex-review-4).
    38	        if !applyUpdates, contentAlreadyApplied,
    39	           try seededIdentitiesMatch(catalog, in: context) {
    40	            if context.hasChanges { try context.save() }
    41	            return
    42	        }
    43	
    44	        try reconcileExercises(catalog.exercises, applyUpdates: applyUpdates, in: context)
    45	        try reconcileEquipmentModels(catalog.equipmentModels, applyUpdates: applyUpdates, in: context)
    46	
    47	        if applyUpdates {
    48	            preferences.seededCatalogVersion = catalog.version
    49	            preferences.seededCatalogFingerprint = fingerprint
    50	            preferences.updatedAt = .now
    51	        }
    52	        if context.hasChanges {
    53	            try context.save()
    54	        }
    55	    }
    56	
    57	    /// Whether the store's seeded rows are exactly the catalog's rows.
    58	    ///
    59	    /// Two aggregate queries per entity, no rows materialised: how many seeded
    60	    /// rows there are, and how many carry an id the catalog does not define.
    61	    /// Both zero-difference ⇒ every catalog row is present. Fetching the ids
    62	    /// themselves would be honest too, but materialises ~1950 SwiftData objects
    63	    /// and costs ~85 ms — the pass this exists to avoid (measured: 0.2 ms for
    64	    /// the counts, 5 ms for the two id-set queries, 63 ms for a plain fetch).
    65	    ///
    66	    /// Residual: a store holding *two* copies of one seeded row and missing
    67	    /// another passes both checks. Nothing in the app can produce that — the
    68	    /// reconciler inserts only by missing id — and it would take a CloudKit
    69	    /// merge conflict (no unique constraints, T2). The old count-only check, by
    70	    /// contrast, passed for any deletion balanced by any insertion, which is
    71	    /// what a partially restored backup looks like (codex-review-4).
    72	    ///
    73	    /// A store seeded from a *newer* catalog than the bundle (an app downgrade)
    74	    /// holds ids this catalog does not define, fails the check, and falls
    75	    /// through to the full pass; that pass finds every row present and, since
    76	    /// `applyUpdates` is false, changes nothing.
    77	    private static func seededIdentitiesMatch(
    78	        _ catalog: SeedCatalog, in context: ModelContext
    79	    ) throws -> Bool {
    80	        guard try context.fetchCount(
    81	                FetchDescriptor<Exercise>(predicate: #Predicate { $0.isSeeded }))
    82	                == catalog.exercises.count,
    83	              try context.fetchCount(
    84	                FetchDescriptor<EquipmentModel>(predicate: #Predicate { $0.isSeeded }))
    85	                == catalog.equipmentModels.count
    86	        else { return false }
    87	
    88	        let exerciseIDs = Set(catalog.exercises.map(\.id))
    89	        let modelIDs = Set(catalog.equipmentModels.map(\.id))
    90	        return try context.fetchCount(FetchDescriptor<Exercise>(
    91	            predicate: #Predicate { $0.isSeeded && !exerciseIDs.contains($0.id) })) == 0
    92	            && context.fetchCount(FetchDescriptor<EquipmentModel>(
    93	                predicate: #Predicate { $0.isSeeded && !modelIDs.contains($0.id) })) == 0
    94	    }
    95	
    96	    // MARK: Per-entity reconciliation
    97	
    98	    private static func reconcileExercises(
    99	        _ seeds: [SeedExercise], applyUpdates: Bool, in context: ModelContext
   100	    ) throws {
   101	        let existing = try context.fetch(
   102	            FetchDescriptor<Exercise>(predicate: #Predicate { $0.isSeeded }))
   103	        let byID = Dictionary(existing.map { ($0.id, $0) }) { first, _ in first }
   104	
   105	        for seed in seeds {
   106	            if let row = byID[seed.id] {
   107	                guard applyUpdates else { continue }
   108	                // Allowlisted seeded fields only (D24): name + metadata.
   109	                setIfChanged(&row.name, seed.name)
   110	                setIfChanged(&row.loadType, seed.loadType)
   111	                setIfChanged(&row.equipmentTypeTags, seed.equipmentTypeTags)
   112	                setIfChanged(&row.muscleGroup, seed.muscleGroup)
   113	            } else {
   114	                context.insert(Exercise(
   115	                    id: seed.id,
   116	                    name: seed.name,
   117	                    loadType: seed.loadType,
   118	                    equipmentTypeTags: seed.equipmentTypeTags,
   119	                    muscleGroup: seed.muscleGroup,
   120	                    isSeeded: true))
   121	            }
   122	        }
   123	    }
   124	
   125	    private static func reconcileEquipmentModels(
   126	        _ seeds: [SeedEquipmentModel], applyUpdates: Bool, in context: ModelContext
   127	    ) throws {
   128	        let existing = try context.fetch(
   129	            FetchDescriptor<EquipmentModel>(predicate: #Predicate { $0.isSeeded }))
   130	        let byID = Dictionary(existing.map { ($0.id, $0) }) { first, _ in first }
   131	        // Links the *user* added to a seeded model (ticket 19: an exercise
   132	        // invented at a station) are user data living in an allowlisted
   133	        // seeded field. They are re-merged below rather than overwritten —
   134	        // D24 says reconciliation never touches user-created rows, and
   135	        // silently unlinking one is touching it.
   136	        let userExerciseIDs = applyUpdates ? try userCreatedExerciseIDs(in: context) : []
   137	
   138	        for seed in seeds {
   139	            if let row = byID[seed.id] {
   140	                guard applyUpdates else { continue }
   141	                // Allowlisted seeded fields only (D24): name + metadata +
   142	                // exercise links.
   143	                setIfChanged(&row.manufacturer, seed.manufacturer)
   144	                setIfChanged(&row.modelName, seed.modelName)
   145	                setIfChanged(&row.equipmentType, seed.equipmentType)
   146	                setIfChanged(
   147	                    &row.exerciseIDs,
   148	                    merged(
   149	                        seeded: seed.exerciseIDs, existing: row.exerciseIDs,
   150	                        preserving: userExerciseIDs))
   151	            } else {
   152	                context.insert(EquipmentModel(
   153	                    id: seed.id,
   154	                    manufacturer: seed.manufacturer,
   155	                    modelName: seed.modelName,
   156	                    exerciseIDs: seed.exerciseIDs,
   157	                    equipmentType: seed.equipmentType,
   158	                    isSeeded: true))
   159	            }
   160	        }
   161	    }
   162	
   163	    /// The ids of user-created exercises (D24's user ID space).
   164	    private static func userCreatedExerciseIDs(in context: ModelContext) throws -> Set<UUID> {
   165	        Set(try context.fetch(
   166	            FetchDescriptor<Exercise>(predicate: #Predicate { !$0.isSeeded })).map(\.id))
   167	    }
   168	
   169	    /// The catalog's links, in catalog order, followed by the user-added ones
   170	    /// the store already had, in their existing order.
   171	    private static func merged(
   172	        seeded: [UUID], existing: [UUID], preserving userIDs: Set<UUID>
   173	    ) -> [UUID] {
   174	        let seededSet = Set(seeded)
   175	        return seeded + existing.filter { userIDs.contains($0) && !seededSet.contains($0) }
   176	    }
   177	
   178	    /// Writes only on a real difference so an identical rerun leaves the
   179	    /// context without changes (no save, no CloudKit churn).
   180	    private static func setIfChanged<T: Equatable>(_ field: inout T, _ value: T) {
   181	        if field != value { field = value }
   182	    }
   183	}
