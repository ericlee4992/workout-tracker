   262	    // MARK: Archival
   263	
   264	    /// Gyms and machines are archived by flag, never deleted; archiving leaves
   265	    /// workout history completely untouched. Even a hard delete (not used by
   266	    /// the app for archival) must nullify, not cascade into history.
   267	    @Test func archivalUsesFlagsAndNeverTouchesHistory() throws {
   268	        let url = makeStoreURL()
   269	        defer { removeStore(at: url) }
   270	
   271	        let gymID = UUID()
   272	        let machineID = UUID()
   273	        let workoutID = UUID()
   274	
   275	        let container = try WorkoutTrackerStore.makeContainer(url: url)
   276	        let context = ModelContext(container)
   277	
   278	        let gym = Gym(id: gymID, name: "Old Gym", defaultUnit: .kg)
   279	        let machine = MachineInstance(id: machineID, label: "Row #1", gym: gym)
   280	        let workout = Workout(id: workoutID, startedAt: .now, finishedAt: .now, gym: gym)
   281	        let entry = ExerciseEntry(
   282	            id: UUID(), order: 0, workout: workout, machine: machine,
   283	            snapshotExerciseID: UUID(), snapshotMachineID: machineID,
   284	            snapshotGymID: gymID, snapshotLoadType: .weighted,
   285	            snapshotExerciseName: "Seated Row",
   286	            snapshotMachineLabel: "Row #1", snapshotGymName: "Old Gym")
   287	        let set = SetRecord(
   288	            id: UUID(), order: 0, type: .working, reps: 10, weightValue: 50,
   289	            weightUnit: .kg, normalizedKg: 50, completedAt: .now, entry: entry)
   290	        context.insert(gym)
   291	        context.insert(machine)
   292	        context.insert(workout)
   293	        context.insert(entry)
   294	        context.insert(set)
   295	        try context.save()
   296	
   297	        // Archive: set flags — no deletion involved.
   298	        gym.archived = true
   299	        machine.archived = true
   300	        try context.save()
   301	
   302	        #expect(try context.fetchCount(FetchDescriptor<Gym>()) == 1)
   303	        #expect(try context.fetchCount(FetchDescriptor<MachineInstance>()) == 1)
   304	        let archivedGym = try fetchOne(
   305	            Gym.self, id: gymID, in: context,
   306	            matching: #Predicate { $0.id == gymID })
   307	        #expect(archivedGym.archived == true)
   308	        let archivedMachine = try fetchOne(
   309	            MachineInstance.self, id: machineID, in: context,
   310	            matching: #Predicate { $0.id == machineID })
   311	        #expect(archivedMachine.archived == true)
   312	
   313	        // History side is untouched: counts, live links, and snapshots intact.
   314	        #expect(try context.fetchCount(FetchDescriptor<Workout>()) == 1)
   315	        #expect(try context.fetchCount(FetchDescriptor<ExerciseEntry>()) == 1)
   316	        #expect(try context.fetchCount(FetchDescriptor<SetRecord>()) == 1)
   317	        #expect(entry.machine?.id == machineID)
   318	        #expect(workout.gym?.id == gymID)
   319	
   320	        // Safety net: even hard-deleting gym + machine must not cascade into
   321	        // history — relationships nullify and snapshots keep resolving.
   322	        context.delete(machine)
   323	        context.delete(gym)
   324	        try context.save()
   325	
   326	        #expect(try context.fetchCount(FetchDescriptor<Workout>()) == 1)
   327	        #expect(try context.fetchCount(FetchDescriptor<ExerciseEntry>()) == 1)
   328	        #expect(try context.fetchCount(FetchDescriptor<SetRecord>()) == 1)
   329	        let survivingWorkout = try fetchOne(
   330	            Workout.self, id: workoutID, in: context,
   331	            matching: #Predicate { $0.id == workoutID })
   332	        #expect(survivingWorkout.gym == nil)
   333	        let survivingEntry = try #require(survivingWorkout.entries?.first)
   334	        #expect(survivingEntry.machine == nil)
   335	        #expect(survivingEntry.snapshotMachineID == machineID)
   336	        #expect(survivingEntry.snapshotGymID == gymID)
   337	        #expect(survivingEntry.snapshotMachineLabel == "Row #1")
   338	        #expect(survivingEntry.snapshotGymName == "Old Gym")
   339	    }
