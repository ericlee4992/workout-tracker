   417	        self.type = type
   418	        self.reps = reps
   419	        self.weightValue = weightValue
   420	        self.weightUnit = weightUnit
     1	import Foundation
     2	
     3	// Exercise presets — the small rules about naming and ordering them. Pure: no
     4	// UI, no SwiftData.
     5	//
     6	// Presets are user-created (D37) and records key on them (D36), so two presets
     7	// that read the same to a human but differ as rows would split a PR table for
     8	// no reason the user could see. That is the whole job of this file.
     9	
    10	enum ExercisePresets {
    11	
    12	    /// Names offered when adding a preset. Suggestions, not a catalog: they
    13	    /// save typing at the gym and nothing more. D3's reasoning applies — a
    14	    /// worldwide list of every grip on every machine is unknowable, so the app
    15	    /// does not pretend to have one.
    16	    static let suggestions = [
    17	        "Wide grip", "Narrow grip", "Neutral grip", "Reverse grip",
    18	        "Single arm", "Single leg", "Double leg",
    19	        "High pulley", "Low pulley", "Feet high", "Feet low",
    20	    ]
    21	
    22	    /// What the user typed, trimmed. Names are stored as written — "Wide Grip"
    23	    /// stays "Wide Grip" — because it is their label to read.
    24	    static func cleanedName(_ name: String) -> String {
    25	        name.trimmingCharacters(in: .whitespacesAndNewlines)
    26	    }
    27	
    28	    /// Whether `name` already exists among `existing`, ignoring case and
    29	    /// spacing. "wide grip" and "Wide Grip" are one preset; letting both exist
    30	    /// would split a rep-count table across two rows that look identical in the
    31	    /// chips (D36).
    32	    static func isDuplicate(_ name: String, among existing: [String]) -> Bool {
    33	        let candidate = comparable(name)
    34	        guard !candidate.isEmpty else { return false }
    35	        return existing.contains { comparable($0) == candidate }
    36	    }
    37	
    38	    /// Whether a name can be added at all.
    39	    static func isValid(_ name: String, existing: [String]) -> Bool {
    40	        !cleanedName(name).isEmpty && !isDuplicate(name, among: existing)
    41	    }
    42	
    43	    /// Order for a preset appended to `existing` orders.
    44	    static func nextOrder(after existing: [Int]) -> Int {
    45	        (existing.max() ?? -1) + 1
    46	    }
    47	
    48	    /// Orders renumbered 0..<n in the given sequence, for after a move or a
    49	    /// delete — scalar ordering, never implicit to-many order (T2).
    50	    static func renumbered(_ count: Int) -> [Int] {
    51	        Array(0..<count)
    52	    }
    53	
    54	    private static func comparable(_ name: String) -> String {
    55	        cleanedName(name)
    56	            .folding(options: [.caseInsensitive, .diacriticInsensitive],
    57	                     locale: Locale(identifier: "en_US_POSIX"))
    58	            .split(separator: " ", omittingEmptySubsequences: true)
    59	            .joined(separator: " ")
    60	    }
    61	}

