   553	                if entry.snapshotCapturedAt == nil {
   554	                    captureSnapshot(of: entry, at: date)
   555	                }
   556	                upsertMemory(for: entry, at: date)
   557	            }
   558	        } else {
   559	            set.completedAt = nil
   560	        }
   561	        try context.save()
   562	    }
