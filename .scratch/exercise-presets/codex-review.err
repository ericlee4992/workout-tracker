     ) {
         self.id = id
         self.manufacturer = manufacturer
         self.modelName = modelName
         self.exerciseIDs = exerciseIDs
         self.equipmentType = equipmentType
         self.isSeeded = isSeeded
     }
 
     var displayName: String { "\(manufacturer) \(modelName)" }
 }
 
