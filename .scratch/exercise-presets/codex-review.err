   341	    // MARK: Schema rules
   342	
   343	    /// CloudKit rule: every relationship is optional. Assigning nil to each
   344	    /// relationship property only compiles if the property is Optional, so
   345	    /// this test is the compile-time proof; it also sanity-checks the schema
   346	    /// builds and covers every model type.
   347	    @Test func allRelationshipsAreOptional() throws {
   348	        let exercise = Exercise(name: "X")
   349	        exercise.entries = nil
   350	        exercise.templateItems = nil
   351	
   352	        let model = EquipmentModel(manufacturer: "M", modelName: "N")
   353	        model.machines = nil
   354	
   355	        let gym = Gym(name: "G")
   356	        gym.machines = nil
   357	        gym.workouts = nil
   358	
   359	        let machine = MachineInstance(label: "L")
   360	        machine.gym = nil
   361	        machine.model = nil
   362	        machine.entries = nil
   363	
   364	        let template = WorkoutTemplate(name: "T")
   365	        template.items = nil
   366	
   367	        let item = TemplateItem(order: 0)
   368	        item.template = nil
   369	        item.exercise = nil
   370	
   371	        let workout = Workout()
   372	        workout.gym = nil
   373	        workout.entries = nil
   374	
   375	        let entry = ExerciseEntry(
   376	            order: 0, snapshotExerciseID: UUID(), snapshotLoadType: .weighted,
   377	            snapshotExerciseName: "X")
   378	        entry.workout = nil
   379	        entry.exercise = nil
   380	        entry.machine = nil
   381	        entry.sets = nil
   382	
   383	        let set = SetRecord(order: 0)
   384	        set.entry = nil
   385	
   386	        // GymExerciseMemory, AppPreferences, and ExerciseRestOverride hold
   387	        // scalar ids only — no relationships by design.
   388	
   389	        // The full schema builds and includes every model.
   390	        let schema = WorkoutTrackerStore.schema
   391	        #expect(schema.entities.count == WorkoutTrackerStore.modelTypes.count)
   392	    }
