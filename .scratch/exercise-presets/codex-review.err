    63	            ForEach(snapshot.sets) { set in
    64	                HStack {
    65	                    Text(set.type.marker ?? "\(set.order + 1)")
    66	                        .font(.caption.weight(.semibold))
    67	                        .frame(width: 24, alignment: .leading)
    68	                    Text(set.displayLabel)
    69	                        .font(.subheadline.monospacedDigit())
    70	                }
    71	            }
    72	        }
    73	        .padding(.vertical, 3)
    74	    }
    75	
    76	    @ViewBuilder
    77	    private func recordsView(for kind: PerformanceLayerKind) -> some View {
    78	        if let summary = recordSummaries[kind], !summary.isEmpty {
    79	            VStack(alignment: .leading, spacing: 7) {
    80	                Text(recordTitle(for: summary.loadType))
    81	                    .font(.caption.weight(.semibold))
    82	                    .foregroundStyle(.secondary)
    83	
    84	                if summary.loadType == .bodyweight,
    85	                   let best = summary.bodyweightBest {
    86	                    recordRow(label: "Most reps", value: "\(best.reps) reps")
    87	                } else {
    88	                    ForEach(summary.repCountBests.keys.sorted(), id: \.self) { reps in
    89	                        if let achievement = summary.repCountBests[reps] {
    90	                            recordRow(
    91	                                label: "\(reps) reps",
    92	                                value: achievementLabel(achievement))
    93	                        }
    94	                    }
    95	                }
    96	
    97	                if let estimate = summary.estimatedOneRepMax {
    98	                    recordRow(
    99	                        label: "e1RM (Brzycki, est.)",
   100	                        value: estimateLabel(estimate))
   101	                    Text("From \(Format.weight(estimate.weightValue)) \(estimate.weightUnit.rawValue) × \(estimate.reps)")
   102	                        .font(.caption2)
   103	                        .foregroundStyle(.secondary)
   104	                }
   105	            }
   106	            .padding(.vertical, 3)
   107	        } else {
   108	            Text(PerformanceLayerKind.emptyRecordsMessage)
   109	                .font(.caption)
   110	                .foregroundStyle(.secondary)
   111	        }
   112	    }
   113	
   114	    private func recordRow(label: String, value: String) -> some View {
   115	        HStack {
   116	            Text(label)
   117	            Spacer()
   118	            Text(value)
   119	                .font(.subheadline.monospacedDigit().weight(.medium))
   120	        }
   121	        .font(.subheadline)
   122	    }
   123	
   124	    private func recordTitle(for loadType: LoadType) -> String {
   125	        switch loadType {
   126	        case .weighted: "Weight records"
   127	        case .assisted: "Least-assistance records · lower is better"
   128	        case .bodyweightPlus: "Added-weight records"
   129	        case .bodyweight: "Bodyweight record"
   130	        }
   131	    }
   132	
   133	    private func achievementLabel(_ achievement: RecordAchievement) -> String {
   134	        guard let value = achievement.weightValue,
   135	              let unit = achievement.weightUnit else {
   136	            return "\(achievement.reps) reps"
   137	        }
   138	        return "\(WeightMath.displayNumber(value)) \(unit.rawValue)"
   139	    }
   140	
   141	    private func estimateLabel(_ estimate: E1RMRecord) -> String {
   142	        let value = WeightMath.convert(
   143	            estimate.e1RMKg, from: .kg, to: estimate.weightUnit)
   144	        return "≈\(WeightMath.displayNumber(value)) \(estimate.weightUnit.rawValue)"
   145	    }
   146	
   147	    @ViewBuilder
   148	    private func header(for kind: PerformanceLayerKind) -> some View {
   149	        switch kind {
   150	        case .thisEquipment:
   151	            Label {
   152	                Text("This equipment — \(entry.equipmentDisplayLabel)")
   153	            } icon: {
   154	                Image(systemName: "target").foregroundStyle(.green)
   155	            }
   156	        case .sameModelElsewhere:
   157	            Label {
   158	                Text("Same model elsewhere")
   159	            } icon: {
   160	                Image(systemName: "gearshape.2").foregroundStyle(.orange)
   161	            }
   162	        case .anyEquipment:
   163	            Label {
   164	                Text("Any equipment")
   165	            } icon: {
   166	                Image(systemName: "square.stack.3d.up").foregroundStyle(.secondary)
   167	            }
   168	        }
   169	    }
   170	
   171	    @ViewBuilder
   172	    private func footer(for kind: PerformanceLayerKind) -> some View {
   173	        switch kind {
   174	        case .thisEquipment:
   175	            Text("Only this exact equipment context prefills your sets.")
   176	        case .sameModelElsewhere:
   177	            Text("Same hardware at a different gym — shown for reference, never prefilled.")
   178	        case .anyEquipment:
   179	            Text("Exercise-wide history — equipment may differ, so it is reference only and never prefilled.")
   180	        }
   181	    }
   182	
   183	    private func emptyMessage(for kind: PerformanceLayerKind) -> String {
   184	        kind.emptyHistoryMessage(hasMachine: entry.machine != nil)
   185	    }
   186	
   187	    private var queryIdentity: String {
   188	        [
   189	            entry.id.uuidString,
   190	            entry.machine?.id.uuidString ?? "no-machine",
   191	            entry.machine?.model?.id.uuidString ?? "no-model",
   192	            entry.freeWeightTag?.rawValue ?? "no-tag",
   193	        ].joined(separator: "|")
   194	    }
   195	
   196	    private func loadLayers() {
   197	        guard !entry.isDeleted else { return }
   198	        do {
   199	            // One pass over history for the whole sheet — layers and records
   200	            // are rendered together and must agree.
   201	            let summary = try PerformanceHistory(context: modelContext)
   202	                .summary(for: entry)
   203	            layers = summary.layers
   204	            recordSummaries = summary.records
   205	        } catch {
   206	            assertionFailure("Failed to load performance layers: \(error)")
   207	            layers = []
   208	            recordSummaries = [:]
   209	        }
   210	    }
   211	}
