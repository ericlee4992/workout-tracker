     6	/// Unit badge for a workout summary, derived from the units of the actual
     7	/// logged sets — never just the gym default (SPEC "Units").
     8	enum WorkoutUnitBadge: Equatable {
     9	    case single(WeightUnit)
    10	    case mixed
    11	
    12	    var label: String {
    13	        switch self {
    14	        case .single(let unit): unit.rawValue
    15	        case .mixed: "Mixed"
    16	        }
    17	    }
    18	
    19	    /// Badge over a list of set units: all one unit → that unit, otherwise
    20	    /// Mixed. nil when there are no units to derive from.
    21	    static func derive(fromUnits units: [WeightUnit]) -> WorkoutUnitBadge? {
    22	        guard let first = units.first else { return nil }
    23	        return units.allSatisfy { $0 == first } ? .single(first) : .mixed
    24	    }
    25	
    26	    /// Badge for a set list. Only completed sets count — drafts never reach
    27	    /// history (Finish deletes them), and they carry no logged weight.
    28	    static func derive(fromCompleted sets: [SetRecord]) -> WorkoutUnitBadge? {
    29	        derive(fromUnits: sets.filter { $0.completedAt != nil }.map(\.weightUnit))
    30	    }
