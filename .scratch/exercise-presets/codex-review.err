   346	            entries.insert(newEntry, at: position + 1)
   347	        } else {
   348	            entries.append(newEntry)
   349	        }
   350	        renumber(entries)
   351	
   352	        // Draft rows move to the new entry, preserving relative order;
   353	        // completed sets stay behind — identical to `chooseEquipment`.
   354	        let drafts = Self.orderedSets(of: entry).filter { $0.completedAt == nil }
   355	        for (offset, draft) in drafts.enumerated() {
   356	            draft.entry = newEntry
   357	            draft.order = offset
   358	        }
   359	        renumber(sets: Self.orderedSets(of: entry))
