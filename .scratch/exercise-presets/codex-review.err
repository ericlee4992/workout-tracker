   537	extension AppPreferences {
   538	    /// Canonical row among duplicates: latest `updatedAt`, ties broken by
   539	    /// `id` (app-side upsert — no unique constraints under CloudKit).
   540	    static func canonical(of rows: [AppPreferences]) -> AppPreferences? {
   541	        rows.canonical
   542	    }
   543	
   544	    /// Canonical AppPreferences row for `context`, inserting a fresh row when
   545	    /// none exists yet (first launch).
   546	    static func canonical(in context: ModelContext) throws -> AppPreferences {
   547	        if let canonical = canonical(of: try context.fetch(FetchDescriptor<AppPreferences>())) {
   548	            return canonical
   549	        }
   550	        let fresh = AppPreferences()
   551	        context.insert(fresh)
   552	        return fresh
   553	    }
   554	
   555	    /// First-launch unit-preference resolution: when unset, derive the default
   556	    /// from the locale measurement system (US → lb, else kg) and persist it.
   557	    /// Idempotent — an already-set preference is never overwritten.
   558	    @discardableResult
   559	    static func ensureUnitPreference(
   560	        in context: ModelContext,
   561	        measurementSystem: Locale.MeasurementSystem = Locale.current.measurementSystem
   562	    ) throws -> AppPreferences {
   563	        let preferences = try canonical(in: context)
   564	        if preferences.unitPreference == nil {
   565	            preferences.unitPreference = UnitPrecedence.firstLaunchDefault(for: measurementSystem)
   566	            preferences.updatedAt = .now
   567	        }
   568	        if context.hasChanges {
   569	            try context.save()
   570	        }
   571	        return preferences
   572	    }
   573	}
