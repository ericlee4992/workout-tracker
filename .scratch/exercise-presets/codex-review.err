   186	    // MARK: Actions
   187	
   188	    private func minimize() {
   189	        if let onMinimize {
   190	            onMinimize()
   191	        } else {
   192	            dismiss()
   193	        }
   194	    }
   195	
   196	    /// B2: Finish finishes. A from-scratch workout gets no pre-finish
   197	    /// interrogation — save-as-template moved to the post-finish confirmation
   198	    /// (C2), where it is offered once the workout is safely stored. The
   199	    /// template-drift prompt (D18) survives, but only for workouts that
   200	    /// actually came from a template.
   201	    private func finishTapped() {
   202	        if workout.sourceTemplateID == nil {
   203	            finishWorkout()
   204	            return
   205	        }
   206	        do {
   207	            let drift = TemplateDriftService(context: modelContext)
   208	            if let template = try drift.sourceTemplate(for: workout),
   209	               try drift.shouldPrompt(for: workout, template: template) {
   210	                driftTemplate = template
   211	                choosingDriftResolution = true
   212	            } else {
   213	                finishWorkout()
   214	            }
   215	        } catch {
   216	            assertionFailure("Failed to inspect template drift: \(error)")
   217	        }
   218	    }
   219	
   220	    // `session.finish` / `session.cancel` end the rest timer (state and
   221	    // pending notification) themselves — call sites no longer skip first.
   222	    private func finishWorkout() {
   223	        var outcome = WorkoutFinishOutcome.discardedEmpty
   224	        do {
   225	            outcome = try session.finish(workout)
   226	        } catch {
   227	            assertionFailure("Failed to finish workout: \(error)")
   228	        }
   229	        reportFinished(outcome)
   230	    }
   231	
   232	    private func finishTemplatedWorkout(using resolution: TemplateDriftResolution) {
   233	        var outcome = WorkoutFinishOutcome.discardedEmpty
   234	        do {
   235	            if let driftTemplate {
   236	                outcome = try TemplateDriftService(context: modelContext).resolve(
   237	                    resolution, workout: workout, to: driftTemplate)
   238	            } else {
   239	                outcome = try session.finish(workout)
   240	            }
   241	        } catch {
   242	            assertionFailure("Failed to finish templated workout: \(error)")
   243	        }
   244	        driftTemplate = nil
   245	        reportFinished(outcome)
   246	    }
   247	
   248	    /// C2/A2: hand the outcome to the presenter. A saved workout goes back so
   249	    /// the confirmation can show what was logged; a discarded one goes back as
   250	    /// `nil` so the same sheet can say that nothing was saved instead.
   251	    private func reportFinished(_ outcome: WorkoutFinishOutcome) {
   252	        guard let onFinished else {
   253	            dismiss()
   254	            return
   255	        }
   256	        let saved = outcome == .saved && !workout.isDeleted
   257	            && workout.finishedAt != nil
   258	        onFinished(saved ? workout : nil)
   259	    }
   260	
   261	    private func cancelWorkout() {
   262	        do {
   263	            try session.cancel(workout)
   264	        } catch {
   265	            assertionFailure("Failed to cancel workout: \(error)")
   266	        }
   267	        dismiss()
   268	    }
