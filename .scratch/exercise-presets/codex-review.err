     1	import Foundation
     2	
     3	// Ticket 12 — records computation core (D17/D20/D21/D23). Pure logic: no UI,
     4	// no SwiftData. Operates on plain values mirroring completed-set snapshots —
     5	// callers map SetRecord/ExerciseEntry rows into `RecordSetInput`; this file
     6	// never touches live catalog rows (D23).
     7	//
     8	// Per load type (D20):
     9	// - weighted:       best weight per rep count (1–12) + Brzycki e1RM
    10	// - assisted:       least assistance per rep count, no e1RM
    11	// - bodyweightPlus: most added weight per rep count, no e1RM
    12	// - bodyweight:     most reps, uncapped, no e1RM
    13	// Comparisons use normalizedKg; results carry the as-entered (value, unit)
    14	// for display. Ties resolve to the earliest achieving set.
    15	
    16	// MARK: - Inputs
    17	
    18	/// Plain-value mirror of one logged set plus its entry's context snapshot.
    19	/// Grouping fields come from the entry's snapshot (D23), never live rows.
    20	struct RecordSetInput: Equatable {
    21	    var loadType: LoadType
    22	    var exerciseID: UUID
    23	    /// Gym the set was logged at, from the entry snapshot (nil = no gym).
    24	    /// Not a group key — `.model` records span gyms by design; callers scope
    25	    /// a model group to "elsewhere" by filtering out the current gym's id.
    26	    var gymID: UUID?
    27	    var machineID: UUID?
    28	    var modelID: UUID?
    29	    var freeWeightTag: EquipmentTag?
    30	    /// The variation performed (D36). Part of every group key: a narrow-grip
    31	    /// row PR is not a wide-grip row PR, and pooling them would let one
    32	    /// variation set a record the other can never beat. nil is its own group —
    33	    /// sets logged before presets existed, honestly reported as "no preset".
    34	    var presetID: UUID?
    35	    var setType: SetType
    36	    var reps: Int?
    37	    /// As-entered load; for assisted this is the assistance weight, for
    38	    /// bodyweightPlus the added weight. nil while drafting.
    39	    var weightValue: Double?
    40	    var weightUnit: WeightUnit
    41	    /// Canonical kg derived atomically from (weightValue, weightUnit) (D25).
    42	    var normalizedKg: Double?
    43	    /// nil = not completed; only completed sets feed records/volume.
    44	    var completedAt: Date?
    45	}
    46	
    47	// MARK: - Results
    48	
    49	/// One record-table cell: the achieving set's reps, its as-entered load
    50	/// (nil for plain bodyweight, where load is ignored), and when it happened.
    51	struct RecordAchievement: Equatable {
    52	    let reps: Int
    53	    let weightValue: Double?
    54	    let weightUnit: WeightUnit?
    55	    let normalizedKg: Double?
    56	    let completedAt: Date
    57	}
    58	
    59	/// Best Brzycki estimate plus the set that produced it (weighted only, D20).
    60	struct E1RMRecord: Equatable {
    61	    let e1RMKg: Double
    62	    let reps: Int
    63	    let weightValue: Double
    64	    let weightUnit: WeightUnit
    65	    let normalizedKg: Double
    66	    let completedAt: Date
    67	}
    68	
    69	/// Snapshot-derived grouping keys (D23). A machineless entry is keyed by
    70	/// (exercise, freeWeightTag) so barbell and dumbbell records never merge.
    71	enum RecordGroupKey: Hashable {
    72	    case machine(UUID, preset: UUID?)
    73	    case model(UUID, preset: UUID?)
    74	    case exercise(UUID, preset: UUID?)
    75	    case freeWeight(exerciseID: UUID, tag: EquipmentTag?, preset: UUID?)
    76	}
    77	
    78	// MARK: - Records math
    79	
    80	enum RecordsMath {
    81	
    82	    /// D17: rep-count records and e1RM stop at 12 reps (weight-keyed tables
    83	    /// only — bodyweight most-reps is uncapped).
    84	    static let repRecordCap = 12
    85	
    86	    // MARK: Eligibility
    87	
    88	    /// Load-type-specific eligibility: completed, positive reps, warmups out,
    89	    /// failure and drop in (D26 — a drop set is real work, the weight was
    90	    /// lifted); load finite and — weighted: > 0; assisted: ≥ 0 (0 =
    91	    /// unassisted); bodyweightPlus: ≥ 0 (0 = plain); bodyweight: load ignored.
    92	    static func isEligible(_ set: RecordSetInput) -> Bool {
    93	        guard set.completedAt != nil,
    94	              let reps = set.reps, reps > 0,
    95	              set.setType.countsTowardRecords
    96	        else { return false }
    97	
    98	        switch set.loadType {
    99	        case .bodyweight:
   100	            return true
   101	        case .weighted:
   102	            guard let kg = eligibleLoadKg(of: set) else { return false }
   103	            return kg > 0
   104	        case .assisted, .bodyweightPlus:
   105	            return eligibleLoadKg(of: set) != nil
   106	        }
   107	    }
   108	
   109	    /// Finite, non-negative normalized load with its as-entered value present;
   110	    /// nil when the set has no usable load.
   111	    private static func eligibleLoadKg(of set: RecordSetInput) -> Double? {
   112	        guard set.weightValue != nil,
   113	              let kg = set.normalizedKg, kg.isFinite, kg >= 0
   114	        else { return nil }
   115	        return kg
   116	    }
   117	
   118	    // MARK: Ranking
   119	
   120	    /// Whether `candidate` beats `incumbent` for record purposes. Both are
   121	    /// assumed eligible and of the same (candidate's) load type. Load ranks
   122	    /// first via normalizedKg — direction per load type (assisted: lower is
   123	    /// better) — then more reps, then the earlier `completedAt` (tie rule).
   124	    static func outranks(_ candidate: RecordSetInput, _ incumbent: RecordSetInput) -> Bool {
   125	        guard let candidateReps = candidate.reps, let incumbentReps = incumbent.reps,
   126	              let candidateDate = candidate.completedAt, let incumbentDate = incumbent.completedAt
   127	        else { return false }
   128	
   129	        switch candidate.loadType {
   130	        case .bodyweight:
   131	            break // Load ignored; reps decide.
   132	        case .weighted, .bodyweightPlus, .assisted:
   133	            guard let candidateKg = candidate.normalizedKg,
   134	                  let incumbentKg = incumbent.normalizedKg
   135	            else { return false }
   136	            if candidateKg != incumbentKg {
   137	                let lowerIsBetter = candidate.loadType == .assisted
   138	                return lowerIsBetter ? candidateKg < incumbentKg : candidateKg > incumbentKg
   139	            }
   140	        }
   141	        if candidateReps != incumbentReps { return candidateReps > incumbentReps }
   142	        return candidateDate < incumbentDate
   143	    }
   144	
   145	    // MARK: Rep-count tables (weight-keyed load types)
   146	
   147	    /// Best set per rep count (1–12) among sets whose snapshot load type is
   148	    /// `loadType`: weighted → heaviest, assisted → least assistance,
   149	    /// bodyweightPlus → most added. Empty for `bodyweight` — that load type
   150	    /// has no weight-keyed table (use `mostRepsRecord`).
   151	    static func repCountBests(
   152	        among sets: [RecordSetInput], loadType: LoadType
   153	    ) -> [Int: RecordAchievement] {
   154	        guard loadType != .bodyweight else { return [:] }
   155	        var bests: [Int: RecordSetInput] = [:]
   156	        for set in sets where set.loadType == loadType && isEligible(set) {
   157	            guard let reps = set.reps, reps <= repRecordCap else { continue }
   158	            if let incumbent = bests[reps], !outranks(set, incumbent) { continue }
   159	            bests[reps] = set
   160	        }
   161	        return bests.compactMapValues(achievement(from:))
   162	    }
   163	
   164	    /// Most-reps record among plain-bodyweight sets — uncapped (D20).
   165	    static func mostRepsRecord(among sets: [RecordSetInput]) -> RecordAchievement? {
   166	        var best: RecordSetInput?
   167	        for set in sets where set.loadType == .bodyweight && isEligible(set) {
   168	            if let incumbent = best, !outranks(set, incumbent) { continue }
   169	            best = set
   170	        }
   171	        return best.flatMap(achievement(from:))
   172	    }
   173	
   174	    /// Result cell for an eligible set; nil only on malformed input.
   175	    private static func achievement(from set: RecordSetInput) -> RecordAchievement? {
   176	        guard let reps = set.reps, let completedAt = set.completedAt else { return nil }
   177	        let carriesLoad = set.loadType != .bodyweight
   178	        return RecordAchievement(
   179	            reps: reps,
   180	            weightValue: carriesLoad ? set.weightValue : nil,
   181	            weightUnit: carriesLoad ? set.weightUnit : nil,
   182	            normalizedKg: carriesLoad ? set.normalizedKg : nil,
   183	            completedAt: completedAt
   184	        )
   185	    }
   186	
   187	    // MARK: Brzycki e1RM (weighted only, D17/D20)
   188	
   189	    /// Brzycki estimate `weight / (1.0278 − 0.0278 × reps)` in kg. nil outside
   190	    /// 1...12 reps (estimates degrade past 12, D17) or for a non-positive load.
   191	    static func brzyckiE1RMKg(weightKg: Double, reps: Int) -> Double? {
   192	        guard (1...repRecordCap).contains(reps), weightKg.isFinite, weightKg > 0
   193	        else { return nil }
   194	        return weightKg / (1.0278 - 0.0278 * Double(reps))
   195	    }
   196	
   197	    /// Best Brzycki e1RM among eligible weighted sets of ≤ 12 reps; ties by
   198	    /// estimate resolve to the earliest set. nil when nothing qualifies.
   199	    static func bestE1RM(among sets: [RecordSetInput]) -> E1RMRecord? {
   200	        var best: (set: RecordSetInput, e1RMKg: Double, completedAt: Date)?
   201	        for set in sets where set.loadType == .weighted && isEligible(set) {
   202	            guard let reps = set.reps, let kg = set.normalizedKg,
   203	                  let completedAt = set.completedAt,
   204	                  let e1RMKg = brzyckiE1RMKg(weightKg: kg, reps: reps)
   205	            else { continue }
   206	            if let incumbent = best,
   207	               !(e1RMKg > incumbent.e1RMKg
   208	                 || (e1RMKg == incumbent.e1RMKg && completedAt < incumbent.completedAt)) {
   209	                continue
   210	            }
   211	            best = (set, e1RMKg, completedAt)
   212	        }
   213	        guard let best, let reps = best.set.reps,
   214	              let weightValue = best.set.weightValue, let normalizedKg = best.set.normalizedKg
   215	        else { return nil }
   216	        return E1RMRecord(
   217	            e1RMKg: best.e1RMKg,
   218	            reps: reps,
   219	            weightValue: weightValue,
   220	            weightUnit: best.set.weightUnit,
   221	            normalizedKg: normalizedKg,
   222	            completedAt: best.completedAt
   223	        )
   224	    }
   225	
   226	    // MARK: Volume (D21)
   227	
   228	    /// Σ(normalizedKg × reps) over eligible working+failure+drop sets of
   229	    /// weighted exercises only (warmups are the sole exclusion, D26).
   230	    /// Dumbbell sets are logged per-hand and summed as
   231	    /// labeled — no equipment special-casing, so nothing is doubled.
   232	    /// Assisted/bodyweight/bodyweightPlus contribute nothing.
   233	    static func totalVolumeKg(among sets: [RecordSetInput]) -> Double {
   234	        sets.reduce(0) { total, set in
   235	            guard set.loadType == .weighted, isEligible(set),
   236	                  let reps = set.reps, let kg = set.normalizedKg
   237	            else { return total }
   238	            return total + kg * Double(reps)
   239	        }
   240	    }
   241	
   242	    // MARK: Grouping (D23)
   243	
   244	    /// Every record group this set belongs to, from snapshot values only:
   245	    /// always the exercise; the machine and model when machined; and for
   246	    /// machineless entries, (exercise, freeWeightTag). Every key also carries
   247	    /// the preset (D36) — the variation is part of what makes two sets
   248	    /// comparable, exactly as the machine is.
   249	    static func groupKeys(for set: RecordSetInput) -> Set<RecordGroupKey> {
   250	        let preset = set.presetID
   251	        var keys: Set<RecordGroupKey> = [.exercise(set.exerciseID, preset: preset)]
   252	        if let machineID = set.machineID {
   253	            keys.insert(.machine(machineID, preset: preset))
   254	        } else {
   255	            keys.insert(.freeWeight(
   256	                exerciseID: set.exerciseID, tag: set.freeWeightTag, preset: preset))
   257	        }
   258	        if let modelID = set.modelID {
   259	            keys.insert(.model(modelID, preset: preset))
   260	        }
   261	        return keys
   262	    }
   263	
   264	    /// Sets bucketed under every group key each belongs to (a set appears in
   265	    /// multiple buckets: its machine, model, exercise, and tag scopes).
   266	    static func grouped(_ sets: [RecordSetInput]) -> [RecordGroupKey: [RecordSetInput]] {
   267	        var groups: [RecordGroupKey: [RecordSetInput]] = [:]
   268	        for set in sets {
   269	            for key in groupKeys(for: set) {
   270	                groups[key, default: []].append(set)
   271	            }
   272	        }
   273	        return groups
   274	    }
   275	}
     1	import Foundation
     2	import SwiftData
     3	
     4	enum PerformanceLayerKind: String, Sendable, Hashable {
     5	    case thisEquipment
     6	    case sameModelElsewhere
     7	    case anyEquipment
     8	}
     9	
    10	extension PerformanceLayerKind {
    11	    /// Ticket 13: a layer with no history still renders a labeled explanation
    12	    /// naming *this* layer — never a blank section. Kept beside the layer kind
    13	    /// (Foundation-only, unit-tested) so the empty states cannot silently
    14	    /// vanish from the sheet.
    15	    func emptyHistoryMessage(hasMachine: Bool) -> String {
    16	        switch self {
    17	        case .thisEquipment:
    18	            hasMachine
    19	                ? "No completed sets on this machine yet."
    20	                : "No completed sets with this equipment yet."
    21	        case .sameModelElsewhere:
    22	            "No other gyms with this model logged yet."
    23	        case .anyEquipment:
    24	            "No history for this exercise yet."
    25	        }
    26	    }
    27	
    28	    /// Shown in place of a layer's records block when it has no eligible sets.
    29	    static let emptyRecordsMessage = "No eligible records at this layer yet."
    30	}
    31	
    32	struct PreviousSetValue: Sendable, Equatable, Identifiable {
    33	    var id: UUID
    34	    var order: Int
    35	    var type: SetType
    36	    var reps: Int
    37	    var weightValue: Double?
    38	    var weightUnit: WeightUnit
    39	    var normalizedKg: Double?
    40	    var completedAt: Date
    41	
    42	    var displayLabel: String {
    43	        let repsLabel = "\(reps)"
    44	        guard let weightValue else { return "\(repsLabel) reps" }
    45	        return "\(Format.weight(weightValue)) \(weightUnit.rawValue) × \(repsLabel)"
    46	    }
    47	}
    48	
    49	struct PreviousPerformanceSnapshot: Sendable, Equatable {
    50	    var layer: PerformanceLayerKind
    51	    var workoutID: UUID
    52	    var workoutDate: Date
    53	    var gymName: String?
    54	    var equipmentLabel: String
    55	    var sets: [PreviousSetValue]
    56	}
    57	
    58	struct PerformanceLayerResult: Sendable, Equatable, Identifiable {
    59	    var kind: PerformanceLayerKind
    60	    var snapshot: PreviousPerformanceSnapshot?
    61	    var id: PerformanceLayerKind { kind }
    62	}
    63	
    64	struct RecordLayerSummary: Sendable, Equatable {
    65	    var loadType: LoadType
    66	    var repCountBests: [Int: RecordAchievement]
    67	    var bodyweightBest: RecordAchievement?
    68	    var estimatedOneRepMax: E1RMRecord?
    69	
    70	    var isEmpty: Bool {
    71	        repCountBests.isEmpty && bodyweightBest == nil && estimatedOneRepMax == nil
    72	    }
    73	}
    74	
    75	/// Everything the performance sheet renders for one entry: each applicable
    76	/// fallback layer's reference snapshot, and that layer's records.
    77	struct PerformanceSummary: Sendable, Equatable {
    78	    var layers: [PerformanceLayerResult]
    79	    var records: [PerformanceLayerKind: RecordLayerSummary]
    80	}
    81	
    82	/// Ticket 11 history selection. Every grouping decision uses entry snapshots
    83	/// (D23), and every source is a finished workout with completed sets only.
    84	/// Live catalog relationships are used solely to identify the draft entry's
    85	/// current context before its own snapshot is captured.
    86	struct PerformanceHistory {
    87	    let context: ModelContext
    88	
    89	    init(context: ModelContext) {
    90	        self.context = context
    91	    }
    92	
    93	    /// Prefill source for one draft row, matched by exact set type and its
    94	    /// zero-based ordinal among rows of that type — so every type, `drop`
    95	    /// included (D26), is its own sequence: the nth drop set matches the
    96	    /// previous session's nth drop set. The source entry is from the most
    97	    /// recent finished matching workout; if that workout contains duplicates,
    98	    /// the last entry by scalar order wins.
    99	    func prefill(for target: SetRecord) throws -> PreviousSetValue? {
   100	        guard target.completedAt == nil, let entry = target.entry else { return nil }
   101	        let peers = WorkoutSession.orderedSets(of: entry)
   102	            .filter { $0.type == target.type }
   103	        guard let ordinal = peers.firstIndex(where: { $0.id == target.id }),
   104	              let source = try latestEntry(matching: layerOneMatch(for: entry)) else {
   105	            return nil
   106	        }
   107	        let matchingSets = completedSets(of: source).filter { $0.type == target.type }
   108	        guard matchingSets.indices.contains(ordinal) else { return nil }
   109	        return value(from: matchingSets[ordinal])
   110	    }
   111	
   112	    /// Applies a previously selected candidate without completing the row.
   113	    /// Callers pass their dirty state at the last possible moment; a dirty
   114	    /// row is never overwritten by a delayed result.
   115	    ///
   116	    /// B1 (ticket 17): once the entry has a completed set, its draft rows are
   117	    /// seeded by within-session carry-forward (`WorkoutSession.addSet`) and
   118	    /// the cross-workout candidate stays a reference label only — today's
   119	    /// numbers outrank last week's, and clobbering them would undo the
   120	    /// carry-forward the moment the row appeared.
   121	    @discardableResult
   122	    func applyPrefill(
   123	        _ value: PreviousSetValue,
   124	        to target: SetRecord,
   125	        isDirty: Bool
   126	    ) throws -> Bool {
   127	        guard !isDirty, target.completedAt == nil,
   128	              !entryHasOtherCompletedSet(than: target)
   129	        else { return false }
   130	        target.reps = value.reps
   131	        target.weightValue = value.weightValue
   132	        target.weightUnit = value.weightUnit
   133	        target.normalizedKg = value.normalizedKg
   134	        try context.save()
   135	        return true
   136	    }
   137	
   138	    private func entryHasOtherCompletedSet(than target: SetRecord) -> Bool {
   139	        guard let entry = target.entry else { return false }
   140	        return (entry.sets ?? []).contains {
   141	            $0.id != target.id && $0.completedAt != nil
   142	        }
   143	    }
   144	
   145	    /// Latest reference snapshot for each applicable fallback layer. A
   146	    /// machine entry has three layers. A machineless entry has a tag-specific
   147	    /// first layer and an exercise-wide reference layer.
   148	    func layers(for entry: ExerciseEntry) throws -> [PerformanceLayerResult] {
   149	        layers(for: entry, in: try historicalEntries())
   150	    }
   151	
   152	    /// Layers *and* their records from a single pass over history. The sheet
   153	    /// shows both together, and each of the four values it used to request
   154	    /// separately re-read the whole entry table (and re-grouped every set in
   155	    /// it). Results are identical to calling the pieces one by one.
   156	    func summary(for entry: ExerciseEntry) throws -> PerformanceSummary {
   157	        let all = try historicalEntries()
   158	        let grouped = RecordsMath.grouped(all.flatMap(recordInputs(from:)))
   159	        let layers = layers(for: entry, in: all)
   160	        return PerformanceSummary(
   161	            layers: layers,
   162	            records: Dictionary(uniqueKeysWithValues: layers.map { layer in
   163	                (layer.kind, recordSummary(
   164	                    for: entry, layer: layer.kind, in: grouped))
   165	            }))
   166	    }
   167	
   168	    private func layers(
   169	        for entry: ExerciseEntry,
   170	        in all: [ExerciseEntry]
   171	    ) -> [PerformanceLayerResult] {
   172	        var results: [PerformanceLayerResult] = []
   173	
   174	        results.append(PerformanceLayerResult(
   175	            kind: .thisEquipment,
   176	            snapshot: snapshot(
   177	                layer: .thisEquipment,
   178	                entry: latestEntry(in: all, matching: layerOneMatch(for: entry)))))
   179	
   180	        if let modelID = entry.machine?.model?.id,
   181	           let gymID = entry.workout?.gym?.id {
   182	            results.append(PerformanceLayerResult(
   183	                kind: .sameModelElsewhere,
   184	                snapshot: snapshot(
   185	                    layer: .sameModelElsewhere,
   186	                    entry: latestEntry(in: all) { candidate in
   187	                        candidate.snapshotExerciseID == currentExerciseID(for: entry)
   188	                            && candidate.snapshotModelID == modelID
   189	                            && candidate.snapshotGymID != gymID
   190	                    })))
   191	        }
   192	
   193	        results.append(PerformanceLayerResult(
   194	            kind: .anyEquipment,
   195	            snapshot: snapshot(
   196	                layer: .anyEquipment,
   197	                entry: latestEntry(in: all) { candidate in
   198	                    candidate.snapshotExerciseID == currentExerciseID(for: entry)
   199	                })))
   200	        return results
   201	    }
   202	
   203	    /// All completed values in a layer, used by ticket 13's record surface.
   204	    func completedValues(
   205	        for entry: ExerciseEntry,
   206	        layer: PerformanceLayerKind
   207	    ) throws -> [(entry: ExerciseEntry, set: PreviousSetValue)] {
   208	        let all = try historicalEntries()
   209	        let exerciseID = currentExerciseID(for: entry)
   210	        let matches: (ExerciseEntry) -> Bool
   211	        switch layer {
   212	        case .thisEquipment:
   213	            matches = layerOneMatch(for: entry)
   214	        case .sameModelElsewhere:
   215	            guard let modelID = entry.machine?.model?.id,
   216	                  let gymID = entry.workout?.gym?.id else { return [] }
   217	            let presetID = currentPresetID(for: entry)
   218	            matches = {
   219	                $0.snapshotExerciseID == exerciseID
   220	                    && $0.snapshotModelID == modelID
   221	                    && $0.snapshotGymID != gymID
   222	                    && $0.snapshotPresetID == presetID
   223	            }
   224	        case .anyEquipment:
   225	            let presetID = currentPresetID(for: entry)
   226	            matches = {
   227	                $0.snapshotExerciseID == exerciseID && $0.snapshotPresetID == presetID
   228	            }
   229	        }
   230	        return all.filter(matches).flatMap { historicalEntry in
   231	            completedSets(of: historicalEntry).map {
   232	                (entry: historicalEntry, set: value(from: $0))
   233	            }
   234	        }
   235	    }
   236	
   237	    /// Ticket 13 bridge from SwiftData snapshots into ticket 12's pure
   238	    /// records core. Group selection follows `RecordGroupKey`: machine,
   239	    /// model, exercise, or tag-specific free weight. Thus barbell and
   240	    /// dumbbell records never merge even though both share an exercise UUID.
   241	    ///
   242	    /// The summary's load type classifies *history*, so it is derived from
   243	    /// the layer's own inputs' snapshot load types (D23), never from the live
   244	    /// exercise: RecordsMath filters each input by its snapshot load type, so
   245	    /// a catalog loadType edit would otherwise leave the summary's load type
   246	    /// disagreeing with every one of its inputs and blank every past record
   247	    /// at every layer. Live catalog reads survive only where they answer
   248	    /// "which exercise/equipment is the user on right now" for the draft
   249	    /// entry (`currentExerciseID`, `layerOneMatch`, `layers`); nothing that
   250	    /// classifies or filters history reads a live relationship.
   251	    func recordSummary(
   252	        for entry: ExerciseEntry,
   253	        layer: PerformanceLayerKind
   254	    ) throws -> RecordLayerSummary {
   255	        recordSummary(
   256	            for: entry,
   257	            layer: layer,
   258	            in: RecordsMath.grouped(
   259	                try historicalEntries().flatMap(recordInputs(from:))))
   260	    }
   261	
   262	    private func recordSummary(
   263	        for entry: ExerciseEntry,
   264	        layer: PerformanceLayerKind,
   265	        in grouped: [RecordGroupKey: [RecordSetInput]]
   266	    ) -> RecordLayerSummary {
   267	        let exerciseID = currentExerciseID(for: entry)
   268	        let presetID = currentPresetID(for: entry)
   269	        let key: RecordGroupKey?
   270	        // Set when the layer is scoped to gyms other than the current one.
   271	        var elsewhereThanGymID: UUID?
   272	        switch layer {
   273	        case .thisEquipment:
   274	            if let machineID = entry.machine?.id {
   275	                key = .machine(machineID, preset: presetID)
   276	            } else {
   277	                key = .freeWeight(
   278	                    exerciseID: exerciseID, tag: entry.freeWeightTag, preset: presetID)
   279	            }
   280	        case .sameModelElsewhere:
   281	            // "Elsewhere" is part of the layer, not just its header: the model
   282	            // group spans gyms, so the current gym's own sets are dropped —
   283	            // the same rule `layers`/`completedValues` apply to snapshots.
   284	            if let modelID = entry.machine?.model?.id,
   285	               let gymID = entry.workout?.gym?.id {
   286	                key = .model(modelID, preset: presetID)
   287	                elsewhereThanGymID = gymID
   288	            } else {
   289	                key = nil
   290	            }
   291	        case .anyEquipment:
   292	            // Layer 3 is "exercise anywhere" (ticket 11) — always the
   293	            // exercise-wide key. Keying machineless entries by free-weight tag
   294	            // made it byte-identical to layer 1, hiding all other equipment.
   295	            key = .exercise(exerciseID, preset: presetID)
   296	        }
   297	        var inputs = key.flatMap { grouped[$0] } ?? []
   298	        if let elsewhereThanGymID {
   299	            inputs = inputs.filter { $0.gymID != elsewhereThanGymID }
   300	        }
   301	        let loadType = historicalLoadType(among: inputs) ?? entry.snapshotLoadType
   302	        return RecordLayerSummary(
   303	            loadType: loadType,
   304	            repCountBests: RecordsMath.repCountBests(among: inputs, loadType: loadType),
   305	            bodyweightBest: RecordsMath.mostRepsRecord(among: inputs),
   306	            estimatedOneRepMax: RecordsMath.bestE1RM(among: inputs))
   307	    }
   308	
   309	    /// The load type a layer's history is recorded under: the dominant
   310	    /// snapshot load type among its inputs, ties resolving to the most
   311	    /// recently completed set's. nil when the layer has no history, leaving
   312	    /// the caller to fall back to the entry's own snapshot load type.
   313	    private func historicalLoadType(among inputs: [RecordSetInput]) -> LoadType? {
   314	        var counts: [LoadType: Int] = [:]
   315	        for input in inputs { counts[input.loadType, default: 0] += 1 }
   316	        guard let topCount = counts.values.max() else { return nil }
   317	        let leaders = Set(counts.filter { $0.value == topCount }.keys)
   318	        if leaders.count == 1 { return leaders.first }
   319	        return inputs
   320	            .filter { leaders.contains($0.loadType) }
   321	            .max { ($0.completedAt ?? .distantPast) < ($1.completedAt ?? .distantPast) }?
   322	            .loadType
   323	    }
   324	
   325	    // MARK: Selection
   326	
   327	    private func historicalEntries() throws -> [ExerciseEntry] {
   328	        try context.fetch(FetchDescriptor<ExerciseEntry>()).filter {
   329	            $0.snapshotCapturedAt != nil
   330	                && $0.workout?.finishedAt != nil
   331	                && !$0.isDeleted
   332	                && !completedSets(of: $0).isEmpty
   333	        }
   334	    }
   335	
   336	    private func latestEntry(
   337	        matching predicate: (ExerciseEntry) -> Bool
   338	    ) throws -> ExerciseEntry? {
   339	        latestEntry(in: try historicalEntries(), matching: predicate)
   340	    }
   341	
   342	    private func latestEntry(
   343	        in entries: [ExerciseEntry],
   344	        matching predicate: (ExerciseEntry) -> Bool
   345	    ) -> ExerciseEntry? {
   346	        // Max over (finishedAt, startedAt, workout id, entry order). Including
   347	        // entry order last makes duplicate matches in one source workout
   348	        // deterministically choose the final entry.
   349	        entries.filter(predicate).max { lhs, rhs in
   350	            entrySortKey(lhs) < entrySortKey(rhs)
   351	        }
   352	    }
   353	
   354	    private func entrySortKey(_ entry: ExerciseEntry) -> (Date, Date, String, Int, String) {
   355	        (
   356	            entry.workout?.finishedAt ?? .distantPast,
   357	            entry.workout?.startedAt ?? .distantPast,
   358	            entry.workout?.id.uuidString ?? "",
   359	            entry.order,
   360	            entry.id.uuidString
   361	        )
   362	    }
   363	
   364	    private func currentExerciseID(for entry: ExerciseEntry) -> UUID {
   365	        entry.exercise?.id ?? entry.snapshotExerciseID
   366	    }
   367	
   368	    private func layerOneMatch(for entry: ExerciseEntry) -> (ExerciseEntry) -> Bool {
   369	        let exerciseID = currentExerciseID(for: entry)
   370	        // D36: the variation is part of "the same thing done before". Prefill
   371	        // especially — seeding a narrow-grip row with wide-grip numbers asserts
   372	        // a comparability the app exists to deny (D11's reasoning, one axis in).
   373	        let presetID = currentPresetID(for: entry)
   374	        if let machineID = entry.machine?.id {
   375	            return {
   376	                $0.snapshotExerciseID == exerciseID
   377	                    && $0.snapshotMachineID == machineID
   378	                    && $0.snapshotPresetID == presetID
   379	            }
   380	        }
   381	        let tag = entry.freeWeightTag
   382	        return {
   383	            $0.snapshotExerciseID == exerciseID
   384	                && $0.snapshotMachineID == nil
   385	                && $0.snapshotFreeWeightTag == tag
   386	                && $0.snapshotPresetID == presetID
   387	        }
   388	    }
   389	
   390	    /// The preset the *draft* entry is set to right now — live until the
   391	    /// snapshot freezes it, like the machine it sits beside.
   392	    private func currentPresetID(for entry: ExerciseEntry) -> UUID? {
   393	        entry.snapshotCapturedAt == nil ? entry.preset?.id : entry.snapshotPresetID
   394	    }
   395	
   396	    private func completedSets(of entry: ExerciseEntry) -> [SetRecord] {
   397	        WorkoutSession.orderedSets(of: entry).filter { $0.completedAt != nil }
   398	    }
   399	
   400	    private func value(from set: SetRecord) -> PreviousSetValue {
   401	        PreviousSetValue(
   402	            id: set.id,
   403	            order: set.order,
   404	            type: set.type,
   405	            reps: set.reps ?? 0,
   406	            weightValue: set.weightValue,
   407	            weightUnit: set.weightUnit,
   408	            normalizedKg: set.normalizedKg,
   409	            completedAt: set.completedAt ?? .distantPast)
   410	    }
   411	
   412	    private func recordInputs(from entry: ExerciseEntry) -> [RecordSetInput] {
   413	        completedSets(of: entry).map { set in
   414	            RecordSetInput(
   415	                loadType: entry.snapshotLoadType,
   416	                exerciseID: entry.snapshotExerciseID,
   417	                gymID: entry.snapshotGymID,
   418	                machineID: entry.snapshotMachineID,
   419	                modelID: entry.snapshotModelID,
   420	                freeWeightTag: entry.snapshotFreeWeightTag,
   421	                presetID: entry.snapshotPresetID,
   422	                setType: set.type,
   423	                reps: set.reps,
   424	                weightValue: set.weightValue,
   425	                weightUnit: set.weightUnit,
   426	                normalizedKg: set.normalizedKg,
   427	                completedAt: set.completedAt)
   428	        }
   429	    }
   430	
   431	    private func snapshot(
   432	        layer: PerformanceLayerKind,
   433	        entry: ExerciseEntry?
   434	    ) -> PreviousPerformanceSnapshot? {
   435	        guard let entry, let workout = entry.workout else { return nil }
   436	        return PreviousPerformanceSnapshot(
   437	            layer: layer,
   438	            workoutID: workout.id,
   439	            workoutDate: workout.finishedAt ?? workout.startedAt,
   440	            gymName: entry.snapshotGymName,
   441	            equipmentLabel: entry.snapshotEquipmentLabel,
   442	            sets: completedSets(of: entry).map(value(from:)))
   443	    }
