   602	
   603	enum WorkoutTrackerStore {
   604	    /// Every model in the app schema — keep exhaustive.
   605	    static let modelTypes: [any PersistentModel.Type] = [
   606	        Exercise.self,
   607	        ExercisePreset.self,
   608	        EquipmentModel.self,
   609	        Gym.self,
   610	        MachineInstance.self,
   611	        WorkoutTemplate.self,
   612	        TemplateItem.self,
   613	        Workout.self,
   614	        ExerciseEntry.self,
   615	        SetRecord.self,
   616	        GymExerciseMemory.self,
   617	        AppPreferences.self,
   618	        ExerciseRestOverride.self,
   619	    ]
   620	
   621	    static var schema: Schema { Schema(modelTypes) }
   622	
   623	    /// On-disk container. `url` overrides the store location (tests);
   624	    /// nil uses the default application-support location.
   625	    static func makeContainer(url: URL? = nil) throws -> ModelContainer {
   626	        let schema = Self.schema
   627	        let configuration: ModelConfiguration
   628	        if let url {
   629	            configuration = ModelConfiguration(schema: schema, url: url)
   630	        } else {
   631	            configuration = ModelConfiguration(schema: schema, isStoredInMemoryOnly: false)
   632	        }
   633	        return try ModelContainer(for: schema, configurations: [configuration])
   634	    }
   635	
   636	    /// Launch argument that makes the app start from an empty store, so
   637	    /// XCUITest runs are deterministic (`WorkoutTrackerUITests`).
   638	    static let uiTestResetArgument = "-uiTestReset"
   639	
   640	    static var isUITestReset: Bool {
   641	        ProcessInfo.processInfo.arguments.contains(uiTestResetArgument)
   642	    }
   643	
   644	    /// Throwaway UI-test store: a dedicated on-disk location wiped on every
   645	    /// launch. On-disk (not in-memory) so the app exercises the real
   646	    /// SwiftData persistence path the tests are meant to drive.
   647	    static func makeUITestContainer() throws -> ModelContainer {
   648	        let directory = URL.cachesDirectory.appending(
   649	            path: "UITestStore", directoryHint: .isDirectory)
   650	        try? FileManager.default.removeItem(at: directory)
   651	        try FileManager.default.createDirectory(
   652	            at: directory, withIntermediateDirectories: true)
   653	        return try makeContainer(url: directory.appending(path: "UITestStore.store"))
   654	    }
   655	}
