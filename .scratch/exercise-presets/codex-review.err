     1	import XCTest
     2	
     3	/// Exercise presets (D36–D38) end to end: define one, make it a machine's
     4	/// usual, and switch it mid-workout.
     5	///
     6	/// The switch is the part worth driving through the real UI — it is the only
     7	/// place where the D19 freeze rule is visible to a person: change grips after
     8	/// logging a set and you get a *second* exercise card, not a relabelled one.
     9	final class ExercisePresetUITests: XCTestCase {
    10	    private var app: XCUIApplication!
    11	
    12	    private let gymName = "Preset Test Gym"
    13	    private let machineLabel = "Cable Row 2"
    14	    private let modelName = "Life Fitness Insignia Series Row"
    15	    private let exerciseName = "Seated Row"
    16	
    17	    override func setUp() {
    18	        super.setUp()
    19	        continueAfterFailure = false
    20	        app = XCUIApplication()
    21	        app.launchArguments = ["-uiTestReset"]
    22	        app.launch()
    23	    }
    24	
    25	    func testPresetsAreDefinedChosenAndFrozenOnceLogged() {
    26	        definePresets()
    27	        createGym()
    28	        addMachine()
    29	
    30	        // --- Log on the machine's usual preset ------------------------------
    31	        startEmptyWorkout()
    32	        addByMachine()
    33	
    34	        let wideChip = anyElement("presetChip.Wide grip")
    35	        XCTAssertTrue(
    36	            wideChip.waitForExistence(timeout: 5),
    37	            "The entry card should offer the exercise's presets")
    38	        XCTAssertTrue(
    39	            anyElement("presetChip.Narrow grip").exists,
    40	            "Every preset should be one tap away, not buried in a menu")
    41	
    42	        logSet(weight: "70", reps: "8")
    43	
    44	        // --- Switching after a logged set splits the entry (D19 + D36) ------
    45	        anyElement("presetChip.Narrow grip").tap()
    46	
    47	        let cards = app.staticTexts.matching(
    48	            NSPredicate(format: "label == %@", exerciseName))
    49	        XCTAssertTrue(
    50	            cards.count >= 2,
    51	            "Switching preset after a logged set must start a new entry, "
    52	                + "not relabel the one holding completed sets")
    53	
    54	        finishWorkout()
    55	
    56	        // --- History names the variation ------------------------------------
    57	        tab("History").tap()
    58	        let row = app.staticTexts[exerciseName].firstMatch
    59	        XCTAssertTrue(row.waitForExistence(timeout: 5), "The workout should be in History")
    60	        row.tap()
    61	
    62	        // The equipment line in the workout detail is snapshot-rendered, so
    63	        // this is the preset as it was recorded, not as it is named now.
    64	        let equipment = app.staticTexts.matching(
    65	            NSPredicate(format: "label CONTAINS %@", "Wide grip")).firstMatch
    66	        XCTAssertTrue(
    67	            equipment.waitForExistence(timeout: 5),
    68	            "The logged set should say which variation it was performed in")
    69	    }
    70	
    71	    // MARK: - Steps
    72	
    73	    private func definePresets() {
    74	        tab("Exercises").tap()
    75	        let field = app.searchFields.firstMatch
    76	        XCTAssertTrue(field.waitForExistence(timeout: 5))
    77	        field.tap()
    78	        field.typeText(exerciseName)
    79	
    80	        let row = app.staticTexts[exerciseName].firstMatch
    81	        XCTAssertTrue(row.waitForExistence(timeout: 5), "The seeded exercise should be listed")
    82	        row.press(forDuration: 1.2)
    83	        app.buttons["Presets…"].firstMatch.tap()
    84	
    85	        XCTAssertTrue(
    86	            anyElement("noPresets").waitForExistence(timeout: 5),
    87	            "A fresh exercise has no presets")
    88	        // One from the suggestions, one typed — both paths matter at a gym.
    89	        anyElement("presetSuggestion.Wide grip").tap()
    90	        let name = app.textFields["newPresetName"]
    91	        name.tap()
    92	        name.typeText("Narrow grip")
    93	        app.buttons["addPreset"].tap()
    94	
    95	        XCTAssertTrue(anyElement("preset.Wide grip").exists)
    96	        XCTAssertTrue(anyElement("preset.Narrow grip").exists)
    97	        app.buttons["Done"].tap()
    98	    }
    99	
   100	    private func createGym() {
   101	        tab("Gyms").tap()
   102	        app.buttons["addGym"].tap()
   103	        let name = app.textFields["gymName"]
   104	        XCTAssertTrue(name.waitForExistence(timeout: 5))
   105	        name.tap()
   106	        name.typeText(gymName)
   107	        app.buttons["saveGym"].tap()
   108	        XCTAssertTrue(anyElement("gymRow.\(gymName)").waitForExistence(timeout: 5))
   109	    }
   110	
   111	    private func addMachine() {
   112	        anyElement("gymRow.\(gymName)").tap()
   113	        let add = app.buttons["addMachine"]
   114	        XCTAssertTrue(add.waitForExistence(timeout: 5))
   115	        add.tap()
   116	
   117	        let label = app.textFields["machineLabel"]
   118	        XCTAssertTrue(label.waitForExistence(timeout: 5))
   119	        label.tap()
   120	        label.typeText(machineLabel)
   121	
   122	        anyElement("catalogModel").tap()
   123	        let search = app.searchFields.firstMatch
   124	        XCTAssertTrue(search.waitForExistence(timeout: 5))
   125	        search.tap()
   126	        search.typeText("Insignia Series Row")
   127	        let modelRow = anyElement("modelOption.\(modelName)")
   128	        XCTAssertTrue(modelRow.waitForExistence(timeout: 5), "Catalog model should be listed")
   129	        modelRow.tap()
   130	
   131	        // D38: the machine's usual preset, offered because this model serves
   132	        // exactly one exercise.
   133	        let picker = anyElement("machinePresetPicker")
   134	        XCTAssertTrue(
   135	            picker.waitForExistence(timeout: 5),
   136	            "A single-exercise machine should offer that exercise's presets")
   137	        picker.tap()
   138	        app.buttons["Wide grip"].firstMatch.tap()
   139	
   140	        app.buttons["saveMachine"].tap()
   141	        XCTAssertTrue(app.staticTexts[machineLabel].waitForExistence(timeout: 5))
   142	    }
   143	
   144	    private func startEmptyWorkout() {
   145	        tab("Workout").tap()
   146	        // The picker resets to "No gym" on a fresh screen, and Add by Machine
   147	        // only lists the machines of the workout's gym.
   148	        let picker = anyElement("gymPicker")
   149	        XCTAssertTrue(picker.waitForExistence(timeout: 5))
   150	        if !picker.label.contains(gymName) {
   151	            picker.tap()
   152	            tapOption(gymName)
   153	        }
   154	        app.buttons["startEmptyWorkout"].tap()
   155	    }
   156	
   157	    /// Taps an option however SwiftUI rendered it — menu item, pushed row, or
   158	    /// plain cell.
   159	    private func tapOption(_ label: String) {
   160	        let button = app.buttons[label]
   161	        if button.waitForExistence(timeout: 3) {
   162	            button.tap()
   163	            return
   164	        }
   165	        let text = app.staticTexts[label]
   166	        XCTAssertTrue(text.waitForExistence(timeout: 3), "No option labelled \(label)")
   167	        text.tap()
   168	    }
   169	
   170	    private func addByMachine() {
   171	        let add = app.buttons["addByMachine"]
   172	        XCTAssertTrue(add.waitForExistence(timeout: 5))
   173	        add.tap()
   174	        let machine = anyElement("machineOption.\(machineLabel)")
   175	        XCTAssertTrue(machine.waitForExistence(timeout: 5))
   176	        machine.tap()
   177	    }
   178	
   179	    private func logSet(weight: String, reps: String) {
   180	        let weightField = app.textFields["setRow.weight"].firstMatch
   181	        XCTAssertTrue(weightField.waitForExistence(timeout: 5))
   182	        weightField.tap()
   183	        weightField.typeText(weight)
   184	        let repsField = app.textFields["setRow.reps"].firstMatch
   185	        repsField.tap()
   186	        repsField.typeText(reps)
   187	        app.buttons["setRow.complete"].firstMatch.tap()
   188	    }
   189	
   190	    private func finishWorkout() {
   191	        app.buttons["finishWorkout"].tap()
   192	        let done = app.buttons["Done"].firstMatch
   193	        if done.waitForExistence(timeout: 5) { done.tap() }
   194	    }
   195	
   196	    private func tab(_ name: String) -> XCUIElement {
   197	        app.tabBars.buttons[name]
   198	    }
   199	
   200	    private func anyElement(_ identifier: String) -> XCUIElement {
   201	        app.descendants(matching: .any).matching(identifier: identifier).firstMatch
   202	    }
   203	}
     1	import Foundation
     2	import SwiftData
     3	
     4	// Milestone 3, ticket 01 — reads the store and produces an `ExportSnapshot`.
     5	// The only export component that touches SwiftData; it imports no UI, and the
     6	// renderers below it never see a `@Model` object.
     7	
     8	struct ExportCollector {
     9	    let dateFormat: ExportDateFormat
    10	    let appVersion: String
    11	
    12	    init(
    13	        dateFormat: ExportDateFormat = ExportDateFormat(),
    14	        appVersion: String = ExportCollector.bundleVersion()
    15	    ) {
    16	        self.dateFormat = dateFormat
    17	        self.appVersion = appVersion
    18	    }
    19	
    20	    /// `1.0 (3)`, or empty when the bundle carries no version (test hosts).
    21	    static func bundleVersion() -> String {
    22	        let info = Bundle.main.infoDictionary
    23	        let short = info?["CFBundleShortVersionString"] as? String
    24	        let build = info?["CFBundleVersion"] as? String
    25	        switch (short, build) {
    26	        case let (short?, build?): return "\(short) (\(build))"
    27	        case let (short?, nil): return short
    28	        case let (nil, build?): return build
    29	        case (nil, nil): return ""
    30	        }
    31	    }
    32	
    33	    // MARK: - Collection
    34	
    35	    func snapshot(from context: ModelContext, now: Date = .now) throws -> ExportSnapshot {
    36	        let gyms = try context.fetch(FetchDescriptor<Gym>())
    37	        let machines = try context.fetch(FetchDescriptor<MachineInstance>())
    38	        let exercises = try context.fetch(FetchDescriptor<Exercise>())
    39	        let models = try context.fetch(FetchDescriptor<EquipmentModel>())
    40	        let templates = try context.fetch(FetchDescriptor<WorkoutTemplate>())
    41	        let workouts = try context.fetch(FetchDescriptor<Workout>())
    42	        let memories = try context.fetch(FetchDescriptor<GymExerciseMemory>())
    43	        let overrides = try context.fetch(FetchDescriptor<ExerciseRestOverride>())
    44	        let preferences = AppPreferences.canonical(
    45	            of: try context.fetch(FetchDescriptor<AppPreferences>()))
    46	
    47	        let modelsByID = Dictionary(models.map { ($0.id, $0) }, uniquingKeysWith: { first, _ in first })
    48	        let exerciseNamesByID = Dictionary(
    49	            exercises.map { ($0.id, $0.name) }, uniquingKeysWith: { first, _ in first })
    50	
    51	        let exportedWorkouts = workouts
    52	            .sorted(by: Self.workoutOrder)
    53	            .map { workout(from: $0, modelsByID: modelsByID) }
    54	
    55	        // D28 — which catalog rows the user's own data actually reaches. Not
    56	        // transitive: a referenced model's `exerciseIDs` may name exercises
    57	        // nothing else references, and following those links would drag in most
    58	        // of a 1877-row catalog to describe links the app already ships.
    59	        let referenced = referencedCatalogIDs(
    60	            machines: machines, workouts: exportedWorkouts,
    61	            templates: templates, memories: memories, overrides: overrides,
    62	            models: models,
    63	            userExerciseIDs: Set(exercises.lazy.filter { !$0.isSeeded }.map(\.id)))
    64	
    65	        let exportedExercises = exercises
    66	            .filter { !$0.isSeeded || referenced.exerciseIDs.contains($0.id) }
    67	            .sorted { ($0.name, $0.id.uuidString) < ($1.name, $1.id.uuidString) }
    68	            .map(exercise(from:))
    69	        let exportedModels = models
    70	            .filter { !$0.isSeeded || referenced.modelIDs.contains($0.id) }
    71	            .sorted { ($0.displayName, $0.id.uuidString) < ($1.displayName, $1.id.uuidString) }
    72	            .map(equipmentModel(from:))
    73	        let exportedTemplates = templates
    74	            .sorted { ($0.name, $0.id.uuidString) < ($1.name, $1.id.uuidString) }
    75	            .map { template(from: $0, exerciseNamesByID: exerciseNamesByID) }
    76	        let exportedGyms = gyms
    77	            .sorted { ($0.name, $0.id.uuidString) < ($1.name, $1.id.uuidString) }
    78	            .map(gym(from:))
    79	        let exportedMachines = machines
    80	            .sorted { ($0.label, $0.id.uuidString) < ($1.label, $1.id.uuidString) }
    81	            .map(machine(from:))
    82	
    83	        let entryCount = exportedWorkouts.reduce(0) { $0 + $1.entries.count }
    84	        let allSets = exportedWorkouts.flatMap { $0.entries.flatMap(\.sets) }
    85	
    86	        return ExportSnapshot(
    87	            exportedAt: dateFormat.string(from: now),
    88	            appVersion: appVersion,
    89	            seededCatalogVersion: preferences?.seededCatalogVersion ?? 0,
    90	            counts: ExportSnapshot.Counts(
    91	                workouts: exportedWorkouts.count,
    92	                entries: entryCount,
    93	                sets: allSets.count,
    94	                completedSets: allSets.filter { $0.completedAt != nil }.count,
    95	                gyms: exportedGyms.count,
    96	                machines: exportedMachines.count,
    97	                exercises: exportedExercises.count,
    98	                equipmentModels: exportedModels.count,
    99	                templates: exportedTemplates.count),
   100	            preferences: preferences.map(self.preferences(from:)),
   101	            gyms: exportedGyms,
   102	            machines: exportedMachines,
   103	            exercises: exportedExercises,
   104	            equipmentModels: exportedModels,
   105	            templates: exportedTemplates,
   106	            workouts: exportedWorkouts,
   107	            gymExerciseMemory: memories
   108	                .sorted { ($0.updatedAt, $0.id.uuidString) < ($1.updatedAt, $1.id.uuidString) }
   109	                .map(gymMemory(from:)),
   110	            exerciseRestOverrides: overrides
   111	                .sorted { ($0.updatedAt, $0.id.uuidString) < ($1.updatedAt, $1.id.uuidString) }
   112	                .map(restOverride(from:)))
   113	    }
   114	
   115	    /// Chronological, with a total tie-break so two exports of unchanged data
   116	    /// are byte-identical.
   117	    private static func workoutOrder(_ lhs: Workout, _ rhs: Workout) -> Bool {
   118	        (lhs.startedAt, lhs.id.uuidString) < (rhs.startedAt, rhs.id.uuidString)
   119	    }
   120	
   121	    // MARK: - Referenced catalog rows (D28)
   122	
   123	    private struct ReferencedCatalog {
   124	        var exerciseIDs: Set<UUID> = []
   125	        var modelIDs: Set<UUID> = []
   126	    }
   127	
   128	    private func referencedCatalogIDs(
   129	        machines: [MachineInstance],
   130	        workouts: [ExportSnapshot.Workout],
   131	        templates: [WorkoutTemplate],
   132	        memories: [GymExerciseMemory],
   133	        overrides: [ExerciseRestOverride],
   134	        models: [EquipmentModel],
   135	        userExerciseIDs: Set<UUID>
   136	    ) -> ReferencedCatalog {
   137	        var referenced = ReferencedCatalog()
   138	        for machine in machines {
   139	            if let modelID = machine.model?.id { referenced.modelIDs.insert(modelID) }
   140	        }
   141	        // D27: the user may attach an exercise they invented to a *seeded*
   142	        // model, and that edge is user data — reconciliation preserves it, so
   143	        // an export must too. Without this, correcting the only machine that
   144	        // named the model would leave the export unable to say which station
   145	        // the movement belongs to (codex-review, finding 2). This is not
   146	        // following shipped catalog links: only links to user-created
   147	        // exercises count.
   148	        for model in models where model.isSeeded {
   149	            if model.exerciseIDs.contains(where: userExerciseIDs.contains) {
   150	                referenced.modelIDs.insert(model.id)
   151	            }
   152	        }
   153	        for workout in workouts {
   154	            for entry in workout.entries {
   155	                referenced.exerciseIDs.insert(entry.exerciseID)
   156	                if let modelID = entry.modelID { referenced.modelIDs.insert(modelID) }
   157	            }
   158	        }
   159	        for item in templates.flatMap({ $0.items ?? [] }) {
   160	            if let exerciseID = item.exercise?.id { referenced.exerciseIDs.insert(exerciseID) }
   161	        }
   162	        for memory in memories { referenced.exerciseIDs.insert(memory.exerciseID) }
   163	        for override in overrides { referenced.exerciseIDs.insert(override.exerciseID) }
   164	        return referenced
   165	    }
   166	
   167	    // MARK: - Row mapping
   168	
   169	    private func gym(from gym: Gym) -> ExportSnapshot.Gym {
   170	        ExportSnapshot.Gym(
   171	            id: gym.id, name: gym.name, city: gym.city,
   172	            defaultUnit: gym.defaultUnit, notes: gym.notes, archived: gym.archived)
   173	    }
   174	
   175	    private func machine(from machine: MachineInstance) -> ExportSnapshot.Machine {
   176	        ExportSnapshot.Machine(
   177	            id: machine.id, label: machine.label, gymID: machine.gym?.id,
   178	            modelID: machine.model?.id, defaultUnit: machine.defaultUnit,
   179	            archived: machine.archived)
   180	    }
   181	
   182	    private func exercise(from exercise: Exercise) -> ExportSnapshot.Exercise {
   183	        ExportSnapshot.Exercise(
   184	            id: exercise.id, name: exercise.name, loadType: exercise.loadType,
   185	            equipmentTypeTags: exercise.equipmentTypeTags,
   186	            muscleGroup: exercise.muscleGroup, isSeeded: exercise.isSeeded)
   187	    }
   188	
   189	    private func equipmentModel(from model: EquipmentModel) -> ExportSnapshot.EquipmentModel {
   190	        ExportSnapshot.EquipmentModel(
   191	            id: model.id, manufacturer: model.manufacturer, modelName: model.modelName,
   192	            exerciseIDs: model.exerciseIDs, equipmentType: model.equipmentType,
   193	            isSeeded: model.isSeeded)
   194	    }
   195	
   196	    private func template(
   197	        from template: WorkoutTemplate, exerciseNamesByID: [UUID: String]
   198	    ) -> ExportSnapshot.Template {
   199	        let items = (template.items ?? [])
   200	            .sorted { ($0.order, $0.id.uuidString) < ($1.order, $1.id.uuidString) }
   201	            .map { item in
   202	                ExportSnapshot.TemplateItem(
   203	                    id: item.id, order: item.order,
   204	                    exerciseID: item.exercise?.id,
   205	                    exerciseName: item.exercise.map { exerciseNamesByID[$0.id] ?? $0.name },
   206	                    targetSets: item.targetSets, targetReps: item.targetReps,
   207	                    targetRepsBySet: item.targetRepsBySet)
   208	            }
   209	        return ExportSnapshot.Template(id: template.id, name: template.name, items: items)
   210	    }
   211	
   212	    private func workout(
   213	        from workout: Workout, modelsByID: [UUID: EquipmentModel]
   214	    ) -> ExportSnapshot.Workout {
   215	        let entries = (workout.entries ?? [])
   216	            .sorted { ($0.order, $0.id.uuidString) < ($1.order, $1.id.uuidString) }
   217	            .map { entry(from: $0, modelsByID: modelsByID) }
   218	        return ExportSnapshot.Workout(
   219	            id: workout.id,
   220	            startedAt: dateFormat.string(from: workout.startedAt),
   221	            finishedAt: dateFormat.optionalString(from: workout.finishedAt),
   222	            notes: workout.notes,
   223	            sourceTemplateID: workout.sourceTemplateID,
   224	            sourceTemplateName: workout.sourceTemplateName,
   225	            // The workout carries a snapshot *name* but no snapshot gym id
   226	            // (D23 puts the ids on the entry). So the id is the live link —
   227	            // nil once the gym is deleted — while the name is what the workout
   228	            // was logged under. The CSV's gym columns come from the entry,
   229	            // where both are snapshotted together.
   230	            gymID: workout.gym?.id,
   100	        var defaultUnit: WeightUnit?
   101	        var archived: Bool
   102	    }
   103	
   104	    struct Exercise: Codable, Equatable {
   105	        var id: UUID
   106	        var name: String
   107	        var loadType: LoadType
   108	        var equipmentTypeTags: [EquipmentTag]
   109	        var muscleGroup: String?
   110	        /// True for a seeded row the user's data referenced (D28).
   111	        var isSeeded: Bool
   112	    }
   113	
   114	    struct EquipmentModel: Codable, Equatable {
   115	        var id: UUID
   116	        var manufacturer: String
   117	        var modelName: String
   118	        var exerciseIDs: [UUID]
   119	        var equipmentType: EquipmentCategory?
   120	        var isSeeded: Bool
   121	    }
   122	}
   123	
   124	// MARK: - Templates
   125	
   126	extension ExportSnapshot {
   127	    struct Template: Codable, Equatable {
   128	        var id: UUID
   129	        var name: String
   130	        var items: [TemplateItem]
   131	    }
   132	
   133	    struct TemplateItem: Codable, Equatable {
   134	        var id: UUID
   135	        var order: Int
   136	        var exerciseID: UUID?
   137	        /// Resolved at export time for readability; `exerciseID` is the key.
   138	        var exerciseName: String?
   139	        var targetSets: Int?
   140	        var targetReps: Int?
   141	        var targetRepsBySet: [Int?]
   142	    }
   143	}
   144	
   145	// MARK: - History
   146	
   147	extension ExportSnapshot {
   148	    struct Workout: Codable, Equatable {
   149	        var id: UUID
   150	        var startedAt: String
   151	        /// Absent while the workout is still running (D30).
   152	        var finishedAt: String?
   153	        var notes: String
   154	        var sourceTemplateID: UUID?
   155	        var sourceTemplateName: String?
   156	        var gymID: UUID?
   157	        var gymName: String?
   158	        var entries: [Entry]
   159	    }
   160	
   161	    /// One exercise within a workout.
   162	    ///
   163	    /// Context for a **frozen** entry (first set completed) is the entry's D23
   164	    /// snapshot, never a live lookup — renaming a gym must not rewrite an old
   165	    /// export row. Context for a **draft** entry (`snapshotCapturedAt == nil`)
   166	    /// is the live relationships, because no snapshot has been captured yet and
   167	    /// the equipment the user just picked is the only truth there is
   168	    /// (codex-review, finding 1).
   169	    ///
   170	    /// `modelManufacturer` is the one value neither path stores; it is resolved
   171	    /// from the catalog at export time and absent when the model is gone.
   172	    struct Entry: Codable, Equatable {
   173	        var id: UUID
   174	        var order: Int
   175	        /// When equipment froze (first set completion). Absent = still a draft,
   176	        /// and every context field below is live rather than snapshotted.
   177	        var snapshotCapturedAt: String?
   178	        var exerciseID: UUID
   179	        var exerciseName: String
   180	        var loadType: LoadType
   181	        var freeWeightTag: EquipmentTag?
   182	        var machineID: UUID?
   183	        var machineLabel: String?
   184	        var modelID: UUID?
   185	        /// Manufacturer *and* model, as the snapshot stores it
   186	        /// (`EquipmentModel.displayName`) — hence not `modelName`, which would
   187	        /// promise a raw name the store never captured (codex-review, finding 5).
   188	        var modelDisplayName: String?
   189	        var modelManufacturer: String?
   190	        var gymID: UUID?
   191	        var gymName: String?
   192	        /// The variation performed (D36). Absent = none recorded, which is the
   193	        /// truth about every set logged before presets existed.
   194	        var presetID: UUID?
   195	        var presetName: String?
   196	        var sets: [SetRow]
   197	    }
   198	
   199	    /// One logged set. `weight`/`unit` are exactly as entered and `weightKg`
   200	    /// is the stored normalization (D29) — never a converted display value,
   201	    /// and never rounded.
   202	    struct SetRow: Codable, Equatable {
   203	        var id: UUID
   204	        var order: Int
   205	        var type: SetType
   206	        var reps: Int?
   207	        var weight: Double?
   208	        var unit: WeightUnit
   209	        var weightKg: Double?
   210	        /// Absent = not completed. Present in the export regardless (D30).
   211	        var completedAt: String?
   212	    }
   213	}
   214	
   215	// MARK: - Memory & overrides
   216	
   217	extension ExportSnapshot {
   218	    struct GymMemory: Codable, Equatable {
   219	        var id: UUID
   220	        var gymID: UUID
   221	        var exerciseID: UUID
   222	        var machineID: UUID?
   223	        var updatedAt: String
   224	    }
   225	
   226	    struct RestOverride: Codable, Equatable {
   227	        var id: UUID
   228	        var exerciseID: UUID
   229	        var workingRestSeconds: Int?
   230	        var warmupRestSeconds: Int?

