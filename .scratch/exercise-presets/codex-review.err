   336	            freeWeightTag: entry.freeWeightTag,
   337	            workout: workout,
   338	            exercise: exercise,
   339	            machine: entry.machine,
   340	            preset: preset,
   341	            snapshotExerciseID: exercise.id,
   342	            snapshotLoadType: exercise.loadType,
   343	            snapshotExerciseName: exercise.name)
