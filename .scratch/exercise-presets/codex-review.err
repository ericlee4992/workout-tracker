   226	    /// A preset hangs off a *seeded* exercise, and the catalog reconciler
   227	    /// rewrites seeded rows on every version bump (D24). The user's presets are
   228	    /// user data on a catalog row — the same shape D27 protects for
   229	    /// user-created exercises linked to seeded models — so they must survive.
   230	    @Test func presetsOnASeededExerciseSurviveACatalogBump() throws {
   231	        let schema = WorkoutTrackerStore.schema
   232	        let container = try ModelContainer(
   233	            for: schema,
   234	            configurations: [ModelConfiguration(schema: schema, isStoredInMemoryOnly: true)])
   235	        let context = ModelContext(container)
   236	        let catalog = try SeedCatalog.bundled()
   237	        try CatalogSeeder.reconcile(catalog, in: context)
   238	
   239	        let seeded = try #require(
   240	            try context.fetch(FetchDescriptor<Exercise>()).first { $0.isSeeded })
   241	        let preset = ExercisePreset(name: "Wide grip", order: 0, exercise: seeded)
   242	        context.insert(preset)
   243	        try context.save()
   244	
   245	        // Same content, a later version — the path that rewrites allowlisted
   246	        // fields on every seeded row.
   247	        var bumped = catalog
   248	        bumped.version = catalog.version + 1
   249	        try CatalogSeeder.reconcile(bumped, in: context)
   250	
   251	        let after = try #require(
   252	            try context.fetch(FetchDescriptor<Exercise>()).first { $0.id == seeded.id })
   253	        #expect(
   254	            (after.presets ?? []).map(\.name) == ["Wide grip"],
   255	            "the user's preset must not be swept away by a catalog update")
   256	    }
   257	
   258	    /// Prefill is the sharp end of D36: seeding a narrow-grip row with
   259	    /// wide-grip numbers asserts a comparability the app exists to deny.
   260	    @Test func prefillDoesNotCrossPresets() throws {
   261	        let rig = try makeRig()
   262	        let firstStart = Date(timeIntervalSince1970: 4_000_000)
   263	        let first = try rig.session.startWorkout(at: rig.gym, on: firstStart)
   264	        let wideEntry = try rig.session.addEntry(
   265	            for: rig.exercise, to: first, machine: rig.machine)
   266	        try rig.session.choosePreset(rig.wide, for: wideEntry)
   267	        try logSet(rig, on: wideEntry, weight: 70, reps: 8, at: firstStart.addingTimeInterval(60))
   268	        _ = try rig.session.finish(first, at: firstStart.addingTimeInterval(600))
   269	
   270	        let second = try rig.session.startWorkout(
   271	            at: rig.gym, on: firstStart.addingTimeInterval(86_400))
   272	        let narrowEntry = try rig.session.addEntry(
   273	            for: rig.exercise, to: second, machine: rig.machine)
   274	        try rig.session.choosePreset(rig.narrow, for: narrowEntry)
   275	
   276	        let previous = PerformanceHistory(context: rig.context)
   277	        let narrowRow = try #require(WorkoutSession.orderedSets(of: narrowEntry).first)
   278	        #expect(
   279	            try previous.prefill(for: narrowRow) == nil,
   280	            "narrow grip has no history to prefill from")
   281	
   282	        let wideAgain = try rig.session.addEntry(
   283	            for: rig.exercise, to: second, machine: rig.machine)
   284	        try rig.session.choosePreset(rig.wide, for: wideAgain)
   285	        let wideRow = try #require(WorkoutSession.orderedSets(of: wideAgain).first)
   286	        let widePrefill = try previous.prefill(for: wideRow)
   287	        #expect(widePrefill?.weightValue == 70, "wide grip prefills from wide grip")
   288	    }
   289	}

