   617	extension View {
   618	    /// Runs `action` whenever a store save touched the catalog (equipment
   619	    /// models or exercises) — the invalidation signal for a cached
   620	    /// `CatalogModelIndex`. Rebuilding on `models.count` alone left a rename,
   621	    /// an `equipmentType` change, a link change or a muscle-group edit invisible
   622	    /// until the view was recreated (codex-review-4); rebuilding on every body
   623	    /// evaluation would cost a full index build per keystroke.
   624	    func onCatalogChange(_ action: @escaping () -> Void) -> some View {
   625	        onReceive(NotificationCenter.default.publisher(for: ModelContext.didSave)) { note in
   626	            let touched = [
   627	                ModelContext.NotificationKey.insertedIdentifiers,
   628	                ModelContext.NotificationKey.updatedIdentifiers,
   629	                ModelContext.NotificationKey.deletedIdentifiers,
   630	            ].flatMap { key -> [PersistentIdentifier] in
   631	                note.userInfo?[key.rawValue] as? [PersistentIdentifier] ?? []
   632	            }
   633	            // A save whose payload cannot be read is treated as a change: a
   634	            // missed rebuild shows stale rows, a spare one costs milliseconds.
   635	            let unreadable = touched.isEmpty
   636	            if unreadable || CatalogIndexInvalidation
   637	                .touchesCatalog(entityNames: touched.map(\.entityName)) {
   638	                action()
   639	            }
   640	        }
   641	    }
   642	}
