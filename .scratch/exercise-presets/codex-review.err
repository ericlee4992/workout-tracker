   188	        context.insert(set)
   189	        try context.save()
   190	        return entry
   191	    }
   192	
   193	    /// The machine's usual preset (D38), resolved against the exercise that is
   194	    /// actually being logged — a stale id pointing at another exercise's preset,
   195	    /// or at one since deleted, degrades to "none chosen" rather than attaching
   196	    /// a variation from a different movement.
   197	    func usualPreset(of machine: MachineInstance?, for exercise: Exercise) -> ExercisePreset? {
   198	        guard let presetID = machine?.defaultPresetID else { return nil }
   199	        return (exercise.presets ?? []).first { $0.id == presetID }
   200	    }
   201	
   202	    /// Machine-first logging (D7): the exercises linked to `machine`'s
   203	    /// equipment model, resolved from the model's scalar `exerciseIDs` in
   204	    /// link order. Exactly one → the UI auto-fills it with zero extra
   205	    /// prompts; several → the UI offers a chooser restricted to these; empty
   206	    /// (model-less machine, or no link resolves) → the UI falls back to the
   207	    /// full exercise picker.
   208	    func exercisesFor(machine: MachineInstance) throws -> [Exercise] {
   209	        let ids = machine.model?.exerciseIDs ?? []
   210	        guard !ids.isEmpty else { return [] }
   211	        let fetched = try context.fetch(FetchDescriptor<Exercise>(
   212	            predicate: #Predicate { ids.contains($0.id) }))
   213	        let byID = Dictionary(fetched.map { ($0.id, $0) }) { first, _ in first }
   214	        return ids.compactMap { byID[$0] }
   215	    }
   216	
   217	    /// Machine-first add (D7): appends an entry with the machine already
   218	    /// set. `exercise` is the machine's single linked exercise (auto-fill),
   219	    /// the one chosen from a multi-exercise station's chooser, or any
   220	    /// exercise from the full picker when the machine has no model.
   221	    @discardableResult
   222	    func addEntry(
   223	        machine: MachineInstance,
   224	        exercise: Exercise,
   225	        to workout: Workout
   226	    ) throws -> ExerciseEntry {
   227	        try addEntry(for: exercise, to: workout, machine: machine)
   228	    }
   229	
   230	    func deleteEntry(_ entry: ExerciseEntry) throws {
   231	        let workout = entry.workout
   232	        context.delete(entry)
   233	        if let workout {
   234	            renumber(Self.orderedEntries(of: workout).filter { $0 !== entry })
   235	        }
   236	        try context.save()
   237	    }
   238	
   239	    /// Moves `entry` to `index` within its workout's ordered entries.
   240	    func moveEntry(_ entry: ExerciseEntry, toIndex index: Int) throws {
   241	        guard let workout = entry.workout else { return }
   242	        var entries = Self.orderedEntries(of: workout)
   243	        guard let from = entries.firstIndex(where: { $0.id == entry.id }) else { return }
   244	        entries.remove(at: from)
   245	        entries.insert(entry, at: max(0, min(index, entries.count)))
   246	        renumber(entries)
   247	        try context.save()
   248	    }
   249	
   250	    /// Equipment choice (D19). Pass a machine, a free-weight tag, or neither.
   251	    /// While the entry is a draft (no set ever completed) the choice edits it
   252	    /// in place. Once frozen, choosing different equipment starts a NEW entry
   253	    /// right after it: uncompleted draft rows move over, completed sets and
   254	    /// the old entry's snapshot stay untouched. Returns the entry now holding
   255	    /// the draft rows (the new entry when a split happened).
   256	    @discardableResult
   257	    func chooseEquipment(
   258	        for entry: ExerciseEntry,
   259	        machine: MachineInstance?,
   260	        freeWeightTag: EquipmentTag?
   261	    ) throws -> ExerciseEntry {
   262	        let tag = machine == nil ? freeWeightTag : nil
   263	        if entry.machine?.id == machine?.id && entry.freeWeightTag == tag {
   264	            return entry // no change
   265	        }
   266	        guard entry.snapshotCapturedAt != nil else {
   267	            entry.machine = machine
   268	            entry.freeWeightTag = tag
   269	            try context.save()
   270	            return entry
   271	        }
   272	
   273	        // Frozen: split into a new entry ordered right after the old one.
   274	        guard let workout = entry.workout, let exercise = entry.exercise else {
   275	            return entry
   276	        }
   277	        var entries = Self.orderedEntries(of: workout)
   278	        let newEntry = ExerciseEntry(
   279	            order: 0,
   280	            freeWeightTag: tag,
   281	            workout: workout,
   282	            exercise: exercise,
   283	            machine: machine,
   284	            // The variation follows the user across the equipment change; the
   285	            // new machine's usual preset does not override a deliberate pick.
   286	            preset: entry.preset,
   287	            snapshotExerciseID: exercise.id,
   288	            snapshotLoadType: exercise.loadType,
   289	            snapshotExerciseName: exercise.name)
   290	        context.insert(newEntry)
   291	        if let position = entries.firstIndex(where: { $0.id == entry.id }) {
   292	            entries.insert(newEntry, at: position + 1)
   293	        } else {
   294	            entries.append(newEntry)
   295	        }
   296	        renumber(entries)
   297	
   298	        // Draft rows move to the new entry, preserving relative order;
   299	        // completed sets stay behind.
   300	        let drafts = Self.orderedSets(of: entry).filter { $0.completedAt == nil }
   301	        for (offset, draft) in drafts.enumerated() {
   302	            draft.entry = newEntry
   303	            draft.order = offset
   304	        }
   305	        renumber(sets: Self.orderedSets(of: entry))
   306	        if drafts.isEmpty {
   307	            let set = SetRecord(
   308	                order: 0, weightUnit: defaultUnit(for: newEntry), entry: newEntry)
   309	            context.insert(set)
   310	        }
   311	        try context.save()
   312	        return newEntry
   313	    }
   314	
   315	    /// Picks the variation performed (D36–D38).
   316	    ///
   317	    /// Same freeze rule as equipment (D19), for the same reason: once a set has
   318	    /// completed, its snapshot says which variation it was, and records key on
   319	    /// that. Switching afterwards therefore starts a new entry rather than
   320	    /// relabelling completed work — a wide-grip set must never become a
   321	    /// narrow-grip set because the user changed handles for their next three.
   322	    @discardableResult
   323	    func choosePreset(_ preset: ExercisePreset?, for entry: ExerciseEntry) throws
   324	        -> ExerciseEntry {
