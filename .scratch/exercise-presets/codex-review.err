   285	    private func updateRest(for set: SetRecord, isCompleted: Bool) {
   286	        do {
   287	            showRestTimer(try restTimer.handleCompletionChange(
   288	                of: set, isCompleted: isCompleted))
   289	        } catch {
   290	            assertionFailure("Failed to update rest timer: \(error)")
   291	        }
   292	    }
