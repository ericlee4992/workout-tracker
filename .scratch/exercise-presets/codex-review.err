   612	    // MARK: - Defaults & ordering
   613	
   614	    /// Unit-default precedence for a new set (T7, ticket 05 function):
   615	    /// machine → gym → app preference.
   616	    func defaultUnit(for entry: ExerciseEntry) -> WeightUnit {
   617	        let rows = (try? context.fetch(FetchDescriptor<AppPreferences>())) ?? []
   618	        return UnitPrecedence.defaultUnit(
   619	            machine: entry.machine,
   620	            gym: entry.workout?.gym,
   621	            appPreference: AppPreferences.canonical(of: rows)?.unitPreference)
   622	    }
