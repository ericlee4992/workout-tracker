   296	    @FocusState private var focusedField: Field?
   297	
   298	    private static let swipeDeleteWidth: CGFloat = 88
   299	
   300	    private enum Field { case weight, reps }
   301	
   302	    private var session: WorkoutSession { WorkoutSession(context: modelContext) }
   303	
   304	    init(
   305	        set: SetRecord, index: Int, loadType: LoadType,
   306	        onCompletionChanged: @escaping (Bool) -> Void,
   307	        onDelete: @escaping () -> Void
   308	    ) {
   309	        self.set = set
   310	        self.index = index
   311	        self.loadType = loadType
   312	        self.onCompletionChanged = onCompletionChanged
   313	        self.onDelete = onDelete
   314	        _weightText = State(initialValue: set.weightValue.map(Format.weight) ?? "")
   315	        _repsText = State(initialValue: set.reps.map(String.init) ?? "")
   316	    }
   317	
   318	    private var isCompleted: Bool { !set.isDeleted && set.completedAt != nil }
   319	
   320	    /// Deleting a set was already possible from the row's menu, but nobody
   321	    /// finds a menu they don't know is there. The swipe is the discoverable
   322	    /// half of the same action — both call `WorkoutSession.deleteSet`.
   323	    var body: some View {
   324	        ZStack(alignment: .trailing) {
   325	            if swipeOffset < 0 { swipeDeleteButton }
   326	            rowContent
   327	                // Opaque, so the delete button stays hidden behind the row
   328	                // until the swipe pulls it out from under.
   329	                .background(Color(.secondarySystemGroupedBackground))
   330	                .offset(x: swipeOffset)
     1	import SwiftData
     2	import SwiftUI
     3	
     4	/// Presets for one exercise: the grips, stances and single/double variations
     5	/// the user actually switches between (D36–D38).
     6	///
     7	/// Attached to the exercise, seeded or not (D37). A preset on a seeded exercise
     8	/// is user data hanging off a catalog row — the same shape D27 already blessed
     9	/// for user-created exercises linked to seeded models — so catalog
    10	/// reconciliation leaves it alone.
    11	struct ExercisePresetsSheet: View {
    12	    @Environment(\.modelContext) private var modelContext
    13	    @Environment(\.dismiss) private var dismiss
    14	    var exercise: Exercise
    15	
    16	    @State private var newName = ""
    17	    @State private var editing: ExercisePreset?
    18	    @State private var editText = ""
    19	
    20	    private var presets: [ExercisePreset] {
    21	        (exercise.presets ?? []).sorted {
    22	            ($0.order, $0.name) < ($1.order, $1.name)
    23	        }
    24	    }
    25	
    26	    private var existingNames: [String] { presets.map(\.name) }
    27	
    28	    private var unusedSuggestions: [String] {
    29	        ExercisePresets.suggestions.filter {
    30	            !ExercisePresets.isDuplicate($0, among: existingNames)
    31	        }
    32	    }
    33	
    34	    var body: some View {
    35	        NavigationStack {
    36	            List {
    37	                Section {
    38	                    if presets.isEmpty {
    39	                        Text("No presets yet. Without any, this exercise is logged as one thing.")
    40	                            .foregroundStyle(.secondary)
    41	                            .accessibilityIdentifier("noPresets")
    42	                    }
    43	                    ForEach(presets) { preset in
    44	                        Text(preset.name)
    45	                            .accessibilityIdentifier("preset.\(preset.name)")
    46	                            .contextMenu {
    47	                                Button("Rename…") {
    48	                                    editText = preset.name
    49	                                    editing = preset
    50	                                }
    51	                                Button("Delete", role: .destructive) { delete(preset) }
    52	                            }
    53	                    }
    54	                    .onMove(perform: move)
    55	                    .onDelete(perform: deleteAt)
    56	                } header: {
    57	                    Text("Presets")
    58	                } footer: {
    59	                    // The consequence, said where the decision is made.
    60	                    Text("Records, previous performance and prefill are kept separately for each preset — a narrow-grip best is not a wide-grip best. Renaming one keeps its history; deleting one leaves already-logged sets naming it.")
    61	                }
    62	
    63	                Section {
    64	                    HStack {
    65	                        TextField("New preset (e.g. Wide grip)", text: $newName)
    66	                            .accessibilityIdentifier("newPresetName")
    67	                            .onSubmit(add)
    68	                        Button("Add", action: add)
    69	                            .disabled(!ExercisePresets.isValid(newName, existing: existingNames))
    70	                            .accessibilityIdentifier("addPreset")
    71	                    }
    72	                    if ExercisePresets.isDuplicate(newName, among: existingNames) {
    73	                        Text("\(ExercisePresets.cleanedName(newName)) is already a preset here.")
    74	                            .font(.caption)
    75	                            .foregroundStyle(.red)
    76	                    }
    77	                } header: {
    78	                    Text("Add")
    79	                }
    80	
    81	                if !unusedSuggestions.isEmpty {
    82	                    Section {
    83	                        ForEach(unusedSuggestions, id: \.self) { suggestion in
    84	                            Button(suggestion) { add(named: suggestion) }
    85	                                .accessibilityIdentifier("presetSuggestion.\(suggestion)")
    86	                        }
    87	                    } header: {
    88	                        Text("Common")
    89	                    } footer: {
    90	                        Text("Suggestions only — nothing is added until you tap one.")
    91	                    }
    92	                }
    93	            }
    94	            .navigationTitle(exercise.name)
    95	            .navigationBarTitleDisplayMode(.inline)
    96	            .toolbar {
    97	                ToolbarItem(placement: .confirmationAction) {
    98	                    Button("Done") { dismiss() }
    99	                }
   100	                ToolbarItem(placement: .topBarLeading) {
   101	                    EditButton()
   102	                }
   103	            }
   104	            .alert(
   105	                "Rename Preset",
   106	                isPresented: Binding(
   107	                    get: { editing != nil },
   108	                    set: { if !$0 { editing = nil } }),
   109	                presenting: editing
   110	            ) { preset in
   111	                TextField("Name", text: $editText)
   112	                Button("Save") { rename(preset) }
   113	                Button("Cancel", role: .cancel) {}
   114	            } message: { _ in
   115	                Text("Sets already logged under the old name keep it — history records what you did, not what you call it now (D23).")
   116	            }
   117	        }
   118	    }
   119	
   120	    // MARK: - Editing
   121	
   122	    private func add() { add(named: newName) }
   123	
   124	    private func add(named name: String) {
   125	        let cleaned = ExercisePresets.cleanedName(name)
   126	        guard ExercisePresets.isValid(cleaned, existing: existingNames) else { return }
   127	        let preset = ExercisePreset(
   128	            name: cleaned,
   129	            order: ExercisePresets.nextOrder(after: presets.map(\.order)),
   130	            exercise: exercise)
   131	        modelContext.insert(preset)
   132	        save()
   133	        newName = ""
   134	    }
   135	
   136	    private func rename(_ preset: ExercisePreset) {
   137	        let cleaned = ExercisePresets.cleanedName(editText)
   138	        let others = presets.filter { $0.id != preset.id }.map(\.name)
   139	        guard ExercisePresets.isValid(cleaned, existing: others) else { return }
   140	        preset.name = cleaned
   141	        save()
   142	    }
   143	
   144	    private func delete(_ preset: ExercisePreset) {
   145	        modelContext.delete(preset)
   146	        renumber()
   147	    }
   148	
   149	    private func deleteAt(_ offsets: IndexSet) {
   150	        for index in offsets { modelContext.delete(presets[index]) }
   151	        renumber()
   152	    }
   153	
   154	    private func move(from source: IndexSet, to destination: Int) {
   155	        var ordered = presets
   156	        ordered.move(fromOffsets: source, toOffset: destination)
   157	        for (index, preset) in ordered.enumerated() { preset.order = index }
   158	        save()
   159	    }
   160	
   161	    private func renumber() {
   162	        for (index, preset) in presets.enumerated() { preset.order = index }
   163	        save()
   164	    }
   165	
   166	    private func save() {
   167	        do {
   168	            try modelContext.save()
   169	        } catch {
   170	            assertionFailure("Failed to save presets: \(error)")
   171	        }
   172	    }
   173	}
    60	                        }
