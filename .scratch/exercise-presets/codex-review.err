    46	    private struct Rig {
    47	        var context: ModelContext
    48	        var session: WorkoutSession
    49	        var gym: Gym
    50	        var machine: MachineInstance
    51	        var exercise: Exercise
    52	        var wide: ExercisePreset
    53	        var narrow: ExercisePreset
