/bin/zsh -lc "python3 - <<'PY'
# Compact exact scorer port for targeted regressions.
import json,math,re,unicodedata
from collections import Counter
R=json.load(open('WorkoutTracker/Resources/SeedCatalog.json'))['equipmentModels']
def n(s):return ' '.join(''.join(c if c.isalnum() else ' ' for c in unicodedata.normalize('NFKD',s).casefold()).split())
def t(s):return n(s).split()
def rt(s):return[x for x in t(s) if len(x)>1 or x[0].isdigit()]
d=Counter();P=[]
for r in R:m=t(r['manufacturer']);q=sorted(set(t(r['modelName'])));a=sorted(set(m+q));d.update(a);P.append((r,m,q,a))
N=len(R);W={x:math.log(1+N/(1+f)) for x,f in d.items()};U=math.log(1+N/2);M=[(x,set(rt(x))) for x in sorted({r['manufacturer'] for r in R})]
def w(x):return W.get(x,U)
def ed(a,b,L):
 p=list(range(len(b)+1))
 for i,x in enumerate(a,1):
  q=[i]+[0]*len(b);lo=i
  for j,y in enumerate(b,1):q[j]=min(p[j-1]+(x"'!=y),p[j]+1,q[j-1]+1);lo=min(lo,q[j])
  if lo>L:return None
  p=q
 return p[-1] if p[-1]<=L else None
def near(x,C,u):
 wx=w(x)
 if wx<1.5 or len(x)<4:return None
 L=2 if len(x)>=7 else 1;b=None
 for c in sorted(C):
  if c in u or abs(len(c)-len(x))>L or (c in W and c!=x) or not(c[0]==x[0] or c[-1]==x[-1]):continue
  z=ed(x,c,L)
  if z is not None and (b is None or z<b[0]):b=(z,c)
 return b[1] if b else None
JP=['"'warning','caution','danger','read','manual','instruction','before use','patent','made in','www','.com','serial','s n','capacity','max','maximum','min','lbs','weight stack','assembled','conforms','part no','rev']
def junk(s):z=n(s);return not z or not any(x.isalpha() for x in z) or any(p in z for p in JP) or bool(re.search(r'\\d+\\s?(lb|kg)\\b',z))
def rank(lines):
 C=set(rt('\\n'.join(lines)));E={x for l in lines if not junk(l) for x in rt(l)} or C;EW=sum(w(x) for x in sorted(E));named={m for m,s in M if s<=C};O=[]
 for r,m,q,a in P:
  ns=set(q or a);NW=sum(W.get(x,0) for x in ns);u=set();cv=ex=0
  for x in sorted(a,key=lambda y:(-W.get(y,0),y)):
   wx=w(x);isn=x in ns
   if x in C and x not in u:u.add(x);cv+=wx if isn else 0;ex+=wx if x in E else 0
   else:
    z=near(x,C,u)
    if z:u.add(z);cv+=wx*.85 if isn else 0;ex+=w(z)*.85 if z in E else 0
  if not cv:continue
  ma=bool(m) and set(x for x in m if len(x)>1)<=C;co=bool(named) and r['manufacturer'] not in named;s=.6*cv/NW+.3*min(1,ex/EW)+(.1 if ma else 0);s*=.6 if co else 1
  if s>=.25:O.append((min(1,s),r['manufacturer'],r['modelName'],ma,co,r['id']))
 return sorted(O,key=lambda x:(-x[0],x[1]+' '+x[2],x[5]))[:8],named
def show(name,lines):
 a,named=rank(lines);p=a[0] if a and a[0][0]>=.85 and a[0][3] and not a[0][4] and(len(a)<2 or a[0][0]-a[1][0]>=.08)else None
 print('\\n',name,'named=',named,'pre=',None if not p else p[1]+' '+p[2])
 for x in a[:6]:print(f'{x[0]:.9f}',x[1],'|',x[2],f'm={x[3]} c={x[4]}')
for name,lines in [
('Hammer D.Y clean',['HAMMER STRENGTH','ISO-LATERAL D.Y. ROW']),
('Hammer T-Bar clean',['HAMMER STRENGTH','ISO-LATERAL T-BAR ROW']),
('Sorinex Base Rack&A',['SORINEX','BASE CAMP RACK & A HALF']),
('Sorinex XL Rack&a',['SORINEX','XL SERIES RACK & A HALF']),
('Hoist 6 station S',['HOIST','6 STATION SINGLE POD CMJ-6600-S']),
('Life chest plus incidental Matrix',['LIFE FITNESS','INSIGNIA SERIES CHEST PRESS','MATRIX']),
('Life chest plus incidental Hoist',['LIFE FITNESS','INSIGNIA SERIES CHEST PRESS','HOIST']),
('Life abdominal clean',['LIFE FITNESS','INSIGNIA SERIES ABDOMINAL']),
('Rogue logo only R6',['ROGUE','R-6 POWER RACK']),
('Prime logo only 2:1',['PRIME','PRODIGY HLP SELECTORIZED RACK 2:1'])]:show(name,lines)
