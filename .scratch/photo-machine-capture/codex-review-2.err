    54	        let preselected = CatalogMatcher.preselection(from: matches)
    55	        #expect(
    56	            preselected == nil || preselected?.manufacturer == "Matrix",
    57	            "preselected a rival maker: \(describe(matches))")
    58	        if let best = matches.first, best.manufacturer != "Matrix" {
