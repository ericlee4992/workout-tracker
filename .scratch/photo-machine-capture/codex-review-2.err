    64	
    65	    @Test func unlistedHardwareLeadsToCreateNew() throws {
    66	        let index = try realIndex()
    67	        let matches = rank(
    68	            ["ATLANTIS STRENGTH", "PLATE LOADED BELT SQUAT", "C-227"], in: index)
    69	        #expect(
    70	            CatalogMatcher.preselection(from: matches) == nil,
    71	            "preselected unlisted hardware: \(describe(matches))")
    72	    }
    73	
    74	    // MARK: - Identities that live in single characters
    75	
    76	    /// `4 Station`, `5 Station`, `9 Station` are three different machines. A
    77	    /// tokenizer that drops one-character tokens made them the same row.
    78	    @Test func stationCountsAreNotInterchangeable() throws {
    79	        let index = try realIndex()
    80	        let matches = rank(["NAUTILUS", "5 STATION"], in: index)
    81	        let best = try #require(matches.first)
