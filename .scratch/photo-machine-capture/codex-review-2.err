    57	        return reading
    58	    }
    59	
    60	    /// Synchronous recognition. Separated so tests can call it directly on a
    61	    /// rendered fixture without an async hop.
    62	    static func perform(
    63	        _ image: CGImage, orientation: CGImagePropertyOrientation = .up
    64	    ) throws -> LabelReading {
