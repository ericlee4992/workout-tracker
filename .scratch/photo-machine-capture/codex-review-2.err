    72	    private(set) var unknownTokenWeight: Double = 1
    73	    /// Canonical manufacturer spellings, for the create-new guess.
    74	    private(set) var manufacturers: [String] = []
    75	    /// Token sets of every known manufacturer, for conflict detection.
    76	    private(set) var manufacturerTokenSets: [(name: String, tokens: Set<String>)] = []
    77	
    78	    init(models: [(id: UUID, manufacturer: String, modelName: String)]) {
    79	        var documentFrequency: [String: Int] = [:]
    80	        var tokenised: [(id: UUID, manufacturer: String, modelName: String,
    81	                         tokens: [String], manufacturerTokens: [String],
    82	                         nameTokens: [String])] = []
    83	        tokenised.reserveCapacity(models.count)
