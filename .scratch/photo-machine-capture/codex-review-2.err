     5	/// Photo machine capture, ticket 02 — photograph a machine's name plate, and
     6	/// let the user confirm which catalog model it is.
     7	///
     8	/// The sheet **proposes** (D33). It preselects the top hit when the match is
     9	/// strong, shows the alternatives with their scores, and always leaves "none of
    10	/// these" one tap away — because D23 keys history, prefill and PRs on the model
    11	/// UUID, so a wrong model silently accepted splits the user's own history.
    12	struct ScanMachineLabelSheet: View {
    13	    @Environment(\.modelContext) private var modelContext
    14	    @Environment(\.dismiss) private var dismiss
    15	
    16	    /// The user accepted a catalog row.
    17	    let onUseModel: (EquipmentModel) -> Void
    18	    /// The user wants a new model, prefilled with (manufacturer, model name).
    19	    let onCreateNew: (String, String) -> Void
    20	
    21	    @State private var phase: Phase = .idle
    22	    @State private var showingPicker = false
    23	    @State private var pickerSource: ImagePicker.Source = .photoLibrary
    24	    @State private var selectedID: UUID?
    25	    /// Why the camera is not being used, when it is not. Shown, never silent.
    26	    @State private var captureNotice: String?
    27	
    28	    private enum Phase {
    29	        case idle
    30	        case reading
    31	        case results(Results)
    32	        case failed(String)
    33	    }
    34	
    35	    private struct Results {
    36	        var reading: LabelReading
    37	        var matches: [CatalogMatch]
    38	        var manufacturerGuess: String
    39	        var modelNameGuess: String
    40	    }
    41	
    42	    var body: some View {
    43	        NavigationStack {
    44	            List {
    45	                switch phase {
    46	                case .idle:
    47	                    Label("Opening the camera…", systemImage: "camera")
    48	                        .foregroundStyle(.secondary)
    49	                        .accessibilityIdentifier("scanStatus")
    50	                case .reading:
    51	                    HStack(spacing: 10) {
    52	                        ProgressView()
    53	                        Text("Reading the label…")
    54	                    }
    55	                    .accessibilityIdentifier("scanStatus")
    56	                case .results(let results):
    57	                    resultsContent(results)
    58	                case .failed(let message):
    59	                    failureContent(message)
    60	                }
    61	            }
    62	            .navigationTitle("Scan Label")
    63	            .navigationBarTitleDisplayMode(.inline)
    64	            .toolbar {
    65	                ToolbarItem(placement: .cancellationAction) {
    66	                    Button("Cancel") { dismiss() }
    67	                }
    68	            }
    69	            .sheet(isPresented: $showingPicker) {
    70	                ImagePicker(source: pickerSource) { image in
    71	                    showingPicker = false
    72	                    guard let image else {
    73	                        // Backed out of the camera without taking anything.
    74	                        if case .idle = phase { dismiss() }
    75	                        return
    76	                    }
    77	                    read(image)
    78	                }
    79	                .ignoresSafeArea()
    80	            }
    81	            .onAppear(perform: start)
    82	        }
    83	    }
    84	
    85	    // MARK: - Content
    86	
    87	    @ViewBuilder
    88	    private func resultsContent(_ results: Results) -> some View {
    89	        if let captureNotice {
    90	            Section {
    91	                Label(captureNotice, systemImage: "info.circle")
    92	                    .font(.footnote)
    93	                    .foregroundStyle(.secondary)
    94	            }
    95	        }
    96	
    97	        Section {
    98	            Text(results.reading.text)
    99	                .font(.footnote.monospaced())
   100	                .foregroundStyle(.secondary)
   101	                .accessibilityIdentifier("scanReadingText")
   102	        } header: {
   103	            Text("What the camera read")
   104	        }
   105	
   106	        // Below the create-new floor the catalog probably does not have this
   107	        // machine, so the *action* leads, not just the wording (codex-review,
   108	        // finding 8). Above it, the candidates lead and create-new waits below.
   109	        let leadWithCreateNew = results.matches.isEmpty
   110	            || CatalogMatcher.suggestsCreatingNew(results.matches)
   111	
   112	        if leadWithCreateNew {
   113	            Section {
   114	                Button("Add this as a new model") {
   115	                    createNew(results)
   116	                }
   117	                .accessibilityIdentifier("scanCreateNew")
   118	            } footer: {
   119	                Text(results.matches.isEmpty
   120	                    ? "Nothing in the catalog looks like this label."
   121	                    : "Nothing in the catalog is a close match for this label.")
   122	            }
   123	        }
   124	
   125	        if !results.matches.isEmpty {
   126	            Section {
   127	                ForEach(results.matches, id: \.modelID) { match in
   128	                    Button {
   129	                        selectedID = match.modelID
   130	                    } label: {
   131	                        HStack {
   132	                            VStack(alignment: .leading, spacing: 2) {
   133	                                Text(match.modelName)
   134	                                Text(match.manufacturer)
   135	                                    .font(.caption)
   136	                                    .foregroundStyle(.secondary)
   137	                            }
   138	                            Spacer()
   139	                            Text(percentage(match.score))
   140	                                .font(.caption.monospacedDigit())
   141	                                .foregroundStyle(.tertiary)
   142	                            if selectedID == match.modelID {
   143	                                Image(systemName: "checkmark")
   144	                                    .foregroundStyle(.tint)
   145	                            }
   146	                        }
   147	                    }
   148	                    .buttonStyle(.plain)
   149	                    .accessibilityIdentifier("scanCandidate.\(match.modelName)")
   150	                }
   151	            } header: {
   152	                Text(leadWithCreateNew ? "Weak alternatives" : "Catalog models")
   153	            } footer: {
   154	                Text(selectedID == nil
   155	                    ? "Nothing is picked for you here — the reading was not clear enough to choose between these. Tap the machine you are standing at."
   156	                    : "Check the machine in front of you before accepting — records are kept per model, so the wrong one splits your history.")
   157	            }
   158	
   159	            Section {
   160	                Button("Use This") {
   161	                    use(selectedID)
   162	                }
   163	                .disabled(selectedID == nil)
   164	                .accessibilityIdentifier("scanUseCandidate")
   165	
   166	                if !leadWithCreateNew {
   167	                    Button("None of these — create new") {
   168	                        createNew(results)
   169	                    }
   170	                    .accessibilityIdentifier("scanCreateNew")
   171	                }
   172	
   173	                Button("Retake photo") { retake() }
   174	            }
   175	        } else {
   176	            Section {
   177	                Button("Retake photo") { retake() }
   178	            }
   179	        }
   180	    }
   181	
   182	    private func createNew(_ results: Results) {
   183	        onCreateNew(results.manufacturerGuess, results.modelNameGuess)
   184	        dismiss()
   185	    }
   186	
   187	    @ViewBuilder
   188	    private func failureContent(_ message: String) -> some View {
   189	        Section {
   190	            Label(message, systemImage: "exclamationmark.triangle")
   191	                .accessibilityIdentifier("scanStatus")
   192	        }
   193	        Section {
   194	            if CaptureAvailability.resolve() == .cameraDenied,
   195	               let settings = URL(string: UIApplication.openSettingsURLString) {
   196	                Link("Open Settings", destination: settings)
   197	            }
   198	            Button("Choose from photos") { present(.photoLibrary) }
   199	            Button("Try the camera again") { retake() }
   200	            Button("Enter it by hand") {
   201	                onCreateNew("", "")
   202	                dismiss()
   203	            }
   204	            .accessibilityIdentifier("scanCreateNew")
   205	        }
   206	    }
   207	
   208	    private func percentage(_ score: Double) -> String {
   209	        "\(Int((score * 100).rounded()))%"
   210	    }
   211	
   212	    // MARK: - Flow
   213	
   214	    private func start() {
   215	        guard case .idle = phase else { return }
   216	        if ScanFixture.isEnabled {
   217	            read(ScanFixture.image())
   218	            return
   219	        }
   220	        let availability = CaptureAvailability.resolve()
   221	        captureNotice = availability.reason
   222	        switch availability {
   223	        case .camera:
   224	            present(.camera)
   225	        case .noCamera:
   226	            // Straight to the library, with the reason on screen behind it.
   227	            present(.photoLibrary)
   228	        case .cameraDenied:
   229	            // Nothing is presented over the top: the user needs to read this
   230	            // and choose, not have another picker appear.
   231	            phase = .failed(availability.reason ?? "Camera access is off.")
   232	        }
   233	    }
   234	
   235	    private func present(_ source: ImagePicker.Source) {
   236	        pickerSource = source
   237	        showingPicker = true
   238	    }
   239	
   240	    private func retake() {
   241	        let availability = CaptureAvailability.resolve()
   242	        captureNotice = availability.reason
   243	        present(ImagePicker.Source.preferred(given: availability))
   244	    }
   245	
   246	    private func read(_ image: UIImage) {
   247	        phase = .reading
   248	        selectedID = nil
   249	        Task {
   250	            do {
   251	                // Vision runs off the main actor and reads the photo in the
   252	                // orientation it was taken; the image is not retained past this
   253	                // call (D34).
   254	                let reading = try await MachineLabelOCR.read(image)
   255	                let index = try catalogIndex()
   256	                let matches = CatalogMatcher.rank(reading, in: index)
   257	                let manufacturer = MachineLabelText.guessManufacturer(
   258	                    in: reading, knownManufacturers: index.manufacturers) ?? ""
   259	                phase = .results(Results(
   260	                    reading: reading,
   261	                    matches: matches,
   262	                    manufacturerGuess: manufacturer,
   263	                    modelNameGuess: MachineLabelText.guessModelName(
   264	                        in: reading, manufacturer: manufacturer)))
   265	                // Preselected only when the match is strong, the plate names
   266	                // this manufacturer, and the runner-up is not breathing down
   267	                // its neck. Never applied on its own (D33).
   268	                selectedID = CatalogMatcher.preselection(from: matches)?.modelID
   269	            } catch {
   270	                phase = .failed(error.localizedDescription)
   271	            }
   272	        }
   273	    }
   274	
   275	    /// Built per scan from the store's own models, so a model the user added
   276	    /// five minutes ago is matchable too. Measured over the full 1877-row
   277	    /// catalog in `MachineLabelOCRTests`; the slow part of a scan is Vision,
   278	    /// which already runs off the main actor.
   279	    private func catalogIndex() throws -> CatalogMatchIndex {
   280	        CatalogMatchIndex(models: try modelContext
   281	            .fetch(FetchDescriptor<EquipmentModel>())
   282	            .map { (id: $0.id, manufacturer: $0.manufacturer, modelName: $0.modelName) })
   283	    }
   284	
   285	    private func use(_ modelID: UUID?) {
   286	        guard let modelID else { return }
   287	        do {
   288	            let matched = try modelContext.fetch(FetchDescriptor<EquipmentModel>(
   289	                predicate: #Predicate { $0.id == modelID }))
   290	            guard let model = matched.first else {
   291	                phase = .failed("That model is no longer in the catalog.")
   292	                return
   293	            }
   294	            onUseModel(model)
   295	            dismiss()
   296	        } catch {
   297	            phase = .failed("Could not open that model: \(error.localizedDescription)")
   298	        }
   299	    }
   300	}
   301	
   302	/// Test-only camera stand-in, gated on a launch argument exactly like
   303	/// `-uiTestReset`: the Simulator has no camera, so without this the scan flow
   304	/// could not be driven end to end by `WorkoutTrackerUITests` at all.
   305	enum ScanFixture {
   306	    static let launchArgument = "-uiTestScanFixture"
   307	
   308	    static var isEnabled: Bool {
   309	        ProcessInfo.processInfo.arguments.contains(launchArgument)
   310	    }
   311	
   312	    /// A rendered name plate for a model the seeded catalog really contains.
   313	    static func image() -> UIImage {
   314	        let size = CGSize(width: 1_600, height: 500)
   315	        return UIGraphicsImageRenderer(size: size).image { context in
   316	            UIColor.white.setFill()
   317	            context.fill(CGRect(origin: .zero, size: size))
   318	            draw("LIFE FITNESS", in: size, y: 60, fontSize: 64)
   319	            draw("Insignia Series Chest Press", in: size, y: 200, fontSize: 88)
   320	            draw("MAX 300 LB", in: size, y: 380, fontSize: 40)
   321	        }
   322	    }
   323	
   324	    private static func draw(_ text: String, in size: CGSize, y: CGFloat, fontSize: CGFloat) {
   325	        let font = UIFont.systemFont(ofSize: fontSize, weight: .semibold)
   326	        let string = NSAttributedString(
   327	            string: text, attributes: [.font: font, .foregroundColor: UIColor.black])
   328	        string.draw(at: CGPoint(x: (size.width - string.size().width) / 2, y: y))
