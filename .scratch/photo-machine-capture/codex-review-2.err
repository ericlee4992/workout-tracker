    83	            best.modelName.contains("5"),
    84	            "the station count is the identity, got: \(describe(matches))")
    85	        if let second = matches.dropFirst().first {
    86	            #expect(
    87	                best.score > second.score,
    88	                "sibling station counts must not tie: \(describe(matches))")
    89	        }
    90	    }
    91	
    92	    /// No two shipped rows may reduce to the same matcher representation — that
    93	    /// would make one of them unreachable and the other a coin flip.
    94	    @Test func noTwoCatalogRowsNormaliseToTheSameIdentity() throws {
    95	        let catalog = try SeedCatalog.bundled()
    96	        var seen: [String: String] = [:]
    97	        var collisions: [String] = []
    98	        for model in catalog.equipmentModels {
    99	            let key = (MachineLabelText.tokens(model.manufacturer)
   100	                + MachineLabelText.tokens(model.modelName))
   101	                .sorted().joined(separator: " ")
   102	            let name = "\(model.manufacturer) \(model.modelName)"
   103	            if let existing = seen[key], existing != name {
   104	                collisions.append("\(existing) ≡ \(name)")
   105	            }
   106	            seen[key] = name
   107	        }
   108	        #expect(collisions.isEmpty, "identical matcher identities: \(collisions.prefix(5))")
   109	    }
   110	
   111	    // MARK: - Ambiguity is not a winner
   112	
   113	    /// A short generic row is a subset of a longer specific one. Both explain
   114	    /// their own tokens fully; only the longer row explains the plate.
   115	    @Test func aGenericRowDoesNotOutrankTheSpecificOneItIsContainedIn() throws {
   116	        let index = try realIndex()
   117	        let matches = rank(["LIFE FITNESS", "INSIGNIA SERIES BACK EXTENSION"], in: index)
   118	        let best = try #require(matches.first)
   119	        #expect(
   120	            best.modelName.lowercased().contains("insignia"),
   121	            "the specific row must win: \(describe(matches))")
   122	        if let preselected = CatalogMatcher.preselection(from: matches) {
   123	            #expect(preselected.modelName.lowercased().contains("insignia"))
   124	        }
   125	    }
   126	
   127	    /// A photograph taken between two stations names two machines. Neither is
   128	    /// the answer, and picking one is a coin flip on the user's history.
   129	    @Test func aPhotoOfTwoMachinesPreselectsNeither() throws {
   130	        let index = try realIndex()
   131	        let matches = rank(
   132	            ["LIFE FITNESS", "INSIGNIA SERIES CHEST PRESS", "INSIGNIA SERIES SHOULDER PRESS"],
   133	            in: index)
   134	        #expect(
   135	            CatalogMatcher.preselection(from: matches) == nil,
   136	            "picked one of two machines in frame: \(describe(matches))")
   137	    }
   138	
   139	    /// One recognised word may not be evidence for two different catalog words:
   140	    /// "abduction" is not a misreading of "adduction", it is another machine.
   141	    @Test func abductionIsNotEvidenceForAdduction() throws {
   142	        let index = try realIndex()
   143	        let matches = rank(["LIFE FITNESS", "INSIGNIA SERIES HIP ABDUCTION"], in: index)
   144	        let best = try #require(matches.first)
   145	        #expect(
   146	            best.modelName.lowercased().contains("abduction"),
   147	            "got: \(describe(matches))")
   148	        // An adduction-only row must not tie the abduction row it is not.
   149	        let adductionOnly = matches.first {
   150	            let name = $0.modelName.lowercased()
   151	            return name.contains("adduction") && !name.contains("abduction")
   152	        }
   153	        if let adductionOnly {
   154	            #expect(
   155	                best.score - adductionOnly.score >= CatalogMatcher.preselectionMargin,
   156	                "abduction and adduction are too close: \(describe(matches))")
   157	        }
   158	    }
   159	
   160	    // MARK: - Determinism
   161	
   162	    /// The same photo must rank the same way whatever order the catalog arrived
   163	    /// in and whatever this process's hash seed is.
   164	    @Test func rankingDoesNotDependOnCatalogOrder() throws {
   165	        let models = try SeedCatalog.bundled().equipmentModels.map {
   166	            (id: $0.id, manufacturer: $0.manufacturer, modelName: $0.modelName)
   167	        }
   168	        let forward = CatalogMatchIndex(models: models)
   169	        let backward = CatalogMatchIndex(models: models.reversed())
   170	        let reading = LabelReading.lines(
   171	            ["LIFE FITNESS", "Insignia Series Chest Press", "MAX 300 LB"])
   172	
   173	        let first = CatalogMatcher.rank(reading, in: forward, limit: 5)
   174	        let second = CatalogMatcher.rank(reading, in: backward, limit: 5)
   175	        #expect(first == second)
   176	        #expect(CatalogMatcher.preselection(from: first)
   177	            == CatalogMatcher.preselection(from: second))
   178	    }
   179	
   180	    /// And the same reading assembled from differently ordered lines.
   181	    @Test func rankingDoesNotDependOnLineOrder() throws {
   182	        let index = try realIndex()
   183	        let forward = rank(["LIFE FITNESS", "Insignia Series Chest Press"], in: index)
   184	        let reversed = rank(["Insignia Series Chest Press", "LIFE FITNESS"], in: index)
   185	        #expect(forward.map(\.modelID) == reversed.map(\.modelID))
   186	        #expect(forward.map(\.score) == reversed.map(\.score))
   187	    }
   188	}
     1	import Foundation
     2	import Testing
     3	
     4	@testable import WorkoutTracker
     5	
     6	// Photo machine capture, ticket 01 — the matcher, which is the part that can
     7	// be wrong in a way that costs the user something. A missed match costs a few
     8	// taps; a confident wrong match attaches the user's sets to another machine's
     9	// UUID and splits their history (D23), so several of these tests are about
    10	// *refusing* to answer.
    11	
    12	struct CatalogMatcherTests {
    13	
    14	    // MARK: - Fixtures
    15	
    16	    /// A small catalog with the properties that matter: repeated words across
    17	    /// rows ("series", "chest", "press") so IDF has something to do, two rows
    18	    /// that differ by one distinctive word, and two manufacturers.
    19	    private func makeIndex() -> CatalogMatchIndex {
    20	        CatalogMatchIndex(models: catalog.map {
    21	            (id: $0.id, manufacturer: $0.manufacturer, modelName: $0.modelName)
    22	        })
    23	    }
    24	
    25	    private struct Row {
    26	        let id: UUID
    27	        let manufacturer: String
    28	        let modelName: String
    29	    }
    30	
    31	    private let catalog: [Row] = [
    32	        Row(id: UUID(uuidString: "00000000-0000-0000-0000-000000000001")!,
    33	            manufacturer: "Life Fitness", modelName: "Insignia Series Chest Press"),
    34	        Row(id: UUID(uuidString: "00000000-0000-0000-0000-000000000002")!,
    35	            manufacturer: "Life Fitness", modelName: "Insignia Series Shoulder Press"),
    36	        Row(id: UUID(uuidString: "00000000-0000-0000-0000-000000000003")!,
    37	            manufacturer: "Life Fitness", modelName: "Axiom Series Chest Press"),
    38	        Row(id: UUID(uuidString: "00000000-0000-0000-0000-000000000004")!,
    39	            manufacturer: "Hammer Strength", modelName: "Select Seated Leg Press"),
    40	        Row(id: UUID(uuidString: "00000000-0000-0000-0000-000000000005")!,
    41	            manufacturer: "Precor", modelName: "Vitality Series Seated Row VSL019BP"),
    42	        Row(id: UUID(uuidString: "00000000-0000-0000-0000-000000000006")!,
    43	            manufacturer: "Cybex", modelName: "Eagle NX Leg Extension"),
    44	    ]
    45	
    46	    private var insigniaChestPress: UUID { catalog[0].id }
    47	    private var insigniaShoulderPress: UUID { catalog[1].id }
    48	    private var hammerLegPress: UUID { catalog[3].id }
    49	    private var precorRow: UUID { catalog[4].id }
    50	
    51	    private func rank(_ lines: [String]) -> [CatalogMatch] {
    52	        CatalogMatcher.rank(LabelReading.lines(lines), in: makeIndex())
    53	    }
    54	
    55	    /// What the sheet would preselect, which is the only thing that can be
    56	    /// confidently *wrong* (D33).
    57	    private func preselected(_ lines: [String]) -> CatalogMatch? {
    58	        CatalogMatcher.preselection(from: rank(lines))
    59	    }
    60	
    61	    // MARK: - Finding the right row
    62	
    63	    @Test func readsAPlainNamePlate() throws {
    64	        let matches = rank(["LIFE FITNESS", "Insignia Series", "Chest Press"])
    65	        let best = try #require(matches.first)
    66	        #expect(best.modelID == insigniaChestPress)
    67	        #expect(preselected(["LIFE FITNESS", "Insignia Series", "Chest Press"])?.modelID
    68	            == insigniaChestPress)
    69	    }
    70	
    71	    /// Vision returns lines in reading order, but a plate photographed at an
    72	    /// angle can come back out of order, and the brand is sometimes below.
    73	    @Test func lineOrderDoesNotMatter() throws {
    74	        let forward = rank(["LIFE FITNESS", "Insignia Series", "Chest Press"])
    75	        let scrambled = rank(["Chest Press", "LIFE FITNESS", "Insignia Series"])
    76	        #expect(forward.first?.modelID == scrambled.first?.modelID)
    77	        #expect(forward.first?.score == scrambled.first?.score)
    78	    }
    79	
    80	    /// The failures OCR actually makes: a swapped letter, an `I` read as `l`,
    81	    /// an `M` read as `H`.
    82	    @Test func singleCharacterMisreadsStillFindTheRow() throws {
    83	        for misread in ["Insigma Series Chest Press",
    84	                        "lnsignia Series Chest Press",
    85	                        "INSIGNIA SERIES CHEST PBESS"] {
    86	            let best = try #require(rank(["LIFE FITNESS", misread]).first)
    87	            #expect(best.modelID == insigniaChestPress, "failed on \(misread)")
    88	        }
    89	        let hammer = try #require(rank(["HAMIER STRENGTH", "Select Seated Leg Press"]).first)
    90	        #expect(hammer.modelID == hammerLegPress)
    91	    }
    92	
    93	    @Test func plateFurnitureDoesNotSinkTheMatch() throws {
    94	        let best = try #require(rank([
    95	            "LIFE FITNESS",
    96	            "Insignia Series Chest Press",
    97	            "MAX 300 LB / 136 KG",
    98	            "READ MANUAL BEFORE USE",
    99	            "SN 84213-9920",
   100	        ]).first)
   101	        #expect(best.modelID == insigniaChestPress)
   102	        #expect(
   103	            preselected([
   104	                "LIFE FITNESS", "Insignia Series Chest Press", "MAX 300 LB / 136 KG",
   105	                "READ MANUAL BEFORE USE", "SN 84213-9920",
   106	            ])?.modelID == insigniaChestPress,
   107	            "warnings must not cost the row its preselection")
   108	    }
   109	
   110	    /// A model code on the plate is evidence, not noise — Precor's own names
   111	    /// carry them.
   112	    @Test func aModelCodeIsEvidence() throws {
   113	        let best = try #require(rank(["VSL019BP"]).first)
   114	        #expect(best.modelID == precorRow)
   115	    }
   116	
   117	    // MARK: - Ranking, not just picking
   118	
   119	    @Test func siblingModelsRankInTheRightOrderAndBothAppear() throws {
   120	        let matches = rank(["LIFE FITNESS", "Insignia Series", "Shoulder Press"])
   121	        #expect(matches.first?.modelID == insigniaShoulderPress)
   122	        #expect(
   123	            matches.contains { $0.modelID == insigniaChestPress },
   124	            "the sibling belongs in the list — the plate may have been misread")
   125	        let shoulder = try #require(matches.first(where: { $0.modelID == insigniaShoulderPress }))
   126	        let chest = try #require(matches.first(where: { $0.modelID == insigniaChestPress }))
   127	        #expect(shoulder.score > chest.score)
   128	    }
   129	
   130	    @Test func rankingIsDeterministicAndBounded() throws {
   131	        let index = makeIndex()
   132	        let reading = LabelReading.lines(["LIFE FITNESS", "Series Press"])
   133	        let first = CatalogMatcher.rank(reading, in: index, limit: 3)
   134	        let second = CatalogMatcher.rank(reading, in: index, limit: 3)
   135	        #expect(first == second)
   136	        #expect(first.count <= 3)
   137	        #expect(first.map(\.score) == first.map(\.score).sorted(by: >))
   138	    }
   139	
   140	    // MARK: - Refusing to answer
   141	
   142	    /// Hardware the catalog does not have must not borrow a confident answer
   143	    /// from a row that happens to share a common word.
   144	    @Test func unknownHardwareScoresBelowTheCreateNewFloor() throws {
   145	        let matches = rank(["ATLANTIS STRENGTH", "Plate Loaded Belt Squat", "Model C-227"])
   146	        #expect(CatalogMatcher.suggestsCreatingNew(matches))
   147	        #expect(CatalogMatcher.preselection(from: matches) == nil)
   148	    }
   149	
   150	    /// IDF doing its job: words shared by half the catalog identify nothing.
   151	    @Test func commonWordsAloneAreNotAMatch() throws {
   152	        let matches = rank(["SERIES", "PRESS"])
   153	        #expect(CatalogMatcher.preselection(from: matches) == nil)
   154	    }
   155	
   156	    @Test func anEmptyOrUnreadableReadingRanksNothing() {
   157	        #expect(rank([]).isEmpty)
   158	        #expect(rank(["", "  "]).isEmpty)
   159	        // Lone letters are noise; a lone digit is not (it is the whole
   160	        // difference between "4 Station" and "5 Station"), but on its own it
   161	        // matches nothing in this catalog.
   162	        #expect(rank(["I", "®"]).isEmpty)
   163	    }
   164	
   165	    // MARK: - Edit distance
   166	
   167	    @Test func editDistanceIsBoundedAndCorrect() {
   168	        #expect(CatalogMatcher.editDistance("insignia", "insignia", limit: 2) == 0)
   169	        // "insignia" → "insigma" is two edits (n→m, drop an i), which is why
   170	        // the long-token allowance is 2 rather than 1.
   171	        #expect(CatalogMatcher.editDistance("insignia", "insigma", limit: 2) == 2)
   172	        #expect(CatalogMatcher.editDistance("insignia", "insigma", limit: 1) == nil)
   173	        #expect(CatalogMatcher.editDistance("insignia", "lnsignia", limit: 2) == 1)
   174	        // Beyond the limit it reports nothing rather than a large number, so
   175	        // callers cannot accidentally treat "far apart" as "matched".
   176	        #expect(CatalogMatcher.editDistance("insignia", "shoulder", limit: 2) == nil)
   177	        #expect(CatalogMatcher.editDistance("press", "pressing", limit: 2) == nil)
   178	    }
   179	
   180	    // MARK: - Naming a new model (D35)
   181	
   182	    @Test func manufacturerGuessUsesTheCatalogSpelling() {
   183	        let index = makeIndex()
   184	        let reading = LabelReading.lines(["LIFE FITNESS", "Some Unlisted Press"])
   185	        #expect(
   186	            MachineLabelText.guessManufacturer(
   187	                in: reading, knownManufacturers: index.manufacturers) == "Life Fitness")
   188	    }
   189	
   190	    @Test func manufacturerGuessPrefersTheLongerBrandName() {
   191	        let known = ["Hammer", "Hammer Strength"]
   192	        let reading = LabelReading.lines(["HAMMER STRENGTH", "Iso-Lateral Row"])
   193	        #expect(
   194	            MachineLabelText.guessManufacturer(in: reading, knownManufacturers: known)
   195	                == "Hammer Strength")
   196	    }
   197	
   198	    @Test func anUnknownBrandFallsBackToTheTopLine() {
   199	        let reading = LabelReading.lines(["ATLANTIS", "Belt Squat", "MAX 400 LB"])
   200	        #expect(
   201	            MachineLabelText.guessManufacturer(in: reading, knownManufacturers: ["Cybex"])
   202	                == "ATLANTIS")
   203	    }
   204	
   205	    @Test func modelNameGuessSkipsJunkAndTheBrandItself() {
   206	        let reading = LabelReading(lines: [
   207	            LabelReading.Line(text: "ATLANTIS", confidence: 1, heightFraction: 0.05),
   208	            LabelReading.Line(text: "Belt Squat C-227", confidence: 1, heightFraction: 0.12),
   209	            LabelReading.Line(text: "MAX 400 LB", confidence: 1, heightFraction: 0.04),
   210	            LabelReading.Line(text: "READ MANUAL BEFORE USE", confidence: 1, heightFraction: 0.03),
   211	        ])
   212	        #expect(
   213	            MachineLabelText.guessModelName(in: reading, manufacturer: "ATLANTIS")
   214	                == "Belt Squat C-227")
   215	    }
   216	
   217	    @Test func junkLineDetection() {
   218	        #expect(MachineLabelText.isJunkLine("MAX 300 LB"))
   219	        #expect(MachineLabelText.isJunkLine("READ MANUAL BEFORE USE"))
   220	        #expect(MachineLabelText.isJunkLine("www.lifefitness.com"))
   221	        #expect(MachineLabelText.isJunkLine("84213-9920"))
   222	        #expect(MachineLabelText.isJunkLine("   "))
   223	        #expect(!MachineLabelText.isJunkLine("Insignia Series Chest Press"))
   224	        #expect(!MachineLabelText.isJunkLine("Eagle NX Leg Extension"))
   225	    }
   226	
   227	    // MARK: - Normalisation
   228	
   229	    @Test func normalisationFlattensPlateTypography() {
   230	        #expect(MachineLabelText.normalized("LIFE FITNESS®") == "life fitness")
   231	        #expect(MachineLabelText.normalized("Hammer  Strength™") == "hammer strength")
   232	        #expect(MachineLabelText.normalized("Iso-Lateral / Row") == "iso lateral row")
   233	        // Catalog side keeps everything — `4 Station` and `R-6` are identities.
   234	        #expect(MachineLabelText.tokens("A Chest Press 2") == ["a", "chest", "press", "2"])
   235	        // Photo side drops lone letters (bracket edges, logo fragments) but
   236	        // keeps lone digits, which are often the whole distinction.
   237	        #expect(MachineLabelText.readingTokens("A Chest Press 2") == ["chest", "press", "2"])
   238	        #expect(MachineLabelText.readingTokens("NAUTILUS 5 STATION") == ["nautilus", "5", "station"])
   239	    }
   240	}

