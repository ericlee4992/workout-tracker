    60	            availability == .camera ? .camera : .photoLibrary
    61	        }
    62	
    63	        var sourceType: UIImagePickerController.SourceType {
    64	            switch self {
    65	            case .camera: .camera
    66	            case .photoLibrary: .photoLibrary
    67	            }
    68	        }
    69	    }
    70	
    71	    let source: Source
    72	    /// nil = the user backed out.
    73	    let onPicked: (UIImage?) -> Void
    74	
    75	    func makeUIViewController(context: Context) -> UIImagePickerController {
    76	        let controller = UIImagePickerController()
    77	        controller.sourceType = source.sourceType
    78	        controller.allowsEditing = false
    79	        controller.delegate = context.coordinator
    80	        return controller
    81	    }
    82	
    83	    func updateUIViewController(_ controller: UIImagePickerController, context: Context) {}
    84	
    85	    func makeCoordinator() -> Coordinator {
    86	        Coordinator(onPicked: onPicked)
    87	    }
    88	
    89	    final class Coordinator: NSObject, UIImagePickerControllerDelegate,
    90	                             UINavigationControllerDelegate {
    91	        private let onPicked: (UIImage?) -> Void
    92	        /// The delegate can fire twice if the user is quick; the reading is
    93	        /// started from this callback, so it must happen exactly once.
    94	        private var hasFinished = false
    95	
    96	        init(onPicked: @escaping (UIImage?) -> Void) {
    97	            self.onPicked = onPicked
    98	        }
    99	
   100	        func imagePickerController(
   101	            _ picker: UIImagePickerController,
   102	            didFinishPickingMediaWithInfo info: [UIImagePickerController.InfoKey: Any]
   103	        ) {
   104	            finish(with: info[.originalImage] as? UIImage)
   105	        }
   106	
   107	        func imagePickerControllerDidCancel(_ picker: UIImagePickerController) {
   108	            finish(with: nil)
   109	        }
   110	
   111	        private func finish(with image: UIImage?) {
   112	            guard !hasFinished else { return }
   113	            hasFinished = true
   114	            onPicked(image)
   115	        }
   116	    }
   117	}

