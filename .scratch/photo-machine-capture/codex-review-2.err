    85	        for model in models {
    86	            let manufacturerTokens = MachineLabelText.tokens(model.manufacturer)
    87	            let nameTokens = Array(Set(MachineLabelText.tokens(model.modelName))).sorted()
    88	            let all = Array(Set(manufacturerTokens + nameTokens)).sorted()
    89	            for token in all { documentFrequency[token, default: 0] += 1 }
    90	            tokenised.append((model.id, model.manufacturer, model.modelName,
