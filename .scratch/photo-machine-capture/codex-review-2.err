     1	import Foundation
     2	
     3	// Photo machine capture, ticket 01 — what a name plate said, and how to read
     4	// meaning out of it. Pure: no UI, no SwiftData, no Vision.
     5	//
     6	// `MachineLabelOCR` produces a `LabelReading`; `CatalogMatcher` ranks the
     7	// catalog against it; the create-new path uses the guesses at the bottom of
     8	// this file. Everything here is text handling, so everything here is testable
     9	// without a camera.
    10	
    11	/// One photographed label, as text.
    12	struct LabelReading: Equatable {
    13	
    14	    /// A single recognised line, top of the plate first.
    15	    struct Line: Equatable {
    16	        var text: String
    17	        /// Vision's own confidence, 0–1.
    18	        var confidence: Double
    19	        /// Line height as a fraction of the image. The model name is almost
    20	        /// always the biggest text on a name plate and the manufacturer sits
    21	        /// above it in smaller type, so size is a real signal about which line
    22	        /// is which — more reliable than position alone.
    23	        var heightFraction: Double
    24	
    25	        init(text: String, confidence: Double = 1, heightFraction: Double = 0) {
    26	            self.text = text
    27	            self.confidence = confidence
    28	            self.heightFraction = heightFraction
    29	        }
    30	    }
    31	
    32	    var lines: [Line] = []
    33	
    34	    var isEmpty: Bool { lines.allSatisfy { $0.text.trimmed.isEmpty } }
    35	
    36	    /// The whole plate as the user will see it echoed back in the sheet.
    37	    var text: String {
    38	        lines.map(\.text).joined(separator: "\n")
    39	    }
    40	
    41	    static func lines(_ texts: [String]) -> LabelReading {
    42	        LabelReading(lines: texts.map { Line(text: $0) })
    43	    }
    44	}
    45	
    46	// MARK: - Normalisation
    47	
    48	enum MachineLabelText {
    49	
    50	    /// Case-folded, diacritic-free, punctuation-free, single-spaced.
    51	    ///
    52	    /// Name plates are shouted in capitals, sometimes stylised
    53	    /// (`LIFE FITNESS®`, `Hammer Strength™`), and Vision reproduces whatever
    54	    /// it sees. Comparison happens in one flat form or not at all.
    55	    static func normalized(_ text: String) -> String {
    56	        let folded = text.folding(options: [.diacriticInsensitive, .caseInsensitive, .widthInsensitive],
    57	                                  locale: Locale(identifier: "en_US_POSIX"))
    58	        let scalars = folded.unicodeScalars.map { scalar -> Character in
    59	            CharacterSet.alphanumerics.contains(scalar) ? Character(scalar) : " "
    60	        }
    61	        return String(scalars)
    62	            .split(separator: " ", omittingEmptySubsequences: true)
    63	            .joined(separator: " ")
    64	    }
    65	
    66	    /// Normalised tokens of a **catalog row**. Nothing is dropped: shipped
    67	    /// identities turn on single characters — `4 Station` vs `5 Station`,
    68	    /// `R-4` vs `R-6`, PRIME's `2:1` vs `4:1`. Filtering them made distinct
    69	    /// catalog UUIDs indistinguishable, which is the D23 history-splitting
    70	    /// failure in its purest form (codex-review, finding 2).
    71	    static func tokens(_ text: String) -> [String] {
    72	        normalized(text)
    73	            .split(separator: " ")
    74	            .map(String.init)
    75	    }
    76	
    77	    /// Normalised tokens of a **photograph**. Same as `tokens`, minus lone
    78	    /// letters: a bracket edge or a logo fragment read as a stray `I` is noise,
    79	    /// and a one-letter false hit against a rare catalog token is expensive.
    80	    /// Lone *digits* stay — `5` in `NAUTILUS 5 STATION` is the whole answer.
    81	    static func readingTokens(_ text: String) -> [String] {
    82	        tokens(text).filter { $0.count > 1 || $0.first?.isNumber == true }
    83	    }
    84	
    85	    // MARK: Junk lines
    86	
    87	    /// Phrases that appear on name plates and never in a model name.
    88	    private static let junkPhrases = [
    89	        "warning", "caution", "danger", "read", "manual", "instruction",
    90	        "before use", "patent", "made in", "www", ".com", "serial", "s n",
    91	        "capacity", "max", "maximum", "min", "lbs", "weight stack",
    92	        "assembled", "conforms", "part no", "rev",
    93	    ]
    94	
    95	    /// Whether a line is plate furniture rather than the hardware's name:
    96	    /// load ratings, warnings, URLs, part numbers, pure digits.
    97	    ///
    98	    /// Used only for *guessing* what to call a new model. Matching keeps these
    99	    /// lines, because a line the eye reads as junk sometimes carries the one
   100	    /// token that identifies the row — Precor's catalogue names really do
   101	    /// include codes like `VSL019BP`.
   102	    static func isJunkLine(_ text: String) -> Bool {
   103	        let normalized = normalized(text)
   104	        guard !normalized.isEmpty else { return true }
   105	        // No letters at all: a number, a date, a stack rating.
   106	        if !normalized.contains(where: \.isLetter) { return true }
   107	        if junkPhrases.contains(where: { normalized.contains($0) }) { return true }
   108	        // "300 lb" / "150kg" style ratings.
   109	        if normalized.range(of: #"\d+\s?(lb|kg)\b"#, options: .regularExpression) != nil {
   110	            return true
   111	        }
   112	        return false
   113	    }
   114	
   115	    // MARK: Guessing a name for a new model (D35)
   116	
   117	    /// The manufacturer the plate names, in the catalog's own spelling when the
   118	    /// catalog knows it.
   119	    ///
   120	    /// Canonical spelling matters: a user-created model that says
   121	    /// `LIFE FITNESS` sorts and reads as a different brand from the 200 seeded
   122	    /// rows that say `Life Fitness`, for no reason the user would accept.
   123	    static func guessManufacturer(
   124	        in reading: LabelReading, knownManufacturers: [String]
   125	    ) -> String? {
   126	        let brandLine = reading.lines.first { !isJunkLine($0.text) }
   127	
   128	        // Longest match first: "Hammer Strength" must beat "Hammer".
   129	        let ranked = knownManufacturers
   130	            .sorted { lhs, rhs in
   131	                let left = tokens(lhs).count, right = tokens(rhs).count
   132	                return left == right ? lhs < rhs : left > right
   133	            }
   134	
   135	        func knownBrand(in text: String) -> String? {
   136	            let candidates = Set(readingTokens(text))
   137	            guard !candidates.isEmpty else { return nil }
   138	            return ranked.first { manufacturer in
   139	                let needed = Set(readingTokens(manufacturer))
   140	                return !needed.isEmpty && needed.isSubset(of: candidates)
   141	            }
   142	        }
   143	
   144	        // The brand line first (codex-review, finding 9). Scanning the whole
   145	        // photo lets a *neighbouring* machine's brand — or a brand word printed
   146	        // in a warning — overwrite a genuinely new manufacturer's name.
   147	        if let brandLine, let known = knownBrand(in: brandLine.text) { return known }
   148	
   149	        // Then the rest of the plate, but only when exactly one known brand
   150	        // appears in it: two brands in one photograph is a photograph of two
   151	        // machines, and guessing between them is worse than not guessing.
   152	        let elsewhere = reading.lines
   153	            .filter { !isJunkLine($0.text) && $0.text != brandLine?.text }
   154	            .compactMap { knownBrand(in: $0.text) }
   155	        if Set(elsewhere).count == 1, let only = elsewhere.first { return only }
   156	
   157	        // Nothing known: the brand is conventionally the top line of a plate,
   158	        // as long as that line is not furniture. Preserved verbatim — a new
   159	        // manufacturer is exactly the case where inventing a spelling is wrong.
   160	        return brandLine.map { $0.text.trimmed }
   161	    }
   162	
   163	    /// The best candidate for a model name: the largest non-junk line that is
   164	    /// not just the manufacturer repeated. Falls back to the first usable line,
   165	    /// then to the raw text, because an editable wrong guess beats an empty
   166	    /// field the user has to fill in standing at the machine.
   167	    static func guessModelName(in reading: LabelReading, manufacturer: String?) -> String {
   168	        let manufacturerTokens = Set(readingTokens(manufacturer ?? ""))
   169	        let usable = reading.lines.filter { line in
   170	            guard !isJunkLine(line.text) else { return false }
   171	            let lineTokens = Set(readingTokens(line.text))
   172	            guard !lineTokens.isEmpty else { return false }
   173	            // Drop a line that says nothing but the brand.
   174	            return !manufacturerTokens.isEmpty ? !lineTokens.isSubset(of: manufacturerTokens) : true
   175	        }
   176	        let byPresence = usable.max {
   177	            ($0.heightFraction, $0.confidence) < ($1.heightFraction, $1.confidence)
   178	        }
   179	        return (byPresence ?? usable.first).map { $0.text.trimmed }
   180	            ?? reading.text.trimmed
   181	    }
   182	}
   183	
   184	/// Local convenience only — the codebase's idiom elsewhere is a `trimmedName`
   185	/// computed property per view, and a module-wide `String.trimmed` would be a
   186	/// bigger change than this feature is entitled to make.
   187	private extension String {
   188	    var trimmed: String { trimmingCharacters(in: .whitespacesAndNewlines) }
   189	}

