codex
The first pass already exposes an important shape: the four original unsafe-preselection examples appear gated, but the new “manufacturer named” rule is a deliberately large recall trade. I’m quantifying that now over all 1,877 rows and separating “clean model name only” from “clean manufacturer + model name,” because those answer different real-world plate conditions.
hook: PreToolUse
hook: PreToolUse Completed
exec
/bin/zsh -lc "python3 - <<'PY'
import json,math,re,unicodedata
from collections import Counter
p='WorkoutTracker/Resources/SeedCatalog.json'
rows=json.load(open(p))['equipmentModels']

def norm(s):
 s=unicodedata.normalize('NFKD',s).casefold()
 s=''.join(c if c.isalnum() else ' ' for c in s)
 return ' '.join(s.split())
def toks(s): return norm(s).split()
def rtoks(s): return [x for x in toks(s) if len(x)>1 or x[:1].isdigit()]
df=Counter()
prepared=[]
for r in rows:
 mt=toks(r['manufacturer']); nt=sorted(set(toks(r['modelName']))); all_=sorted(set(mt+nt))
 df.update(all_); prepared.append((r,mt,nt,all_))
n=len(rows); weights={t:math.log(1+n/(1+f)) for t,f in df.items()}; unknown=math.log(1+n/2)
manus=sorted({r['manufacturer'] for r in rows if r['manufacturer'].strip()})
mansets=[(m,set(rtoks(m))) for m in manus if rtoks(m)]
def w(t): return weights.get(t,unknown)
def ed(a,b,lim):
 if a==b:return 0
 if abs(len(a)-len(b))>lim:return None
 prev=list(range(len(b)+1))
 for i,x in enumerate(a,1):
  cur=[i]+[0]*len(b); rb=i
  for j,y in enumerate(b,1):
   cur[j]=min(prev[j-1]+(x"'!=y),prev[j]+1,cur[j-1]+1);rb=min(rb,cur[j])
  if rb>lim:return None
  prev=cur
 d=prev[-1];return d if d<=lim else None
def near(token,cands,consumed,weight):
 if weight<1.5 or len(token)<4:return None
 allowed=2 if len(token)>=7 else 1; best=None
 for c in sorted(cands):
  if c in consumed or abs(len(c)-len(token))>allowed:continue
  if c in weights and c!=token:[REDACTED_SECRET]
  if not (c[0]==token[0] or c[-1]==token[-1]):continue
  d=ed(token,c,allowed)
  if d is not None and (best is None or d<best[0]):best=(d,c)
 return None if best is None else best[1]
def junk(text):
 no=norm(text)
 phrases=['"'warning','caution','danger','read','manual','instruction','before use','patent','made in','www','.com','serial','s n','capacity','max','maximum','min','lbs','weight stack','assembled','conforms','part no','rev']
 if not no:return True
 if not any(c.isalpha() for c in no):return True
 if any(q in no for q in phrases):return True
 if re.search(r'\\d+\\s?(lb|kg)\\b',no):return True
 return False
def rank(lines,limit=8):
 all_=set(rtoks('\\n'.join(lines)))
 if not all_:return []
 evidence=set(x for line in lines if not junk(line) for x in rtoks(line)) or all_
 ew=sum(w(x) for x in sorted(evidence))
 named={m for m,s in mansets if s<=all_}
 out=[]
 for r,mt,nt,allrow in prepared:
  nametoks=set(nt if nt else allrow); nw=sum(weights.get(x,0) for x in nametoks)
  if nw<=0:continue
  ordered=sorted(allrow,key=lambda x:(-weights.get(x,0),x))
  consumed=set(); covered=explained=0
  for t in ordered:
   wt=w(t); isn=t in nametoks
   if t in all_ and t not in consumed:
    consumed.add(t);covered+=wt if isn else 0;explained+=wt if t in evidence else 0
   else:
    q=near(t,all_,consumed,wt)
    if q:
     consumed.add(q);covered+=wt*.85 if isn else 0;explained+=w(q)*.85 if q in evidence else 0
  cov=covered/nw
  if cov<=0:continue
  exp=min(1,explained/ew) if ew else 0
  matched=bool(mt) and set(x for x in mt if len(x)>1)<=all_
  conflict=bool(named) and r['manufacturer'] not in named
  score=cov*.6+exp*.3+(.1 if matched else 0)
  if conflict:score*=.6
  score=min(1,score)
  if score>=.25:out.append((score,r['manufacturer'],r['modelName'],matched,conflict,r['id']))
 out.sort(key=lambda x:(-x[0],x[1]+' '+x[2],x[5]))
 return out[:limit]
def pre(ms):
 if not ms or ms[0][0]<.85 or not ms[0][3] or ms[0][4]:return None
 if len(ms)>1 and ms[0][0]-ms[1][0]<.08:return None
 return ms[0]
CASES={
'NEWCO pendulum':['NEWCO','PENDULUM SQUAT'],
'MATRIX pendulum':['MATRIX','PENDULUM SQUAT'],
'Atlantis C-227':['ATLANTIS STRENGTH','PLATE LOADED BELT SQUAT','C-227'],
'Nautilus 5':['NAUTILUS','5 STATION'],
'Rogue R-6':['ROGUE FITNESS','R-6 POWER RACK'],
'PRIME 2:1':['PRIME FITNESS','PRODIGY HLP SELECTORIZED RACK 2:1'],
'Insignia back ext':['LIFE FITNESS','INSIGNIA SERIES BACK EXTENSION'],
'two machines':['LIFE FITNESS','INSIGNIA SERIES CHEST PRESS','INSIGNIA SERIES SHOULDER PRESS'],
'hip abduction':['LIFE FITNESS','INSIGNIA SERIES HIP ABDUCTION'],
'Rogue R 6 spaced':['ROGUE FITNESS','R 6 POWER RACK'],
