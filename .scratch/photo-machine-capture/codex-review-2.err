   162	
   163	    /// The best candidate for a model name: the largest non-junk line that is
   164	    /// not just the manufacturer repeated. Falls back to the first usable line,
   165	    /// then to the raw text, because an editable wrong guess beats an empty
   166	    /// field the user has to fill in standing at the machine.
   167	    static func guessModelName(in reading: LabelReading, manufacturer: String?) -> String {
   168	        let manufacturerTokens = Set(readingTokens(manufacturer ?? ""))
   169	        let usable = reading.lines.filter { line in
   170	            guard !isJunkLine(line.text) else { return false }
   171	            let lineTokens = Set(readingTokens(line.text))
   172	            guard !lineTokens.isEmpty else { return false }
   173	            // Drop a line that says nothing but the brand.
   174	            return !manufacturerTokens.isEmpty ? !lineTokens.isSubset(of: manufacturerTokens) : true
   175	        }
   176	        let byPresence = usable.max {
   177	            ($0.heightFraction, $0.confidence) < ($1.heightFraction, $1.confidence)
   178	        }
   179	        return (byPresence ?? usable.first).map { $0.text.trimmed }
   180	            ?? reading.text.trimmed
   181	    }
   182	}
   183	
   184	/// Local convenience only — the codebase's idiom elsewhere is a `trimmedName`
   185	/// computed property per view, and a module-wide `String.trimmed` would be a
   186	/// bigger change than this feature is entitled to make.
   187	private extension String {
   188	    var trimmed: String { trimmingCharacters(in: .whitespacesAndNewlines) }
   189	}

