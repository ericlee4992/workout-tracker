    11	// Photo machine capture, ticket 01 — the one test that runs the whole chain:
    12	// pixels → Vision → matcher → a catalog row. The label is rendered here rather
    13	// than checked in as a photo, so the test is hermetic and the fixture is
    14	// readable in the diff.
    15	//
    16	// Vision itself is Apple's; these tests are not trying to measure it. They are
    17	// checking that this app hands it a sane image, reads its output in the right
    18	// order, and feeds the matcher something it can work with.
    19	
    20	struct MachineLabelOCRTests {
    21	
    22	    /// Draws a name-plate-ish image: brand small on top, model large beneath,
    23	    /// a load rating and a warning in the corner like the real thing.
    24	    private func renderLabel(
    25	        brand: String, model: String, extras: [String] = [],
    26	        size: CGSize = CGSize(width: 1_600, height: 620)
    27	    ) -> CGImage {
    28	        let renderer = UIGraphicsImageRenderer(size: size)
    29	        let image = renderer.image { context in
    30	            UIColor.white.setFill()
    31	            context.fill(CGRect(origin: .zero, size: size))
    32	
    33	            /// Draws centred, shrinking the type until the line fits — a
    34	            /// clipped fixture would test Vision's guess at half a word
    35	            /// rather than this app's handling of a legible plate.
    36	            func draw(_ text: String, y: CGFloat, size fontSize: CGFloat) {
    37	                var font = UIFont.systemFont(ofSize: fontSize, weight: .semibold)
    38	                var string = NSAttributedString(string: text, attributes: [.font: font])
    39	                while string.size().width > size.width - 80, font.pointSize > 12 {
    40	                    font = UIFont.systemFont(ofSize: font.pointSize - 4, weight: .semibold)
    41	                    string = NSAttributedString(string: text, attributes: [.font: font])
    42	                }
    43	                let attributed = NSAttributedString(
    44	                    string: text,
    45	                    attributes: [.font: font, .foregroundColor: UIColor.black])
    46	                attributed.draw(
    47	                    at: CGPoint(x: (size.width - attributed.size().width) / 2, y: y))
    48	            }
    49	
    50	            draw(brand, y: 60, size: 64)
    51	            draw(model, y: 200, size: 96)
    52	            for (index, extra) in extras.enumerated() {
    53	                draw(extra, y: 400 + CGFloat(index) * 60, size: 40)
    54	            }
    55	        }
    56	        return image.cgImage!
    57	    }
    58	
    59	    /// Pixels turned 90° clockwise, with no orientation metadata — the raw
    60	    /// buffer a sideways camera hands over.
    61	    private func rotatedClockwise(_ image: CGImage) -> CGImage {
    62	        let size = CGSize(width: image.height, height: image.width)
    63	        return UIGraphicsImageRenderer(size: size).image { context in
    64	            let cgContext = context.cgContext
    65	            cgContext.translateBy(x: size.width, y: 0)
    66	            cgContext.rotate(by: .pi / 2)
    67	            UIImage(cgImage: image).draw(at: .zero)
    68	        }.cgImage!
    69	    }
