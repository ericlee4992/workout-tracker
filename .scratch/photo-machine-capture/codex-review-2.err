hook: PreToolUse
hook: PreToolUse Completed
exec
/bin/zsh -lc "PYTHONUNBUFFERED=1 python3 - <<'PY'
# Exact port of current matcher; brand+model clean-read corpus sweep only.
import json,math,re,unicodedata
from collections import Counter
rows=json.load(open('WorkoutTracker/Resources/SeedCatalog.json'))['equipmentModels']
def norm(s):s=unicodedata.normalize('NFKD',s).casefold();return ' '.join(''.join(c if c.isalnum() else ' ' for c in s).split())
def t(s):return norm(s).split()
def rt(s):return [x for x in t(s) if len(x)>1 or x[:1].isdigit()]
df=Counter();P=[]
for r in rows:
 m=t(r['manufacturer']);n=sorted(set(t(r['modelName'])));a=sorted(set(m+n));df.update(a);P.append((r,m,n,a))
N=len(rows);W={x:math.log(1+N/(1+f)) for x,f in df.items()};U=math.log(1+N/2);MS=[(m,set(rt(m))) for m in sorted({r['manufacturer'] for r in rows})]
def w(x):return W.get(x,U)
def ed(a,b,L):
 if abs(len(a)-len(b))>L:return None
 q=list(range(len(b)+1))
 for i,x in enumerate(a,1):
  z=[i]+[0]*len(b);lo=i
  for j,y in enumerate(b,1):z[j]=min(q[j-1]+(x"'!=y),q[j]+1,z[j-1]+1);lo=min(lo,z[j])
  if lo>L:return None
  q=z
 return q[-1] if q[-1]<=L else None
def near(x,C,u,wt):
 if wt<1.5 or len(x)<4:return None
 L=2 if len(x)>=7 else 1;b=None
 for c in sorted(C):
  if c in u or abs(len(c)-len(x))>L or (c in W and c!=x) or not(c[0]==x[0] or c[-1]==x[-1]):continue
  d=ed(x,c,L)
  if d is not None and (b is None or d<b[0]):b=(d,c)
 return b[1] if b else None
def rank(r):
 C=set(rt(r['"'manufacturer']+' '+r['modelName']));ew=sum(w(x) for x in sorted(C));named={m for m,s in MS if s<=C};out=[]
 for z,m,n,a in P:
  ns=set(n or a);nw=sum(W.get(x,0) for x in ns);u=set();cv=ex=0
  for x in sorted(a,key=lambda y:(-W.get(y,0),y)):
   wx=w(x);isn=x in ns
   if x in C and x not in u:u.add(x);cv+=wx if isn else 0;ex+=wx
   else:
    q=near(x,C,u,wx)
    if q:u.add(q);cv+=wx*.85 if isn else 0;ex+=w(q)*.85
  if not cv:continue
  matched=bool(m) and set(x for x in m if len(x)>1)<=C;conflict=bool(named) and z['manufacturer'] not in named
  s=.6*cv/nw+.3*min(1,ex/ew)+(.1 if matched else 0);s*=.6 if conflict else 1
  if s>=.25:out.append((min(1,s),z['manufacturer'],z['modelName'],matched,conflict,z['id']))
 return sorted(out,key=lambda x:(-x[0],x[1]+' '+x[2],x[5]))[:8]
right=wrong=none=top=0;R=Counter();samples=[];wrongs=[]
for i,r in enumerate(rows):
 ms=rank(r);p=None
 if ms and ms[0][0]>=.85 and ms[0][3] and not ms[0][4] and (len(ms)<2 or ms[0][0]-ms[1][0]>=.08):p=ms[0]
 top+=bool(ms and ms[0][5]==r['id'])
 if p is None:
  none+=1
  if not ms:k='no candidates'
  elif ms[0][0]<.85:k='score'
  elif not ms[0][3]:k='manufacturer not matched'
  elif ms[0][4]:k='conflict'
  elif len(ms)>1 and ms[0][0]-ms[1][0]<.08:k='margin'
  else:k='other'
  R[k]+=1
  if len(samples)<30:samples.append((r,ms,k))
 elif p[5]==r['id']:right+=1
 else:wrong+=1;wrongs.append((r,ms,p))
print(f'BRAND+MODEL total={N} top-right={top} pre-right={right} pre-wrong={wrong} no-pre={none} fraction={right/N:.9f} reasons={dict(R)}')
print('SAMPLE FAILURES')
for r,ms,k in samples:print(k,'|',r['manufacturer'],'|',r['modelName'],'=>','NONE' if not ms else f'{ms[0][0]:.9f} {ms[0][1]} {ms[0][2]} gap '+(f'{ms[0][0]-ms[1][0]:.9f}' if len(ms)>1 else 'inf'))
print('WRONG PRESELECTIONS',len(wrongs))
for r,ms,p in wrongs:print(r['manufacturer'],'|',r['modelName'],'=>',p[:5])
# conflict anomalies & lone letter identities
inc=[]
for r in rows:
 named={m for m,s in MS if s<=set(rt(r['manufacturer']+' '+r['modelName']))}
 if named"'!={r['"'manufacturer']}:inc.append((r,named))
print('NAMED ANOMALIES',len(inc))
for r,x in inc:print(r['manufacturer'],'|',r['modelName'],'=>',sorted(x))
single=[]
for r in rows:
 one=[x for x in t(r['modelName']) if len(x)==1 and x.isalpha()]
 if one:single.append((r,one))
print('LONE LETTER ROWS',len(single))
for r,x in single:print(r['manufacturer'],'|',r['modelName'],'=>',x)
