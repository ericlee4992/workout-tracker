/bin/zsh -lc "python3 - <<'PY'
import json,math,re,unicodedata,itertools
from collections import Counter
rows=json.load(open('WorkoutTracker/Resources/SeedCatalog.json'))['equipmentModels']
def n(s):return ' '.join(''.join(c if c.isalnum() else ' ' for c in unicodedata.normalize('NFKD',s).casefold()).split())
def t(s):return n(s).split()
def ed(a,b):
 p=list(range(len(b)+1))
 for i,x in enumerate(a,1):
  q=[i]+[0]*len(b)
  for j,y in enumerate(b,1):q[j]=min(p[j-1]+(x"'!=y),p[j]+1,q[j-1]+1)
  p=q
 return p[-1]
df=Counter()
for r in rows:df.update(set(t(r['"'manufacturer'])+t(r['modelName'])))
N=len(rows);w={x:math.log(1+N/(1+f)) for x,f in df.items()}
# Nearby manufacturer/model token pairs, potential greedy manufacturer theft.
out=[]
for r in rows:
 for m,x in itertools.product(set(t(r['manufacturer'])),set(t(r['modelName']))):
  d=ed(m,x)
  if len(m)>=4 and len(x)>=4 and d<=4 and (m[0]==x[0] or m[-1]==x[-1]) and w[m]>w[x]:out.append((d,w[m]-w[x],r['manufacturer'],r['modelName'],m,x,w[m],w[x]))
print('manufacturer/name near pairs',len(out))
for z in sorted(out)[:100]:print(z)
