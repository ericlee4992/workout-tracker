     4	@testable import WorkoutTracker
     5	
     6	// Photo machine capture — the negatives, replayed against the **shipped**
     7	// 1877-row catalog rather than a six-row fixture.
     8	//
     9	// Every case here was found by the first Codex cross-review
    10	// (`.scratch/photo-machine-capture/codex-review.md`), and every one of them
    11	// preselected a confidently wrong catalog UUID before the fixes: a plate saying
    12	// NEWCO matched Nautilus at 0.97, `NAUTILUS 5 STATION` tied 4/5/9 Station at
    13	// 1.00, and a photo of a Hip Abduction machine also scored Hip Adduction at
    14	// 1.00. That is the D23 history-splitting failure D33 exists to prevent, so
    15	// these run against the real corpus where the sibling rows actually live.
    16	
    17	struct CatalogMatcherAdversarialTests {
    18	
    19	    private func realIndex() throws -> CatalogMatchIndex {
    20	        CatalogMatchIndex(models: try SeedCatalog.bundled().equipmentModels.map {
    21	            (id: $0.id, manufacturer: $0.manufacturer, modelName: $0.modelName)
    22	        })
    23	    }
    24	
    25	    private func rank(_ lines: [String], in index: CatalogMatchIndex) -> [CatalogMatch] {
    26	        CatalogMatcher.rank(LabelReading.lines(lines), in: index, limit: 8)
    27	    }
    28	
    29	    private func describe(_ matches: [CatalogMatch]) -> String {
    30	        matches.prefix(3)
    31	            .map { "\($0.displayName) \(String(format: "%.2f", $0.score))" }
    32	            .joined(separator: " | ")
    33	    }
    34	
    35	    // MARK: - A brand the catalog does not know
    36	
    37	    /// An unlisted manufacturer whose machine shares a generic name with a
    38	    /// catalog row. "NEWCO" is the most informative word on that plate; before
    39	    /// the fix it weighed nothing, and Nautilus Pendulum Squat scored 0.97.
    40	    @Test func anUnknownBrandDoesNotBorrowAnotherMakersRow() throws {
    41	        let index = try realIndex()
    42	        let matches = rank(["NEWCO", "PENDULUM SQUAT"], in: index)
    43	        #expect(
    44	            CatalogMatcher.preselection(from: matches) == nil,
    45	            "preselected on an unknown brand: \(describe(matches))")
    46	    }
    47	
    48	    /// A brand the catalog *does* know, on a machine it does not list under
