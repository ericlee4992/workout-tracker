    29	    let score: Double
    30	    /// The plate names this row's manufacturer.
    31	    let manufacturerMatched: Bool
    32	    /// The plate names a *different* known manufacturer.
    33	    let manufacturerConflicts: Bool
    34	
    35	    var displayName: String { "\(manufacturer) \(modelName)" }
    36	}
    37	
    38	/// The catalog, prepared for matching: tokens per row plus the IDF weight of
    39	/// every token across the whole catalog.
    40	///
    41	/// Weights are a property of the corpus, not of any one row: "series" and
    42	/// "press" appear in hundreds of names and say almost nothing, while
    43	/// "insignia", "sorinex" or "vsl019bp" nearly identify a row on their own. Term
    44	/// frequency does that arithmetic for us instead of a hand-written stop-word
    45	/// list that would need updating with the catalog.
    46	struct CatalogMatchIndex {
    47	
    48	    struct Entry {
    49	        let id: UUID
    50	        let manufacturer: String
    51	        let modelName: String
    52	        /// Everything the row says, manufacturer included, weight-descending so
    53	        /// scoring consumes the most distinctive evidence first.
    54	        let tokens: [String]
    55	        let manufacturerTokens: [String]
    56	        /// The model-name tokens alone. Coverage is measured over *these*: the
    57	        /// brand is already worth its own bonus, and counting it twice let
    58	        /// "Insignia Series Row" score 86% on a plate that plainly said Chest
    59	        /// Press, purely because it shared "Life Fitness Insignia Series".
    60	        let nameTokens: Set<String>
    61	        /// Σ weight over `nameTokens` — the denominator for coverage.
    62	        let nameWeight: Double
    63	    }
    64	
    65	    private(set) var entries: [Entry] = []
    66	    private(set) var weights: [String: Double] = [:]
    67	    /// Weight given to a word the catalog has never seen. Such a word is
    68	    /// maximally distinctive — "NEWCO" on a plate is the single most
