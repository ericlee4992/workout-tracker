     1	import CoreGraphics
     2	import CoreImage
     3	import Foundation
     4	import UIKit
     5	import Vision
     6	
     7	// Photo machine capture, ticket 01 — the camera-facing half: a photograph in, a
     8	// `LabelReading` out.
     9	//
    10	// Lives in `Features/Gyms` rather than `Domain/`: it orchestrates a platform
    11	// framework and speaks `UIImage`, while `Domain/` is value types and pure logic
    12	// (CLAUDE.md, and codex-review finding 12). `LabelReading` and the matcher stay
    13	// in Domain, where they can be tested without a camera.
    14	//
    15	// Vision's text recognition is on device and offline, which is the only kind
    16	// that works in a basement gym and the only kind that keeps a photo of the
    17	// user's gym from leaving their phone (D34). It also costs no dependency, which
    18	// the project's no-third-party rule requires.
    19	
    20	enum MachineLabelOCR {
    21	
    22	    enum Failure: Error, LocalizedError {
    23	        case unreadableImage
    24	        case recognitionFailed(underlying: Error)
    25	        case noTextFound
    26	
    27	        var errorDescription: String? {
    28	            switch self {
    29	            case .unreadableImage:
    30	                "That photo could not be opened."
    31	            case .recognitionFailed(let underlying):
    32	                "Could not read the photo: \(underlying.localizedDescription)"
    33	            case .noTextFound:
    34	                "No text found in that photo."
    35	            }
    36	        }
    37	    }
    38	
    39	    /// Reads a photograph as the user took it, off the main actor.
    40	    ///
    41	    /// Orientation matters twice over: Vision reads rotated text far worse than
    42	    /// upright text, and this app orders lines by their vertical position to
    43	    /// decide which one is the brand. A camera image is almost never `.up`
    44	    /// (codex-review, finding 5).
    45	    static func read(_ image: UIImage) async throws -> LabelReading {
    46	        guard let cgImage = cgImage(from: image) else { throw Failure.unreadableImage }
    47	        return try await read(cgImage, orientation: orientation(of: image))
    48	    }
    49	
    50	    static func read(
    51	        _ image: CGImage, orientation: CGImagePropertyOrientation = .up
    52	    ) async throws -> LabelReading {
    53	        let reading = try await Task.detached(priority: .userInitiated) {
    54	            try perform(image, orientation: orientation)
    55	        }.value
    56	        guard !reading.isEmpty else { throw Failure.noTextFound }
    57	        return reading
    58	    }
    59	
    60	    /// Synchronous recognition. Separated so tests can call it directly on a
    61	    /// rendered fixture without an async hop.
    62	    static func perform(
    63	        _ image: CGImage, orientation: CGImagePropertyOrientation = .up
    64	    ) throws -> LabelReading {
    65	        let request = VNRecognizeTextRequest()
    66	        request.recognitionLevel = .accurate
    67	        // Off deliberately: "Insignia", "Cybex", "Hammer Strength" and
    68	        // "VSL019BP" are not dictionary words, and correction rewrites exactly
    69	        // the distinctive tokens the matcher depends on.
    70	        request.usesLanguageCorrection = false
    71	        request.recognitionLanguages = ["en-US"]
    72	
    73	        let handler = VNImageRequestHandler(cgImage: image, orientation: orientation, options: [:])
    74	        do {
    75	            try handler.perform([request])
    76	        } catch {
    77	            throw Failure.recognitionFailed(underlying: error)
    78	        }
    79	
    80	        // Each line keeps its own box, so the sort below cannot drift out of
    81	        // step with the text the way zipping two separately-filtered arrays
    82	        // would.
    83	        let lines = (request.results ?? []).compactMap {
    84	            observation -> (line: LabelReading.Line, top: CGFloat)? in
    85	            guard let candidate = observation.topCandidates(1).first else { return nil }
    86	            let text = candidate.string.trimmingCharacters(in: .whitespacesAndNewlines)
    87	            guard !text.isEmpty else { return nil }
    88	            return (
    89	                LabelReading.Line(
    90	                    text: text,
    91	                    confidence: Double(candidate.confidence),
    92	                    heightFraction: Double(observation.boundingBox.height)),
    93	                observation.boundingBox.maxY)
    94	        }
    95	        // Vision's origin is bottom-left, and its boxes are already expressed in
    96	        // the *oriented* image's coordinates, so "top of the plate" is the
    97	        // largest maxY. Order matters to the manufacturer guess, which trusts
    98	        // the brand line when the catalog does not recognise the brand.
    99	        return LabelReading(lines: lines.sorted { $0.top > $1.top }.map(\.line))
   100	    }
   101	
   102	    // MARK: - Getting pixels out of a UIImage
   103	
   104	    /// A `UIImage` from the photo library can be backed by a `CIImage` (a HEIC
   105	    /// or an edited photo) and have no `cgImage` at all. Rendering it is a few
   106	    /// lines; calling it unreadable would have been a lie.
   107	    private static func cgImage(from image: UIImage) -> CGImage? {
   108	        if let cgImage = image.cgImage { return cgImage }
   109	        if let ciImage = image.ciImage {
   110	            return CIContext().createCGImage(ciImage, from: ciImage.extent)
   111	        }
   112	        // Last resort: redraw it. Costs a copy, works for anything UIKit can
   113	        // display.
   114	        let format = UIGraphicsImageRendererFormat.default()
   115	        format.scale = image.scale
   116	        return UIGraphicsImageRenderer(size: image.size, format: format)
   117	            .image { _ in image.draw(at: .zero) }
   118	            .cgImage
   119	    }
   120	
   121	    private static func orientation(of image: UIImage) -> CGImagePropertyOrientation {
   122	        // A redrawn image (the fallback above) is already upright.
   123	        guard image.cgImage != nil || image.ciImage != nil else { return .up }
   124	        return CGImagePropertyOrientation(image.imageOrientation)
   125	    }
   126	}
