     1	import AVFoundation
     2	import SwiftUI
     3	import UIKit
     4	
     5	/// What this device and its permissions will actually allow, resolved *before*
     6	/// anything is presented.
     7	///
     8	/// Ticket 02 asks for a stated reason and a way forward in every case; silently
     9	/// swapping the camera for the photo library (or handing a denied permission to
    10	/// `UIImagePickerController` and hoping) is neither (codex-review, finding 6).
    11	enum CaptureAvailability: Equatable {
    12	    /// Camera present and usable — `.notDetermined` counts: presenting is what
    13	    /// triggers the system prompt, which is the correct first ask.
    14	    case camera
    15	    /// No camera on this device (Simulator, or a restricted iPad).
    16	    case noCamera
    17	    /// The user or a policy has turned camera access off.
    18	    case cameraDenied
    19	
    20	    static func resolve(
    21	        hasCamera: Bool = UIImagePickerController.isSourceTypeAvailable(.camera),
    22	        status: AVAuthorizationStatus = AVCaptureDevice.authorizationStatus(for: .video)
    23	    ) -> CaptureAvailability {
    24	        guard hasCamera else { return .noCamera }
    25	        switch status {
    26	        case .authorized, .notDetermined: return .camera
    27	        case .denied, .restricted: return .cameraDenied
    28	        @unknown default: return .cameraDenied
    29	        }
    30	    }
    31	
    32	    /// What to tell the user, or nil when the camera simply works.
    33	    var reason: String? {
    34	        switch self {
    35	        case .camera: nil
    36	        case .noCamera: "This device has no camera — pick a photo of the name plate instead."
    37	        case .cameraDenied:
    38	            "Camera access is off for Workout Tracker. Turn it on in Settings, or pick a photo you already took."
    39	        }
    40	    }
    41	}
    42	
    43	/// Photo machine capture, ticket 02 — a photograph of a name plate, from the
    44	/// camera or the photo library.
    45	///
    46	/// `UIImagePickerController` rather than `PhotosPicker`, because this needs the
    47	/// *camera* and PhotosPicker cannot take one; the same controller covers the
    48	/// library fallback, so there is one presentation path instead of two.
    49	struct ImagePicker: UIViewControllerRepresentable {
    50	    enum Source {
    51	        case camera
    52	        case photoLibrary
    53	
    54	        /// The camera when `CaptureAvailability` says it will work, otherwise
    55	        /// the photo library — a photo taken earlier is a perfectly good input.
    56	        /// The *reason* for a fallback is shown by the sheet; this only picks.
    57	        static func preferred(
    58	            given availability: CaptureAvailability = .resolve()
    59	        ) -> Source {
    60	            availability == .camera ? .camera : .photoLibrary
    61	        }
    62	
    63	        var sourceType: UIImagePickerController.SourceType {
    64	            switch self {
    65	            case .camera: .camera
    66	            case .photoLibrary: .photoLibrary
    67	            }
    68	        }
    69	    }
    70	
    71	    let source: Source
    72	    /// nil = the user backed out.
    73	    let onPicked: (UIImage?) -> Void
    74	
    75	    func makeUIViewController(context: Context) -> UIImagePickerController {
    76	        let controller = UIImagePickerController()
    77	        controller.sourceType = source.sourceType
    78	        controller.allowsEditing = false
    79	        controller.delegate = context.coordinator
    80	        return controller
    81	    }
    82	
    83	    func updateUIViewController(_ controller: UIImagePickerController, context: Context) {}
    84	
    85	    func makeCoordinator() -> Coordinator {
    86	        Coordinator(onPicked: onPicked)
    87	    }
    88	
    89	    final class Coordinator: NSObject, UIImagePickerControllerDelegate,
    90	                             UINavigationControllerDelegate {
    91	        private let onPicked: (UIImage?) -> Void
    92	        /// The delegate can fire twice if the user is quick; the reading is
    93	        /// started from this callback, so it must happen exactly once.
    94	        private var hasFinished = false
    95	
    96	        init(onPicked: @escaping (UIImage?) -> Void) {
    97	            self.onPicked = onPicked
    98	        }
    99	
   100	        func imagePickerController(
   101	            _ picker: UIImagePickerController,
   102	            didFinishPickingMediaWithInfo info: [UIImagePickerController.InfoKey: Any]
   103	        ) {
   104	            finish(with: info[.originalImage] as? UIImage)
   105	        }
   106	
   107	        func imagePickerControllerDidCancel(_ picker: UIImagePickerController) {
   108	            finish(with: nil)
   109	        }
   110	
   111	        private func finish(with image: UIImage?) {
   112	            guard !hasFinished else { return }
   113	            hasFinished = true
   114	            onPicked(image)
   115	        }
   116	    }
   117	}

