   101	        let weightTable = weights
   102	        let weightOf: (String) -> Double = { weightTable[$0] ?? 0 }
   103	        entries = tokenised.map { row in
   104	            // A name that is nothing but the brand ("Cybex" by "Cybex") would
   105	            // have no denominator; fall back to everything the row says.
   106	            let nameTokens = row.nameTokens.isEmpty ? row.tokens : row.nameTokens
   107	            return Entry(
   108	                id: row.id, manufacturer: row.manufacturer, modelName: row.modelName,
   109	                // Deterministic order regardless of hash seed: weight, then
   110	                // the token itself (codex-review, finding 7).
   111	                tokens: row.tokens.sorted {
   112	                    weightOf($0) == weightOf($1) ? $0 < $1 : weightOf($0) > weightOf($1)
   113	                },
   114	                manufacturerTokens: row.manufacturerTokens,
   115	                nameTokens: Set(nameTokens),
   116	                nameWeight: nameTokens.reduce(0) { $0 + weightOf($1) })
   117	        }
   118	        manufacturers = Array(Set(models.map(\.manufacturer)))
   119	            .filter { !$0.trimmingCharacters(in: .whitespaces).isEmpty }
   120	            .sorted()
   121	        manufacturerTokenSets = manufacturers.compactMap { name in
   122	            let tokens = Set(MachineLabelText.readingTokens(name))
   123	            return tokens.isEmpty ? nil : (name, tokens)
   124	        }
   125	    }
   126	
   127	    /// IDF weight, with unseen words treated as maximally distinctive.
   128	    func weight(_ token: String) -> Double { weights[token] ?? unknownTokenWeight }
   129	
   130	    /// Whether the catalog knows this word at all.
   131	    func isKnown(_ token: String) -> Bool { weights[token] != nil }
   132	
   133	    /// Manufacturers the plate names outright.
   134	    func manufacturersNamed(in readingTokens: Set<String>) -> Set<String> {
   135	        Set(manufacturerTokenSets
   136	            .filter { $0.tokens.isSubset(of: readingTokens) }
   137	            .map(\.name))
   138	    }
   139	}
   140	
   141	enum CatalogMatcher {
   142	
   143	    /// At or above this a row *may* be preselected — see `preselection`, which
   144	    /// also demands a named manufacturer and a clear margin. Still shown, still
   145	    /// confirmed by a tap (D33), never applied behind the user's back.
   146	    static let confidentScore = 0.85
   147	    /// Below this, the sheet leads with "create new": the catalog probably does
   148	    /// not have this machine, and offering a 30%-sure row as the answer invites
   149	    /// the wrong tap.
   150	    static let createNewBelow = 0.35
   151	    /// Weak candidates are still worth listing; noise is not.
   152	    static let candidateFloor = 0.25
   153	    /// How far the top row must stand clear of the runner-up to be preselected.
   154	    /// A photograph taken between two stations, or a short catalog name that is
   155	    /// a prefix of a longer one, produces near-ties — and a near-tie resolved
   156	    /// by lexical order is a coin flip on the user's history.
   157	    static let preselectionMargin = 0.08
   158	
   159	    /// Candidates for `reading`, best first. Deterministic: ties break by score,
   160	    /// then display name, then id, so the same photo always ranks the same way.
   161	    static func rank(
   162	        _ reading: LabelReading, in index: CatalogMatchIndex, limit: Int = 5
   163	    ) -> [CatalogMatch] {
   164	        // Matching sees the whole plate — a code in a line that reads as
   165	        // furniture ("VSL019BP") is still evidence. *Explanation* is measured
   166	        // only over the lines that claim to name the machine, so warnings and
   167	        // load ratings cannot make every row look unexplanatory.
   168	        let allTokens = Set(MachineLabelText.readingTokens(reading.text))
   169	        guard !allTokens.isEmpty else { return [] }
   170	        let evidenceTokens = Set(reading.lines
   171	            .filter { !MachineLabelText.isJunkLine($0.text) }
   172	            .flatMap { MachineLabelText.readingTokens($0.text) })
   173	        let evidence = evidenceTokens.isEmpty ? allTokens : evidenceTokens
   174	        // Summed in sorted order: floating-point addition is not associative,
   175	        // and a `Set`'s iteration order changes with the hash seed, so an
   176	        // unsorted reduction made scores differ in the last bit between runs
   177	        // (codex-review, finding 7).
   178	        let evidenceWeight = evidence.sorted().reduce(0.0) { $0 + index.weight($1) }
   179	        let namedManufacturers = index.manufacturersNamed(in: allTokens)
   180	
   181	        var matches: [CatalogMatch] = []
   182	        for entry in index.entries where entry.nameWeight > 0 {
   183	            guard let match = score(
   184	                entry, allTokens: allTokens, evidence: evidence,
   185	                evidenceWeight: evidenceWeight,
   186	                namedManufacturers: namedManufacturers, index: index)
   187	            else { continue }
   188	            matches.append(match)
   189	        }
   190	
   191	        return matches
   192	            .sorted { lhs, rhs in
   193	                if lhs.score != rhs.score { return lhs.score > rhs.score }
   194	                if lhs.displayName != rhs.displayName { return lhs.displayName < rhs.displayName }
   195	                return lhs.modelID.uuidString < rhs.modelID.uuidString
   196	            }
   197	            .prefix(limit)
   198	            .map { $0 }
   199	    }
   200	
   201	    /// The row to preselect, or nil when the app should not put its thumb on
   202	    /// the scale (D33). Three conditions, each closing a way to be confidently
   203	    /// wrong: a strong score, a manufacturer the plate actually names, and
   204	    /// daylight between first and second.
   205	    static func preselection(from matches: [CatalogMatch]) -> CatalogMatch? {
   206	        guard let best = matches.first, best.score >= confidentScore else { return nil }
   207	        guard best.manufacturerMatched, !best.manufacturerConflicts else { return nil }
   208	        if matches.count > 1, best.score - matches[1].score < preselectionMargin { return nil }
   209	        return best
   210	    }
   211	
   212	    /// Whether the sheet should lead with creating a model instead.
   213	    static func suggestsCreatingNew(_ matches: [CatalogMatch]) -> Bool {
   214	        (matches.first?.score ?? 0) < createNewBelow
   215	    }
   216	
   217	    // MARK: - Scoring one row
   218	
   219	    private static func score(
   220	        _ entry: CatalogMatchIndex.Entry,
   221	        allTokens: Set<String>,
   222	        evidence: Set<String>,
   223	        evidenceWeight: Double,
   224	        namedManufacturers: Set<String>,
   225	        index: CatalogMatchIndex
   226	    ) -> CatalogMatch? {
   227	        // One reading word may serve as evidence for exactly one catalog word.
   228	        // Without this, "abduction" covered both `Hip Abduction` and — through
   229	        // a one-edit slip — `Hip Adduction`, tying two distinct machines at
   230	        // 1.00 (codex-review, finding 4).
   231	        var consumed: Set<String> = []
   232	        var covered = 0.0
   233	        var explained = 0.0
   234	
   235	        for token in entry.tokens {  // weight-descending, so distinctive first
   236	            let weight = index.weight(token)
   237	            let isNameToken = entry.nameTokens.contains(token)
   238	            if allTokens.contains(token), !consumed.contains(token) {
   239	                consumed.insert(token)
   240	                if isNameToken { covered += weight }
   241	                if evidence.contains(token) { explained += weight }
   242	            } else if let near = nearestToken(
   243	                to: token, in: allTokens, excluding: consumed, weight: weight, index: index) {
   244	                consumed.insert(near)
   245	                // Fuzzy evidence is discounted: it is a guess about what the
   246	                // camera saw, not something it read.
   247	                if isNameToken { covered += weight * 0.85 }
   248	                if evidence.contains(near) { explained += index.weight(near) * 0.85 }
   249	            }
   250	        }
   251	
   252	        let coverage = covered / entry.nameWeight
   253	        guard coverage > 0 else { return nil }
   254	        // What share of what the plate *claims about this machine* the row
   255	        // accounts for. This is what stops a short generic row ("Back
   256	        // Extension") from fully explaining a plate that also said "Insignia
   257	        // Series", and what makes an unknown brand cost a row real points.
   258	        let explanation = evidenceWeight > 0 ? min(1, explained / evidenceWeight) : 0
   259	
   260	        let manufacturerMatched = !entry.manufacturerTokens.isEmpty
   261	            && Set(entry.manufacturerTokens.filter { $0.count > 1 }).isSubset(of: allTokens)
   262	        let conflicts = !namedManufacturers.isEmpty
   263	            && !namedManufacturers.contains(entry.manufacturer)
   264	
   265	        var score = coverage * 0.60 + explanation * 0.30 + (manufacturerMatched ? 0.10 : 0)
   266	        if conflicts {
   267	            // The plate names someone else's brand. Whatever the words say,
   268	            // this is not that machine — it is at best a hint about what the
   269	            // machine resembles.
   270	            score *= 0.6
   271	        }
   272	        score = min(1, score)
   273	        guard score >= candidateFloor else { return nil }
   274	        return CatalogMatch(
   275	            modelID: entry.id, manufacturer: entry.manufacturer,
   276	            modelName: entry.modelName, score: score,
   277	            manufacturerMatched: manufacturerMatched,
   278	            manufacturerConflicts: conflicts)
   279	    }
   280	
   281	    // MARK: - Fuzzy token matching
   282	
   283	    /// A reading token within OCR-slip distance of `token`, or nil.
   284	    ///
   285	    /// Refuses to pair two words the catalog both knows: "adduction" is not a
   286	    /// misreading of "abduction", it is a different machine. Only worth trying
   287	    /// for tokens that carry weight — a near-miss on "series" buys nothing.
   288	    private static func nearestToken(
   289	        to token: String, in candidates: Set<String>, excluding consumed: Set<String>,
   290	        weight: Double, index: CatalogMatchIndex
   291	    ) -> String? {
   292	        guard weight >= 1.5, token.count >= 4 else { return nil }
   293	        let allowed = token.count >= 7 ? 2 : 1
   294	        var best: (token: String, distance: Int)?
   295	        // Sorted so the choice cannot depend on the hash seed
   296	        // (codex-review, finding 7).
   297	        for candidate in candidates.sorted() where !consumed.contains(candidate) {
   298	            guard abs(candidate.count - token.count) <= allowed else { continue }
   299	            // Both words are in the catalog's vocabulary: they are two real
   300	            // names, not one name misread.
   301	            guard !index.isKnown(candidate) || candidate == token else { continue }
   302	            // OCR mangles the middle of a word far more often than both ends.
   303	            guard candidate.first == token.first || candidate.last == token.last else { continue }
   304	            guard let distance = editDistance(token, candidate, limit: allowed) else { continue }
   305	            if distance < (best?.distance ?? Int.max) {
   306	                best = (candidate, distance)
   307	            }
   308	        }
   309	        return best?.token
   310	    }
   311	
   312	    /// Levenshtein distance, abandoned as soon as it exceeds `limit` (which is
   313	    /// what makes it cheap enough to run against a 1877-row catalog inline).
   314	    static func editDistance(_ lhs: String, _ rhs: String, limit: Int) -> Int? {
   315	        if lhs == rhs { return 0 }
   316	        let left = Array(lhs), right = Array(rhs)
   317	        if abs(left.count - right.count) > limit { return nil }
   318	
   319	        var previous = Array(0...right.count)
   320	        var current = [Int](repeating: 0, count: right.count + 1)
     1	import Foundation
     2	
     3	// Photo machine capture, ticket 01 — what a name plate said, and how to read
     4	// meaning out of it. Pure: no UI, no SwiftData, no Vision.
     5	//
     6	// `MachineLabelOCR` produces a `LabelReading`; `CatalogMatcher` ranks the
     7	// catalog against it; the create-new path uses the guesses at the bottom of
     8	// this file. Everything here is text handling, so everything here is testable
     9	// without a camera.
    10	
    11	/// One photographed label, as text.
    12	struct LabelReading: Equatable {
    13	
    14	    /// A single recognised line, top of the plate first.
    15	    struct Line: Equatable {
    16	        var text: String
    17	        /// Vision's own confidence, 0–1.
    18	        var confidence: Double
    19	        /// Line height as a fraction of the image. The model name is almost
    20	        /// always the biggest text on a name plate and the manufacturer sits
    21	        /// above it in smaller type, so size is a real signal about which line
    22	        /// is which — more reliable than position alone.
    23	        var heightFraction: Double
    24	
    25	        init(text: String, confidence: Double = 1, heightFraction: Double = 0) {
    26	            self.text = text
    27	            self.confidence = confidence
    28	            self.heightFraction = heightFraction
    29	        }
    30	    }
    31	
    32	    var lines: [Line] = []
    33	
    34	    var isEmpty: Bool { lines.allSatisfy { $0.text.trimmed.isEmpty } }
    35	
    36	    /// The whole plate as the user will see it echoed back in the sheet.
    37	    var text: String {
    38	        lines.map(\.text).joined(separator: "\n")
    39	    }
    40	
    41	    static func lines(_ texts: [String]) -> LabelReading {
    42	        LabelReading(lines: texts.map { Line(text: $0) })
    43	    }
    44	}
    45	
    46	// MARK: - Normalisation
    47	
    48	enum MachineLabelText {
    49	
    50	    /// Case-folded, diacritic-free, punctuation-free, single-spaced.
    51	    ///
    52	    /// Name plates are shouted in capitals, sometimes stylised
    53	    /// (`LIFE FITNESS®`, `Hammer Strength™`), and Vision reproduces whatever
    54	    /// it sees. Comparison happens in one flat form or not at all.
    55	    static func normalized(_ text: String) -> String {
    56	        let folded = text.folding(options: [.diacriticInsensitive, .caseInsensitive, .widthInsensitive],
    57	                                  locale: Locale(identifier: "en_US_POSIX"))
    58	        let scalars = folded.unicodeScalars.map { scalar -> Character in
    59	            CharacterSet.alphanumerics.contains(scalar) ? Character(scalar) : " "
    60	        }
    61	        return String(scalars)
    62	            .split(separator: " ", omittingEmptySubsequences: true)
    63	            .joined(separator: " ")
    64	    }
    65	
    66	    /// Normalised tokens of a **catalog row**. Nothing is dropped: shipped
    67	    /// identities turn on single characters — `4 Station` vs `5 Station`,
    68	    /// `R-4` vs `R-6`, PRIME's `2:1` vs `4:1`. Filtering them made distinct
    69	    /// catalog UUIDs indistinguishable, which is the D23 history-splitting
    70	    /// failure in its purest form (codex-review, finding 2).
    71	    static func tokens(_ text: String) -> [String] {
    72	        normalized(text)
    73	            .split(separator: " ")
    74	            .map(String.init)
    75	    }
    76	
    77	    /// Normalised tokens of a **photograph**. Same as `tokens`, minus lone
    78	    /// letters: a bracket edge or a logo fragment read as a stray `I` is noise,
    79	    /// and a one-letter false hit against a rare catalog token is expensive.
    80	    /// Lone *digits* stay — `5` in `NAUTILUS 5 STATION` is the whole answer.
    81	    static func readingTokens(_ text: String) -> [String] {
    82	        tokens(text).filter { $0.count > 1 || $0.first?.isNumber == true }
    83	    }
    84	
    85	    // MARK: Junk lines
    86	
    87	    /// Phrases that appear on name plates and never in a model name.
    88	    private static let junkPhrases = [
    89	        "warning", "caution", "danger", "read", "manual", "instruction",
    90	        "before use", "patent", "made in", "www", ".com", "serial", "s n",
    91	        "capacity", "max", "maximum", "min", "lbs", "weight stack",
    92	        "assembled", "conforms", "part no", "rev",
    93	    ]
    94	
    95	    /// Whether a line is plate furniture rather than the hardware's name:
    96	    /// load ratings, warnings, URLs, part numbers, pure digits.
    97	    ///
    98	    /// Used only for *guessing* what to call a new model. Matching keeps these
    99	    /// lines, because a line the eye reads as junk sometimes carries the one
   100	    /// token that identifies the row — Precor's catalogue names really do
   101	    /// include codes like `VSL019BP`.
   102	    static func isJunkLine(_ text: String) -> Bool {
   103	        let normalized = normalized(text)
   104	        guard !normalized.isEmpty else { return true }
   105	        // No letters at all: a number, a date, a stack rating.
   106	        if !normalized.contains(where: \.isLetter) { return true }
   107	        if junkPhrases.contains(where: { normalized.contains($0) }) { return true }
   108	        // "300 lb" / "150kg" style ratings.
   109	        if normalized.range(of: #"\d+\s?(lb|kg)\b"#, options: .regularExpression) != nil {
   110	            return true
   111	        }
   112	        return false
   113	    }
   114	
   115	    // MARK: Guessing a name for a new model (D35)
   116	
   117	    /// The manufacturer the plate names, in the catalog's own spelling when the
   118	    /// catalog knows it.
   119	    ///
   120	    /// Canonical spelling matters: a user-created model that says
   121	    /// `LIFE FITNESS` sorts and reads as a different brand from the 200 seeded
   122	    /// rows that say `Life Fitness`, for no reason the user would accept.
   123	    static func guessManufacturer(
   124	        in reading: LabelReading, knownManufacturers: [String]
   125	    ) -> String? {
   126	        let brandLine = reading.lines.first { !isJunkLine($0.text) }
   127	
   128	        // Longest match first: "Hammer Strength" must beat "Hammer".
   129	        let ranked = knownManufacturers
   130	            .sorted { lhs, rhs in
   131	                let left = tokens(lhs).count, right = tokens(rhs).count
   132	                return left == right ? lhs < rhs : left > right
   133	            }
   134	
   135	        func knownBrand(in text: String) -> String? {
   136	            let candidates = Set(readingTokens(text))
   137	            guard !candidates.isEmpty else { return nil }
   138	            return ranked.first { manufacturer in
   139	                let needed = Set(readingTokens(manufacturer))
   140	                return !needed.isEmpty && needed.isSubset(of: candidates)
   141	            }
   142	        }
   143	
   144	        // The brand line first (codex-review, finding 9). Scanning the whole
   145	        // photo lets a *neighbouring* machine's brand — or a brand word printed
   146	        // in a warning — overwrite a genuinely new manufacturer's name.
   147	        if let brandLine, let known = knownBrand(in: brandLine.text) { return known }
   148	
   149	        // Then the rest of the plate, but only when exactly one known brand
   150	        // appears in it: two brands in one photograph is a photograph of two
   151	        // machines, and guessing between them is worse than not guessing.
   152	        let elsewhere = reading.lines
   153	            .filter { !isJunkLine($0.text) && $0.text != brandLine?.text }
   154	            .compactMap { knownBrand(in: $0.text) }
   155	        if Set(elsewhere).count == 1, let only = elsewhere.first { return only }
   156	
   157	        // Nothing known: the brand is conventionally the top line of a plate,
   158	        // as long as that line is not furniture. Preserved verbatim — a new
   159	        // manufacturer is exactly the case where inventing a spelling is wrong.
   160	        return brandLine.map { $0.text.trimmed }
   161	    }
   162	
   163	    /// The best candidate for a model name: the largest non-junk line that is
   164	    /// not just the manufacturer repeated. Falls back to the first usable line,
   165	    /// then to the raw text, because an editable wrong guess beats an empty
   166	    /// field the user has to fill in standing at the machine.
   167	    static func guessModelName(in reading: LabelReading, manufacturer: String?) -> String {
   168	        let manufacturerTokens = Set(readingTokens(manufacturer ?? ""))
   169	        let usable = reading.lines.filter { line in
   170	            guard !isJunkLine(line.text) else { return false }
   171	            let lineTokens = Set(readingTokens(line.text))
   172	            guard !lineTokens.isEmpty else { return false }
   173	            // Drop a line that says nothing but the brand.
   174	            return !manufacturerTokens.isEmpty ? !lineTokens.isSubset(of: manufacturerTokens) : true
   175	        }
   176	        let byPresence = usable.max {
   177	            ($0.heightFraction, $0.confidence) < ($1.heightFraction, $1.confidence)
   178	        }
   179	        return (byPresence ?? usable.first).map { $0.text.trimmed }
   180	            ?? reading.text.trimmed
   181	    }
   182	}
   183	
   184	/// Local convenience only — the codebase's idiom elsewhere is a `trimmedName`
   185	/// computed property per view, and a module-wide `String.trimmed` would be a
   186	/// bigger change than this feature is entitled to make.
   187	private extension String {
   188	    var trimmed: String { trimmingCharacters(in: .whitespacesAndNewlines) }
   189	}

