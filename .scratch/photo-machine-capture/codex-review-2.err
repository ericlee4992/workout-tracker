/bin/zsh -lc "python3 - <<'PY'
import json,re,unicodedata
rows=json.load(open('WorkoutTracker/Resources/SeedCatalog.json'))['equipmentModels']
phr=['warning','caution','danger','read','manual','instruction','before use','patent','made in','www','.com','serial','s n','capacity','max','maximum','min','lbs','weight stack','assembled','conforms','part no','rev']
def n(s):return ' '.join(''.join(c if c.isalnum() else ' ' for c in unicodedata.normalize('NFKD',s).casefold()).split())
def reasons(s):
 z=n(s);return [p for p in phr if p in z]+(['rating'] if re.search(r'\\d+\\s?(lb|kg)\\b',z) else [])
bad=[(r,reasons(r['modelName'])) for r in rows if reasons(r['modelName'])]
print('junk model names',len(bad))
from collections import Counter
print(Counter(x for r,rs in bad for x in rs))
for r,rs in bad:print(','.join(rs),'|',r['manufacturer'],'|',r['modelName'])
