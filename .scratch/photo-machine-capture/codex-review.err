     1	import Foundation
     2	
     3	// Photo machine capture, ticket 01 — what a name plate said, and how to read
     4	// meaning out of it. Pure: no UI, no SwiftData, no Vision.
     5	//
     6	// `MachineLabelOCR` produces a `LabelReading`; `CatalogMatcher` ranks the
     7	// catalog against it; the create-new path uses the guesses at the bottom of
     8	// this file. Everything here is text handling, so everything here is testable
     9	// without a camera.
    10	
    11	/// One photographed label, as text.
    12	struct LabelReading: Equatable {
    13	
    14	    /// A single recognised line, top of the plate first.
    15	    struct Line: Equatable {
    16	        var text: String
    17	        /// Vision's own confidence, 0–1.
    18	        var confidence: Double
    19	        /// Line height as a fraction of the image. The model name is almost
    20	        /// always the biggest text on a name plate and the manufacturer sits
    21	        /// above it in smaller type, so size is a real signal about which line
    22	        /// is which — more reliable than position alone.
    23	        var heightFraction: Double
    24	
    25	        init(text: String, confidence: Double = 1, heightFraction: Double = 0) {
    26	            self.text = text
    27	            self.confidence = confidence
    28	            self.heightFraction = heightFraction
    29	        }
    30	    }
    31	
    32	    var lines: [Line] = []
    33	
    34	    var isEmpty: Bool { lines.allSatisfy { $0.text.trimmed.isEmpty } }
    35	
    36	    /// The whole plate as the user will see it echoed back in the sheet.
    37	    var text: String {
    38	        lines.map(\.text).joined(separator: "\n")
    39	    }
    40	
    41	    static func lines(_ texts: [String]) -> LabelReading {
    42	        LabelReading(lines: texts.map { Line(text: $0) })
    43	    }
    44	}
    45	
    46	// MARK: - Normalisation
    47	
    48	enum MachineLabelText {
    49	
    50	    /// Case-folded, diacritic-free, punctuation-free, single-spaced.
    51	    ///
    52	    /// Name plates are shouted in capitals, sometimes stylised
    53	    /// (`LIFE FITNESS®`, `Hammer Strength™`), and Vision reproduces whatever
    54	    /// it sees. Comparison happens in one flat form or not at all.
    55	    static func normalized(_ text: String) -> String {
    56	        let folded = text.folding(options: [.diacriticInsensitive, .caseInsensitive, .widthInsensitive],
    57	                                  locale: Locale(identifier: "en_US_POSIX"))
    58	        let scalars = folded.unicodeScalars.map { scalar -> Character in
    59	            CharacterSet.alphanumerics.contains(scalar) ? Character(scalar) : " "
    60	        }
    61	        return String(scalars)
    62	            .split(separator: " ", omittingEmptySubsequences: true)
    63	            .joined(separator: " ")
    64	    }
    65	
    66	    /// Normalised tokens. One-character tokens are dropped: a stray `I` or `®`
    67	    /// misread as a letter is noise, never evidence.
    68	    static func tokens(_ text: String) -> [String] {
    69	        normalized(text)
    70	            .split(separator: " ")
    71	            .map(String.init)
    72	            .filter { $0.count > 1 }
    73	    }
    74	
    75	    // MARK: Junk lines
    76	
    77	    /// Phrases that appear on name plates and never in a model name.
    78	    private static let junkPhrases = [
    79	        "warning", "caution", "danger", "read", "manual", "instruction",
    80	        "before use", "patent", "made in", "www", ".com", "serial", "s n",
    81	        "capacity", "max", "maximum", "min", "lbs", "weight stack",
    82	        "assembled", "conforms", "part no", "rev",
    83	    ]
    84	
    85	    /// Whether a line is plate furniture rather than the hardware's name:
    86	    /// load ratings, warnings, URLs, part numbers, pure digits.
    87	    ///
    88	    /// Used only for *guessing* what to call a new model. Matching keeps these
    89	    /// lines, because a line the eye reads as junk sometimes carries the one
    90	    /// token that identifies the row — Precor's catalogue names really do
    91	    /// include codes like `VSL019BP`.
    92	    static func isJunkLine(_ text: String) -> Bool {
    93	        let normalized = normalized(text)
    94	        guard !normalized.isEmpty else { return true }
    95	        // No letters at all: a number, a date, a stack rating.
    96	        if !normalized.contains(where: \.isLetter) { return true }
    97	        if junkPhrases.contains(where: { normalized.contains($0) }) { return true }
    98	        // "300 lb" / "150kg" style ratings.
    99	        if normalized.range(of: #"\d+\s?(lb|kg)\b"#, options: .regularExpression) != nil {
   100	            return true
   101	        }
   102	        return false
   103	    }
   104	
   105	    // MARK: Guessing a name for a new model (D35)
   106	
   107	    /// The manufacturer the plate names, in the catalog's own spelling when the
   108	    /// catalog knows it.
   109	    ///
   110	    /// Canonical spelling matters: a user-created model that says
   111	    /// `LIFE FITNESS` sorts and reads as a different brand from the 200 seeded
   112	    /// rows that say `Life Fitness`, for no reason the user would accept.
   113	    static func guessManufacturer(
   114	        in reading: LabelReading, knownManufacturers: [String]
   115	    ) -> String? {
   116	        let readingTokens = Set(tokens(reading.text))
   117	        guard !readingTokens.isEmpty else { return nil }
   118	
   119	        // Longest match first: "Hammer Strength" must beat "Hammer".
   120	        let ranked = knownManufacturers.sorted {
   121	            tokens($0).count > tokens($1).count
   122	        }
   123	        for manufacturer in ranked {
   124	            let needed = Set(tokens(manufacturer))
   125	            guard !needed.isEmpty else { continue }
   126	            if needed.isSubset(of: readingTokens) { return manufacturer }
   127	        }
   128	
   129	        // Nothing known: the brand is conventionally the top line of a plate,
   130	        // as long as that line is not furniture.
   131	        return reading.lines.first { !isJunkLine($0.text) }.map {
   132	            $0.text.trimmed
   133	        }
   134	    }
   135	
   136	    /// The best candidate for a model name: the largest non-junk line that is
   137	    /// not just the manufacturer repeated. Falls back to the first usable line,
   138	    /// then to the raw text, because an editable wrong guess beats an empty
   139	    /// field the user has to fill in standing at the machine.
   140	    static func guessModelName(in reading: LabelReading, manufacturer: String?) -> String {
   141	        let manufacturerTokens = Set(tokens(manufacturer ?? ""))
   142	        let usable = reading.lines.filter { line in
   143	            guard !isJunkLine(line.text) else { return false }
   144	            let lineTokens = Set(tokens(line.text))
   145	            guard !lineTokens.isEmpty else { return false }
   146	            // Drop a line that says nothing but the brand.
   147	            return !manufacturerTokens.isEmpty ? !lineTokens.isSubset(of: manufacturerTokens) : true
   148	        }
   149	        let byPresence = usable.max {
   150	            ($0.heightFraction, $0.confidence) < ($1.heightFraction, $1.confidence)
   151	        }
   152	        return (byPresence ?? usable.first).map { $0.text.trimmed }
   153	            ?? reading.text.trimmed
   154	    }
   155	}
   156	
   157	/// Local convenience only — the codebase's idiom elsewhere is a `trimmedName`
   158	/// computed property per view, and a module-wide `String.trimmed` would be a
   159	/// bigger change than this feature is entitled to make.
   160	private extension String {
   161	    var trimmed: String { trimmingCharacters(in: .whitespacesAndNewlines) }
   162	}
     1	import Foundation
     2	
     3	// Photo machine capture, ticket 01 — ranking the catalog against a photographed
     4	// name plate. Pure: no UI, no SwiftData, no Vision.
     5	//
     6	// The job is not "find the best row" — it is "be right, or say you are not
     7	// sure". D23 keys history, prefill and PRs on the model UUID, so a confident
     8	// wrong match splits the user's own training history exactly the way duplicate
     9	// catalog identities did (codex-review-4). Hence D33: this file proposes, the
    10	// user confirms, and a weak best answer is reported as weak.
    11	
    12	/// One ranked catalog row.
    13	struct CatalogMatch: Equatable {
    14	    let modelID: UUID
    15	    let manufacturer: String
    16	    let modelName: String
    17	    /// 0–1. Comparable only against the thresholds below, not a probability.
    18	    let score: Double
    19	
    20	    var displayName: String { "\(manufacturer) \(modelName)" }
    21	}
    22	
    23	/// The catalog, prepared for matching: tokens per row plus the IDF weight of
    24	/// every token across the whole catalog.
    25	///
    26	/// Built once per scan from the store's models (1877 seeded rows plus the
    27	/// user's own), because the weights are a property of the corpus, not of any
    28	/// one row: "series" and "press" appear in hundreds of names and say almost
    29	/// nothing, while "insignia", "sorinex" or "vsl019bp" nearly identify a row on
    30	/// their own. Term frequency does that arithmetic for us instead of a
    31	/// hand-written stop-word list that would need updating with the catalog.
    32	struct CatalogMatchIndex {
    33	
    34	    struct Entry {
    35	        let id: UUID
    36	        let manufacturer: String
    37	        let modelName: String
    38	        /// Everything the row says, manufacturer included.
    39	        let tokens: [String]
    40	        let manufacturerTokens: [String]
    41	        /// The model-name tokens alone. Coverage is measured over *these*:
    42	        /// the brand is already worth its own bonus, and counting it twice let
    43	        /// "Insignia Series Row" score 86% on a plate that plainly said Chest
    44	        /// Press, purely because it shares "Life Fitness Insignia Series".
    45	        let nameTokens: [String]
    46	        /// Σ weight over `nameTokens` — the denominator for coverage.
    47	        let nameWeight: Double
    48	    }
    49	
    50	    private(set) var entries: [Entry] = []
    51	    private(set) var weights: [String: Double] = [:]
    52	    /// Canonical manufacturer spellings, for the create-new guess.
    53	    private(set) var manufacturers: [String] = []
    54	
    55	    init(models: [(id: UUID, manufacturer: String, modelName: String)]) {
    56	        // Document frequency over rows, then IDF.
    57	        var documentFrequency: [String: Int] = [:]
    58	        var tokenised: [(id: UUID, manufacturer: String, modelName: String,
    59	                         tokens: [String], manufacturerTokens: [String],
    60	                         nameTokens: [String])] = []
    61	        tokenised.reserveCapacity(models.count)
    62	
    63	        for model in models {
    64	            let manufacturerTokens = MachineLabelText.tokens(model.manufacturer)
    65	            let nameTokens = Array(Set(MachineLabelText.tokens(model.modelName))).sorted()
    66	            let all = Array(Set(manufacturerTokens + nameTokens)).sorted()
    67	            for token in all { documentFrequency[token, default: 0] += 1 }
    68	            tokenised.append((model.id, model.manufacturer, model.modelName,
    69	                              all, manufacturerTokens, nameTokens))
    70	        }
    71	
    72	        let count = Double(max(models.count, 1))
    73	        weights = documentFrequency.mapValues { frequency in
    74	            log(1 + count / (1 + Double(frequency)))
    75	        }
    76	        entries = tokenised.map { row in
    77	            // A name that is nothing but the brand ("Cybex" by "Cybex") would
    78	            // have no denominator; fall back to everything the row says.
    79	            let nameTokens = row.nameTokens.isEmpty ? row.tokens : row.nameTokens
    80	            return Entry(
    81	                id: row.id, manufacturer: row.manufacturer, modelName: row.modelName,
    82	                tokens: row.tokens, manufacturerTokens: row.manufacturerTokens,
    83	                nameTokens: nameTokens,
    84	                nameWeight: nameTokens.reduce(0) { $0 + (weights[$1] ?? 0) })
    85	        }
    86	        manufacturers = Array(Set(models.map(\.manufacturer)))
    87	            .filter { !$0.trimmingCharacters(in: .whitespaces).isEmpty }
    88	            .sorted()
    89	    }
    90	
    91	    func weight(_ token: String) -> Double { weights[token] ?? 0 }
    92	}
    93	
    94	enum CatalogMatcher {
    95	
    96	    /// At or above this, the top hit is preselected in the sheet — still shown,
    97	    /// still confirmed by a tap (D33), never applied behind the user's back.
    98	    ///
    99	    /// Set above the band where siblings land: photographing a Life Fitness
   100	    /// Insignia chest press scores the right row at 100% and its five stablemates
   101	    /// at 75–79%, because they share "Insignia Series" and the brand. A
   102	    /// threshold inside that band would preselect a stablemate whenever the
   103	    /// distinguishing word was the one the camera missed.
   104	    static let confidentScore = 0.85
   105	    /// Below this, the sheet leads with "create new": the catalog probably does
   106	    /// not have this machine, and offering a 30%-sure row as the answer invites
   107	    /// the wrong tap.
   108	    static let createNewBelow = 0.35
   109	    /// Weak candidates are still worth listing; noise is not.
   110	    static let candidateFloor = 0.25
   111	
   112	    /// Candidates for `reading`, best first. Deterministic: ties break by score,
   113	    /// then display name, then id, so the same photo always ranks the same way.
   114	    static func rank(
   115	        _ reading: LabelReading, in index: CatalogMatchIndex, limit: Int = 5
   116	    ) -> [CatalogMatch] {
   117	        let readingTokens = Set(MachineLabelText.tokens(reading.text))
   118	        guard !readingTokens.isEmpty else { return [] }
   119	
   120	        let readingWeight = readingTokens.reduce(0.0) { $0 + index.weight($1) }
   121	        var matches: [CatalogMatch] = []
   122	        matches.reserveCapacity(min(limit * 4, index.entries.count))
   123	
   124	        for entry in index.entries where entry.nameWeight > 0 {
   125	            var covered = 0.0
   126	            var explained = 0.0
   127	            for token in entry.tokens {
   128	                let weight = index.weight(token)
   129	                let isNameToken = entry.nameTokens.contains(token)
   130	                if readingTokens.contains(token) {
   131	                    if isNameToken { covered += weight }
   132	                    explained += weight
   133	                } else if let near = nearestToken(to: token, in: readingTokens, weight: weight) {
   134	                    // A single OCR slip should not lose the row: "lnsignia",
   135	                    // "Insigma" and "INSIGNIA" are the same plate.
   136	                    if isNameToken { covered += weight * 0.85 }
   137	                    explained += index.weight(near)
   138	                }
   139	            }
   140	            // Coverage of the *model name*, so a sibling that shares only the
   141	            // brand and a series word cannot ride to a confident score on it.
   142	            let coverage = covered / entry.nameWeight
   143	            guard coverage > 0 else { continue }
   144	
   145	            // How much of what the plate said this row accounts for. Weighted
   146	            // lightly on purpose: plates carry warnings, load ratings and
   147	            // serial numbers that no model name will ever explain, and
   148	            // punishing a row for them would favour long junky names.
   149	            let explanation = readingWeight > 0 ? min(1, explained / readingWeight) : 0
   150	            let manufacturerHit = !entry.manufacturerTokens.isEmpty
   151	                && entry.manufacturerTokens.allSatisfy { token in
   152	                    readingTokens.contains(token)
   153	                        || nearestToken(to: token, in: readingTokens, weight: index.weight(token)) != nil
   154	                }
   155	
   156	            let score = min(1, coverage * 0.85 + explanation * 0.12 + (manufacturerHit ? 0.10 : 0))
   157	            guard score >= candidateFloor else { continue }
   158	            matches.append(CatalogMatch(
   159	                modelID: entry.id, manufacturer: entry.manufacturer,
   160	                modelName: entry.modelName, score: score))
   161	        }
   162	
   163	        return matches
   164	            .sorted { lhs, rhs in
   165	                if lhs.score != rhs.score { return lhs.score > rhs.score }
   166	                if lhs.displayName != rhs.displayName { return lhs.displayName < rhs.displayName }
   167	                return lhs.modelID.uuidString < rhs.modelID.uuidString
   168	            }
   169	            .prefix(limit)
   170	            .map { $0 }
   171	    }
   172	
   173	    /// Whether the best candidate is worth preselecting.
   174	    static func isConfident(_ match: CatalogMatch?) -> Bool {
   175	        (match?.score ?? 0) >= confidentScore
   176	    }
   177	
   178	    /// Whether the sheet should lead with creating a model instead.
   179	    static func suggestsCreatingNew(_ matches: [CatalogMatch]) -> Bool {
   180	        (matches.first?.score ?? 0) < createNewBelow
   181	    }
   182	
   183	    // MARK: - Fuzzy token matching
   184	
   185	    /// A reading token within OCR-slip distance of `token`, or nil.
   186	    ///
   187	    /// Only worth trying for tokens that carry weight — a near-miss on "series"
   188	    /// buys nothing and costs a comparison against every token on the plate.
   189	    private static func nearestToken(
   190	        to token: String, in candidates: Set<String>, weight: Double
   191	    ) -> String? {
   192	        guard weight >= 1.5, token.count >= 4 else { return nil }
   193	        let allowed = token.count >= 7 ? 2 : 1
   194	        var best: (token: String, distance: Int)?
   195	        for candidate in candidates {
   196	            guard abs(candidate.count - token.count) <= allowed else { continue }
   197	            // OCR mangles the middle of a word far more often than both ends.
   198	            guard candidate.first == token.first || candidate.last == token.last else { continue }
   199	            guard let distance = editDistance(token, candidate, limit: allowed) else { continue }
   200	            if distance < (best?.distance ?? Int.max) {
   201	                best = (candidate, distance)
   202	                if distance == 1 { break }
   203	            }
   204	        }
   205	        return best?.token
   206	    }
   207	
   208	    /// Levenshtein distance, abandoned as soon as it exceeds `limit` (which is
   209	    /// what makes it cheap enough to run against a 1877-row catalog inline).
   210	    static func editDistance(_ lhs: String, _ rhs: String, limit: Int) -> Int? {
   211	        if lhs == rhs { return 0 }
   212	        let left = Array(lhs), right = Array(rhs)
   213	        if abs(left.count - right.count) > limit { return nil }
   214	
   215	        var previous = Array(0...right.count)
   216	        var current = [Int](repeating: 0, count: right.count + 1)
   217	        for i in 1...left.count {
   218	            current[0] = i
   219	            var rowBest = current[0]
   220	            for j in 1...right.count {
   221	                let substitution = previous[j - 1] + (left[i - 1] == right[j - 1] ? 0 : 1)
   222	                current[j] = min(substitution, previous[j] + 1, current[j - 1] + 1)
   223	                rowBest = min(rowBest, current[j])
   224	            }
   225	            if rowBest > limit { return nil }
   226	            swap(&previous, &current)
   227	        }
   228	        let distance = previous[right.count]
   229	        return distance <= limit ? distance : nil
   230	    }
   231	}
     1	import CoreGraphics
     2	import Foundation
     3	import Vision
     4	
     5	// Photo machine capture, ticket 01 — the camera-facing half: a photograph in,
     6	// a `LabelReading` out. Imports Vision; imports no UI, touches no store.
     7	//
     8	// Vision's text recognition is on device and offline, which is the only kind
     9	// that works in a basement gym and the only kind that keeps a photo of the
    10	// user's gym from leaving their phone. It also costs no dependency, which the
    11	// project's no-third-party rule requires.
    12	
    13	enum MachineLabelOCR {
    14	
    15	    enum Failure: Error, LocalizedError {
    16	        case recognitionFailed(underlying: Error)
    17	        case noTextFound
    18	
    19	        var errorDescription: String? {
    20	            switch self {
    21	            case .recognitionFailed(let underlying):
    22	                "Could not read the photo: \(underlying.localizedDescription)"
    23	            case .noTextFound:
    24	                "No text found in that photo."
    25	            }
    26	        }
    27	    }
    28	
    29	    /// Reads `image` off the main actor and returns its lines, top first.
    30	    ///
    31	    /// Throws `noTextFound` rather than returning an empty reading: "I saw
    32	    /// nothing" is a result the sheet has to say out loud, not an empty list to
    33	    /// render as zero candidates.
    34	    static func read(_ image: CGImage) async throws -> LabelReading {
    35	        let reading = try await Task.detached(priority: .userInitiated) {
    36	            try perform(image)
    37	        }.value
    38	        guard !reading.isEmpty else { throw Failure.noTextFound }
    39	        return reading
    40	    }
    41	
    42	    /// Synchronous recognition. Separated so tests can call it directly on a
    43	    /// rendered fixture without an async hop.
    44	    static func perform(_ image: CGImage) throws -> LabelReading {
    45	        let request = VNRecognizeTextRequest()
    46	        request.recognitionLevel = .accurate
    47	        // Off deliberately: "Insignia", "Cybex", "Hammer Strength" and
    48	        // "VSL019BP" are not dictionary words, and correction rewrites exactly
    49	        // the distinctive tokens the matcher depends on.
    50	        request.usesLanguageCorrection = false
    51	        request.recognitionLanguages = ["en-US"]
    52	
    53	        let handler = VNImageRequestHandler(cgImage: image, options: [:])
    54	        do {
    55	            try handler.perform([request])
    56	        } catch {
    57	            throw Failure.recognitionFailed(underlying: error)
    58	        }
    59	
    60	        // Each line keeps its own box, so the sort below cannot drift out of
    61	        // step with the text the way zipping two separately-filtered arrays
    62	        // would.
    63	        let lines = (request.results ?? []).compactMap {
    64	            observation -> (line: LabelReading.Line, top: CGFloat)? in
    65	            guard let candidate = observation.topCandidates(1).first else { return nil }
    66	            let text = candidate.string.trimmingCharacters(in: .whitespacesAndNewlines)
    67	            guard !text.isEmpty else { return nil }
    68	            return (
    69	                LabelReading.Line(
    70	                    text: text,
    71	                    confidence: Double(candidate.confidence),
    72	                    heightFraction: Double(observation.boundingBox.height)),
    73	                observation.boundingBox.maxY)
    74	        }
    75	        // Vision's origin is bottom-left, so "top of the plate" is the largest
    76	        // maxY. Order matters to the manufacturer guess, which trusts the top
    77	        // line when the catalog does not recognise the brand.
    78	        return LabelReading(lines: lines.sorted { $0.top > $1.top }.map(\.line))
    79	    }
    80	}

