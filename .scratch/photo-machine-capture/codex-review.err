/bin/zsh -lc "python3 - <<'PY'
import json,re,collections,math,itertools
rows=json.load(open('WorkoutTracker/Resources/SeedCatalog.json'))['equipmentModels']
def toks(s):return [x.lower() for x in re.findall(r'[A-Za-z0-9]+',s) if len(x)>1]
df=collections.Counter()
for r in rows:df.update(set(toks(r['manufacturer'])+toks(r['modelName'])))
N=len(rows);w={t:math.log(1+N/(1+f)) for t,f in df.items()}
def lev(a,b):
 prev=list(range(len(b)+1))
 for i,x in enumerate(a,1):
  cur=[i]
  for j,y in enumerate(b,1):cur.append(min(prev[j]+1,cur[j-1]+1,prev[j-1]+(x"'!=y)))
  prev=cur
 return prev[-1]
ts=[t for t in df if len(t)>=4 and w[t]>=1.5]
out=[]
for i,a in enumerate(ts):
 for b in ts[i+1:]:
  lim=2 if len(a)>=7 else 1
  if abs(len(a)-len(b))<=lim and (a[0]==b[0] or a[-1]==b[-1]) and lev(a,b)==1:
   out.append((abs(w[a]-w[b]),a,df[a],w[a],b,df[b],w[b]))
for x in sorted(out,reverse=True)[:60]:print(x)
