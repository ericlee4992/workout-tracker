   431	                        } label: {
   432	                            Label("Scan label…", systemImage: "camera.viewfinder")
   433	                        }
   434	                        .accessibilityIdentifier("scanMachineLabel")
   435	                    } footer: {
   436	                        Text("Optional — picking one names the machine for you. Without a model, logging on this machine opens the full exercise picker. Scanning photographs the machine's name plate and offers the catalog models it matches.")
   437	                    }
   438	                } else {
   439	                    Section {
   440	                        HStack {
   441	                            Text("Catalog model")
   442	                            Spacer()
   443	                            Text(machine?.model?.displayName ?? "None")
   444	                                .foregroundStyle(.secondary)
   445	                        }
   446	                    } footer: {
   447	                        // Changing an existing machine's model has past-vs-
   448	                        // future consequences (D10), so it keeps its own flow.
   449	                        Text("Use “Correct Model…” on the machine to change this — it asks whether to apply the correction to past workouts.")
   450	                    }
   451	                }
   452	                Section {
   453	                    Picker("Default unit", selection: $defaultUnit) {
   454	                        Text("Gym default").tag(WeightUnit?.none)
   455	                        ForEach(WeightUnit.allCases) { unit in
   456	                            Text(unit.rawValue).tag(WeightUnit?.some(unit))
   457	                        }
   458	                    }
   459	                    .accessibilityIdentifier("machineUnitPicker")
   460	                } footer: {
   461	                    Text("Leave on Gym default to fall through to the gym's unit (then the app preference).")
   462	                }
   463	            }
   464	            .navigationTitle(machine == nil ? "New Machine" : "Edit Machine")
   465	            .navigationBarTitleDisplayMode(.inline)
   466	            .toolbar {
   467	                ToolbarItem(placement: .cancellationAction) {
   468	                    Button("Cancel") { dismiss() }
   469	                }
   470	                ToolbarItem(placement: .confirmationAction) {
   471	                    Button(machine == nil ? "Add" : "Save") { save() }
   472	                        .disabled(trimmedLabel.isEmpty)
   473	                        .accessibilityIdentifier("saveMachine")
   474	                }
   475	            }
   476	            .onAppear(perform: load)
   477	            .onChange(of: model?.id) { _, _ in applyModelDefaultLabel() }
   478	            .sheet(isPresented: $showingScanner) {
   479	                ScanMachineLabelSheet(
   480	                    // Accepting a scanned model goes through exactly the same
   481	                    // state a hand-picked one does, so the label default (D3)
   482	                    // has one implementation, not two.
   483	                    onUseModel: { model = $0 },
   484	                    onCreateNew: { manufacturer, modelName in
   485	                        scanCreatedModel = ScanDraft(
   486	                            manufacturer: manufacturer, modelName: modelName)
   487	                    })
   488	            }
   489	            .sheet(item: $scanCreatedModel) { draft in
   490	                AddModelSheet(
   491	                    initialManufacturer: draft.manufacturer,
   492	                    initialModelName: draft.modelName,
   493	                    onCreate: { model = $0 })
   494	            }
   495	        }
   496	    }
   497	
   498	    private var trimmedLabel: String {
   499	        label.trimmingCharacters(in: .whitespacesAndNewlines)
   500	    }
   501	
   502	    private func load() {
   503	        guard !loaded else { return }
   504	        loaded = true
   505	        guard let machine else { return }
   506	        label = machine.label
   507	        model = machine.model
   508	        defaultUnit = machine.defaultUnit
   509	    }
   510	
   511	    /// D3: picking a catalog model supplies the label, so Add is immediately
   512	    /// enabled instead of waiting for a name to be invented. Still editable,
   513	    /// and a machine with no model still needs one typed.
   514	    private func applyModelDefaultLabel() {
   515	        guard let model else { return }
   516	        guard trimmedLabel.isEmpty || trimmedLabel == modelDerivedLabel else { return }
   517	        label = model.modelName
   518	        modelDerivedLabel = model.modelName
   519	    }
   520	
   521	    private func save() {
   522	        do {
   523	            if let machine {
   524	                try EquipmentLifecycle(context: modelContext).update(
   525	                    machine, label: label, defaultUnit: defaultUnit)
   526	            } else {
   527	                modelContext.insert(MachineInstance(
   528	                    label: trimmedLabel,
   529	                    defaultUnit: defaultUnit,
   530	                    gym: gym,
   531	                    model: model))
   532	                try modelContext.save()
   533	            }
   534	        } catch {
   535	            assertionFailure("Failed to save machine: \(error)")
   536	        }
   537	        dismiss()
   538	    }
   539	}
   540	
   541	extension View {
   542	    /// Runs `action` whenever a store save touched the catalog (equipment
   543	    /// models or exercises) — the invalidation signal for a cached
   544	    /// `CatalogModelIndex`. Rebuilding on `models.count` alone left a rename,
   545	    /// an `equipmentType` change, a link change or a muscle-group edit invisible
   546	    /// until the view was recreated (codex-review-4); rebuilding on every body
   547	    /// evaluation would cost a full index build per keystroke.
   548	    func onCatalogChange(_ action: @escaping () -> Void) -> some View {
   549	        onReceive(NotificationCenter.default.publisher(for: ModelContext.didSave)) { note in
   550	            let touched = [
   551	                ModelContext.NotificationKey.insertedIdentifiers,
   552	                ModelContext.NotificationKey.updatedIdentifiers,
   553	                ModelContext.NotificationKey.deletedIdentifiers,
   554	            ].flatMap { key -> [PersistentIdentifier] in
   555	                note.userInfo?[key.rawValue] as? [PersistentIdentifier] ?? []
   556	            }
   557	            // A save whose payload cannot be read is treated as a change: a
   558	            // missed rebuild shows stale rows, a spare one costs milliseconds.
   559	            let unreadable = touched.isEmpty
   560	            if unreadable || CatalogIndexInvalidation
   561	                .touchesCatalog(entityNames: touched.map(\.entityName)) {
   562	                action()
   563	            }
   564	        }
   565	    }
   566	}
   567	
   568	/// Picker over the whole equipment-model catalog (seeded + user). With ~1900
   569	/// seeded models (ticket 20) a flat A–Z list is unusable, so this is the
   570	/// screen ticket 21 is really about: grouped (manufacturer / body area /
   571	/// equipment type), filterable by body area and equipment type, and searched
   572	/// across manufacturer *and* model together so "hammer incline" lands on the
   573	/// row. Grouping and filtering are display state only (D23) — remembered in
   574	/// AppPreferences, never written into anything logged.
   575	struct ModelPickerView: View {
   576	    @Binding var selection: EquipmentModel?
   577	    @Environment(\.dismiss) private var dismiss
   578	    @Environment(\.modelContext) private var modelContext
   579	    @Query(sort: [
   580	        SortDescriptor(\EquipmentModel.manufacturer),
   581	        SortDescriptor(\EquipmentModel.modelName),
   582	    ]) private var models: [EquipmentModel]
   583	    @Query(sort: \Exercise.name) private var exercises: [Exercise]
   584	    @Query private var allPreferences: [AppPreferences]
   585	    @State private var searchText = ""
   586	    @State private var showingAddModel = false
   587	    /// Built once per catalog change, not per keystroke: filtering value types
   588	    /// is fast, re-reading 1900 SwiftData rows is not.
   589	    @State private var index = CatalogModelIndex.empty
   590	    @State private var modelsByID: [UUID: EquipmentModel] = [:]
   591	
   592	    private var preferences: AppPreferences? {
   593	        AppPreferences.canonical(of: allPreferences)
   594	    }
   595	
   596	    private var grouping: CatalogGrouping {
   597	        preferences?.modelBrowseGrouping ?? .manufacturer
   598	    }
   599	
   600	    private var filter: CatalogModelFilter {
   601	        CatalogModelFilter(
   602	            searchText: searchText,
   603	            bodyArea: preferences?.modelBrowseMuscleGroup,
   604	            equipmentType: preferences?.modelBrowseEquipmentType)
   605	    }
   606	
   607	    private var sections: [CatalogSection<CatalogModelRow>] {
   608	        CatalogBrowsing.browse(index, filter: filter, grouping: grouping)
   609	    }
   610	
   611	    var body: some View {
   612	        List {
   613	            Section {
   614	                Button {
   615	                    selection = nil
   616	                    dismiss()
   617	                } label: {
   618	                    HStack {
   619	                        Text("None")
   620	                        Spacer()
   621	                        if selection == nil {
   622	                            Image(systemName: "checkmark")
   623	                                .foregroundStyle(.tint)
   624	                        }
   625	                    }
   626	                }
   627	                .buttonStyle(.plain)
   628	            }
   629	
   630	            if filter.hasActiveFilters {
   631	                Section {
   632	                    HStack {
   633	                        Label(filterSummary, systemImage: "line.3.horizontal.decrease.circle.fill")
   634	                            .font(.caption)
   635	                            .foregroundStyle(.secondary)
   636	                        Spacer()
   637	                        Button("Clear") { clearFilters() }
   638	                            .font(.caption.weight(.semibold))
   639	                            .accessibilityIdentifier("clearModelFilters")
   640	                    }
   641	                }
   642	            }
   643	
   644	            ForEach(sections) { section in
   645	                Section {
   646	                    ForEach(section.rows) { row in
   647	                        modelButton(row)
   648	                    }
   649	                } header: {
   650	                    if let title = section.title {
   651	                        Text(title)
   652	                    }
   653	                }
   654	            }
   655	
   656	            Section {
   657	                if sections.isEmpty {
   658	                    Text("No models match")
   659	                        .foregroundStyle(.secondary)
   660	                        .accessibilityIdentifier("noModelsMatch")
   661	                }
   662	                Button("New Model…", systemImage: "plus") {
   663	                    showingAddModel = true
   664	                }
   665	            } footer: {
   666	                Text("Can't find the machine's model? Add it — your models live alongside the catalog.")
   667	            }
   668	        }
   669	        .searchable(text: $searchText, prompt: "Search manufacturer or model")
   670	        .navigationTitle("Catalog Model")
   671	        .navigationBarTitleDisplayMode(.inline)
   672	        .toolbar {
   673	            ToolbarItem(placement: .topBarTrailing) {
   674	                browseMenu
   675	            }
   676	        }
   677	        // `initial: true` is what builds the index for the first frame; the
   678	        // count is no longer the invalidation signal — see `onCatalogChange`.
   679	        .onChange(of: models.count, initial: true) { _, _ in rebuildIndex() }
   680	        .onCatalogChange { rebuildIndex() }
   681	        .sheet(isPresented: $showingAddModel) {
   682	            AddModelSheet(onCreate: { newModel in
   683	                selection = newModel
   684	                dismiss()
   685	            })
   686	        }
   687	    }
