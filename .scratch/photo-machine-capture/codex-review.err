import json,re,math,collections
R=json.load(open('WorkoutTracker/Resources/SeedCatalog.json'))['equipmentModels'];tok=lambda s:[x.lower() for x in re.findall(r'[A-Za-z0-9]+',s) if len(x)>1];N=len(R);df=collections.Counter();P=[]
for r in R:
 m=tok(r['manufacturer']); n=sorted(set(tok(r['modelName']))); a=sorted(set(m+n));df.update(a);P.append((r,m,n,a))
w={t:math.log(1+N/(1+f)) for t,f in df.items()}
def ed(a,b,l):
 if abs(len(a)-len(b))>l:return None
 p=list(range(len(b)+1))
 for i,x in enumerate(a,1):
  c=[i]+[0]*len(b);z=i
  for j,y in enumerate(b,1):c[j]=min(p[j-1]+(x"'!=y),p[j]+1,c[j-1]+1);z=min(z,c[j])
  if z>l:return None
  p=c
 return p[-1] if p[-1]<=l else None
def near(t,cs):
 if w[t]<1.5 or len(t)<4:return None
 l=2 if len(t)>=7 else 1
 for c in cs:
  if abs(len(c)-len(t))<=l and (c[0]==t[0] or c[-1]==t[-1]) and ed(t,c,l) is not None:return c
def rank(s):
 q=set(tok(s));rw=sum(w.get(x,0) for x in q);o=[]
 for r,m,n,a in P:
  nw=sum(w[x] for x in n);co=ex=0
  for t in a:
   z=t if t in q else near(t,q)
   if z is not None:
    if t in n:co+=w[t]*(1 if z==t else .85)
    ex+=w.get(z,0)
  if not co:continue
  mh=m and all(x in q or near(x,q) is not None for x in m)
  sc=min(1,.85*co/nw+.12*min(1,ex/rw) +(.1 if mh else 0))
  if sc>=.25:o.append((sc,r['"'manufacturer'],r['modelName']))
 return sorted(o,key=lambda x:(-x[0],x[1]+' '+x[2]))[:8]
for s in ['ATLANTIS STRENGTH Plate Loaded Belt Squat Model C-227','ATLANTIS Belt Squat C-227','LIFE FITNESS INSIGNIA SERIES BACK EXTENSION','INSIGNIA SERIES BACK EXTENSION','ROGUE DONKEY ATLANTIS BELT SQUAT','HAMMER STRENGTH JAMMER','LIFE FITNESS LIFT','RACK','HACK SQUAT']:
 print('\\n'+s)
 for x in rank(s):print(f'{x[0]:.6f}',x[1],'|',x[2])
