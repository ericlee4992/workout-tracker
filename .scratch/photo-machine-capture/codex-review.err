/bin/zsh -lc "python3 - <<'PY'
import json,re,math,unicodedata
rows=json.load(open('WorkoutTracker/Resources/SeedCatalog.json'))['equipmentModels']
def norm(s):
 s=unicodedata.normalize('NFKD',s.casefold())
 return ' '.join(''.join(c if c.isalnum() else ' ' for c in s if not unicodedata.combining(c)).split())
def toks(s):return [x for x in norm(s).split() if len(x)>1]
from collections import Counter
N=len(rows); df=Counter()
prep=[]
for r in rows:
 mt=toks(r['manufacturer']); nt=sorted(set(toks(r['modelName']))); all_=sorted(set(mt+nt));df.update(all_);prep.append((r,mt,nt,all_))
w={t:math.log(1+N/(1+f)) for t,f in df.items()}
def lev(a,b,lim):
 if abs(len(a)-len(b))>lim:return None
 prev=list(range(len(b)+1))
 for i,ca in enumerate(a,1):
  cur=[i]+[0]*len(b); rowbest=i
  for j,cb in enumerate(b,1):
   cur[j]=min(prev[j-1]+(ca"'!=cb),prev[j]+1,cur[j-1]+1);rowbest=min(rowbest,cur[j])
  if rowbest>lim:return None
  prev=cur
 return prev[-1] if prev[-1]<=lim else None
def near(tok,cands,wt):
 if wt<1.5 or len(tok)<4:return None
 al=2 if len(tok)>=7 else 1
 best=None
 for c in cands: # set arbitrary but only token return weight impacts explained; distance equal can differ
  if abs(len(c)-len(tok))>al:continue
  if not(c[0]==tok[0] or c[-1]==tok[-1]):continue
  d=lev(tok,c,al)
  if d is None:continue
  if best is None or d<best[0]:
   best=(d,c)
   if d==1:break
 return best[1] if best else None
def rank(text):
 rt=set(toks(text));rw=sum(w.get(t,0) for t in rt);out=[]
 for r,mt,nt,all_ in prep:
  nw=sum(w[t] for t in nt)
  if not nw:continue
  covered=expl=0
  for t in all_:
   wt=w[t]; isname=t in nt
   if t in rt:
    if isname:covered+=wt
    expl+=wt
   else:
    n=near(t,rt,wt)
    if n:
     if isname:covered+=wt*.85
     expl+=w.get(n,0)
  cov=covered/nw
  if cov<=0:continue
  explanation=min(1,expl/rw) if rw else 0
  mh=bool(mt) and all(t in rt or near(t,rt,w[t]) for t in mt)
  score=min(1,cov*.85+explanation*.12+(.1 if mh else 0))
  if score>=.25: out.append((score,r['"'manufacturer'],r['modelName']))
 return sorted(out,key=lambda x:(-x[0],x[1]+' '+x[2]))[:10]
for s in [
'BACK EXTENSION',
'LIFE FITNESS BACK EXTENSION',
'HAMMER STRENGTH BACK EXTENSION',
'LIFE FITNESS INSIGNIA SERIES CHEST PRESS INSIGNIA SERIES SHOULDER PRESS',
'LIFE FITNESS INSIGNIA SERIES',
'MATRIX',
'MATRIX LEG PRESS',
'PRIME LEG EXTENSION',
'LEG RAISE',
'SMITH MACHINE',
'NAUTILUS SMITH MACHINE HAMMER STRENGTH SMITH MACHINE',
]:
 print('\\nREAD:',s)
 for x in rank(s)[:8]:print(f'{x[0]:.6f}',x[1],'|',x[2])
