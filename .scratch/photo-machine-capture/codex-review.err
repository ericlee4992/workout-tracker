===== WorkoutTracker/Domain/MachineLabelText.swift
     1	import Foundation
     2	
     3	// Photo machine capture, ticket 01 — what a name plate said, and how to read
     4	// meaning out of it. Pure: no UI, no SwiftData, no Vision.
     5	//
     6	// `MachineLabelOCR` produces a `LabelReading`; `CatalogMatcher` ranks the
     7	// catalog against it; the create-new path uses the guesses at the bottom of
     8	// this file. Everything here is text handling, so everything here is testable
     9	// without a camera.
    10	
    11	/// One photographed label, as text.
    12	struct LabelReading: Equatable {
    13	
    14	    /// A single recognised line, top of the plate first.
    15	    struct Line: Equatable {
    16	        var text: String
    17	        /// Vision's own confidence, 0–1.
    18	        var confidence: Double
    19	        /// Line height as a fraction of the image. The model name is almost
    20	        /// always the biggest text on a name plate and the manufacturer sits
    21	        /// above it in smaller type, so size is a real signal about which line
    22	        /// is which — more reliable than position alone.
    23	        var heightFraction: Double
    24	
    25	        init(text: String, confidence: Double = 1, heightFraction: Double = 0) {
    26	            self.text = text
    27	            self.confidence = confidence
    28	            self.heightFraction = heightFraction
    29	        }
    30	    }
    31	
    32	    var lines: [Line] = []
    33	
    34	    var isEmpty: Bool { lines.allSatisfy { $0.text.trimmed.isEmpty } }
    35	
    36	    /// The whole plate as the user will see it echoed back in the sheet.
    37	    var text: String {
    38	        lines.map(\.text).joined(separator: "\n")
    39	    }
    40	
    41	    static func lines(_ texts: [String]) -> LabelReading {
    42	        LabelReading(lines: texts.map { Line(text: $0) })
    43	    }
    44	}
    45	
    46	// MARK: - Normalisation
    47	
    48	enum MachineLabelText {
    49	
    50	    /// Case-folded, diacritic-free, punctuation-free, single-spaced.
    51	    ///
    52	    /// Name plates are shouted in capitals, sometimes stylised
    53	    /// (`LIFE FITNESS®`, `Hammer Strength™`), and Vision reproduces whatever
    54	    /// it sees. Comparison happens in one flat form or not at all.
    55	    static func normalized(_ text: String) -> String {
    56	        let folded = text.folding(options: [.diacriticInsensitive, .caseInsensitive, .widthInsensitive],
    57	                                  locale: Locale(identifier: "en_US_POSIX"))
    58	        let scalars = folded.unicodeScalars.map { scalar -> Character in
    59	            CharacterSet.alphanumerics.contains(scalar) ? Character(scalar) : " "
    60	        }
    61	        return String(scalars)
    62	            .split(separator: " ", omittingEmptySubsequences: true)
    63	            .joined(separator: " ")
    64	    }
    65	
    66	    /// Normalised tokens. One-character tokens are dropped: a stray `I` or `®`
    67	    /// misread as a letter is noise, never evidence.
    68	    static func tokens(_ text: String) -> [String] {
    69	        normalized(text)
    70	            .split(separator: " ")
    71	            .map(String.init)
    72	            .filter { $0.count > 1 }
    73	    }
    74	
    75	    // MARK: Junk lines
    76	
    77	    /// Phrases that appear on name plates and never in a model name.
    78	    private static let junkPhrases = [
    79	        "warning", "caution", "danger", "read", "manual", "instruction",
    80	        "before use", "patent", "made in", "www", ".com", "serial", "s n",
    81	        "capacity", "max", "maximum", "min", "lbs", "weight stack",
    82	        "assembled", "conforms", "part no", "rev",
    83	    ]
    84	
    85	    /// Whether a line is plate furniture rather than the hardware's name:
    86	    /// load ratings, warnings, URLs, part numbers, pure digits.
    87	    ///
    88	    /// Used only for *guessing* what to call a new model. Matching keeps these
    89	    /// lines, because a line the eye reads as junk sometimes carries the one
    90	    /// token that identifies the row — Precor's catalogue names really do
    91	    /// include codes like `VSL019BP`.
    92	    static func isJunkLine(_ text: String) -> Bool {
    93	        let normalized = normalized(text)
    94	        guard !normalized.isEmpty else { return true }
    95	        // No letters at all: a number, a date, a stack rating.
    96	        if !normalized.contains(where: \.isLetter) { return true }
    97	        if junkPhrases.contains(where: { normalized.contains($0) }) { return true }
    98	        // "300 lb" / "150kg" style ratings.
    99	        if normalized.range(of: #"\d+\s?(lb|kg)\b"#, options: .regularExpression) != nil {
   100	            return true
   101	        }
   102	        return false
   103	    }
   104	
   105	    // MARK: Guessing a name for a new model (D35)
   106	
   107	    /// The manufacturer the plate names, in the catalog's own spelling when the
   108	    /// catalog knows it.
   109	    ///
   110	    /// Canonical spelling matters: a user-created model that says
   111	    /// `LIFE FITNESS` sorts and reads as a different brand from the 200 seeded
   112	    /// rows that say `Life Fitness`, for no reason the user would accept.
   113	    static func guessManufacturer(
   114	        in reading: LabelReading, knownManufacturers: [String]
   115	    ) -> String? {
   116	        let readingTokens = Set(tokens(reading.text))
   117	        guard !readingTokens.isEmpty else { return nil }
   118	
   119	        // Longest match first: "Hammer Strength" must beat "Hammer".
   120	        let ranked = knownManufacturers.sorted {
   121	            tokens($0).count > tokens($1).count
   122	        }
   123	        for manufacturer in ranked {
   124	            let needed = Set(tokens(manufacturer))
   125	            guard !needed.isEmpty else { continue }
   126	            if needed.isSubset(of: readingTokens) { return manufacturer }
   127	        }
   128	
   129	        // Nothing known: the brand is conventionally the top line of a plate,
   130	        // as long as that line is not furniture.
   131	        return reading.lines.first { !isJunkLine($0.text) }.map {
   132	            $0.text.trimmed
   133	        }
   134	    }
   135	
   136	    /// The best candidate for a model name: the largest non-junk line that is
   137	    /// not just the manufacturer repeated. Falls back to the first usable line,
   138	    /// then to the raw text, because an editable wrong guess beats an empty
   139	    /// field the user has to fill in standing at the machine.
   140	    static func guessModelName(in reading: LabelReading, manufacturer: String?) -> String {
   141	        let manufacturerTokens = Set(tokens(manufacturer ?? ""))
   142	        let usable = reading.lines.filter { line in
   143	            guard !isJunkLine(line.text) else { return false }
   144	            let lineTokens = Set(tokens(line.text))
   145	            guard !lineTokens.isEmpty else { return false }
   146	            // Drop a line that says nothing but the brand.
   147	            return !manufacturerTokens.isEmpty ? !lineTokens.isSubset(of: manufacturerTokens) : true
   148	        }
   149	        let byPresence = usable.max {
   150	            ($0.heightFraction, $0.confidence) < ($1.heightFraction, $1.confidence)
   151	        }
   152	        return (byPresence ?? usable.first).map { $0.text.trimmed }
   153	            ?? reading.text.trimmed
   154	    }
   155	}
   156	
   157	/// Local convenience only — the codebase's idiom elsewhere is a `trimmedName`
   158	/// computed property per view, and a module-wide `String.trimmed` would be a
   159	/// bigger change than this feature is entitled to make.
   160	private extension String {
   161	    var trimmed: String { trimmingCharacters(in: .whitespacesAndNewlines) }
   162	}
===== WorkoutTracker/Domain/CatalogMatcher.swift
     1	import Foundation
     2	
     3	// Photo machine capture, ticket 01 — ranking the catalog against a photographed
     4	// name plate. Pure: no UI, no SwiftData, no Vision.
     5	//
     6	// The job is not "find the best row" — it is "be right, or say you are not
     7	// sure". D23 keys history, prefill and PRs on the model UUID, so a confident
     8	// wrong match splits the user's own training history exactly the way duplicate
     9	// catalog identities did (codex-review-4). Hence D33: this file proposes, the
    10	// user confirms, and a weak best answer is reported as weak.
    11	
    12	/// One ranked catalog row.
    13	struct CatalogMatch: Equatable {
    14	    let modelID: UUID
    15	    let manufacturer: String
    16	    let modelName: String
    17	    /// 0–1. Comparable only against the thresholds below, not a probability.
    18	    let score: Double
    19	
    20	    var displayName: String { "\(manufacturer) \(modelName)" }
    21	}
    22	
    23	/// The catalog, prepared for matching: tokens per row plus the IDF weight of
    24	/// every token across the whole catalog.
    25	///
    26	/// Built once per scan from the store's models (1877 seeded rows plus the
    27	/// user's own), because the weights are a property of the corpus, not of any
    28	/// one row: "series" and "press" appear in hundreds of names and say almost
    29	/// nothing, while "insignia", "sorinex" or "vsl019bp" nearly identify a row on
    30	/// their own. Term frequency does that arithmetic for us instead of a
    31	/// hand-written stop-word list that would need updating with the catalog.
    32	struct CatalogMatchIndex {
    33	
    34	    struct Entry {
    35	        let id: UUID
    36	        let manufacturer: String
    37	        let modelName: String
    38	        /// Everything the row says, manufacturer included.
    39	        let tokens: [String]
    40	        let manufacturerTokens: [String]
    41	        /// The model-name tokens alone. Coverage is measured over *these*:
    42	        /// the brand is already worth its own bonus, and counting it twice let
    43	        /// "Insignia Series Row" score 86% on a plate that plainly said Chest
    44	        /// Press, purely because it shares "Life Fitness Insignia Series".
    45	        let nameTokens: [String]
    46	        /// Σ weight over `nameTokens` — the denominator for coverage.
    47	        let nameWeight: Double
    48	    }
    49	
    50	    private(set) var entries: [Entry] = []
    51	    private(set) var weights: [String: Double] = [:]
    52	    /// Canonical manufacturer spellings, for the create-new guess.
    53	    private(set) var manufacturers: [String] = []
    54	
    55	    init(models: [(id: UUID, manufacturer: String, modelName: String)]) {
    56	        // Document frequency over rows, then IDF.
    57	        var documentFrequency: [String: Int] = [:]
    58	        var tokenised: [(id: UUID, manufacturer: String, modelName: String,
    59	                         tokens: [String], manufacturerTokens: [String],
    60	                         nameTokens: [String])] = []
    61	        tokenised.reserveCapacity(models.count)
    62	
    63	        for model in models {
    64	            let manufacturerTokens = MachineLabelText.tokens(model.manufacturer)
    65	            let nameTokens = Array(Set(MachineLabelText.tokens(model.modelName))).sorted()
    66	            let all = Array(Set(manufacturerTokens + nameTokens)).sorted()
    67	            for token in all { documentFrequency[token, default: 0] += 1 }
    68	            tokenised.append((model.id, model.manufacturer, model.modelName,
    69	                              all, manufacturerTokens, nameTokens))
    70	        }
    71	
    72	        let count = Double(max(models.count, 1))
    73	        weights = documentFrequency.mapValues { frequency in
    74	            log(1 + count / (1 + Double(frequency)))
    75	        }
    76	        entries = tokenised.map { row in
    77	            // A name that is nothing but the brand ("Cybex" by "Cybex") would
    78	            // have no denominator; fall back to everything the row says.
    79	            let nameTokens = row.nameTokens.isEmpty ? row.tokens : row.nameTokens
    80	            return Entry(
    81	                id: row.id, manufacturer: row.manufacturer, modelName: row.modelName,
    82	                tokens: row.tokens, manufacturerTokens: row.manufacturerTokens,
    83	                nameTokens: nameTokens,
    84	                nameWeight: nameTokens.reduce(0) { $0 + (weights[$1] ?? 0) })
    85	        }
    86	        manufacturers = Array(Set(models.map(\.manufacturer)))
    87	            .filter { !$0.trimmingCharacters(in: .whitespaces).isEmpty }
    88	            .sorted()
    89	    }
    90	
    91	    func weight(_ token: String) -> Double { weights[token] ?? 0 }
    92	}
    93	
    94	enum CatalogMatcher {
    95	
    96	    /// At or above this, the top hit is preselected in the sheet — still shown,
    97	    /// still confirmed by a tap (D33), never applied behind the user's back.
    98	    ///
    99	    /// Set above the band where siblings land: photographing a Life Fitness
   100	    /// Insignia chest press scores the right row at 100% and its five stablemates
   101	    /// at 75–79%, because they share "Insignia Series" and the brand. A
   102	    /// threshold inside that band would preselect a stablemate whenever the
   103	    /// distinguishing word was the one the camera missed.
   104	    static let confidentScore = 0.85
   105	    /// Below this, the sheet leads with "create new": the catalog probably does
   106	    /// not have this machine, and offering a 30%-sure row as the answer invites
   107	    /// the wrong tap.
   108	    static let createNewBelow = 0.35
   109	    /// Weak candidates are still worth listing; noise is not.
   110	    static let candidateFloor = 0.25
   111	
   112	    /// Candidates for `reading`, best first. Deterministic: ties break by score,
   113	    /// then display name, then id, so the same photo always ranks the same way.
   114	    static func rank(
   115	        _ reading: LabelReading, in index: CatalogMatchIndex, limit: Int = 5
   116	    ) -> [CatalogMatch] {
   117	        let readingTokens = Set(MachineLabelText.tokens(reading.text))
   118	        guard !readingTokens.isEmpty else { return [] }
   119	
   120	        let readingWeight = readingTokens.reduce(0.0) { $0 + index.weight($1) }
   121	        var matches: [CatalogMatch] = []
   122	        matches.reserveCapacity(min(limit * 4, index.entries.count))
   123	
   124	        for entry in index.entries where entry.nameWeight > 0 {
   125	            var covered = 0.0
   126	            var explained = 0.0
   127	            for token in entry.tokens {
   128	                let weight = index.weight(token)
   129	                let isNameToken = entry.nameTokens.contains(token)
   130	                if readingTokens.contains(token) {
   131	                    if isNameToken { covered += weight }
   132	                    explained += weight
   133	                } else if let near = nearestToken(to: token, in: readingTokens, weight: weight) {
   134	                    // A single OCR slip should not lose the row: "lnsignia",
   135	                    // "Insigma" and "INSIGNIA" are the same plate.
   136	                    if isNameToken { covered += weight * 0.85 }
   137	                    explained += index.weight(near)
   138	                }
   139	            }
   140	            // Coverage of the *model name*, so a sibling that shares only the
   141	            // brand and a series word cannot ride to a confident score on it.
   142	            let coverage = covered / entry.nameWeight
   143	            guard coverage > 0 else { continue }
   144	
   145	            // How much of what the plate said this row accounts for. Weighted
   146	            // lightly on purpose: plates carry warnings, load ratings and
   147	            // serial numbers that no model name will ever explain, and
   148	            // punishing a row for them would favour long junky names.
   149	            let explanation = readingWeight > 0 ? min(1, explained / readingWeight) : 0
   150	            let manufacturerHit = !entry.manufacturerTokens.isEmpty
   151	                && entry.manufacturerTokens.allSatisfy { token in
   152	                    readingTokens.contains(token)
   153	                        || nearestToken(to: token, in: readingTokens, weight: index.weight(token)) != nil
   154	                }
   155	
   156	            let score = min(1, coverage * 0.85 + explanation * 0.12 + (manufacturerHit ? 0.10 : 0))
   157	            guard score >= candidateFloor else { continue }
   158	            matches.append(CatalogMatch(
   159	                modelID: entry.id, manufacturer: entry.manufacturer,
   160	                modelName: entry.modelName, score: score))
   161	        }
   162	
   163	        return matches
   164	            .sorted { lhs, rhs in
   165	                if lhs.score != rhs.score { return lhs.score > rhs.score }
   166	                if lhs.displayName != rhs.displayName { return lhs.displayName < rhs.displayName }
   167	                return lhs.modelID.uuidString < rhs.modelID.uuidString
   168	            }
   169	            .prefix(limit)
   170	            .map { $0 }
   171	    }
   172	
   173	    /// Whether the best candidate is worth preselecting.
   174	    static func isConfident(_ match: CatalogMatch?) -> Bool {
   175	        (match?.score ?? 0) >= confidentScore
   176	    }
   177	
   178	    /// Whether the sheet should lead with creating a model instead.
   179	    static func suggestsCreatingNew(_ matches: [CatalogMatch]) -> Bool {
   180	        (matches.first?.score ?? 0) < createNewBelow
   181	    }
   182	
   183	    // MARK: - Fuzzy token matching
   184	
   185	    /// A reading token within OCR-slip distance of `token`, or nil.
   186	    ///
   187	    /// Only worth trying for tokens that carry weight — a near-miss on "series"
   188	    /// buys nothing and costs a comparison against every token on the plate.
   189	    private static func nearestToken(
   190	        to token: String, in candidates: Set<String>, weight: Double
   191	    ) -> String? {
   192	        guard weight >= 1.5, token.count >= 4 else { return nil }
   193	        let allowed = token.count >= 7 ? 2 : 1
   194	        var best: (token: String, distance: Int)?
   195	        for candidate in candidates {
   196	            guard abs(candidate.count - token.count) <= allowed else { continue }
   197	            // OCR mangles the middle of a word far more often than both ends.
   198	            guard candidate.first == token.first || candidate.last == token.last else { continue }
   199	            guard let distance = editDistance(token, candidate, limit: allowed) else { continue }
   200	            if distance < (best?.distance ?? Int.max) {
   201	                best = (candidate, distance)
   202	                if distance == 1 { break }
   203	            }
   204	        }
   205	        return best?.token
   206	    }
   207	
   208	    /// Levenshtein distance, abandoned as soon as it exceeds `limit` (which is
   209	    /// what makes it cheap enough to run against a 1877-row catalog inline).
   210	    static func editDistance(_ lhs: String, _ rhs: String, limit: Int) -> Int? {
   211	        if lhs == rhs { return 0 }
   212	        let left = Array(lhs), right = Array(rhs)
   213	        if abs(left.count - right.count) > limit { return nil }
   214	
   215	        var previous = Array(0...right.count)
   216	        var current = [Int](repeating: 0, count: right.count + 1)
   217	        for i in 1...left.count {
   218	            current[0] = i
   219	            var rowBest = current[0]
   220	            for j in 1...right.count {
   221	                let substitution = previous[j - 1] + (left[i - 1] == right[j - 1] ? 0 : 1)
   222	                current[j] = min(substitution, previous[j] + 1, current[j - 1] + 1)
   223	                rowBest = min(rowBest, current[j])
   224	            }
   225	            if rowBest > limit { return nil }
   226	            swap(&previous, &current)
   227	        }
   228	        let distance = previous[right.count]
   229	        return distance <= limit ? distance : nil
   230	    }
   231	}
===== WorkoutTracker/Domain/MachineLabelOCR.swift
     1	import CoreGraphics
     2	import Foundation
     3	import Vision
     4	
     5	// Photo machine capture, ticket 01 — the camera-facing half: a photograph in,
     6	// a `LabelReading` out. Imports Vision; imports no UI, touches no store.
     7	//
     8	// Vision's text recognition is on device and offline, which is the only kind
     9	// that works in a basement gym and the only kind that keeps a photo of the
    10	// user's gym from leaving their phone. It also costs no dependency, which the
    11	// project's no-third-party rule requires.
    12	
    13	enum MachineLabelOCR {
    14	
    15	    enum Failure: Error, LocalizedError {
    16	        case recognitionFailed(underlying: Error)
    17	        case noTextFound
    18	
    19	        var errorDescription: String? {
    20	            switch self {
    21	            case .recognitionFailed(let underlying):
    22	                "Could not read the photo: \(underlying.localizedDescription)"
    23	            case .noTextFound:
    24	                "No text found in that photo."
    25	            }
    26	        }
    27	    }
    28	
    29	    /// Reads `image` off the main actor and returns its lines, top first.
    30	    ///
    31	    /// Throws `noTextFound` rather than returning an empty reading: "I saw
    32	    /// nothing" is a result the sheet has to say out loud, not an empty list to
    33	    /// render as zero candidates.
    34	    static func read(_ image: CGImage) async throws -> LabelReading {
    35	        let reading = try await Task.detached(priority: .userInitiated) {
    36	            try perform(image)
    37	        }.value
    38	        guard !reading.isEmpty else { throw Failure.noTextFound }
    39	        return reading
    40	    }
    41	
    42	    /// Synchronous recognition. Separated so tests can call it directly on a
    43	    /// rendered fixture without an async hop.
    44	    static func perform(_ image: CGImage) throws -> LabelReading {
    45	        let request = VNRecognizeTextRequest()
    46	        request.recognitionLevel = .accurate
    47	        // Off deliberately: "Insignia", "Cybex", "Hammer Strength" and
    48	        // "VSL019BP" are not dictionary words, and correction rewrites exactly
    49	        // the distinctive tokens the matcher depends on.
    50	        request.usesLanguageCorrection = false
    51	        request.recognitionLanguages = ["en-US"]
    52	
    53	        let handler = VNImageRequestHandler(cgImage: image, options: [:])
    54	        do {
    55	            try handler.perform([request])
    56	        } catch {
    57	            throw Failure.recognitionFailed(underlying: error)
    58	        }
    59	
    60	        // Each line keeps its own box, so the sort below cannot drift out of
    61	        // step with the text the way zipping two separately-filtered arrays
    62	        // would.
    63	        let lines = (request.results ?? []).compactMap {
    64	            observation -> (line: LabelReading.Line, top: CGFloat)? in
    65	            guard let candidate = observation.topCandidates(1).first else { return nil }
    66	            let text = candidate.string.trimmingCharacters(in: .whitespacesAndNewlines)
    67	            guard !text.isEmpty else { return nil }
    68	            return (
    69	                LabelReading.Line(
    70	                    text: text,
    71	                    confidence: Double(candidate.confidence),
    72	                    heightFraction: Double(observation.boundingBox.height)),
    73	                observation.boundingBox.maxY)
    74	        }
    75	        // Vision's origin is bottom-left, so "top of the plate" is the largest
    76	        // maxY. Order matters to the manufacturer guess, which trusts the top
    77	        // line when the catalog does not recognise the brand.
    78	        return LabelReading(lines: lines.sorted { $0.top > $1.top }.map(\.line))
    79	    }
    80	}
===== WorkoutTracker/Features/Gyms/ScanMachineLabelSheet.swift
     1	import SwiftData
     2	import SwiftUI
     3	import UIKit
     4	
     5	/// Photo machine capture, ticket 02 — photograph a machine's name plate, and
     6	/// let the user confirm which catalog model it is.
     7	///
     8	/// The sheet **proposes** (D33). It preselects the top hit when the match is
     9	/// strong, shows the alternatives with their scores, and always leaves "none of
    10	/// these" one tap away — because D23 keys history, prefill and PRs on the model
    11	/// UUID, so a wrong model silently accepted splits the user's own history.
    12	struct ScanMachineLabelSheet: View {
    13	    @Environment(\.modelContext) private var modelContext
    14	    @Environment(\.dismiss) private var dismiss
    15	
    16	    /// The user accepted a catalog row.
    17	    let onUseModel: (EquipmentModel) -> Void
    18	    /// The user wants a new model, prefilled with (manufacturer, model name).
    19	    let onCreateNew: (String, String) -> Void
    20	
    21	    @State private var phase: Phase = .idle
    22	    @State private var showingPicker = false
    23	    @State private var pickerSource: ImagePicker.Source = .preferred
    24	    @State private var selectedID: UUID?
    25	
    26	    private enum Phase {
    27	        case idle
    28	        case reading
    29	        case results(Results)
    30	        case failed(String)
    31	    }
    32	
    33	    private struct Results {
    34	        var reading: LabelReading
    35	        var matches: [CatalogMatch]
    36	        var manufacturerGuess: String
    37	        var modelNameGuess: String
    38	    }
    39	
    40	    var body: some View {
    41	        NavigationStack {
    42	            List {
    43	                switch phase {
    44	                case .idle:
    45	                    Label("Opening the camera…", systemImage: "camera")
    46	                        .foregroundStyle(.secondary)
    47	                        .accessibilityIdentifier("scanStatus")
    48	                case .reading:
    49	                    HStack(spacing: 10) {
    50	                        ProgressView()
    51	                        Text("Reading the label…")
    52	                    }
    53	                    .accessibilityIdentifier("scanStatus")
    54	                case .results(let results):
    55	                    resultsContent(results)
    56	                case .failed(let message):
    57	                    failureContent(message)
    58	                }
    59	            }
    60	            .navigationTitle("Scan Label")
    61	            .navigationBarTitleDisplayMode(.inline)
    62	            .toolbar {
    63	                ToolbarItem(placement: .cancellationAction) {
    64	                    Button("Cancel") { dismiss() }
    65	                }
    66	            }
    67	            .sheet(isPresented: $showingPicker) {
    68	                ImagePicker(source: pickerSource) { image in
    69	                    showingPicker = false
    70	                    guard let image else {
    71	                        // Backed out of the camera without taking anything.
    72	                        if case .idle = phase { dismiss() }
    73	                        return
    74	                    }
    75	                    read(image)
    76	                }
    77	                .ignoresSafeArea()
    78	            }
    79	            .onAppear(perform: start)
    80	        }
    81	    }
    82	
    83	    // MARK: - Content
    84	
    85	    @ViewBuilder
    86	    private func resultsContent(_ results: Results) -> some View {
    87	        Section {
    88	            Text(results.reading.text)
    89	                .font(.footnote.monospaced())
    90	                .foregroundStyle(.secondary)
    91	                .accessibilityIdentifier("scanReadingText")
    92	        } header: {
    93	            Text("What the camera read")
    94	        }
    95	
    96	        if results.matches.isEmpty {
    97	            Section {
    98	                Text("Nothing in the catalog looks like this label.")
    99	                    .foregroundStyle(.secondary)
   100	                    .accessibilityIdentifier("scanStatus")
   101	            }
   102	        } else {
   103	            Section {
   104	                ForEach(results.matches, id: \.modelID) { match in
   105	                    Button {
   106	                        selectedID = match.modelID
   107	                    } label: {
   108	                        HStack {
   109	                            VStack(alignment: .leading, spacing: 2) {
   110	                                Text(match.modelName)
   111	                                Text(match.manufacturer)
   112	                                    .font(.caption)
   113	                                    .foregroundStyle(.secondary)
   114	                            }
   115	                            Spacer()
   116	                            Text(percentage(match.score))
   117	                                .font(.caption.monospacedDigit())
   118	                                .foregroundStyle(.tertiary)
   119	                            if selectedID == match.modelID {
   120	                                Image(systemName: "checkmark")
   121	                                    .foregroundStyle(.tint)
   122	                            }
   123	                        }
   124	                    }
   125	                    .buttonStyle(.plain)
   126	                    .accessibilityIdentifier("scanCandidate.\(match.modelName)")
   127	                }
   128	            } header: {
   129	                Text(CatalogMatcher.suggestsCreatingNew(results.matches)
   130	                    ? "Closest catalog models" : "Catalog models")
   131	            } footer: {
   132	                Text(CatalogMatcher.suggestsCreatingNew(results.matches)
   133	                    ? "None of these is a confident match. If your machine isn't one of them, add it as a new model."
   134	                    : "Check the machine in front of you before accepting — records are kept per model, so the wrong one splits your history.")
   135	            }
   136	        }
   137	
   138	        Section {
   139	            Button("Use This") {
   140	                use(selectedID)
   141	            }
   142	            .disabled(selectedID == nil)
   143	            .accessibilityIdentifier("scanUseCandidate")
   144	
   145	            Button("None of these — create new") {
   146	                onCreateNew(results.manufacturerGuess, results.modelNameGuess)
   147	                dismiss()
   148	            }
   149	            .accessibilityIdentifier("scanCreateNew")
   150	
   151	            Button("Retake photo") { present(.preferred) }
   152	        }
   153	    }
   154	
   155	    @ViewBuilder
   156	    private func failureContent(_ message: String) -> some View {
   157	        Section {
   158	            Label(message, systemImage: "exclamationmark.triangle")
   159	                .accessibilityIdentifier("scanStatus")
   160	        }
   161	        Section {
   162	            Button("Try another photo") { present(.preferred) }
   163	            Button("Choose from photos") { present(.photoLibrary) }
   164	            Button("Enter it by hand") {
   165	                onCreateNew("", "")
   166	                dismiss()
   167	            }
   168	            .accessibilityIdentifier("scanCreateNew")
   169	        }
   170	    }
   171	
   172	    private func percentage(_ score: Double) -> String {
   173	        "\(Int((score * 100).rounded()))%"
   174	    }
   175	
   176	    // MARK: - Flow
   177	
   178	    private func start() {
   179	        guard case .idle = phase else { return }
   180	        if ScanFixture.isEnabled {
   181	            read(ScanFixture.image())
   182	        } else {
   183	            present(.preferred)
   184	        }
   185	    }
   186	
   187	    private func present(_ source: ImagePicker.Source) {
   188	        pickerSource = source
   189	        showingPicker = true
   190	    }
   191	
   192	    private func read(_ image: UIImage) {
   193	        phase = .reading
   194	        selectedID = nil
   195	        Task {
   196	            do {
   197	                guard let cgImage = image.cgImage else {
   198	                    throw MachineLabelOCR.Failure.noTextFound
   199	                }
   200	                // Vision runs off the main actor (`MachineLabelOCR.read`); the
   201	                // image is not retained past this call (D34).
   202	                let reading = try await MachineLabelOCR.read(cgImage)
   203	                let index = try catalogIndex()
   204	                let matches = CatalogMatcher.rank(reading, in: index)
   205	                let manufacturer = MachineLabelText.guessManufacturer(
   206	                    in: reading, knownManufacturers: index.manufacturers) ?? ""
   207	                phase = .results(Results(
   208	                    reading: reading,
   209	                    matches: matches,
   210	                    manufacturerGuess: manufacturer,
   211	                    modelNameGuess: MachineLabelText.guessModelName(
   212	                        in: reading, manufacturer: manufacturer)))
   213	                // Preselected, never applied on its own (D33).
   214	                selectedID = CatalogMatcher.isConfident(matches.first)
   215	                    ? matches.first?.modelID : nil
   216	            } catch {
   217	                phase = .failed(error.localizedDescription)
   218	            }
   219	        }
   220	    }
   221	
   222	    /// Built per scan from the store's own models, so a model the user added
   223	    /// five minutes ago is matchable too. Measured over the full 1877-row
   224	    /// catalog in `MachineLabelOCRTests`; the slow part of a scan is Vision,
   225	    /// which already runs off the main actor.
   226	    private func catalogIndex() throws -> CatalogMatchIndex {
   227	        CatalogMatchIndex(models: try modelContext
   228	            .fetch(FetchDescriptor<EquipmentModel>())
   229	            .map { (id: $0.id, manufacturer: $0.manufacturer, modelName: $0.modelName) })
   230	    }
   231	
   232	    private func use(_ modelID: UUID?) {
   233	        guard let modelID else { return }
   234	        do {
   235	            let matched = try modelContext.fetch(FetchDescriptor<EquipmentModel>(
   236	                predicate: #Predicate { $0.id == modelID }))
   237	            guard let model = matched.first else {
   238	                phase = .failed("That model is no longer in the catalog.")
   239	                return
   240	            }
   241	            onUseModel(model)
   242	            dismiss()
   243	        } catch {
   244	            phase = .failed("Could not open that model: \(error.localizedDescription)")
   245	        }
   246	    }
   247	}
   248	
   249	/// Test-only camera stand-in, gated on a launch argument exactly like
   250	/// `-uiTestReset`: the Simulator has no camera, so without this the scan flow
   251	/// could not be driven end to end by `WorkoutTrackerUITests` at all.
   252	enum ScanFixture {
   253	    static let launchArgument = "-uiTestScanFixture"
   254	
   255	    static var isEnabled: Bool {
   256	        ProcessInfo.processInfo.arguments.contains(launchArgument)
   257	    }
   258	
   259	    /// A rendered name plate for a model the seeded catalog really contains.
   260	    static func image() -> UIImage {
   261	        let size = CGSize(width: 1_600, height: 500)
   262	        return UIGraphicsImageRenderer(size: size).image { context in
   263	            UIColor.white.setFill()
   264	            context.fill(CGRect(origin: .zero, size: size))
   265	            draw("LIFE FITNESS", in: size, y: 60, fontSize: 64)
   266	            draw("Insignia Series Chest Press", in: size, y: 200, fontSize: 88)
   267	            draw("MAX 300 LB", in: size, y: 380, fontSize: 40)
   268	        }
   269	    }
   270	
   271	    private static func draw(_ text: String, in size: CGSize, y: CGFloat, fontSize: CGFloat) {
   272	        let font = UIFont.systemFont(ofSize: fontSize, weight: .semibold)
   273	        let string = NSAttributedString(
   274	            string: text, attributes: [.font: font, .foregroundColor: UIColor.black])
   275	        string.draw(at: CGPoint(x: (size.width - string.size().width) / 2, y: y))
   276	    }
   277	}
===== WorkoutTracker/Features/Gyms/ImagePicker.swift
     1	import SwiftUI
     2	import UIKit
     3	
     4	/// Photo machine capture, ticket 02 — a photograph of a name plate, from the
     5	/// camera or the photo library.
     6	///
     7	/// `UIImagePickerController` rather than `PhotosPicker`, because this needs the
     8	/// *camera* and PhotosPicker cannot take one; the same controller covers the
     9	/// library fallback, so there is one presentation path instead of two.
    10	struct ImagePicker: UIViewControllerRepresentable {
    11	    enum Source {
    12	        case camera
    13	        case photoLibrary
    14	
    15	        /// The camera, unless this device has none — a Simulator, or an iPad
    16	        /// with the camera restricted. A photo taken earlier is a perfectly
    17	        /// good input, so the fallback is silent rather than a dead button.
    18	        static var preferred: Source {
    19	            UIImagePickerController.isSourceTypeAvailable(.camera) ? .camera : .photoLibrary
    20	        }
    21	
    22	        var sourceType: UIImagePickerController.SourceType {
    23	            switch self {
    24	            case .camera: .camera
    25	            case .photoLibrary: .photoLibrary
    26	            }
    27	        }
    28	    }
    29	
    30	    let source: Source
    31	    /// nil = the user backed out.
    32	    let onPicked: (UIImage?) -> Void
    33	
    34	    func makeUIViewController(context: Context) -> UIImagePickerController {
    35	        let controller = UIImagePickerController()
    36	        controller.sourceType = source.sourceType
    37	        controller.allowsEditing = false
    38	        controller.delegate = context.coordinator
    39	        return controller
    40	    }
    41	
    42	    func updateUIViewController(_ controller: UIImagePickerController, context: Context) {}
    43	
    44	    func makeCoordinator() -> Coordinator {
    45	        Coordinator(onPicked: onPicked)
    46	    }
    47	
    48	    final class Coordinator: NSObject, UIImagePickerControllerDelegate,
    49	                             UINavigationControllerDelegate {
    50	        private let onPicked: (UIImage?) -> Void
    51	        /// The delegate can fire twice if the user is quick; the reading is
    52	        /// started from this callback, so it must happen exactly once.
    53	        private var hasFinished = false
    54	
    55	        init(onPicked: @escaping (UIImage?) -> Void) {
    56	            self.onPicked = onPicked
    57	        }
    58	
    59	        func imagePickerController(
    60	            _ picker: UIImagePickerController,
    61	            didFinishPickingMediaWithInfo info: [UIImagePickerController.InfoKey: Any]
    62	        ) {
    63	            finish(with: info[.originalImage] as? UIImage)
    64	        }
    65	
    66	        func imagePickerControllerDidCancel(_ picker: UIImagePickerController) {
    67	            finish(with: nil)
    68	        }
    69	
    70	        private func finish(with image: UIImage?) {
    71	            guard !hasFinished else { return }
    72	            hasFinished = true
    73	            onPicked(image)
    74	        }
    75	    }
    76	}
===== WorkoutTrackerTests/CatalogMatcherTests.swift
     1	import Foundation
     2	import Testing
     3	
     4	@testable import WorkoutTracker
     5	
     6	// Photo machine capture, ticket 01 — the matcher, which is the part that can
     7	// be wrong in a way that costs the user something. A missed match costs a few
     8	// taps; a confident wrong match attaches the user's sets to another machine's
     9	// UUID and splits their history (D23), so several of these tests are about
    10	// *refusing* to answer.
    11	
    12	struct CatalogMatcherTests {
    13	
    14	    // MARK: - Fixtures
    15	
    16	    /// A small catalog with the properties that matter: repeated words across
    17	    /// rows ("series", "chest", "press") so IDF has something to do, two rows
    18	    /// that differ by one distinctive word, and two manufacturers.
    19	    private func makeIndex() -> CatalogMatchIndex {
    20	        CatalogMatchIndex(models: catalog.map {
    21	            (id: $0.id, manufacturer: $0.manufacturer, modelName: $0.modelName)
    22	        })
    23	    }
    24	
    25	    private struct Row {
    26	        let id: UUID
    27	        let manufacturer: String
    28	        let modelName: String
    29	    }
    30	
    31	    private let catalog: [Row] = [
    32	        Row(id: UUID(uuidString: "00000000-0000-0000-0000-000000000001")!,
    33	            manufacturer: "Life Fitness", modelName: "Insignia Series Chest Press"),
    34	        Row(id: UUID(uuidString: "00000000-0000-0000-0000-000000000002")!,
    35	            manufacturer: "Life Fitness", modelName: "Insignia Series Shoulder Press"),
    36	        Row(id: UUID(uuidString: "00000000-0000-0000-0000-000000000003")!,
    37	            manufacturer: "Life Fitness", modelName: "Axiom Series Chest Press"),
    38	        Row(id: UUID(uuidString: "00000000-0000-0000-0000-000000000004")!,
    39	            manufacturer: "Hammer Strength", modelName: "Select Seated Leg Press"),
    40	        Row(id: UUID(uuidString: "00000000-0000-0000-0000-000000000005")!,
    41	            manufacturer: "Precor", modelName: "Vitality Series Seated Row VSL019BP"),
    42	        Row(id: UUID(uuidString: "00000000-0000-0000-0000-000000000006")!,
    43	            manufacturer: "Cybex", modelName: "Eagle NX Leg Extension"),
    44	    ]
    45	
    46	    private var insigniaChestPress: UUID { catalog[0].id }
    47	    private var insigniaShoulderPress: UUID { catalog[1].id }
    48	    private var hammerLegPress: UUID { catalog[3].id }
    49	    private var precorRow: UUID { catalog[4].id }
    50	
    51	    private func rank(_ lines: [String]) -> [CatalogMatch] {
    52	        CatalogMatcher.rank(LabelReading.lines(lines), in: makeIndex())
    53	    }
    54	
    55	    // MARK: - Finding the right row
    56	
    57	    @Test func readsAPlainNamePlate() throws {
    58	        let matches = rank(["LIFE FITNESS", "Insignia Series", "Chest Press"])
    59	        let best = try #require(matches.first)
    60	        #expect(best.modelID == insigniaChestPress)
    61	        #expect(CatalogMatcher.isConfident(best))
    62	    }
    63	
    64	    /// Vision returns lines in reading order, but a plate photographed at an
    65	    /// angle can come back out of order, and the brand is sometimes below.
    66	    @Test func lineOrderDoesNotMatter() throws {
    67	        let forward = rank(["LIFE FITNESS", "Insignia Series", "Chest Press"])
    68	        let scrambled = rank(["Chest Press", "LIFE FITNESS", "Insignia Series"])
    69	        #expect(forward.first?.modelID == scrambled.first?.modelID)
    70	        #expect(forward.first?.score == scrambled.first?.score)
    71	    }
    72	
    73	    /// The failures OCR actually makes: a swapped letter, an `I` read as `l`,
    74	    /// an `M` read as `H`.
    75	    @Test func singleCharacterMisreadsStillFindTheRow() throws {
    76	        for misread in ["Insigma Series Chest Press",
    77	                        "lnsignia Series Chest Press",
    78	                        "INSIGNIA SERIES CHEST PBESS"] {
    79	            let best = try #require(rank(["LIFE FITNESS", misread]).first)
    80	            #expect(best.modelID == insigniaChestPress, "failed on \(misread)")
    81	        }
    82	        let hammer = try #require(rank(["HAMIER STRENGTH", "Select Seated Leg Press"]).first)
    83	        #expect(hammer.modelID == hammerLegPress)
    84	    }
    85	
    86	    @Test func plateFurnitureDoesNotSinkTheMatch() throws {
    87	        let best = try #require(rank([
    88	            "LIFE FITNESS",
    89	            "Insignia Series Chest Press",
    90	            "MAX 300 LB / 136 KG",
    91	            "READ MANUAL BEFORE USE",
    92	            "SN 84213-9920",
    93	        ]).first)
    94	        #expect(best.modelID == insigniaChestPress)
    95	        #expect(CatalogMatcher.isConfident(best), "warnings must not cost the row its confidence")
    96	    }
    97	
    98	    /// A model code on the plate is evidence, not noise — Precor's own names
    99	    /// carry them.
   100	    @Test func aModelCodeIsEvidence() throws {
   101	        let best = try #require(rank(["VSL019BP"]).first)
   102	        #expect(best.modelID == precorRow)
   103	    }
   104	
   105	    // MARK: - Ranking, not just picking
   106	
   107	    @Test func siblingModelsRankInTheRightOrderAndBothAppear() throws {
   108	        let matches = rank(["LIFE FITNESS", "Insignia Series", "Shoulder Press"])
   109	        #expect(matches.first?.modelID == insigniaShoulderPress)
   110	        #expect(
   111	            matches.contains { $0.modelID == insigniaChestPress },
   112	            "the sibling belongs in the list — the plate may have been misread")
   113	        let shoulder = try #require(matches.first(where: { $0.modelID == insigniaShoulderPress }))
   114	        let chest = try #require(matches.first(where: { $0.modelID == insigniaChestPress }))
   115	        #expect(shoulder.score > chest.score)
   116	    }
   117	
   118	    @Test func rankingIsDeterministicAndBounded() throws {
   119	        let index = makeIndex()
   120	        let reading = LabelReading.lines(["LIFE FITNESS", "Series Press"])
   121	        let first = CatalogMatcher.rank(reading, in: index, limit: 3)
   122	        let second = CatalogMatcher.rank(reading, in: index, limit: 3)
   123	        #expect(first == second)
   124	        #expect(first.count <= 3)
   125	        #expect(first.map(\.score) == first.map(\.score).sorted(by: >))
   126	    }
   127	
   128	    // MARK: - Refusing to answer
   129	
   130	    /// Hardware the catalog does not have must not borrow a confident answer
   131	    /// from a row that happens to share a common word.
   132	    @Test func unknownHardwareScoresBelowTheCreateNewFloor() throws {
   133	        let matches = rank(["ATLANTIS STRENGTH", "Plate Loaded Belt Squat", "Model C-227"])
   134	        #expect(CatalogMatcher.suggestsCreatingNew(matches))
   135	        #expect(!CatalogMatcher.isConfident(matches.first))
   136	    }
   137	
   138	    /// IDF doing its job: words shared by half the catalog identify nothing.
   139	    @Test func commonWordsAloneAreNotAMatch() throws {
   140	        let matches = rank(["SERIES", "PRESS"])
   141	        #expect(!CatalogMatcher.isConfident(matches.first))
   142	    }
   143	
   144	    @Test func anEmptyOrUnreadableReadingRanksNothing() {
   145	        #expect(rank([]).isEmpty)
   146	        #expect(rank(["", "  "]).isEmpty)
   147	        // Single characters are noise, never evidence.
   148	        #expect(rank(["I", "®", "8"]).isEmpty)
   149	    }
   150	
   151	    // MARK: - Edit distance
   152	
   153	    @Test func editDistanceIsBoundedAndCorrect() {
   154	        #expect(CatalogMatcher.editDistance("insignia", "insignia", limit: 2) == 0)
   155	        // "insignia" → "insigma" is two edits (n→m, drop an i), which is why
   156	        // the long-token allowance is 2 rather than 1.
   157	        #expect(CatalogMatcher.editDistance("insignia", "insigma", limit: 2) == 2)
   158	        #expect(CatalogMatcher.editDistance("insignia", "insigma", limit: 1) == nil)
   159	        #expect(CatalogMatcher.editDistance("insignia", "lnsignia", limit: 2) == 1)
   160	        // Beyond the limit it reports nothing rather than a large number, so
   161	        // callers cannot accidentally treat "far apart" as "matched".
   162	        #expect(CatalogMatcher.editDistance("insignia", "shoulder", limit: 2) == nil)
   163	        #expect(CatalogMatcher.editDistance("press", "pressing", limit: 2) == nil)
   164	    }
   165	
   166	    // MARK: - Naming a new model (D35)
   167	
   168	    @Test func manufacturerGuessUsesTheCatalogSpelling() {
   169	        let index = makeIndex()
   170	        let reading = LabelReading.lines(["LIFE FITNESS", "Some Unlisted Press"])
   171	        #expect(
   172	            MachineLabelText.guessManufacturer(
   173	                in: reading, knownManufacturers: index.manufacturers) == "Life Fitness")
   174	    }
   175	
   176	    @Test func manufacturerGuessPrefersTheLongerBrandName() {
   177	        let known = ["Hammer", "Hammer Strength"]
   178	        let reading = LabelReading.lines(["HAMMER STRENGTH", "Iso-Lateral Row"])
   179	        #expect(
   180	            MachineLabelText.guessManufacturer(in: reading, knownManufacturers: known)
   181	                == "Hammer Strength")
   182	    }
   183	
   184	    @Test func anUnknownBrandFallsBackToTheTopLine() {
   185	        let reading = LabelReading.lines(["ATLANTIS", "Belt Squat", "MAX 400 LB"])
   186	        #expect(
   187	            MachineLabelText.guessManufacturer(in: reading, knownManufacturers: ["Cybex"])
   188	                == "ATLANTIS")
   189	    }
   190	
   191	    @Test func modelNameGuessSkipsJunkAndTheBrandItself() {
   192	        let reading = LabelReading(lines: [
   193	            LabelReading.Line(text: "ATLANTIS", confidence: 1, heightFraction: 0.05),
   194	            LabelReading.Line(text: "Belt Squat C-227", confidence: 1, heightFraction: 0.12),
   195	            LabelReading.Line(text: "MAX 400 LB", confidence: 1, heightFraction: 0.04),
   196	            LabelReading.Line(text: "READ MANUAL BEFORE USE", confidence: 1, heightFraction: 0.03),
   197	        ])
   198	        #expect(
   199	            MachineLabelText.guessModelName(in: reading, manufacturer: "ATLANTIS")
   200	                == "Belt Squat C-227")
   201	    }
   202	
   203	    @Test func junkLineDetection() {
   204	        #expect(MachineLabelText.isJunkLine("MAX 300 LB"))
   205	        #expect(MachineLabelText.isJunkLine("READ MANUAL BEFORE USE"))
   206	        #expect(MachineLabelText.isJunkLine("www.lifefitness.com"))
   207	        #expect(MachineLabelText.isJunkLine("84213-9920"))
   208	        #expect(MachineLabelText.isJunkLine("   "))
   209	        #expect(!MachineLabelText.isJunkLine("Insignia Series Chest Press"))
   210	        #expect(!MachineLabelText.isJunkLine("Eagle NX Leg Extension"))
   211	    }
   212	
   213	    // MARK: - Normalisation
   214	
   215	    @Test func normalisationFlattensPlateTypography() {
   216	        #expect(MachineLabelText.normalized("LIFE FITNESS®") == "life fitness")
   217	        #expect(MachineLabelText.normalized("Hammer  Strength™") == "hammer strength")
   218	        #expect(MachineLabelText.normalized("Iso-Lateral / Row") == "iso lateral row")
   219	        #expect(MachineLabelText.tokens("A Chest Press 2") == ["chest", "press"])
