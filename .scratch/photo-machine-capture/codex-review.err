   528	                    label: trimmedLabel,
   529	                    defaultUnit: defaultUnit,
   530	                    gym: gym,
   531	                    model: model))
   532	                try modelContext.save()
   533	            }
   534	        } catch {
   535	            assertionFailure("Failed to save machine: \(error)")
   536	        }
   537	        dismiss()
   538	    }
   539	}
   540	
   810	        index = CatalogModelIndex.build(models: models, exercises: exercises)
   811	        modelsByID = Dictionary(models.map { ($0.id, $0) }) { first, _ in first }
   812	    }
   813	}
   814	
   815	/// Inline user-model creation (D24: user ID space, `isSeeded == false`;
   816	/// must link at least one exercise).
   817	struct AddModelSheet: View {
   818	    @Environment(\.modelContext) private var modelContext
   819	    @Environment(\.dismiss) private var dismiss
   820	    /// Prefill from a scanned name plate (D35). Both stay editable: the scan
   821	    /// proposes a name, the user owns it.
   822	    var initialManufacturer: String = ""
   823	    var initialModelName: String = ""
   824	    var onCreate: (EquipmentModel) -> Void
   825	    @Query(sort: \Exercise.name) private var exercises: [Exercise]
   826	    @State private var manufacturer = ""
   827	    @State private var modelName = ""
   828	    @State private var equipmentType: EquipmentCategory?
   829	    @State private var linkedExerciseIDs: Set<UUID> = []
   830	    @State private var loadedPrefill = false
   831	
   832	    var body: some View {
   833	        NavigationStack {
   834	            Form {
   835	                Section {
   836	                    TextField("Manufacturer", text: $manufacturer)
   837	                    TextField("Model", text: $modelName)
   838	                    // Optional (ticket 21): a model with no type still shows
   839	                    // up — under "Uncategorized" — rather than being hidden
   840	                    // by a filter it cannot answer (D24).
   841	                    Picker("Equipment type", selection: $equipmentType) {
   842	                        Text("Not set").tag(EquipmentCategory?.none)
   843	                        ForEach(EquipmentCategory.allCases) { type in
   844	                            Text(type.label).tag(EquipmentCategory?.some(type))
   845	                        }
   846	                    }
   847	                    .accessibilityIdentifier("newModelEquipmentType")
   848	                }
   849	                Section {
   850	                    ForEach(exercises) { exercise in
   851	                        Button {
   852	                            toggle(exercise.id)
   853	                        } label: {
   854	                            HStack {
   855	                                Text(exercise.name)
   856	                                Spacer()
   857	                                if linkedExerciseIDs.contains(exercise.id) {
   858	                                    Image(systemName: "checkmark")
   859	                                        .foregroundStyle(.tint)
   860	                                }
   861	                            }
   862	                        }
   863	                        .buttonStyle(.plain)
   864	                    }
   865	                } header: {
   866	                    Text("Exercises")
   867	                } footer: {
   868	                    Text("Link at least one exercise this model serves — multi-exercise stations can link several.")
   869	                }
   870	            }
   871	            .navigationTitle("New Model")
   872	            .navigationBarTitleDisplayMode(.inline)
   873	            .toolbar {
   874	                ToolbarItem(placement: .cancellationAction) {
   875	                    Button("Cancel") { dismiss() }
   876	                }
   877	                ToolbarItem(placement: .confirmationAction) {
   878	                    Button("Add") { addModel() }
   879	                        .disabled(!isValid)
   880	                        .accessibilityIdentifier("saveNewModel")
   881	                }
   882	            }
   883	            .onAppear(perform: applyPrefill)
   884	        }
   885	    }
   886	
   887	    /// Once only: after this the fields are the user's, even if the view
   888	    /// re-appears behind another sheet.
   889	    private func applyPrefill() {
   890	        guard !loadedPrefill else { return }
   891	        loadedPrefill = true
   892	        if manufacturer.isEmpty { manufacturer = initialManufacturer }
   893	        if modelName.isEmpty { modelName = initialModelName }
   894	    }
   895	
   896	    private var trimmedManufacturer: String {
   897	        manufacturer.trimmingCharacters(in: .whitespacesAndNewlines)
   898	    }
   899	
   900	    private var trimmedModelName: String {
   901	        modelName.trimmingCharacters(in: .whitespacesAndNewlines)
   902	    }
   903	
   904	    private var isValid: Bool {
   905	        !trimmedManufacturer.isEmpty && !trimmedModelName.isEmpty
   906	            && !linkedExerciseIDs.isEmpty
   907	    }
   908	
   909	    private func toggle(_ id: UUID) {
   910	        if linkedExerciseIDs.contains(id) {
   911	            linkedExerciseIDs.remove(id)
   912	        } else {
   913	            linkedExerciseIDs.insert(id)
   914	        }
   915	    }
   916	
   917	    private func addModel() {
   918	        // Preserve the catalog's display order in the stored link list.
   919	        let orderedIDs = exercises.map(\.id).filter(linkedExerciseIDs.contains)
   920	        let model = EquipmentModel(
   921	            manufacturer: trimmedManufacturer,
   922	            modelName: trimmedModelName,
   923	            exerciseIDs: orderedIDs,
   924	            equipmentType: equipmentType,
   925	            isSeeded: false)
   926	        modelContext.insert(model)
   927	        do {
   928	            try modelContext.save()
   929	        } catch {
   930	            assertionFailure("Failed to save new model: \(error)")
   931	        }
   932	        onCreate(model)
   933	        dismiss()
   934	    }
   935	}
   936	
   937	#Preview {
   938	    let container = try! ModelContainer(
   939	        for: WorkoutTrackerStore.schema,
   940	        configurations: [ModelConfiguration(isStoredInMemoryOnly: true)])
   941	    container.mainContext.insert(Gym(name: "Gangnam Fitness", city: "Seoul", defaultUnit: .kg))
   942	    container.mainContext.insert(Gym(name: "Hotel Gym"))
   943	    return GymsView()
   944	        .modelContainer(container)
   945	}

