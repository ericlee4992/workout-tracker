from itertools import product

def early(a,b,k):
 if a==b:return 0
 if abs(len(a)-len(b))>k:return None
 p=list(range(len(b)+1));c=[0]*(len(b)+1)
 for i in range(1,len(a)+1):
  c[0]=i; rb=c[0]
  for j in range(1,len(b)+1):
   c[j]=min(p[j-1]+(a[i-1]"'!=b[j-1]),p[j]+1,c[j-1]+1);rb=min(rb,c[j])
  if rb>k:return None
  p,c=c,p
 d=p[len(b)];return d if d<=k else None

def full(a,b):
 p=list(range(len(b)+1))
 for i,x in enumerate(a,1):
  c=[i]
  for j,y in enumerate(b,1):c.append(min(p[j-1]+(x!=y),p[j]+1,c[j-1]+1))
  p=c
 return p[-1]
for n in range(1,8):
 for m in range(1,8):
  for a in map('"''.join,product('ab',repeat=n)):
   for b in map(''.join,product('ab',repeat=m)):
    for k in (1,2):
     e=early(a,b,k); f=full(a,b)
     if f<=k and e is None: print('bad',a,b,k,f);raise SystemExit
print('no false nil <=7 binary')
