     1	import XCTest
     2	
     3	/// Photo machine capture, ticket 03 — the scan flow end to end.
     4	///
     5	/// The Simulator has no camera, so the app is launched with
     6	/// `-uiTestScanFixture`, which substitutes a rendered name plate for the
     7	/// camera roll. Everything after that point — Vision, the matcher, the
     8	/// candidate list, accepting a model — is the real code path.
     9	final class ScanMachineLabelUITests: XCTestCase {
    10	    private var app: XCUIApplication!
    11	
    12	    private let gymName = "Scan Test Gym"
    13	    /// What `ScanFixture` renders, and a real row in the seeded catalog.
    14	    private let expectedModel = "Insignia Series Chest Press"
    15	
    16	    override func setUp() {
    17	        super.setUp()
    18	        continueAfterFailure = false
    19	        app = XCUIApplication()
    20	        app.launchArguments = ["-uiTestReset", "-uiTestScanFixture"]
    21	        app.launch()
    22	    }
    23	
    24	    func testScanningALabelFindsTheCatalogModelAndCanBeOverridden() {
    25	        createGym()
    26	        openNewMachineSheet()
    27	
    28	        // --- Scan: the fixture plate resolves to its catalog row -----------
    29	        app.buttons["scanMachineLabel"].tap()
    30	
    31	        let candidate = app.descendants(matching: .any)
    32	            .matching(identifier: "scanCandidate.\(expectedModel)").firstMatch
    33	        XCTAssertTrue(
    34	            candidate.waitForExistence(timeout: 20),
    35	            "Scanning the fixture label should offer its catalog model")
    36	
    37	        let readingText = app.staticTexts["scanReadingText"]
    38	        XCTAssertTrue(readingText.exists, "The sheet should echo what it read")
    39	        XCTAssertTrue(
    40	            readingText.label.uppercased().contains("LIFE FITNESS"),
    41	            "Expected the plate's text, got: \(readingText.label)")
    42	
    43	        // D33: a confident match is *preselected*, so accepting is one tap —
    44	        // but it is still a tap.
    45	        let use = app.buttons["scanUseCandidate"]
    46	        XCTAssertTrue(use.isEnabled, "A confident match should arrive preselected")
    47	        use.tap()
    48	
    49	        // --- Back on the New Machine sheet, with the model filled in -------
    50	        let modelRow = app.descendants(matching: .any)
    51	            .matching(identifier: "catalogModel").firstMatch
    52	        XCTAssertTrue(modelRow.waitForExistence(timeout: 5))
    53	        XCTAssertTrue(
    54	            modelRow.label.contains(expectedModel),
    55	            "The scanned model should be filled in, got: \(modelRow.label)")
    56	
    57	        // D3: picking a model names the machine, however it was picked.
    58	        let label = app.textFields["machineLabel"]
    59	        XCTAssertTrue(label.waitForExistence(timeout: 5))
    60	        XCTAssertEqual(
    61	            label.value as? String, expectedModel,
    62	            "A scanned model should default the label exactly as a hand-picked one does")
    63	        // Saved as-is: the whole point of the default is that a scan leaves
    64	        // nothing to type while standing at the machine.
    65	        app.buttons["saveMachine"].tap()
    66	        XCTAssertTrue(
    67	            app.staticTexts[expectedModel].waitForExistence(timeout: 5),
    68	            "The machine should be saved at the gym under its scanned name")
    69	    }
    70	
    71	    /// The other half of the ask: when the catalog does not have the machine,
    72	    /// the scan still gets you a model — a user-created one, prefilled (D35).
    73	    func testCreateNewFromAScanPrefillsTheModelSheet() {
    74	        createGym()
    75	        openNewMachineSheet()
    76	
    77	        app.buttons["scanMachineLabel"].tap()
    78	        let createNew = app.buttons["scanCreateNew"]
    79	        XCTAssertTrue(
    80	            createNew.waitForExistence(timeout: 20),
    81	            "Create-new must always be reachable from a scan")
    82	        createNew.tap()
    83	
    84	        let manufacturer = app.textFields["Manufacturer"]
    85	        XCTAssertTrue(
    86	            manufacturer.waitForExistence(timeout: 5),
    87	            "Create-new should open the New Model sheet")
    88	        XCTAssertEqual(
    89	            manufacturer.value as? String, "Life Fitness",
    90	            "The manufacturer should arrive prefilled in the catalog's spelling")
    91	        let modelField = app.textFields["Model"]
    92	        XCTAssertEqual(
    93	            modelField.value as? String, expectedModel,
    94	            "The model name should arrive prefilled from the plate")
    95	    }
    96	
    97	    // MARK: - Helpers
    98	
    99	    private func createGym() {
   100	        app.tabBars.buttons["Gyms"].tap()
   101	        app.buttons["addGym"].tap()
   102	
   103	        let name = app.textFields["gymName"]
   104	        XCTAssertTrue(name.waitForExistence(timeout: 5))
   105	        name.tap()
   106	        name.typeText(gymName)
   107	        app.buttons["saveGym"].tap()
   108	
   109	        let row = app.descendants(matching: .any)
   110	            .matching(identifier: "gymRow.\(gymName)").firstMatch
   111	        XCTAssertTrue(row.waitForExistence(timeout: 5), "The new gym should be listed")
   112	    }
   113	
   114	    private func openNewMachineSheet() {
   115	        app.descendants(matching: .any)
   116	            .matching(identifier: "gymRow.\(gymName)").firstMatch.tap()
   117	        let add = app.buttons["addMachine"]
   118	        XCTAssertTrue(add.waitForExistence(timeout: 5))
   119	        add.tap()
   120	        XCTAssertTrue(app.textFields["machineLabel"].waitForExistence(timeout: 5))
   121	    }
   122	}

