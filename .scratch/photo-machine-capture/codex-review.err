   114	        let chest = try #require(matches.first(where: { $0.modelID == insigniaChestPress }))
   115	        #expect(shoulder.score > chest.score)
   116	    }
   117	
   118	    @Test func rankingIsDeterministicAndBounded() throws {
   119	        let index = makeIndex()
