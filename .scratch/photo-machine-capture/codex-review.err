   689	    private func modelButton(_ row: CatalogModelRow) -> some View {
   690	        Button {
   691	            select(row)
   692	        } label: {
   693	            HStack {
   694	                VStack(alignment: .leading, spacing: 2) {
   695	                    Text(row.displayName)
   696	                    HStack(spacing: 6) {
   697	                        // D24: a user's own model sits in the same list as the
   698	                        // catalog's, labelled rather than segregated.
   699	                        if !row.isSeeded {
   700	                            Text("Custom")
   701	                        }
   702	                        if let type = row.equipmentType {
   703	                            Text(type.label)
   704	                        }
   705	                        if !row.bodyAreas.isEmpty {
   706	                            Text(row.bodyAreas.joined(separator: " · "))
   707	                        }
   708	                    }
   709	                    .font(.caption)
   710	                    .foregroundStyle(.secondary)
   711	                }
   712	                Spacer()
   713	                if selection?.id == row.id {
   714	                    Image(systemName: "checkmark")
   715	                        .foregroundStyle(.tint)
   716	                }
   717	            }
   718	        }
   719	        .buttonStyle(.plain)
   720	        .accessibilityIdentifier("modelOption.\(row.displayName)")
   721	    }
   722	
   723	    /// Grouping and both filters in one menu. Deliberately plain `Button`s
   724	    /// rather than `Picker`s: a menu button can carry its own accessibility
   725	    /// identifier, which is what makes this screen drivable from a UI test.
   726	    private var browseMenu: some View {
   727	        Menu {
   728	            Menu("Group By") {
   729	                ForEach(CatalogGrouping.allCases) { mode in
   730	                    BrowseMenuOption(title: mode.label, isSelected: grouping == mode) {
   731	                        write { $0.modelBrowseGrouping = mode }
   732	                    }
   733	                    .accessibilityIdentifier("modelGrouping.\(mode.rawValue)")
   734	                }
   735	            }
   736	
   737	            Menu("Body Area") {
   738	                BrowseMenuOption(title: "All body areas", isSelected: filter.bodyArea == nil) {
   739	                    write { $0.modelBrowseMuscleGroup = nil }
   740	                }
   741	                .accessibilityIdentifier("modelFilter.bodyArea.all")
   742	                ForEach(index.bodyAreas, id: \.self) { area in
   743	                    BrowseMenuOption(title: area, isSelected: filter.bodyArea == area) {
   744	                        write { $0.modelBrowseMuscleGroup = area }
   745	                    }
   746	                    .accessibilityIdentifier("modelFilter.bodyArea.\(area)")
   747	                }
   748	            }
   749	
   750	            Menu("Equipment Type") {
   751	                BrowseMenuOption(
   752	                    title: "All types", isSelected: filter.equipmentType == nil
   753	                ) {
   754	                    write { $0.modelBrowseEquipmentType = nil }
   755	                }
   756	                .accessibilityIdentifier("modelFilter.type.all")
   757	                ForEach(index.equipmentTypes) { type in
   758	                    BrowseMenuOption(
   759	                        title: type.label, isSelected: filter.equipmentType == type
   760	                    ) {
   761	                        write { $0.modelBrowseEquipmentType = type }
   762	                    }
   763	                    .accessibilityIdentifier("modelFilter.type.\(type.rawValue)")
   764	                }
   765	            }
   766	
   767	            if filter.hasActiveFilters {
   768	                Button("Clear Filters", systemImage: "xmark.circle") { clearFilters() }
   769	            }
   770	        } label: {
   771	            Label(
   772	                "Browse",
   773	                systemImage: filter.hasActiveFilters
   774	                    ? "line.3.horizontal.decrease.circle.fill"
   775	                    : "line.3.horizontal.decrease.circle")
   776	        }
   777	        .accessibilityIdentifier("modelBrowseMenu")
   778	    }
   779	
   780	    private var filterSummary: String {
   781	        [filter.bodyArea, filter.equipmentType?.label]
   782	            .compactMap { $0 }
   783	            .joined(separator: " · ")
   784	    }
   785	
   786	    private func clearFilters() {
   787	        write {
   788	            $0.modelBrowseMuscleGroup = nil
   789	            $0.modelBrowseEquipmentType = nil
   790	        }
   791	    }
   792	
   793	    private func write(_ change: (AppPreferences) -> Void) {
   794	        do {
   795	            let preferences = try AppPreferences.canonical(in: modelContext)
   796	            change(preferences)
   797	            preferences.updatedAt = .now
   798	            try modelContext.save()
   799	        } catch {
   800	            assertionFailure("Failed to save catalog browsing preference: \(error)")
   801	        }
   802	    }
   803	
   804	    private func select(_ row: CatalogModelRow) {
   805	        selection = modelsByID[row.id]
   806	        dismiss()
   807	    }
