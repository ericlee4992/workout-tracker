===== WorkoutTrackerTests/MachineLabelOCRTests.swift
     1	import CoreGraphics
     2	import CoreText
     3	import Foundation
     4	import SwiftData
     5	import Testing
     6	import UIKit
     7	
     8	@testable import WorkoutTracker
     9	
    10	// Photo machine capture, ticket 01 — the one test that runs the whole chain:
    11	// pixels → Vision → matcher → a catalog row. The label is rendered here rather
    12	// than checked in as a photo, so the test is hermetic and the fixture is
    13	// readable in the diff.
    14	//
    15	// Vision itself is Apple's; these tests are not trying to measure it. They are
    16	// checking that this app hands it a sane image, reads its output in the right
    17	// order, and feeds the matcher something it can work with.
    18	
    19	struct MachineLabelOCRTests {
    20	
    21	    /// Draws a name-plate-ish image: brand small on top, model large beneath,
    22	    /// a load rating and a warning in the corner like the real thing.
    23	    private func renderLabel(
    24	        brand: String, model: String, extras: [String] = [],
    25	        size: CGSize = CGSize(width: 1_600, height: 620)
    26	    ) -> CGImage {
    27	        let renderer = UIGraphicsImageRenderer(size: size)
    28	        let image = renderer.image { context in
    29	            UIColor.white.setFill()
    30	            context.fill(CGRect(origin: .zero, size: size))
    31	
    32	            /// Draws centred, shrinking the type until the line fits — a
    33	            /// clipped fixture would test Vision's guess at half a word
    34	            /// rather than this app's handling of a legible plate.
    35	            func draw(_ text: String, y: CGFloat, size fontSize: CGFloat) {
    36	                var font = UIFont.systemFont(ofSize: fontSize, weight: .semibold)
    37	                var string = NSAttributedString(string: text, attributes: [.font: font])
    38	                while string.size().width > size.width - 80, font.pointSize > 12 {
    39	                    font = UIFont.systemFont(ofSize: font.pointSize - 4, weight: .semibold)
    40	                    string = NSAttributedString(string: text, attributes: [.font: font])
    41	                }
    42	                let attributed = NSAttributedString(
    43	                    string: text,
    44	                    attributes: [.font: font, .foregroundColor: UIColor.black])
    45	                attributed.draw(
    46	                    at: CGPoint(x: (size.width - attributed.size().width) / 2, y: y))
    47	            }
    48	
    49	            draw(brand, y: 60, size: 64)
    50	            draw(model, y: 200, size: 96)
    51	            for (index, extra) in extras.enumerated() {
    52	                draw(extra, y: 400 + CGFloat(index) * 60, size: 40)
    53	            }
    54	        }
    55	        return image.cgImage!
    56	    }
    57	
    58	    private func makeIndex() -> CatalogMatchIndex {
    59	        CatalogMatchIndex(models: [
    60	            (id: UUID(uuidString: "00000000-0000-0000-0000-0000000000A1")!,
    61	             manufacturer: "Life Fitness", modelName: "Insignia Series Chest Press"),
    62	            (id: UUID(uuidString: "00000000-0000-0000-0000-0000000000A2")!,
    63	             manufacturer: "Life Fitness", modelName: "Insignia Series Shoulder Press"),
    64	            (id: UUID(uuidString: "00000000-0000-0000-0000-0000000000A3")!,
    65	             manufacturer: "Hammer Strength", modelName: "Select Seated Leg Press"),
    66	        ])
    67	    }
    68	
    69	    @Test func readsARenderedNamePlateTopLineFirst() throws {
    70	        let image = renderLabel(
    71	            brand: "LIFE FITNESS", model: "Insignia Series Chest Press",
    72	            extras: ["MAX 300 LB"])
    73	        let reading = try MachineLabelOCR.perform(image)
    74	
    75	        #expect(!reading.isEmpty)
    76	        let text = MachineLabelText.normalized(reading.text)
    77	        #expect(text.contains("life fitness"))
    78	        #expect(text.contains("chest press"))
    79	        #expect(reading.lines.first?.text.uppercased().contains("LIFE FITNESS") == true,
    80	                "lines must come back top of the plate first, got: \(reading.text)")
    81	        // The model name is set larger than the brand, and Vision's boxes
    82	        // should say so — the create-new guess leans on this.
    83	        let brandLine = try #require(reading.lines.first)
    84	        let modelLine = try #require(reading.lines.first { $0.text.lowercased().contains("chest") })
    85	        #expect(modelLine.heightFraction > brandLine.heightFraction)
    86	    }
    87	
    88	    @Test func aPhotographedPlateFindsItsCatalogRow() throws {
    89	        let image = renderLabel(
    90	            brand: "LIFE FITNESS", model: "Insignia Series Chest Press",
    91	            extras: ["MAX 300 LB", "READ MANUAL BEFORE USE"])
    92	        let reading = try MachineLabelOCR.perform(image)
    93	        let matches = CatalogMatcher.rank(reading, in: makeIndex())
    94	
    95	        let best = try #require(matches.first, "read: \(reading.text)")
    96	        #expect(best.modelName == "Insignia Series Chest Press")
    97	        #expect(CatalogMatcher.isConfident(best), "scored \(best.score) on \(reading.text)")
    98	    }
    99	
   100	    @Test func aBlankPhotoReportsThatItSawNothing() async {
   101	        let renderer = UIGraphicsImageRenderer(size: CGSize(width: 400, height: 400))
   102	        let blank = renderer.image { context in
   103	            UIColor.lightGray.setFill()
   104	            context.fill(CGRect(x: 0, y: 0, width: 400, height: 400))
   105	        }.cgImage!
   106	
   107	        await #expect(throws: MachineLabelOCR.Failure.self) {
   108	            _ = try await MachineLabelOCR.read(blank)
   109	        }
   110	    }
   111	
   112	    /// The case the thresholds are tuned against, on the real catalog: a Life
   113	    /// Fitness Insignia chest press shares "Insignia Series" and its brand with
   114	    /// five stablemates. Exactly one row may clear the confident bar, or a
   115	    /// misread of the single distinguishing word ("Chest") would preselect the
   116	    /// wrong machine and quietly split the user's history (D23/D33).
   117	    @Test func onlyTheRightRowClearsTheConfidentBarAmongItsStablemates() throws {
   118	        let catalog = try SeedCatalog.bundled()
   119	        let index = CatalogMatchIndex(models: catalog.equipmentModels.map {
   120	            (id: $0.id, manufacturer: $0.manufacturer, modelName: $0.modelName)
   121	        })
   122	        let matches = CatalogMatcher.rank(
   123	            LabelReading.lines(["LIFE FITNESS", "Insignia Series Chest Press", "MAX 300 LB"]),
   124	            in: index, limit: 6)
   125	
   126	        let best = try #require(matches.first)
   127	        #expect(best.modelName == "Insignia Series Chest Press")
   128	        #expect(CatalogMatcher.isConfident(best))
   129	        let confident = matches.filter { CatalogMatcher.isConfident($0) }
   130	        let names = confident.map { "\($0.modelName) \($0.score)" }.joined(separator: ", ")
   131	        #expect(confident.count == 1, "stablemates must stay below the bar, got: \(names)")
   132	        #expect(matches.count > 1, "the stablemates still belong in the list")
   133	    }
   134	
   135	    /// The index the app really builds — 1877 seeded rows — has to be cheap
   136	    /// enough to construct and query while the user waits on a tap.
   137	    @Test func indexingAndRankingTheRealCatalogIsFastEnough() throws {
   138	        let catalog = try SeedCatalog.bundled()
   139	        let started = Date()
   140	        let index = CatalogMatchIndex(models: catalog.equipmentModels.map {
   141	            (id: $0.id, manufacturer: $0.manufacturer, modelName: $0.modelName)
   142	        })
   143	        let built = Date()
   144	        let matches = CatalogMatcher.rank(
   145	            LabelReading.lines(["LIFE FITNESS", "Insignia Series Chest Press", "MAX 300 LB"]),
   146	            in: index)
   147	        let ranked = Date()
   148	
   149	        #expect(index.entries.count > 1_000, "sanity: this is the shipped catalog")
   150	        #expect(!matches.isEmpty)
   151	        #expect(matches.first?.manufacturer == "Life Fitness")
   152	        // Loose on purpose: the point is catching an accidental O(n²), not
   153	        // timing a particular Mac.
   154	        #expect(built.timeIntervalSince(started) < 5, "index build took too long")
   155	        #expect(ranked.timeIntervalSince(built) < 2, "ranking took too long")
   156	    }
   157	}
