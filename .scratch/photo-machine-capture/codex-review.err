# Use a dependency-free exact-token version: these cases need no fuzzy matching.
import json,re,math,collections
R=json.load(open('WorkoutTracker/Resources/SeedCatalog.json'))['equipmentModels'];T=lambda s:[x.lower() for x in re.findall(r'[A-Za-z0-9]+',s) if len(x)>1];N=len(R);D=collections.Counter();P=[]
for r in R:
 m=T(r['manufacturer']);n=sorted(set(T(r['modelName'])));a=sorted(set(m+n));D.update(a);P.append((r,m,n,a))
W={x:math.log(1+N/(1+f)) for x,f in D.items()}
def exact(s):
 q=set(T(s));rw=sum(W.get(x,0) for x in q);o=[]
 for r,m,n,a in P:
  den=sum(W[x] for x in n); hits=set(a)&q;co=sum(W[x] for x in hits if x in n);ex=sum(W[x] for x in hits)
  if not co:continue
  sc=min(1,.85*co/den+.12*min(1,ex/rw)+(.1 if m and all(x in q for x in m) else 0))
  if sc>=.25:o.append((sc,r['manufacturer'],r['modelName']))
 return sorted(o,key=lambda x:(-x[0],x[1]+' '+x[2]))[:10]
for s in ['NAUTILUS 5 STATION','PRIME FITNESS PRODIGY HLP SELECTORIZED RACK 4:1','ROGUE FITNESS R-6 POWER RACK','LIFE FITNESS INSIGNIA SERIES BACK EXTENSION','NEWCO PENDULUM SQUAT']:
 print('\\n'+s, 'TOKENS',T(s))
 for x in exact(s):print(f'{x[0]:.6f}',x[1],'|',x[2])
