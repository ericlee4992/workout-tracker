   157	        #expect(CatalogMatcher.editDistance("insignia", "insigma", limit: 2) == 2)
   158	        #expect(CatalogMatcher.editDistance("insignia", "insigma", limit: 1) == nil)
   159	        #expect(CatalogMatcher.editDistance("insignia", "lnsignia", limit: 2) == 1)
   160	        // Beyond the limit it reports nothing rather than a large number, so
   161	        // callers cannot accidentally treat "far apart" as "matched".
   162	        #expect(CatalogMatcher.editDistance("insignia", "shoulder", limit: 2) == nil)
   163	        #expect(CatalogMatcher.editDistance("press", "pressing", limit: 2) == nil)
   164	    }
   165	
