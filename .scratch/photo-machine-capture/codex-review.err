# Compact exact matcher port for adversarial fuzzy readings.
import json,re,math,collections
R=json.load(open('WorkoutTracker/Resources/SeedCatalog.json'))['equipmentModels']; T=lambda s:[x.lower() for x in re.findall(r'[A-Za-z0-9]+',s) if len(x)>1]; N=len(R);D=collections.Counter();P=[]
for r in R:
 m=T(r['manufacturer']);n=sorted(set(T(r['modelName'])));a=sorted(set(m+n));D.update(a);P.append((r,m,n,a))
W={x:math.log(1+N/(1+f)) for x,f in D.items()}
def E(a,b,l):
 if abs(len(a)-len(b))>l:return None
 p=list(range(len(b)+1))
 for i,x in enumerate(a,1):
  c=[i];z=i
  for j,y in enumerate(b,1):c.append(min(p[j]+1,c[j-1]+1,p[j-1]+(x"'!=y)));z=min(z,c[j])
  if z>l:return None
  p=c
 return p[-1] if p[-1]<=l else None
def near(t,q):
 if W[t]<1.5 or len(t)<4:return None
 l=2 if len(t)>=7 else 1
 z=[]
 for c in q:
  if abs(len(c)-len(t))<=l and (c[0]==t[0] or c[-1]==t[-1]):
   d=E(t,c,l)
   if d is not None:z.append((d,c))
 return min(z)[1] if z else None
def rank(s):
 q=set(T(s));rw=sum(W.get(x,0) for x in q);o=[]
 for r,m,n,a in P:
  den=sum(W[x] for x in n);co=ex=0
  for t in a:
   if t in q:z=t;f=1
   else:z=near(t,q);f=.85
   if z:
    if t in n:co+=W[t]*f
    ex+=W.get(z,0)
  if not co:continue
  mh=m and all(x in q or near(x,q) for x in m)
  sc=min(1,.85*co/den+.12*min(1,ex/rw)+(.1 if mh else 0))
  if sc>=.25:o.append((sc,r['"'manufacturer'],r['modelName']))
 return sorted(o,key=lambda x:(-x[0],x[1]+' '+x[2]))[:10]
for s in ['LIFE FITNESS INSIGNIA SERIES HIP ABDUCTION','CYBEX EAGLE NX HIP ABDUCTION','HIP ABDUCTION','HAMMER STRENGTH RACK','NAUTILUS HACK SQUAT','JAMMER STRENGTH GROUND BASE JAMMER','HOIST NOISI']:
 print('\\n'+s)
 for x in rank(s):print(f'{x[0]:.6f}',x[1],'|',x[2])
