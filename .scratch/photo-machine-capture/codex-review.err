   104	
   105	    // MARK: - Ranking, not just picking
   106	
   107	    @Test func siblingModelsRankInTheRightOrderAndBothAppear() throws {
   108	        let matches = rank(["LIFE FITNESS", "Insignia Series", "Shoulder Press"])
   109	        #expect(matches.first?.modelID == insigniaShoulderPress)
