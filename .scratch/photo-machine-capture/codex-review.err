   272	        let font = UIFont.systemFont(ofSize: fontSize, weight: .semibold)
   273	        let string = NSAttributedString(
   274	            string: text, attributes: [.font: font, .foregroundColor: UIColor.black])
   275	        string.draw(at: CGPoint(x: (size.width - string.size().width) / 2, y: y))
