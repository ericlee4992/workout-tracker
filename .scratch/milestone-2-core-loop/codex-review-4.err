   182	
   183	// MARK: - Index
   184	
   185	/// The catalog as value types, built once per screen appearance. Also carries
   186	/// the filter vocabularies actually present, so the filter menus offer body
   187	/// areas and equipment types the catalog really has.
   188	struct CatalogModelIndex {
   189	    /// Sorted by manufacturer, then model name — which is also A–Z of the
   190	    /// display name, so the flat list needs no second sort.
   191	    let rows: [CatalogModelRow]
   192	    let manufacturers: [String]
   193	    let bodyAreas: [String]
   194	    let equipmentTypes: [EquipmentCategory]
   195	
   196	    init(rows: [CatalogModelRow]) {
   197	        self.rows = rows.sorted(by: CatalogBrowsing.precedes)
   198	        self.manufacturers = CatalogBrowsing
   199	            .uniqueValues(rows.map(\.manufacturer))
   200	            .sorted { $0.localizedCaseInsensitiveCompare($1) == .orderedAscending }
   201	        self.bodyAreas = CatalogBrowsing.bodyAreasPresent(in: rows.flatMap(\.bodyAreas))
   202	        self.equipmentTypes = EquipmentCategory.allCases.filter { type in
   203	            rows.contains { $0.equipmentType == type }
   204	        }
   205	    }
   206	
   207	    static let empty = CatalogModelIndex(rows: [])
   208	}
   209	
   210	// MARK: - Pure browsing logic
   211	
   212	enum CatalogBrowsing {
   213	    static let uncategorized = "Uncategorized"
   214	
   215	    // MARK: Search
   216	
   217	    /// Lowercased, diacritic-folded, punctuation flattened to spaces. Both the
   218	    /// haystack and the query go through this, so "iso lateral" finds
   219	    /// "Iso-Lateral" and "hammer incline" finds "Hammer Strength … Incline
   220	    /// Press" — the manufacturer and the model name are one haystack.
   221	    static func normalize(_ text: String) -> String {
   222	        let folded = text.folding(options: [.diacriticInsensitive, .caseInsensitive],
   223	                                  locale: Locale(identifier: "en_US_POSIX"))
   224	        let flattened = folded.map { character -> Character in
   225	            character.isLetter || character.isNumber ? character : " "
   226	        }
   227	        return String(flattened).split(separator: " ").joined(separator: " ")
   228	    }
   229	
   230	    /// Search terms: every token must appear, in any order, anywhere in the
   231	    /// haystack. Order-independence is the point — nobody types a catalog
   232	    /// model's words in catalog order.
   233	    static func tokens(_ searchText: String) -> [String] {
   234	        normalize(searchText).split(separator: " ").map(String.init)
   235	    }
   236	
   237	    static func matches(_ haystack: String, tokens: [String]) -> Bool {
   238	        tokens.allSatisfy { haystack.contains($0) }
   239	    }
   240	
   241	    // MARK: Models
   242	
   243	    static func models(
   244	        _ rows: [CatalogModelRow], matching filter: CatalogModelFilter
   245	    ) -> [CatalogModelRow] {
   246	        let tokens = tokens(filter.searchText)
   247	        return rows.filter { row in
   248	            // A row is only excluded by a category it *has* — an uncategorized
   249	            // row survives every category filter (D24).
   250	            if let bodyArea = filter.bodyArea,
   251	               !row.bodyAreas.isEmpty, !row.bodyAreas.contains(bodyArea) {
   252	                return false
   253	            }
   254	            if let type = filter.equipmentType,
   255	               let rowType = row.equipmentType, rowType != type {
   256	                return false
   257	            }
   258	            return matches(row.searchText, tokens: tokens)
   259	        }
   260	    }
   261	
   262	    static func sections(
   263	        _ rows: [CatalogModelRow], by grouping: CatalogGrouping
   264	    ) -> [CatalogSection<CatalogModelRow>] {
   265	        switch grouping {
   266	        case .alphabetical:
   267	            return flat(rows)
   268	        case .manufacturer:
   269	            return sections(rows, categories: { [$0.manufacturer] }, order: nil)
   270	        case .bodyArea:
   271	            return sections(rows, categories: \.bodyAreas, order: BodyArea.order)
   272	        case .equipmentType:
   273	            return sections(
   274	                rows,
   275	                categories: { $0.equipmentType.map { [$0.label] } ?? [] },
   276	                order: EquipmentCategory.allCases.map(\.label))
   277	        }
   278	    }
   279	
   280	    /// Filter then group, in the order that keeps the work proportional to
   281	    /// what survives the filter.
   282	    static func browse(
   283	        _ index: CatalogModelIndex, filter: CatalogModelFilter, grouping: CatalogGrouping
   284	    ) -> [CatalogSection<CatalogModelRow>] {
   285	        sections(models(index.rows, matching: filter), by: grouping)
   286	    }
   287	
   288	    // MARK: Exercises
   289	
   290	    static func exercises(
   291	        _ rows: [CatalogExerciseRow], matching filter: CatalogExerciseFilter
   292	    ) -> [CatalogExerciseRow] {
   293	        let tokens = tokens(filter.searchText)
   294	        return rows.filter { row in
   295	            if let bodyArea = filter.bodyArea,
   296	               let rowArea = row.bodyArea, rowArea != bodyArea {
   297	                return false
   298	            }
   299	            if let tag = filter.equipmentTag,
   300	               !row.equipmentTags.isEmpty, !row.equipmentTags.contains(tag) {
   301	                return false
   302	            }
   303	            return matches(row.searchText, tokens: tokens)
   304	        }
   305	    }
   306	
   307	    // MARK: Machines
   308	
   309	    static func machineSections(
   310	        _ rows: [MachineBrowseRow], by grouping: MachineGrouping
   311	    ) -> [CatalogSection<MachineBrowseRow>] {
   312	        switch grouping {
   313	        case .alphabetical:
   314	            return flat(rows)
   315	        case .exercise:
   316	            return sections(rows, categories: \.exerciseNames, order: nil)
   317	        case .bodyArea:
   318	            return sections(rows, categories: \.bodyAreas, order: BodyArea.order)
   319	        }
   320	    }
   321	
   322	    // MARK: Section assembly
   323	
   324	    /// Groups `rows` under every category each row carries (a multi-exercise
   325	    /// station is findable under each body area it serves), leaving rows with
   326	    /// no category in a trailing "Uncategorized" section rather than dropping
   327	    /// them. Row order inside a section is the incoming order, so the caller's
   328	    /// sort is the whole ordering story.
   329	    static func sections<Row: Identifiable>(
   330	        _ rows: [Row], categories: (Row) -> [String], order: [String]?
   331	    ) -> [CatalogSection<Row>] {
   332	        var grouped: [String: [Row]] = [:]
   333	        var uncategorized: [Row] = []
   334	        var seen: [String] = []
   335	        for row in rows {
   336	            let titles = uniqueValues(categories(row))
   337	            if titles.isEmpty {
   338	                uncategorized.append(row)
   339	                continue
   340	            }
   341	            for title in titles {
   342	                if grouped[title] == nil {
   343	                    grouped[title] = []
   344	                    seen.append(title)
   345	                }
   346	                grouped[title]?.append(row)
   347	            }
   348	        }
   349	
   350	        let titles: [String]
   351	        if let order {
   352	            let ordered = order.filter { grouped[$0] != nil }
   353	            let rest = seen.filter { !order.contains($0) }
   354	                .sorted { $0.localizedCaseInsensitiveCompare($1) == .orderedAscending }
   355	            titles = ordered + rest
   356	        } else {
   357	            titles = seen.sorted { $0.localizedCaseInsensitiveCompare($1) == .orderedAscending }
   358	        }
   359	
   360	        var result = titles.map { CatalogSection(title: $0, rows: grouped[$0] ?? []) }
   361	        if !uncategorized.isEmpty {
   362	            result.append(CatalogSection(title: Self.uncategorized, rows: uncategorized))
   363	        }
   364	        return result
   365	    }
   366	
   367	    static func flat<Row: Identifiable>(_ rows: [Row]) -> [CatalogSection<Row>] {
   368	        rows.isEmpty ? [] : [CatalogSection(title: nil, rows: rows)]
   369	    }
   370	
   371	    // MARK: Helpers
   372	
   373	    /// Order-preserving de-duplication.
   374	    static func uniqueValues(_ values: [String]) -> [String] {
   375	        var seen: Set<String> = []
   376	        return values.filter { seen.insert($0).inserted }
   377	    }
   378	
   379	    /// The body areas present, in the catalog's head-to-toe order, with any
   380	    /// vocabulary the order does not know appended alphabetically.
   381	    static func bodyAreasPresent(in values: [String]) -> [String] {
   382	        let present = Set(values)
   383	        let known = BodyArea.order.filter(present.contains)
   384	        let unknown = present.subtracting(BodyArea.order)
   385	            .sorted { $0.localizedCaseInsensitiveCompare($1) == .orderedAscending }
   386	        return known + unknown
   387	    }
   388	
   389	    /// Body area per exercise id, for turning a model's links into groups.
   390	    static func bodyAreas(of exercises: [Exercise]) -> [UUID: String] {
   391	        Dictionary(
   392	            exercises.compactMap { exercise in
   393	                exercise.muscleGroup.map { (exercise.id, $0) }
   394	            },
   395	            uniquingKeysWith: { first, _ in first })
   396	    }
   397	
   398	    /// A–Z by manufacturer, then model name; case-insensitive and stable.
   399	    static func precedes(_ lhs: CatalogModelRow, _ rhs: CatalogModelRow) -> Bool {
   400	        switch lhs.manufacturer.localizedCaseInsensitiveCompare(rhs.manufacturer) {
   401	        case .orderedAscending: return true
   402	        case .orderedDescending: return false
   403	        case .orderedSame:
   404	            return lhs.modelName.localizedCaseInsensitiveCompare(rhs.modelName)
   405	                == .orderedAscending
   406	        }
   407	    }
   408	}
   409	
   410	// MARK: - Building the value types from persisted rows
   411	
   412	// The single boundary between SwiftData and browsing. Building an index reads
   413	// every model once; searching and grouping afterwards never touch the store.
   414	
   415	extension CatalogModelIndex {
   416	    static func build(models: [EquipmentModel], exercises: [Exercise]) -> CatalogModelIndex {
   417	        let bodyAreas = CatalogBrowsing.bodyAreas(of: exercises)
   418	        return CatalogModelIndex(rows: models.map { model in
   419	            CatalogModelRow(
   420	                id: model.id,
   421	                manufacturer: model.manufacturer,
   422	                modelName: model.modelName,
   423	                equipmentType: model.equipmentType,
   424	                bodyAreas: CatalogBrowsing.uniqueValues(
   425	                    model.exerciseIDs.compactMap { bodyAreas[$0] }),
   426	                isSeeded: model.isSeeded)
   427	        })
   428	    }
   429	}
   430	
   431	extension CatalogExerciseRow {
   432	    init(_ exercise: Exercise) {
   433	        self.init(
   434	            id: exercise.id,
   435	            name: exercise.name,
   436	            bodyArea: exercise.muscleGroup,
   437	            equipmentTags: exercise.equipmentTypeTags,
   438	            isSeeded: exercise.isSeeded)
   439	    }
   440	}
   441	
   442	extension MachineBrowseRow {
   443	    /// A machine's groups come from its model's linked exercises; a model-less
   444	    /// machine has none and lands in "Uncategorized" (never hidden).
   445	    init(_ machine: MachineInstance, exercisesByID: [UUID: Exercise]) {
   446	        let exercises = (machine.model?.exerciseIDs ?? []).compactMap { exercisesByID[$0] }
   447	        self.init(
   448	            id: machine.id,
   449	            label: machine.label,
   450	            exerciseNames: CatalogBrowsing.uniqueValues(exercises.map(\.name)),
   451	            bodyAreas: CatalogBrowsing.uniqueValues(exercises.compactMap(\.muscleGroup)))
   452	    }
   453	}

