   118	/// Second step of the machine-first path: the exercise list for a picked
   119	/// machine — restricted to the model's linked exercises, or the full
   120	/// searchable catalog when the machine has no model.
   121	private struct MachineExerciseList: View {
   122	    var choice: AddByMachineSheet.ExerciseChoice
   123	    var onSelect: (Exercise) -> Void
   124	    @Query(sort: \Exercise.name) private var allExercises: [Exercise]
   125	    @State private var searchText = ""
   126	    /// Non-nil while the inline creation form is up (ticket 19).
   127	    @State private var creating: NewExerciseRequest?
   128	
   129	    private var exercises: [Exercise] {
   130	        let base = choice.linked ?? allExercises
   131	        let tokens = CatalogBrowsing.tokens(searchText)
   132	        guard choice.linked == nil, !tokens.isEmpty else { return base }
   133	        return base.filter {
   134	            CatalogBrowsing.matches(CatalogBrowsing.normalize($0.name), tokens: tokens)
   135	        }
   136	    }
   137	
   138	    private var trimmedSearch: String {
   139	        searchText.trimmingCharacters(in: .whitespacesAndNewlines)
   140	    }
   141	
   142	    /// Ticket 19: an exercise invented at a station is linked to that
   143	    /// station's model, so the movement is offered here next time. A
   144	    /// model-less machine has nothing to link to — plain creation then.
   145	    private var model: EquipmentModel? { choice.machine.model }
   146	
   147	    var body: some View {
   148	        List {
   149	            Section {
   150	                ForEach(exercises) { exercise in
   151	                    Button {
   152	                        select(exercise)
   153	                    } label: {
   154	                        ExerciseRow(exercise: exercise)
   155	                    }
   156	                    .buttonStyle(.plain)
   157	                    .accessibilityIdentifier("exerciseOption.\(exercise.name)")
   158	                }
   159	                if exercises.isEmpty, !trimmedSearch.isEmpty {
   160	                    Button {
   161	                        creating = request(named: trimmedSearch)
   162	                    } label: {
   163	                        Label("Create “\(trimmedSearch)”", systemImage: "plus")
   164	                    }
   165	                    .accessibilityIdentifier("createExerciseFromSearch")
   166	                }
   167	            }
   168	            Section {
   169	                Button("New Exercise…", systemImage: "plus") {
   170	                    creating = request(named: trimmedSearch)
   171	                }
   172	                .accessibilityIdentifier("newExercise")
   173	            } footer: {
   174	                if let model {
   175	                    Text("A new exercise is linked to \(model.displayName), so this station offers it next time.")
   176	                } else {
   177	                    Text("This machine has no catalog model, so a new exercise is simply added to your catalog.")
   178	                }
   179	            }
   180	        }
   181	        .modifier(FullCatalogSearch(enabled: choice.linked == nil, text: $searchText))
   182	        .navigationTitle(choice.linked == nil ? "Pick Exercise" : choice.machine.label)
   183	        .navigationBarTitleDisplayMode(.inline)
   184	        .sheet(item: $creating) { request in
   185	            NewExerciseSheet(initialName: request.name, linkTo: request.linkTo) { exercise in
   186	                select(exercise)
   187	            }
   188	        }
   189	    }
   190	
   191	    private func request(named name: String) -> NewExerciseRequest {
   192	        NewExerciseRequest(name: name, linkTo: model)
   193	    }
   194	
   195	    private func select(_ exercise: Exercise) {
   196	        creating = nil
   197	        onSelect(exercise)
   198	    }
   199	}
