   751	/// Inline user-model creation (D24: user ID space, `isSeeded == false`;
   752	/// must link at least one exercise).
   753	private struct AddModelSheet: View {
   754	    @Environment(\.modelContext) private var modelContext
   755	    @Environment(\.dismiss) private var dismiss
   756	    var onCreate: (EquipmentModel) -> Void
   757	    @Query(sort: \Exercise.name) private var exercises: [Exercise]
   758	    @State private var manufacturer = ""
   759	    @State private var modelName = ""
   760	    @State private var equipmentType: EquipmentCategory?
