   801	
   802	        let container = try WorkoutTrackerStore.makeContainer(url: url)
   803	        let context = ModelContext(container)
   804	        #expect(try context.fetchCount(FetchDescriptor<Workout>()) == 0)
   805	        #expect(try context.fetchCount(FetchDescriptor<ExerciseEntry>()) == 0)
   806	        #expect(try context.fetchCount(FetchDescriptor<SetRecord>()) == 0)
   807	        // Catalog/gym graph untouched.
   808	        #expect(try context.fetchCount(FetchDescriptor<Gym>()) == 1)
   809	        #expect(try context.fetchCount(FetchDescriptor<MachineInstance>()) == 2)
   810	        #expect(try context.fetchCount(FetchDescriptor<Exercise>()) == 1)
   811	    }
