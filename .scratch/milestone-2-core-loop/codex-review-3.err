   244	        Menu {
   245	            Button {
   246	                select(nil)
   247	            } label: {
   248	                if selectedGym == nil {
   249	                    Label("No gym", systemImage: "checkmark")
   250	                } else {
   251	                    Text("No gym")
   252	                }
   253	            }
   254	            ForEach(gyms) { gym in
   255	                Button {
   256	                    select(gym)
   257	                } label: {
   258	                    let title = gym.city.map { "\(gym.name) · \($0)" } ?? gym.name
   259	                    if gym.id == selectedGym?.id {
