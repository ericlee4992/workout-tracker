   272	    /// Starting a new workout while one is active (the UI's
   273	    /// finish-and-start-new path) finishes the old one first — the invariant
   274	    /// holds at the service boundary.
   275	    @Test func startWorkoutFinishesLingeringActives() throws {
   276	        let url = makeStoreURL()
   277	        defer { removeStore(at: url) }
   278	        let container = try WorkoutTrackerStore.makeContainer(url: url)
   279	        let context = ModelContext(container)
   280	        let session = WorkoutSession(context: context)
   281	
   282	        let exercise = Exercise(name: "Bench Press")
   283	        context.insert(exercise)
   284	        try context.save()
   285	
   286	        // A2 (ticket 17): a lingering workout is only *finished* if it has
   287	        // something to keep, so log a set in it — an empty one would be
   288	        // discarded instead (see the A2 tests below).
   289	        let old = try session.startWorkout(at: nil)
   290	        let entry = try session.addEntry(
   291	            for: exercise, to: old, freeWeightTag: .barbell)
   292	        let set = try #require(WorkoutSession.orderedSets(of: entry).first)
   293	        try session.commitWeight("60", for: set)
   294	        try session.commitReps("10", for: set)
   295	        try session.toggleCompletion(of: set)
   296	
   297	        let new = try session.startWorkout(
   298	            at: nil, on: old.startedAt.addingTimeInterval(60))
   299	        #expect(old.finishedAt != nil)
   300	        #expect(new.finishedAt == nil)
   301	        let active = try context.fetch(FetchDescriptor<Workout>(
   302	            predicate: #Predicate { $0.finishedAt == nil }))
   303	        #expect(active.map(\.id) == [new.id])
   304	    }
