   378	    // MARK: Loggability (A1)
   379	
   380	    /// A1 (ticket 17) — the honesty gate on completion. A row may only be
   381	    /// logged once it says something true: positive reps always, plus a
   382	    /// weight *value* for every load type that carries one.
   383	    ///
   384	    /// `bodyweight` needs reps alone. `assisted` and `bodyweightPlus` need a
   385	    /// value but accept `0` — zero assistance and zero added weight are both
   386	    /// meaningful (they mirror ticket 12's record eligibility, `RecordsMath.
   387	    /// isEligible`), whereas *nil* is simply an unanswered question.
   388	    static func isLoggable(
   389	        reps: Int?,
   390	        weightValue: Double?,
   391	        loadType: LoadType
   392	    ) -> Bool {
   393	        guard let reps, reps > 0 else { return false }
   394	        switch loadType {
   395	        case .bodyweight:
   396	            return true
   397	        case .weighted, .assisted, .bodyweightPlus:
   398	            return weightValue != nil
   399	        }
   400	    }
