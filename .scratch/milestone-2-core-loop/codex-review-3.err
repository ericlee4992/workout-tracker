     4	struct RootView: View {
     5	    @Environment(\.modelContext) private var modelContext
     6	    @State private var selection: Tab = .workout
     7	    @State private var activeWorkout: Workout?
     8	    /// C2/A2: the finish that just happened, awaiting its confirmation sheet.
     9	    @State private var finishConfirmation: FinishConfirmation?
    10	
    11	    enum Tab: Hashable {
    12	        case workout, history, gyms, exercises
    13	    }
    14	
    15	    /// The subject of the post-finish sheet. `workout` is nil when the
    16	    /// workout was empty and got discarded (A2) — the sheet still shows, it
    17	    /// just reports a different outcome. Identity is per-finish rather than
    18	    /// per-workout so the discarded case can be presented at all.
    19	    private struct FinishConfirmation: Identifiable {
    20	        let id = UUID()
    21	        let workout: Workout?
    22	    }
    23	
    24	    var body: some View {
    25	        TabView(selection: $selection) {
    26	            StartWorkoutView(onWorkoutStarted: { activeWorkout = $0 })
    27	                .tabItem { Label("Workout", systemImage: "figure.strengthtraining.traditional") }
    28	                .tag(Tab.workout)
    29	
    30	            HistoryView()
    31	                .tabItem { Label("History", systemImage: "clock.arrow.circlepath") }
    32	                .tag(Tab.history)
    33	
    34	            GymsView()
    35	                .tabItem { Label("Gyms", systemImage: "building.2") }
    36	                .tag(Tab.gyms)
    37	
    38	            ExercisesView()
    39	                .tabItem { Label("Exercises", systemImage: "list.bullet.rectangle") }
    40	                .tag(Tab.exercises)
    41	        }
    42	        .fullScreenCover(item: $activeWorkout) { workout in
    43	            ActiveWorkoutView(
    44	                workout: workout,
    45	                // C1: minimising drops the cover and leaves the workout
    46	                // active; StartWorkoutView shows the resume affordance.
    47	                onMinimize: { activeWorkout = nil },
    48	                onFinished: { finished in
    49	                    activeWorkout = nil
    50	                    finishConfirmation = FinishConfirmation(workout: finished)
    51	                })
    52	        }
    53	        .sheet(item: $finishConfirmation) { confirmation in
    54	            WorkoutFinishedSheet(
    55	                workout: confirmation.workout,
    56	                viewInHistory: {
    57	                    finishConfirmation = nil
    58	                    selection = .history
    59	                },
    60	                done: { finishConfirmation = nil })
    61	            .presentationDetents([.medium])
    62	        }
    63	        .onAppear(perform: recoverActiveWorkout)
    64	        .onAppear(perform: applyLaunchOverride)
    65	    }
    66	
    67	    /// Relaunch resumes the newest active workout; older strays are
    68	    /// auto-finished by the service (exactly-one-active invariant).
    69	    private func recoverActiveWorkout() {
    70	        guard activeWorkout == nil else { return }
    71	        activeWorkout = try? WorkoutSession(context: modelContext).resumableWorkout()
    72	    }
    73	
    74	    // Lets scripted screenshot runs land on a specific screen:
    75	    // SIMCTL_CHILD_PROTO_SCREEN=gyms|exercises
    76	    // ("active", "history", and "detail" were milestone-1 deep links; those
    77	    // screens now render real persisted data.)
    78	    private func applyLaunchOverride() {
    79	        switch ProcessInfo.processInfo.environment["PROTO_SCREEN"] {
    80	        case "gyms":
    81	            selection = .gyms
    82	        case "exercises":
    83	            selection = .exercises
    84	        default:
    85	            break
    86	        }
    87	    }
    88	}
