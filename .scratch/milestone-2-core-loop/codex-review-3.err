     9	    @Query private var allPreferences: [AppPreferences]
    10	    /// C1: a minimised workout keeps running, so the tab must offer the way
    11	    /// back in. Newest first — the same newest-active-wins rule the recovery
    12	    /// path uses.
    13	    @Query(
    14	        filter: #Predicate<Workout> { $0.finishedAt == nil },
    15	        sort: [SortDescriptor(\Workout.startedAt, order: .reverse)])
    16	    private var activeWorkouts: [Workout]
    17	    @State private var selectedGym: Gym?
