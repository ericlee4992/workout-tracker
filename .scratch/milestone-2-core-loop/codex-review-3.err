   457	    /// D23: stable UUIDs + loadType + freeWeightTag + display strings, taken
   458	    /// from the live relationships at first completion and never rewritten.
   459	    private func captureSnapshot(of entry: ExerciseEntry, at date: Date) {
   460	        entry.snapshotCapturedAt = date
   461	        entry.snapshotExerciseID = entry.exercise?.id ?? entry.snapshotExerciseID
   462	        entry.snapshotMachineID = entry.machine?.id
   463	        entry.snapshotModelID = entry.machine?.model?.id
   464	        entry.snapshotGymID = entry.workout?.gym?.id
   465	        entry.snapshotLoadType = entry.exercise?.loadType ?? entry.snapshotLoadType
   466	        entry.snapshotFreeWeightTag = entry.freeWeightTag
   467	        entry.snapshotExerciseName = entry.exercise?.name ?? entry.snapshotExerciseName
   468	        entry.snapshotMachineLabel = entry.machine?.label
   469	        entry.snapshotModelName = entry.machine?.model?.displayName
   470	        entry.snapshotGymName = entry.workout?.gym?.name
   471	    }
   472	
   473	    /// App-level upsert (no unique constraints under CloudKit): among
   474	    /// existing (gym, exercise) rows the latest `updatedAt` wins (ties by id)
   475	    /// and is updated in place — duplicates are never added to.
   476	    private func upsertMemory(for entry: ExerciseEntry, at date: Date) {
   477	        guard let gymID = entry.workout?.gym?.id,
   478	              let exerciseID = entry.exercise?.id else { return }
   479	        let machineID = entry.machine?.id
   480	        let rows = (try? context.fetch(FetchDescriptor<GymExerciseMemory>(
   481	            predicate: #Predicate { $0.gymID == gymID && $0.exerciseID == exerciseID }
   482	        ))) ?? []
   483	        if let canonical = rows.canonical {
   484	            canonical.machineID = machineID
   485	            canonical.updatedAt = date
   486	        } else {
   487	            context.insert(GymExerciseMemory(
   488	                gymID: gymID, exerciseID: exerciseID, machineID: machineID,
   489	                updatedAt: date))
   490	        }
   491	    }
   492	
   493	    // MARK: - Defaults & ordering
