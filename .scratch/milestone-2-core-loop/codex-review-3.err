   245	    /// Today's numbers outrank last week's: the cross-workout candidate is
   246	    /// still selected (the PREVIOUS column keeps its meaning) but it must not
   247	    /// overwrite a carried-forward row.
   248	    @Test func carryForwardSurvivesCrossWorkoutPrefill() throws {
   249	        let rig = try makeRig()
   250	        // A finished workout on the same machine: 100 kg × 5, then 90 kg × 5.
   251	        let past = try rig.session.startWorkout(
   252	            at: rig.gym, on: Date(timeIntervalSince1970: 100))
   253	        let pastEntry = try rig.session.addEntry(
   254	            for: rig.exercise, to: past, machine: rig.machine)
   255	        for (index, weight) in ["100", "90"].enumerated() {
   256	            let row = index == 0
   257	                ? try #require(WorkoutSession.orderedSets(of: pastEntry).first)
   258	                : try rig.session.addSet(to: pastEntry)
   259	            try rig.session.commitWeight(weight, for: row)
   260	            try rig.session.commitReps("5", for: row)
   261	            try rig.session.toggleCompletion(
   262	                of: row, at: Date(timeIntervalSince1970: TimeInterval(110 + index)))
   263	        }
   264	        try rig.session.finish(past, at: Date(timeIntervalSince1970: 200))
   265	
   266	        let (_, entry, first) = try firstDraft(rig, at: Date(timeIntervalSince1970: 300))
   267	        try rig.session.commitWeight("60", for: first)
   268	        try rig.session.commitReps("10", for: first)
   269	        try rig.session.toggleCompletion(of: first, at: Date(timeIntervalSince1970: 310))
   270	
   271	        let second = try rig.session.addSet(to: entry)
   272	        let history = PerformanceHistory(context: rig.context)
   273	        // The reference label still resolves to the historical set…
   274	        let candidate = try #require(try history.prefill(for: second))
   275	        #expect(candidate.displayLabel == "90 kg × 5")
   276	        // …but it does not touch the inputs.
   277	        #expect(try !history.applyPrefill(candidate, to: second, isDirty: false))
   278	        #expect(second.weightValue == 60)
   279	        #expect(second.reps == 10)
   280	    }
   281	}
   220	            let finished = Workout(
   221	                startedAt: base.addingTimeInterval(-7_200),
   222	                finishedAt: base.addingTimeInterval(-3_600))
   223	            strayID = stray.id
   224	            newestID = newest.id
   225	            finishedID = finished.id
   226	            // The stray carries one completed set and one draft — cleanup
   227	            // must keep only the completed one.
   228	            let entry = ExerciseEntry(
   229	                order: 0, workout: stray, exercise: exercise,
   230	                snapshotExerciseID: exercise.id, snapshotLoadType: .weighted,
   231	                snapshotExerciseName: exercise.name)
   232	            let done = SetRecord(
   233	                order: 0, reps: 5, weightValue: 100, weightUnit: .kg,
   234	                normalizedKg: 100, completedAt: base, entry: entry)
   235	            let draft = SetRecord(order: 1, entry: entry)
   236	            for object in [stray, newest, finished, entry, done, draft]
   237	                as [any PersistentModel] {
   238	                context.insert(object)
   239	            }
   240	            try context.save()
   241	        }()
   242	
   243	        // "Relaunch": reopen the store and recover.
   244	        let recoveredAt = base.addingTimeInterval(10_000)
   245	        try {
   246	            let container = try WorkoutTrackerStore.makeContainer(url: url)
   247	            let context = ModelContext(container)
   248	            let session = WorkoutSession(context: context)
   249	            let resumed = try #require(try session.resumableWorkout(at: recoveredAt))
   250	            #expect(resumed.id == newestID)
   251	        }()
   252	
   253	        // Reopen once more: the auto-finish itself must have persisted.
   254	        let container = try WorkoutTrackerStore.makeContainer(url: url)
   255	        let context = ModelContext(container)
   256	        let newest = try fetchWorkout(newestID, in: context)
   257	        #expect(newest.finishedAt == nil)
   258	        let stray = try fetchWorkout(strayID, in: context)
   259	        #expect(stray.finishedAt == recoveredAt)
   260	        let strayEntry = try #require(stray.entries?.first)
   261	        let straySets = try #require(strayEntry.sets)
   262	        try #require(straySets.count == 1)
   263	        #expect(straySets[0].completedAt != nil)
   264	        let finished = try fetchWorkout(finishedID, in: context)
   265	        #expect(finished.finishedAt == base.addingTimeInterval(-3_600))
   266	        // Exactly one active workout remains.
   267	        let active = try context.fetch(FetchDescriptor<Workout>(
   268	            predicate: #Predicate { $0.finishedAt == nil }))
   269	        #expect(active.map(\.id) == [newestID])
   270	    }
