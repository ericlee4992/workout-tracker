   201	    private func finishTapped() {
   202	        if workout.sourceTemplateID == nil {
   203	            finishWorkout()
   204	            return
   205	        }
   206	        do {
   207	            let drift = TemplateDriftService(context: modelContext)
   208	            if let template = try drift.sourceTemplate(for: workout),
   209	               try drift.shouldPrompt(for: workout, template: template) {
   210	                driftTemplate = template
