   232	/// Ticket 06's add-gym form, doubling as the edit form (D2, ticket 17): the
   233	/// fields a gym is created with are exactly the fields it can be corrected
   234	/// with, so there is one place to learn and one place to maintain.
   235	private struct GymEditorSheet: View {
   236	    @Environment(\.modelContext) private var modelContext
   237	    @Environment(\.dismiss) private var dismiss
   238	    /// nil = create a new gym; non-nil = edit that gym in place.
   239	    var gym: Gym?
   240	    @State private var name = ""
   241	    @State private var city = ""
   242	    @State private var defaultUnit: WeightUnit?
   243	    @State private var loaded = false
   244	
   245	    var body: some View {
   246	        NavigationStack {
   247	            Form {
   248	                Section {
   249	                    TextField("Name", text: $name)
   250	                        .accessibilityIdentifier("gymName")
   251	                    TextField("City (optional)", text: $city)
   252	                } footer: {
   253	                    if gym != nil {
   254	                        Text("Existing workout history keeps the name captured when each workout was logged.")
   255	                    }
   256	                }
   257	                Section {
   258	                    Picker("Default unit", selection: $defaultUnit) {
   259	                        Text("App preference").tag(WeightUnit?.none)
   260	                        ForEach(WeightUnit.allCases) { unit in
   261	                            Text(unit.rawValue).tag(WeightUnit?.some(unit))
   262	                        }
   263	                    }
   264	                    .accessibilityIdentifier("gymUnitPicker")
   265	                } footer: {
   266	                    Text(gym == nil
   267	                        ? "Leave on App preference to fall through to your app-wide unit."
   268	                        : "Changing this affects future sets only — sets already logged keep the unit you entered them in.")
   269	                }
   270	            }
   271	            .navigationTitle(gym == nil ? "New Gym" : "Edit Gym")
   272	            .navigationBarTitleDisplayMode(.inline)
   273	            .toolbar {
   274	                ToolbarItem(placement: .cancellationAction) {
   275	                    Button("Cancel") { dismiss() }
   276	                }
   277	                ToolbarItem(placement: .confirmationAction) {
   278	                    Button(gym == nil ? "Add" : "Save") { save() }
   279	                        .disabled(trimmedName.isEmpty)
   280	                        .accessibilityIdentifier("saveGym")
   281	                }
   282	            }
   283	            .onAppear(perform: load)
   284	        }
   285	    }
   286	
   287	    private var trimmedName: String {
   288	        name.trimmingCharacters(in: .whitespacesAndNewlines)
   289	    }
   290	
   291	    private func load() {
   292	        guard !loaded else { return }
   293	        loaded = true
   294	        guard let gym else { return }
   295	        name = gym.name
   296	        city = gym.city ?? ""
   297	        defaultUnit = gym.defaultUnit
   298	    }
   299	
   300	    private func save() {
   301	        do {
   302	            if let gym {
   303	                try EquipmentLifecycle(context: modelContext).update(
   304	                    gym, name: name, city: city, defaultUnit: defaultUnit)
   305	            } else {
   306	                let trimmedCity = city.trimmingCharacters(in: .whitespacesAndNewlines)
   307	                modelContext.insert(Gym(
   308	                    name: trimmedName,
   309	                    city: trimmedCity.isEmpty ? nil : trimmedCity,
   310	                    defaultUnit: defaultUnit))
   311	                try modelContext.save()
   312	            }
   313	        } catch {
   314	            assertionFailure("Failed to save gym: \(error)")
   315	        }
   316	        dismiss()
   317	    }
   318	}
