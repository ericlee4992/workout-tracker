   210	        reps.typeText("12")
   211	        app.buttons["setRow.unit"].firstMatch.tap() // kg → lb, as entered
   212	        app.buttons["setRow.complete"].firstMatch.tap()
   213	
   214	        app.buttons["addSet"].firstMatch.tap()
   215	
   216	        let secondWeight = app.textFields.matching(identifier: "setRow.weight")
   217	            .element(boundBy: 1)
