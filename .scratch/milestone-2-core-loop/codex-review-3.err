    13	struct ExerciseEntryCard: View {
    14	    @Environment(\.modelContext) private var modelContext
    15	    var entry: ExerciseEntry
    16	    var showMachinePicker: () -> Void
    17	    var showPerformance: () -> Void
    18	    var completionChanged: (SetRecord, Bool) -> Void
    19	    @State private var showingRestSettings = false
    20	
    21	    private var session: WorkoutSession { WorkoutSession(context: modelContext) }
    22	
    23	    private var orderedSets: [SetRecord] {
    24	        entry.isDeleted ? [] : WorkoutSession.orderedSets(of: entry)
    25	    }
    26	
    27	    private var loadType: LoadType {
    28	        entry.exercise?.loadType ?? entry.snapshotLoadType
    29	    }
    30	
    31	    var body: some View {
    32	        VStack(alignment: .leading, spacing: 10) {
    33	            titleRow
    34	            machineRow
    35	
    36	            if loadType == .assisted {
    37	                Label("Assisted: lower weight = harder. Records track least assistance.", systemImage: "arrow.down.right.circle")
    38	                    .font(.caption)
    39	                    .foregroundStyle(.secondary)
    40	            }
    41	
    42	            columnHeaders
    43	
    44	            ForEach(orderedSets) { set in
    45	                SetRowView(
    46	                    set: set,
    47	                    index: workingIndex(of: set),
    48	                    loadType: loadType,
    49	                    onCompletionChanged: { completed in
    50	                        completionChanged(set, completed)
    51	                    },
    52	                    onDelete: { deleteSet(set) })
    53	            }
    54	
    55	            Button {
    56	                addSet()
    57	            } label: {
    58	                Label("Add Set", systemImage: "plus")
    59	                    .font(.subheadline)
    60	                    .frame(maxWidth: .infinity)
    61	            }
    62	            .buttonStyle(.borderless)
    63	            .accessibilityIdentifier("addSet")
    64	            .padding(.top, 2)
    65	        }
    66	        .padding(14)
    67	        .background(Color(.secondarySystemGroupedBackground))
    68	        .clipShape(RoundedRectangle(cornerRadius: 14))
    69	        .padding(.horizontal)
    70	        .sheet(isPresented: $showingRestSettings) {
    71	            if let exercise = entry.exercise {
    72	                ExerciseRestSettingsSheet(exercise: exercise)
    73	            }
    74	        }
    75	    }
    76	
    77	    private var titleRow: some View {
    78	        HStack {
    79	            Text(entry.exercise?.name ?? entry.snapshotExerciseName)
    80	                .font(.headline)
    81	            Spacer()
    82	            Menu {
    83	                if entry.exercise != nil {
    84	                    Button("Rest Durations…", systemImage: "timer") {
    85	                        showingRestSettings = true
    86	                    }
    87	                }
    88	                Button("Delete Exercise", systemImage: "trash", role: .destructive) {
    89	                    deleteEntry()
    90	                }
    91	            } label: {
    92	                Image(systemName: "ellipsis.circle")
    93	                    .foregroundStyle(.secondary)
    94	            }
    95	            .accessibilityLabel("Exercise options")
    96	            Button(action: showPerformance) {
    97	                Image(systemName: "chart.bar.doc.horizontal")
    98	                    .foregroundStyle(.tint)
    99	            }
   100	            .accessibilityLabel("Previous performance")
   101	        }
   102	    }
   103	
   104	    private var machineRow: some View {
   105	        Button(action: showMachinePicker) {
   106	            HStack(spacing: 6) {
   107	                Image(systemName: entry.machine != nil ? "gearshape.2" : "dumbbell")
   108	                    .font(.caption)
   109	                VStack(alignment: .leading, spacing: 1) {
   110	                    Text(entry.equipmentDisplayLabel)
   111	                        .font(.subheadline.weight(.medium))
   112	                    if let model = entry.machine?.model {
   113	                        Text(model.displayName)
   114	                            .font(.caption2)
   115	                            .foregroundStyle(.secondary)
   116	                    }
   117	                }
   118	                Image(systemName: "chevron.right")
   119	                    .font(.caption2)
   120	                    .foregroundStyle(.tertiary)
   121	                Spacer()
   122	            }
   123	            .padding(.vertical, 6)
   124	            .padding(.horizontal, 10)
   125	            .background(Color(.tertiarySystemFill))
   126	            .clipShape(RoundedRectangle(cornerRadius: 8))
   127	        }
   128	        .buttonStyle(.plain)
   129	    }
   130	
   131	    private var columnHeaders: some View {
   132	        HStack(spacing: 8) {
   133	            Text("SET").frame(width: 34)
   134	            Text("PREVIOUS").frame(maxWidth: .infinity, alignment: .leading)
   135	            Text(weightHeader).frame(width: 88)
   136	            Text("REPS").frame(width: 48)
   137	            Color.clear.frame(width: 30)
   138	        }
   139	        .font(.caption2.weight(.semibold))
   140	        .foregroundStyle(.secondary)
   141	    }
   142	
   143	    private var weightHeader: String {
   144	        loadType == .assisted ? "ASSIST" : "WEIGHT"
   145	    }
   146	
   147	    private func workingIndex(of set: SetRecord) -> Int {
   148	        var index = 0
   149	        for s in orderedSets {
   150	            if s.type != .warmup { index += 1 }
   151	            if s.id == set.id { break }
   152	        }
   153	        return index
   154	    }
   155	
   156	    // MARK: Actions
   157	
   158	    private func addSet() {
   159	        do {
   160	            try session.addSet(to: entry)
   161	        } catch {
   162	            assertionFailure("Failed to add set: \(error)")
   163	        }
   164	    }
   165	
   166	    private func deleteSet(_ set: SetRecord) {
   167	        do {
   168	            try session.deleteSet(set)
   169	        } catch {
   170	            assertionFailure("Failed to delete set: \(error)")
   171	        }
   172	    }
   173	
   174	    private func deleteEntry() {
   175	        do {
   176	            try session.deleteEntry(entry)
   177	        } catch {
   178	            assertionFailure("Failed to delete entry: \(error)")
   179	        }
   180	    }
   181	}
