   128	
   129	    private func resumeSubtitle(_ workout: Workout) -> String {
   130	        let count = WorkoutSession.orderedEntries(of: workout).count
   131	        let exercises = "\(count) \(count == 1 ? "exercise" : "exercises")"
   132	        guard let gymName = workout.gym?.name else { return "In progress · \(exercises)" }
   133	        return "\(gymName) · \(exercises)"
   134	    }
