   277	                order: 0, weightUnit: defaultUnit(for: newEntry), entry: newEntry)
   278	            context.insert(set)
   279	        }
   280	        try context.save()
   281	        return newEntry
   282	    }
   283	
   284	    // MARK: - Sets
   285	
   286	    /// Appends a draft set.
   287	    ///
   288	    /// B1 (ticket 17) — within-session carry-forward: the row is seeded from
   289	    /// the entry's last **completed** set (weight value, unit, reps) and
   290	    /// arrives uncompleted, so a repeat set costs one tap — the same contract
   291	    /// as ticket 11's cross-workout prefill. On a 4-set exercise the numbers
   292	    /// are typed once.
   293	    ///
   294	    /// With nothing completed yet the old behaviour stands: the last row's
   295	    /// unit as entered (else the precedence chain machine → gym → app
   296	    /// preference) and no values, leaving ticket 11's prefill to populate the
   297	    /// row from previous workouts.
   298	    @discardableResult
   299	    func addSet(to entry: ExerciseEntry) throws -> SetRecord {
   300	        let existing = Self.orderedSets(of: entry)
   301	        let carryForward = existing.last { $0.completedAt != nil }
   302	        let unit = carryForward?.weightUnit ?? existing.last?.weightUnit
   303	            ?? defaultUnit(for: entry)
   304	        let set = SetRecord(
   305	            order: (existing.last?.order).map { $0 + 1 } ?? 0,
   306	            type: existing.last?.type ?? .working,
   307	            reps: carryForward?.reps,
   308	            weightValue: carryForward?.weightValue,
   309	            weightUnit: unit,
   310	            // Carried from the same source set, so it already matches `unit`.
   311	            normalizedKg: carryForward?.normalizedKg,
   312	            entry: entry)
   313	        context.insert(set)
   314	        try context.save()
   315	        return set
   316	    }
   317	
   318	    func deleteSet(_ set: SetRecord) throws {
   319	        let entry = set.entry
   320	        context.delete(set)
   321	        if let entry {
   322	            renumber(sets: Self.orderedSets(of: entry).filter { $0 !== set })
   323	        }
   324	        try context.save()
   325	    }
   326	
   327	    /// Set-type cycle used by the row's marker button: working → warmup →
   328	    /// failure → working.
   329	    func cycleSetType(_ set: SetRecord) throws {
   330	        switch set.type {
   331	        case .working: set.type = .warmup
   332	        case .warmup: set.type = .failure
   333	        case .failure: set.type = .working
   334	        }
   335	        try context.save()
   336	    }
   337	
   338	    /// Direct set-type pick (E5, ticket 17): the row's marker is a menu with
   339	    /// named options, so the type can be chosen instead of cycled blindly.
   340	    func setType(_ type: SetType, of set: SetRecord) throws {
   341	        guard set.type != type else { return }
   342	        set.type = type
   343	        try context.save()
   344	    }
   345	
   346	    /// Weight-field commit (end-editing). Empty or unparseable input clears
   347	    /// the draft value; a valid value recomputes `normalizedKg` atomically
   348	    /// through `StoredWeight` (D25).
   349	    func commitWeight(_ text: String, for set: SetRecord) throws {
   350	        let trimmed = text.trimmingCharacters(in: .whitespaces)
   351	        if let value = Double(trimmed.replacingOccurrences(of: ",", with: ".")),
   352	           let stored = StoredWeight(value: value, unit: set.weightUnit) {
   353	            set.weightValue = stored.value
   354	            set.normalizedKg = stored.normalizedKg
   355	        } else {
   356	            set.weightValue = nil
   357	            set.normalizedKg = nil
   358	        }
   359	        try context.save()
   360	    }
   361	
   362	    /// Reps-field commit (end-editing).
   363	    func commitReps(_ text: String, for set: SetRecord) throws {
   364	        set.reps = Int(text.trimmingCharacters(in: .whitespaces))
   365	        try context.save()
   366	    }
   367	
   368	    /// kg/lb toggle: reinterprets the as-entered value in the other unit —
   369	    /// never a silent conversion — recomputing `normalizedKg` (D25).
   370	    func toggleUnit(of set: SetRecord) throws {
   371	        set.weightUnit = set.weightUnit.toggled
