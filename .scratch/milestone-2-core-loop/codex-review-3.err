   130	        let assisted = try makeRig(loadType: .assisted)
   131	        let assistedRow = try firstDraft(assisted).set
   132	        try assisted.session.commitReps("8", for: assistedRow)
   133	        #expect(throws: WorkoutSessionError.setNotLoggable) {
   134	            try assisted.session.toggleCompletion(of: assistedRow)
   135	        }
   136	        try assisted.session.commitWeight("0", for: assistedRow)
   137	        try assisted.session.toggleCompletion(of: assistedRow)
   138	        #expect(assistedRow.completedAt != nil)
   139	        #expect(assistedRow.weightValue == 0)
   140	
   141	        // bodyweightPlus: same — zero added weight logs.
   142	        let plus = try makeRig(loadType: .bodyweightPlus)
   143	        let plusRow = try firstDraft(plus).set
   144	        try plus.session.commitReps("6", for: plusRow)
   145	        #expect(throws: WorkoutSessionError.setNotLoggable) {
   146	            try plus.session.toggleCompletion(of: plusRow)
   147	        }
   148	        try plus.session.commitWeight("0", for: plusRow)
   149	        try plus.session.toggleCompletion(of: plusRow)
   150	        #expect(plusRow.completedAt != nil)
   151	    }
