   169	    /// The template's comparable rows, each still carrying the `TemplateItem`
   170	    /// it came from. Items whose `exercise` was nullified by a delete have no
   171	    /// identity to match on and are dropped here — the single place that
   172	    /// filtering happens, so snapshots and write targets can never diverge.
   173	    private func snapshotRows(
   174	        _ template: WorkoutTemplate
   175	    ) -> [(item: TemplateItem, snapshot: TemplateDriftItem)] {
   176	        WorkoutTemplateService.orderedItems(of: template).compactMap { item in
   177	            guard let exerciseID = item.exercise?.id else { return nil }
   178	            return (item, TemplateDriftItem(
   179	                exerciseID: exerciseID,
   180	                targetRepsBySet: item.storedTargets.repsBySet))
