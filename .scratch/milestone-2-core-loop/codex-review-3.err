   102	    /// The way back into a minimised workout (C1). Resuming re-presents the
   103	    /// newest active workout, auto-finishing older strays exactly as the
   104	    /// relaunch recovery does.
   105	    private func resumeRow(_ workout: Workout) -> some View {
   106	        Button {
   107	            resumeActive()
   108	        } label: {
   109	            HStack {
   110	                Image(systemName: "figure.strengthtraining.traditional")
