   494	                    } label: {
   495	                        HStack {
   496	                            VStack(alignment: .leading, spacing: 2) {
   497	                                Text(model.displayName)
   498	                                if !model.isSeeded {
   499	                                    Text("Custom")
   500	                                        .font(.caption)
