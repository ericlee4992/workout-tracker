   227	        XCTAssertEqual(
   228	            app.buttons.matching(identifier: "setRow.unit").element(boundBy: 1).label, "lb",
   229	            "The new set should inherit the unit as entered")
   230	
   231	        // Populated but uncompleted: one tap logs it, no typing.
   232	        let secondComplete = app.buttons.matching(identifier: "setRow.complete")
   233	            .element(boundBy: 1)
   234	        XCTAssertEqual(completeValue(of: secondComplete), "Not completed")
   235	        secondComplete.tap()
   236	        XCTAssertEqual(
   237	            completeValue(of: secondComplete), "Completed",
   238	            "One tap should log the carried-forward set")
   239	
   240	        finishWorkout()
   241	    }
   242	
   243	    // MARK: - C1: leaving and resuming an active workout
   244	
   245	    /// Ticket 17 C1: the active workout is no longer a trap — it can be
   246	    /// minimised, the tabs are usable, and the Workout tab offers the way
   247	    /// back in.
   248	    func testMinimizeKeepsTheWorkoutActiveAndResumeReopensIt() {
   249	        tab("Workout").tap()
   250	        app.buttons["startEmptyWorkout"].tap()
   251	        XCTAssertTrue(app.buttons["finishWorkout"].waitForExistence(timeout: 5))
   252	
   253	        app.buttons["minimizeWorkout"].tap()
   254	
   255	        let resume = app.buttons["resumeWorkout"]
   256	        XCTAssertTrue(
   257	            resume.waitForExistence(timeout: 5),
   258	            "Minimising should reveal a resume affordance on the Workout tab")
   259	
   260	        // The tab bar is genuinely usable again.
   261	        let history = tab("History")
   262	        XCTAssertTrue(history.isHittable, "The tab bar should be hittable once minimised")
   263	        history.tap()
   264	        tab("Workout").tap()
   265	
   266	        XCTAssertTrue(resume.waitForExistence(timeout: 5))
   267	        resume.tap()
   268	        XCTAssertTrue(
   269	            app.buttons["finishWorkout"].waitForExistence(timeout: 5),
   270	            "Resuming should reopen the still-active workout")
   271	
   272	        // Leave nothing behind.
   273	        app.buttons["Cancel"].firstMatch.tap()
   274	        app.buttons["Discard Workout"].firstMatch.tap()
   275	        XCTAssertTrue(tab("History").waitForExistence(timeout: 5))
   276	    }
