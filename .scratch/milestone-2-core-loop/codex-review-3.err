    42	private struct GymRow: View {
    43	    var gym: Gym
    44	
    45	    var body: some View {
    46	        HStack {
    47	            VStack(alignment: .leading, spacing: 3) {
    48	                Text(gym.name)
    49	                    .font(.headline)
    50	                if let city = gym.city {
    51	                    Text(city)
    52	                        .font(.caption)
    53	                        .foregroundStyle(.secondary)
    54	                }
    55	            }
    56	            Spacer()
    57	            if let unit = gym.defaultUnit {
    58	                UnitBadge(unit: unit)
    59	            } else {
    60	                Text("app default")
    61	                    .font(.caption)
    62	                    .foregroundStyle(.tertiary)
    63	            }
    64	        }
    65	        .padding(.vertical, 2)
    66	    }
    67	}
