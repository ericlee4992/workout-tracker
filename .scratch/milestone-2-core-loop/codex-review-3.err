   160	        tapOption("lb")
   161	        app.buttons["saveGym"].tap()
   162	
   163	        XCTAssertTrue(
   164	            app.staticTexts["Seoul"].waitForExistence(timeout: 5),
   165	            "The edited city should show on the gym")
   166	
