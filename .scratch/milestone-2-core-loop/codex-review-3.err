   172	        anyElement("catalogModel").tap()
   173	        let modelRow = anyElement("modelOption.\(modelName)")
   174	        XCTAssertTrue(modelRow.waitForExistence(timeout: 5))
   175	        modelRow.tap()
   176	        XCTAssertTrue(save.isEnabled, "Picking a model should supply a default label")
   177	        save.tap()
   178	
   179	        // D2: the machine's default unit is editable after creation.
   180	        let machineRow = app.staticTexts["Insignia Series Chest Press"]
   181	        XCTAssertTrue(
   182	            machineRow.waitForExistence(timeout: 5),
   183	            "The machine should be labelled after the model")
   184	        machineRow.press(forDuration: 1.2)
   185	        app.buttons["Edit Machine…"].tap()
   186	        XCTAssertTrue(anyElement("machineUnitPicker").waitForExistence(timeout: 5))
   187	        anyElement("machineUnitPicker").tap()
   188	        tapOption("kg")
   189	        app.buttons["saveMachine"].tap()
   190	        XCTAssertTrue(machineRow.waitForExistence(timeout: 5))
   191	    }
   192	
   193	    // MARK: - B1: within-session carry-forward
   194	
   195	    /// Ticket 17 B1: the second set of an exercise must not be retyped. Add
   196	    /// Set inherits the last completed row's weight, unit and reps, arrives
   197	    /// uncompleted, and logs in a single tap.
   198	    func testAddSetCarriesForwardTheLastCompletedSet() {
   199	        createGym()
   200	        addMachine()
   201	        startEmptyWorkout()
   202	        addByMachine()
   203	
   204	        let weight = app.textFields["setRow.weight"].firstMatch
   205	        XCTAssertTrue(weight.waitForExistence(timeout: 5))
   206	        weight.tap()
   207	        weight.typeText("80")
   208	        let reps = app.textFields["setRow.reps"].firstMatch
