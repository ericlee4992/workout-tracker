   136	    // MARK: Start flow
   137	
   138	    /// Start-while-active offers Resume or Finish-and-start-new.
   139	    private func startTapped(template: WorkoutTemplate?) {
   140	        pendingTemplate = template
   141	        if (try? session.resumableWorkout()) != nil {
   142	            showingResumeDialog = true
   143	        } else {
   144	            startNew()
   145	        }
   146	    }
   147	
   148	    private func startNew() {
   149	        do {
   150	            // Any still-active workout is auto-finished by `startWorkout`,
   151	            // which ends its rest timer and pending notification.
   152	            let workout: Workout
   153	            if let template = pendingTemplate {
   154	                workout = try WorkoutTemplateService(context: modelContext)
   155	                    .start(template, at: selectedGym)
   156	            } else {
   157	                workout = try session.startWorkout(at: selectedGym)
   158	            }
   159	            pendingTemplate = nil
   160	            onWorkoutStarted(workout)
   161	        } catch {
   162	            assertionFailure("Failed to start workout: \(error)")
   163	        }
   164	    }
   165	
   166	    private func finishActiveThenStartTapped() {
   167	        do {
   168	            guard let active = try session.resumableWorkout() else {
   169	                startNew()
   170	                return
   171	            }
   172	            let drift = TemplateDriftService(context: modelContext)
   173	            if let template = try drift.sourceTemplate(for: active),
   174	               try drift.shouldPrompt(for: active, template: template) {
   175	                replacementWorkout = active
   176	                replacementSourceTemplate = template
   177	                showingReplacementDrift = true
   178	            } else {
   179	                startNew()
   180	            }
   181	        } catch {
   182	            assertionFailure("Failed to inspect active workout drift: \(error)")
   183	        }
   184	    }
   185	
   186	    private func resolveReplacementDrift(_ resolution: TemplateDriftResolution) {
   187	        do {
   188	            if let workout = replacementWorkout,
   189	               let template = replacementSourceTemplate {
   190	                try TemplateDriftService(context: modelContext).resolve(
   191	                    resolution, workout: workout, to: template)
   192	            }
   193	            replacementWorkout = nil
   194	            replacementSourceTemplate = nil
   195	            startNew()
   196	        } catch {
   197	            assertionFailure("Failed to resolve template before starting: \(error)")
   198	        }
   199	    }
   200	
   201	    private func resumeActive() {
   202	        pendingTemplate = nil
   203	        if let workout = try? session.resumableWorkout() {
   204	            onWorkoutStarted(workout)
   205	        }
   206	    }
   207	
   208	    private func delete(_ template: WorkoutTemplate) {
   209	        do { try WorkoutTemplateService(context: modelContext).delete(template) }
   210	        catch { assertionFailure("Failed to delete template: \(error)") }
   211	    }
