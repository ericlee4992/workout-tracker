   119	    /// Plain bodyweight logs on reps alone; the other three load types need a
   120	    /// value, but accept zero.
   121	    @Test func loadTypeSpecificCompletionRules() throws {
   122	        // bodyweight: reps only.
   123	        let bodyweight = try makeRig(loadType: .bodyweight)
   124	        let bwRow = try firstDraft(bodyweight).set
   125	        try bodyweight.session.commitReps("20", for: bwRow)
   126	        try bodyweight.session.toggleCompletion(of: bwRow)
   127	        #expect(bwRow.completedAt != nil)
