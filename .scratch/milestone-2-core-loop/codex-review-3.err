    14	    /// resurrected: archival is how a gym leaves the pickers (ticket 10), and
    15	    /// a remembered id must not be a back door around that.
    16	    static func resolve(id: UUID?, among gyms: [Gym]) -> Gym? {
    17	        guard let id else { return nil }
    18	        return gyms.first { $0.id == id && !$0.archived }
