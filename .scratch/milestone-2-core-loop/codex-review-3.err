     1	import Foundation
     2	import SwiftData
     3	import Testing
     4	@testable import WorkoutTracker
     5	
     6	/// Ticket 17 A1 + B1 — the two honesty/speed rules of the set row:
     7	/// a set may only be completed once it says something true, and a new set
     8	/// inherits what the last completed one said.
     9	struct SetLoggingTests {
    10	    private func makeContext() throws -> ModelContext {
    11	        let schema = WorkoutTrackerStore.schema
    12	        let container = try ModelContainer(
    13	            for: schema,
    14	            configurations: [ModelConfiguration(schema: schema, isStoredInMemoryOnly: true)])
    15	        return ModelContext(container)
    16	    }
    17	
    18	    private struct Rig {
    19	        var context: ModelContext
    20	        var session: WorkoutSession
    21	        var exercise: Exercise
    22	        var gym: Gym
    23	        var machine: MachineInstance
    24	    }
    25	
    26	    private func makeRig(loadType: LoadType = .weighted) throws -> Rig {
    27	        let context = try makeContext()
    28	        let exercise = Exercise(name: "Press", loadType: loadType)
    29	        let model = EquipmentModel(
    30	            manufacturer: "Life Fitness", modelName: "Insignia",
    31	            exerciseIDs: [exercise.id])
    32	        let gym = Gym(name: "Gym", defaultUnit: .kg)
    33	        let machine = MachineInstance(label: "Press 1", gym: gym, model: model)
    34	        for object in [exercise, model, gym, machine] as [any PersistentModel] {
    35	            context.insert(object)
    36	        }
    37	        try context.save()
    38	        return Rig(
    39	            context: context, session: WorkoutSession(context: context),
    40	            exercise: exercise, gym: gym, machine: machine)
    41	    }
    42	
    43	    private func firstDraft(_ rig: Rig, at date: Date = Date(timeIntervalSince1970: 100))
    44	        throws -> (workout: Workout, entry: ExerciseEntry, set: SetRecord) {
    45	        let workout = try rig.session.startWorkout(at: rig.gym, on: date)
    46	        let entry = try rig.session.addEntry(
    47	            for: rig.exercise, to: workout, machine: rig.machine)
    48	        let set = try #require(WorkoutSession.orderedSets(of: entry).first)
    49	        return (workout, entry, set)
    50	    }
    51	
    52	    // MARK: - A1: an empty set cannot be completed
    53	
    54	    /// The predicate itself, over every load type: reps must be positive, and
    55	    /// only plain bodyweight may log without a weight value. Zero is a real
    56	    /// answer for assisted/bodyweightPlus; nil never is.
    57	    @Test func loggabilityRulesPerLoadType() {
    58	        for loadType in LoadType.allCases {
    59	            // No reps at all.
    60	            #expect(!WorkoutSession.isLoggable(
    61	                reps: nil, weightValue: 60, loadType: loadType))
    62	            // Zero reps is not a set.
    63	            #expect(!WorkoutSession.isLoggable(
    64	                reps: 0, weightValue: 60, loadType: loadType))
    65	            // Reps + a weight value always works.
    66	            #expect(WorkoutSession.isLoggable(
    67	                reps: 10, weightValue: 60, loadType: loadType))
    68	        }
    69	
    70	        // Reps alone: only plain bodyweight.
    71	        #expect(WorkoutSession.isLoggable(
    72	            reps: 10, weightValue: nil, loadType: .bodyweight))
    73	        #expect(!WorkoutSession.isLoggable(
    74	            reps: 10, weightValue: nil, loadType: .weighted))
    75	        #expect(!WorkoutSession.isLoggable(
    76	            reps: 10, weightValue: nil, loadType: .assisted))
    77	        #expect(!WorkoutSession.isLoggable(
    78	            reps: 10, weightValue: nil, loadType: .bodyweightPlus))
    79	
    80	        // Zero load is meaningful where it means "unassisted" / "no added
    81	        // weight" (ticket 12 eligibility) — and harmless elsewhere.
    82	        #expect(WorkoutSession.isLoggable(
    83	            reps: 10, weightValue: 0, loadType: .assisted))
    84	        #expect(WorkoutSession.isLoggable(
    85	            reps: 10, weightValue: 0, loadType: .bodyweightPlus))
    86	    }
    87	
    88	    /// A1: the empty row that used to persist as `— × —` now refuses, and
    89	    /// leaves no trace — no completion stamp, no D23 snapshot, no memory row.
    90	    @Test func completingAnEmptySetThrowsAndChangesNothing() throws {
