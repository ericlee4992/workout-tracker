   101	        // Reps alone are still not enough for a weighted exercise.
   102	        try rig.session.commitReps("10", for: set)
   103	        #expect(throws: WorkoutSessionError.setNotLoggable) {
   104	            try rig.session.toggleCompletion(of: set)
   105	        }
   106	        // Zero reps is not a set either.
   107	        try rig.session.commitWeight("60", for: set)
   108	        try rig.session.commitReps("0", for: set)
   109	        #expect(throws: WorkoutSessionError.setNotLoggable) {
   110	            try rig.session.toggleCompletion(of: set)
   111	        }
   112	
   113	        try rig.session.commitReps("10", for: set)
   114	        try rig.session.toggleCompletion(of: set)
   115	        #expect(set.completedAt != nil)
   116	        #expect(entry.snapshotCapturedAt != nil)
   117	    }
