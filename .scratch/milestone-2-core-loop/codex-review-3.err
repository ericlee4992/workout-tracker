   389	                }
   390	            }
   391	            .navigationTitle(machine == nil ? "New Machine" : "Edit Machine")
   392	            .navigationBarTitleDisplayMode(.inline)
   393	            .toolbar {
   394	                ToolbarItem(placement: .cancellationAction) {
   395	                    Button("Cancel") { dismiss() }
   396	                }
   397	                ToolbarItem(placement: .confirmationAction) {
   398	                    Button(machine == nil ? "Add" : "Save") { save() }
   399	                        .disabled(trimmedLabel.isEmpty)
   400	                        .accessibilityIdentifier("saveMachine")
   401	                }
   402	            }
