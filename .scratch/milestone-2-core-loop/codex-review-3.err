   209	    /// With nothing completed yet, `addSet` behaves exactly as before: an
   210	    /// empty row carrying only the unit, left for ticket 11's cross-workout
   211	    /// prefill to populate.
   212	    @Test func addSetWithoutACompletedSetKeepsTheOldBehaviour() throws {
   213	        let rig = try makeRig()
   214	        let (_, entry, first) = try firstDraft(rig)
   215	        try rig.session.commitWeight("60", for: first)
   216	        try rig.session.commitReps("10", for: first) // typed, never completed
   217	        try rig.session.toggleUnit(of: first)
   218	
   219	        let second = try rig.session.addSet(to: entry)
   220	        #expect(second.weightValue == nil)
   221	        #expect(second.reps == nil)
   222	        #expect(second.normalizedKg == nil)
   223	        #expect(second.weightUnit == .lb) // unit still follows the last row
   224	        #expect(second.completedAt == nil)
   225	    }
   226	
   227	    /// The source is the last *completed* set, not the last row — a draft
   228	    /// row someone half-typed into does not become the template.
   229	    @Test func carryForwardIgnoresLaterDraftRows() throws {
   230	        let rig = try makeRig()
   231	        let (_, entry, first) = try firstDraft(rig)
   232	        try rig.session.commitWeight("60", for: first)
   233	        try rig.session.commitReps("10", for: first)
   234	        try rig.session.toggleCompletion(of: first)
   235	
   236	        let second = try rig.session.addSet(to: entry)
   237	        try rig.session.commitWeight("999", for: second) // draft, uncompleted
   238	
   239	        let third = try rig.session.addSet(to: entry)
   240	        #expect(third.weightValue == 60)
   241	        #expect(third.reps == 10)
   242	        #expect(third.order == 2)
   243	    }
