   111	
   112	    // MARK: - A2: an empty workout never reaches History
   113	
   114	    /// Ticket 17 A2: Start → Finish with nothing logged leaves no trace, and
   115	    /// says so rather than confirming a save that never happened.
   116	    func testFinishingAnEmptyWorkoutDiscardsItAndSaysSo() {
   117	        tab("Workout").tap()
   118	        app.buttons["startEmptyWorkout"].tap()
   119	        XCTAssertTrue(app.buttons["finishWorkout"].waitForExistence(timeout: 5))
   120	
   121	        // D1: with no gym the machine-first path stays visible and explains
   122	        // itself instead of silently disappearing.
   123	        let addByMachine = app.buttons["addByMachine"]
   124	        XCTAssertTrue(
   125	            addByMachine.waitForExistence(timeout: 5),
   126	            "Add by Machine should stay visible without a gym")
   127	        XCTAssertFalse(addByMachine.isEnabled, "…but disabled")
   128	        XCTAssertTrue(
   129	            anyElement("addByMachineUnavailable").exists,
   130	            "…with a short explanation of why")
   131	
   132	        app.buttons["finishWorkout"].tap()
   133	        let summary = app.staticTexts["finishedSummary"]
   134	        XCTAssertTrue(summary.waitForExistence(timeout: 5))
   135	        XCTAssertTrue(
   136	            summary.label.contains("wasn't saved"),
   137	            "Finishing an empty workout should say nothing was saved, got: \(summary.label)")
   138	        app.buttons["finishedDone"].tap()
   139	
   140	        tab("History").tap()
   141	        XCTAssertTrue(
   142	            app.staticTexts["No workouts yet"].waitForExistence(timeout: 5),
   143	            "An empty workout must never reach History")
   144	    }
   145	
   146	    // MARK: - D2/D3: gyms and machines are editable
   147	
   148	    /// Ticket 17 D2: a gym's unit and city are corrections, not one-shot
   149	    /// choices. D3: picking a catalog model names the machine for you.
   150	    func testGymSettingsAreEditableAndModelNamesTheMachine() {
   151	        createGym()
   152	
   153	        anyElement("gymRow.\(gymName)").tap()
   154	        app.buttons["editGym"].tap()
   155	        let city = app.textFields["City (optional)"]
   156	        XCTAssertTrue(city.waitForExistence(timeout: 5))
   157	        city.tap()
   158	        city.typeText("Seoul")
