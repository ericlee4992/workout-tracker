     1	import Foundation
     2	import SwiftData
     3	
     4	struct TemplateDriftItem: Equatable {
     5	    var exerciseID: UUID
     6	    var targetRepsBySet: [Int?]
     7	}
     8	
     9	enum TemplateDriftResolution: CaseIterable, Equatable, Sendable {
    10	    case updateTemplate
    11	    case updateValuesOnly
    12	    case updateBoth
    13	    case keepOriginal
    14	}
    15	
    16	/// Pure D18 comparison and transition rules. Exercise occurrences are
    17	/// matched in order, so duplicate exercises remain deterministic.
    18	enum TemplateDrift {
    19	    static func hasDrift(
    20	        template: [TemplateDriftItem],
    21	        workout: [TemplateDriftItem]
    22	    ) -> Bool {
    23	        template != workout
    24	    }
    25	
    26	    static func resolving(
    27	        _ resolution: TemplateDriftResolution,
    28	        template: [TemplateDriftItem],
    29	        workout: [TemplateDriftItem]
    30	    ) -> [TemplateDriftItem] {
    31	        switch resolution {
    32	        case .keepOriginal:
    33	            return template
    34	        case .updateBoth:
    35	            return workout
    36	        case .updateTemplate:
    37	            let matches = matchesFromWorkoutToTemplate(
    38	                template: template, workout: workout)
    39	            return workout.enumerated().map { index, item in
    40	                let oldTargets = matches[index].map {
    41	                    template[$0].targetRepsBySet
    42	                } ?? []
    43	                return TemplateDriftItem(
    44	                    exerciseID: item.exerciseID,
    45	                    targetRepsBySet: (0..<item.targetRepsBySet.count).map {
    46	                        oldTargets.indices.contains($0) ? oldTargets[$0] : nil
    47	                    })
    48	            }
    49	        case .updateValuesOnly:
    50	            var result = template
    51	            let matches = matchesFromWorkoutToTemplate(
    52	                template: template, workout: workout)
    53	            for (workoutIndex, templateIndex) in matches.enumerated() {
    54	                guard let templateIndex else { continue }
    55	                let completed = workout[workoutIndex].targetRepsBySet
    56	                for slot in result[templateIndex].targetRepsBySet.indices
    57	                    where completed.indices.contains(slot) {
    58	                    result[templateIndex].targetRepsBySet[slot] = completed[slot]
    59	                }
    60	            }
    61	            return result
    62	        }
    63	    }
    64	
    65	    private static func matchesFromWorkoutToTemplate(
    66	        template: [TemplateDriftItem],
    67	        workout: [TemplateDriftItem]
    68	    ) -> [Int?] {
    69	        var available: [UUID: [Int]] = [:]
    70	        for (index, item) in template.enumerated() {
    71	            available[item.exerciseID, default: []].append(index)
    72	        }
    73	        var usedCount: [UUID: Int] = [:]
    74	        var result: [Int?] = []
    75	        for item in workout {
    76	            let occurrence = usedCount[item.exerciseID, default: 0]
    77	            let candidates = available[item.exerciseID] ?? []
    78	            result.append(candidates.indices.contains(occurrence)
    79	                ? candidates[occurrence]
    80	                : nil)
    81	            usedCount[item.exerciseID] = occurrence + 1
    82	        }
    83	        return result
    84	    }
    85	}
    86	
    87	/// SwiftData boundary around the pure drift policy. Draft set rows and
    88	/// entries with zero completed sets never enter the workout snapshot.
    89	struct TemplateDriftService {
    90	    let context: ModelContext
    91	
    92	    func sourceTemplate(for workout: Workout) throws -> WorkoutTemplate? {
    93	        guard let sourceID = workout.sourceTemplateID else { return nil }
    94	        let id = sourceID
    95	        return try context.fetch(FetchDescriptor<WorkoutTemplate>(
    96	            predicate: #Predicate { $0.id == id })).first
    97	    }
    98	
    99	    func shouldPrompt(for workout: Workout, template: WorkoutTemplate) throws -> Bool {
   100	        let preferences = try context.fetch(FetchDescriptor<AppPreferences>())
   101	        guard AppPreferences.canonical(of: preferences)?.driftPromptSuppressed != true else {
   102	            return false
   103	        }
   104	        return TemplateDrift.hasDrift(
   105	            template: templateSnapshot(template),
   106	            workout: workoutSnapshot(workout))
   107	    }
   108	
   109	    func apply(
   110	        _ resolution: TemplateDriftResolution,
   111	        workout: Workout,
   112	        to template: WorkoutTemplate
   113	    ) throws {
   114	        guard resolution != .keepOriginal else { return }
   115	        let original = templateSnapshot(template)
   116	        let completed = workoutSnapshot(workout)
   117	        let resolved = TemplateDrift.resolving(
   118	            resolution, template: original, workout: completed)
   119	
   120	        if resolution == .updateValuesOnly {
   121	            // Pair rows with resolved values from ONE filtered source. A
   122	            // positional zip over `orderedItems` would shift every target by
   123	            // one for each item whose exercise was nullified by a delete,
   124	            // writing one exercise's reps onto another.
   125	            for (row, values) in zip(snapshotRows(template), resolved) {
   126	                guard row.snapshot.exerciseID == values.exerciseID else { continue }
   127	                row.item.targetSets = values.targetRepsBySet.count
   128	                row.item.targetRepsBySet = values.targetRepsBySet
   129	                row.item.targetReps = values.targetRepsBySet.first.flatMap { $0 }
   130	            }
   131	            try context.save()
   132	            return
   133	        }
   134	
   135	        let exercises = exerciseLookup(template: template, workout: workout)
   136	        for old in template.items ?? [] { context.delete(old) }
   137	        for (order, value) in resolved.enumerated() {
   138	            guard let exercise = exercises[value.exerciseID] else { continue }
   139	            let item = TemplateItem(
   140	                order: order,
   141	                targetSets: value.targetRepsBySet.count,
   142	                targetReps: value.targetRepsBySet.first.flatMap { $0 },
   143	                targetRepsBySet: value.targetRepsBySet,
   144	                exercise: exercise)
   145	            item.template = template
   146	            context.insert(item)
   147	        }
   148	        try context.save()
   149	    }
   150	
   151	    /// Close out a template-sourced workout: apply the chosen resolution, then
   152	    /// finish the workout. The order matters — `apply` reads the workout's
   153	    /// completed structure and `finish` prunes the workout — so both drift
   154	    /// prompts (finishing, and replacing an active workout) share this one
   155	    /// sequence rather than each spelling it out.
   156	    @discardableResult
   157	    func resolve(
   158	        _ resolution: TemplateDriftResolution,
   159	        workout: Workout,
   160	        to template: WorkoutTemplate
   161	    ) throws -> WorkoutFinishOutcome {
   162	        try apply(resolution, workout: workout, to: template)
   163	        return try WorkoutSession(context: context).finish(workout)
   164	    }
   165	
   166	    func templateSnapshot(_ template: WorkoutTemplate) -> [TemplateDriftItem] {
   167	        snapshotRows(template).map(\.snapshot)
   168	    }
   169	
   170	    /// The template's comparable rows, each still carrying the `TemplateItem`
   171	    /// it came from. Items whose `exercise` was nullified by a delete have no
   172	    /// identity to match on and are dropped here — the single place that
   173	    /// filtering happens, so snapshots and write targets can never diverge.
   174	    private func snapshotRows(
   175	        _ template: WorkoutTemplate
   176	    ) -> [(item: TemplateItem, snapshot: TemplateDriftItem)] {
   177	        WorkoutTemplateService.orderedItems(of: template).compactMap { item in
   178	            guard let exerciseID = item.exercise?.id else { return nil }
   179	            return (item, TemplateDriftItem(
   180	                exerciseID: exerciseID,
   181	                targetRepsBySet: item.storedTargets.repsBySet))
   182	        }
   183	    }
   184	
   185	    func workoutSnapshot(_ workout: Workout) -> [TemplateDriftItem] {
   186	        WorkoutSession.orderedEntries(of: workout).compactMap { entry in
   187	            guard let exerciseID = entry.exercise?.id else { return nil }
   188	            let completed = WorkoutSession.orderedSets(of: entry)
   189	                .filter { $0.completedAt != nil }
   190	            guard !completed.isEmpty else { return nil }
   191	            return TemplateDriftItem(
   192	                exerciseID: exerciseID,
   193	                targetRepsBySet: completed.map(\.reps))
   194	        }
   195	    }
   196	
   197	    private func exerciseLookup(
   198	        template: WorkoutTemplate,
   199	        workout: Workout
   200	    ) -> [UUID: Exercise] {
   201	        let templateExercises = WorkoutTemplateService.orderedItems(of: template)
   202	            .compactMap(\.exercise)
   203	        let workoutExercises = WorkoutSession.orderedEntries(of: workout)
   204	            .compactMap(\.exercise)
   205	        return Dictionary(
   206	            (templateExercises + workoutExercises).map { ($0.id, $0) },
   207	            uniquingKeysWith: { first, _ in first })
   208	    }
   209	}
     1	import SwiftData
     2	import SwiftUI
     3	
     4	/// C2 (ticket 17) — the receipt for a finished workout. Finishing used to
     5	/// drop you on the Workout tab with no confirmation and no way back to what
     6	/// you just logged. This says what was saved, offers the workout itself, and
     7	/// carries the save-as-template option that used to block Finish (B2).
     8	///
     9	/// A2: `workout` is nil when the workout was empty and got discarded instead
    10	/// of finished. The same receipt then says *that* — silently vanishing and
    11	/// confirming a save are both lies about what happened.
    12	///
    13	/// Light and skippable: Done is always one tap away.
    14	struct WorkoutFinishedSheet: View {
    15	    @Environment(\.modelContext) private var modelContext
    16	    /// The saved workout, or nil when nothing was logged (A2).
    17	    var workout: Workout?
    18	    /// Dismisses the sheet and shows the workout in History.
    19	    var viewInHistory: () -> Void
    20	    var done: () -> Void
    21	
    22	    @State private var namingTemplate = false
    23	    @State private var templateName = ""
    24	    @State private var templateFailure: String?
    25	    @State private var savedTemplateName: String?
    26	
    27	    /// The workout only when it really reached history — a deleted or
    28	    /// missing one is the discarded case, whatever the caller passed.
    29	    private var savedWorkout: Workout? {
    30	        guard let workout, !workout.isDeleted, workout.finishedAt != nil else {
    31	            return nil
    32	        }
    33	        return workout
    34	    }
    35	
    36	    private var entryCount: Int {
    37	        savedWorkout.map { WorkoutSession.orderedEntries(of: $0).count } ?? 0
    38	    }
    39	
    40	    private var setCount: Int {
    41	        savedWorkout?.completedSets.count ?? 0
    42	    }
    43	
    44	    var body: some View {
    45	        NavigationStack {
    46	            List {
    47	                Section {
    48	                    VStack(alignment: .leading, spacing: 6) {
    49	                        Label(
    50	                            savedWorkout == nil ? "Nothing to save" : "Workout saved",
    51	                            systemImage: savedWorkout == nil
    52	                                ? "tray" : "checkmark.circle.fill")
    53	                            .font(.headline)
    54	                            .foregroundStyle(savedWorkout == nil ? Color.secondary : Color.green)
    55	                        Text(summaryLine)
    56	                            .font(.subheadline)
    57	                            .foregroundStyle(.secondary)
    58	                            .accessibilityIdentifier("finishedSummary")
    59	                    }
    60	                    .padding(.vertical, 4)
    61	                }
    62	
    63	                if savedWorkout != nil {
    64	                    Section {
    65	                        Button("View in History", systemImage: "clock.arrow.circlepath") {
    66	                            viewInHistory()
    67	                        }
    68	                        .accessibilityIdentifier("viewFinishedWorkout")
    69	
    70	                        if let savedTemplateName {
    71	                            Label("Saved as template “\(savedTemplateName)”", systemImage: "checkmark")
    72	                                .foregroundStyle(.secondary)
    73	                        } else if canSaveAsTemplate {
    74	                            Button("Save as Template", systemImage: "square.on.square") {
    75	                                templateName = defaultTemplateName
    76	                                namingTemplate = true
    77	                            }
    78	                            .accessibilityIdentifier("saveAsTemplate")
    79	                        }
    80	                    } footer: {
    81	                        if savedTemplateName == nil, canSaveAsTemplate {
    82	                            Text("Completed sets become target set and rep slots. Weights and rest times are not saved.")
    83	                        }
    84	                    }
    85	                }
    86	            }
    87	            .navigationTitle(savedWorkout == nil ? "Nothing logged" : "Nice work")
    88	            .navigationBarTitleDisplayMode(.inline)
    89	            .toolbar {
    90	                ToolbarItem(placement: .topBarTrailing) {
    91	                    Button("Done") { done() }
    92	                        .font(.headline)
    93	                        .accessibilityIdentifier("finishedDone")
    94	                }
    95	            }
    96	            .alert("Save as Template", isPresented: $namingTemplate) {
    97	                TextField("Template name", text: $templateName)
    98	                Button("Save") { saveTemplate() }
    99	                    .disabled(templateName.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty)
   100	                Button("Cancel", role: .cancel) {}
   101	            } message: {
   102	                Text("Completed sets become target set and rep slots. Weights and rest times are not saved.")
   103	            }
   104	            .alert(
   105	                "Couldn't Save Template",
   106	                isPresented: Binding(
   107	                    get: { templateFailure != nil },
   108	                    set: { if !$0 { templateFailure = nil } })
   109	            ) {
   110	                Button("OK", role: .cancel) { templateFailure = nil }
   111	            } message: {
   112	                Text(templateFailure ?? "")
   113	            }
   114	        }
   115	    }
   116	
   117	    private var summaryLine: String {
   118	        guard let saved = savedWorkout else {
   119	            return "No sets were completed, so this workout wasn't saved."
   120	        }
   121	        var parts = [
   122	            HistoryRendering.pluralized(entryCount, "exercise", "exercises"),
   123	            HistoryRendering.pluralized(setCount, "set", "sets"),
   124	        ]
   125	        if let gymName = saved.gym?.name {
   126	            parts.append(gymName)
   127	        }
   128	        return parts.joined(separator: " · ")
   129	    }
   130	
   131	    /// A workout can only become a template once something has been
   132	    /// completed — `saveAsTemplate` captures completed sets only and throws
   133	    /// `noExercises` otherwise.
   134	    private var canSaveAsTemplate: Bool {
   135	        savedWorkout.map(WorkoutTemplateService.canSaveAsTemplate) ?? false
   136	    }
   137	
   138	    private var defaultTemplateName: String {
   139	        let formatter = DateFormatter()
   140	        formatter.dateStyle = .medium
   141	        let date = savedWorkout?.startedAt ?? .now
   142	        return "Workout \(formatter.string(from: date))"
   143	    }
   144	
   145	    private func saveTemplate() {
   146	        guard let saved = savedWorkout else { return }
   147	        do {
   148	            let template = try WorkoutTemplateService(context: modelContext)
   149	                .saveAsTemplate(saved, name: templateName)
   150	            savedTemplateName = template.name
   151	        } catch {
   152	            templateFailure = Self.templateFailureMessage(error)
   153	        }
   154	    }
   155	
   156	    private static func templateFailureMessage(_ error: Error) -> String {
   157	        switch error as? WorkoutTemplateError {
   158	        case .emptyName:
   159	            return "Give the template a name and try again."
   160	        case .noExercises:
   161	            return "This workout has no completed sets, so there is nothing to save as a template."
   162	        case nil:
   163	            return "The template could not be saved: \(error.localizedDescription)"
   164	        }
   165	    }
   166	}
