    54	        unitChip.tap()
    55	        XCTAssertEqual(unitChip.label, "lb", "Tapping the unit chip should switch the set to lb")
    56	
    57	        let complete = app.buttons["setRow.complete"].firstMatch
    58	        complete.tap()
    59	        XCTAssertEqual(completeValue(of: complete), "Completed")
    60	
    61	        finishWorkout()
    62	
    63	        // --- History -------------------------------------------------------
    64	        tab("History").tap()
    65	        // E1/E2 (ticket 17): the row is headlined by what was performed, not
    66	        // by the gym, and the counts agree with their nouns.
    67	        XCTAssertTrue(
    68	            app.staticTexts[exerciseName].waitForExistence(timeout: 5),
    69	            "The history row should be titled by the exercise performed")
    70	        let summary = app.staticTexts.matching(
    71	            NSPredicate(format: "label CONTAINS %@", "1 exercise · 1 set")).firstMatch
    72	        XCTAssertTrue(
    73	            summary.waitForExistence(timeout: 5),
    74	            "The finished workout should appear in History with 1 exercise and 1 set")
    75	
    76	        // --- Second workout on the same machine ----------------------------
    77	        startEmptyWorkout()
    78	        addByMachine()
    79	
    80	        let previous = app.staticTexts["setRow.previous"].firstMatch
    81	        XCTAssertTrue(previous.waitForExistence(timeout: 5))
    82	        XCTAssertEqual(
    83	            previous.label, "60 lb × 10",
    84	            "The PREVIOUS column should show last session's set on this machine")
    85	
    86	        let repeatWeight = app.textFields["setRow.weight"].firstMatch
    87	        XCTAssertEqual(value(of: repeatWeight), "60", "Prefill should populate the weight field")
    88	        XCTAssertEqual(
    89	            value(of: app.textFields["setRow.reps"].firstMatch), "10",
    90	            "Prefill should populate the reps field")
    91	        XCTAssertEqual(
    92	            app.buttons["setRow.unit"].firstMatch.label, "lb",
    93	            "Prefill should keep the unit as entered last time")
    94	
    95	        // The one-tap guarantee: an untouched prefilled row is logged by a
    96	        // single tap on the checkmark — no typing, no extra confirmation.
    97	        let repeatComplete = app.buttons["setRow.complete"].firstMatch
    98	        XCTAssertEqual(completeValue(of: repeatComplete), "Not completed")
    99	        repeatComplete.tap()
   100	        XCTAssertEqual(
   101	            completeValue(of: repeatComplete), "Completed",
   102	            "One tap on the checkmark should log the repeat set")
   103	
   104	        finishWorkout()
   105	
   106	        tab("History").tap()
   107	        let rows = app.staticTexts.matching(
   108	            NSPredicate(format: "label CONTAINS %@", "1 exercise · 1 set"))
   109	        XCTAssertEqual(rows.count, 2, "Both workouts should be in History")
