   261	                    } else {
   262	                        Text(title)
   263	                    }
   264	                }
   265	            }
   266	        } label: {
   267	            HStack {
   268	                Image(systemName: "mappin.and.ellipse")
   269	                    .foregroundStyle(.tint)
   270	                VStack(alignment: .leading, spacing: 2) {
   271	                    Text(selectedGym?.name ?? "No gym")
   272	                        .font(.headline)
   273	                        .foregroundStyle(.primary)
   274	                    Text(selectedGym.map { $0.city ?? "" } ?? "Home / no location")
   275	                        .font(.subheadline)
   276	                        .foregroundStyle(.secondary)
   277	                }
   278	                Spacer()
   279	                UnitBadge(unit: currentUnit)
   280	                Image(systemName: "chevron.up.chevron.down")
   281	                    .font(.caption)
   282	                    .foregroundStyle(.secondary)
   283	            }
   284	        }
   285	        .accessibilityIdentifier("gymPicker")
   286	    }
