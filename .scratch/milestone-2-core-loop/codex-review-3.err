    21	    @State private var showingResumeDialog = false
    22	    @State private var pendingTemplate: WorkoutTemplate?
    23	    @State private var editingTemplate: WorkoutTemplate?
    24	    @State private var showingTemplateEditor = false
    25	    @State private var replacementWorkout: Workout?
    26	    @State private var replacementSourceTemplate: WorkoutTemplate?
    27	    @State private var showingReplacementDrift = false
    28	    /// Called with the workout to present — freshly started or resumed.
    29	    var onWorkoutStarted: (Workout) -> Void
    30	
    31	    private var session: WorkoutSession { WorkoutSession(context: modelContext) }
    32	
