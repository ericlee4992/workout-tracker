     private var weightHeader: String {
         loadType == .assisted ? "ASSIST" : "WEIGHT"
     }
 
     private func workingIndex(of set: SetRecord) -> Int {
         var index = 0
         for s in orderedSets {
             if s.type != .warmup { index += 1 }
             if s.id == set.id { break }
         }
         return index
     }
 
     // MARK: Actions
 
     private func addSet() {
         do {
