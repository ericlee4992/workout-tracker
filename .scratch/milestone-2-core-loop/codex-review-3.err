   215	    /// Gym-level unit for the currently picked gym, falling through to the
   216	    /// app preference (T7; no machine context here).
   217	    private var currentUnit: WeightUnit {
   218	        UnitPrecedence.defaultUnit(
   219	            machineUnit: nil,
   220	            gymUnit: selectedGym?.defaultUnit,
   221	            appPreference: AppPreferences.canonical(of: allPreferences)?.unitPreference)
   222	    }
   223	
   224	    /// D1: restore the remembered gym at launch. An archived or deleted gym
   225	    /// resolves to "No gym" — archival is how a gym leaves the pickers.
   226	    private func restoreSelectedGym() {
   227	        guard !restoredSelectedGym else { return }
   228	        restoredSelectedGym = true
   229	        selectedGym = GymSelection.resolve(
   230	            id: AppPreferences.canonical(of: allPreferences)?.selectedGymID,
   231	            among: gyms)
   232	    }
   233	
   234	    /// D1: every pick is remembered — the gym is the anchor of the whole
   235	    /// equipment model, so re-choosing it each launch was a tax on the
   236	    /// differentiator. "No gym" is itself a remembered choice.
   237	    private func select(_ gym: Gym?) {
   238	        selectedGym = gym
   239	        do { try GymSelection.remember(gym, in: modelContext) }
   240	        catch { assertionFailure("Failed to remember gym selection: \(error)") }
   241	    }
   242	
