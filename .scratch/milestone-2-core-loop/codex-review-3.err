   183	struct SetRowView: View {
   184	    @Environment(\.modelContext) private var modelContext
   185	    var set: SetRecord
   186	    var index: Int
   187	    /// The entry's load type — decides which fields this row must carry
   188	    /// before it may be logged (A1).
   189	    var loadType: LoadType
   190	    /// Called after either completion direction so the rest timer can start,
   191	    /// replace, or cancel its persisted source.
   192	    var onCompletionChanged: (Bool) -> Void
   193	    var onDelete: () -> Void
   194	
   195	    // In-progress keystrokes live here; they hit the store only on commit
   196	    // (end-editing / completion) — SPEC's durability boundary.
   197	    @State private var weightText: String
   198	    @State private var repsText: String
   199	    @State private var previousLabel = "—"
   200	    @State private var isDirty = false
   201	    @FocusState private var focusedField: Field?
   202	
   203	    private enum Field { case weight, reps }
   204	
   205	    private var session: WorkoutSession { WorkoutSession(context: modelContext) }
   206	
   207	    init(
   208	        set: SetRecord, index: Int, loadType: LoadType,
   209	        onCompletionChanged: @escaping (Bool) -> Void,
   210	        onDelete: @escaping () -> Void
   211	    ) {
   212	        self.set = set
   213	        self.index = index
   214	        self.loadType = loadType
   215	        self.onCompletionChanged = onCompletionChanged
   216	        self.onDelete = onDelete
   217	        _weightText = State(initialValue: set.weightValue.map(Format.weight) ?? "")
   218	        _repsText = State(initialValue: set.reps.map(String.init) ?? "")
   219	    }
   220	
   221	    private var isCompleted: Bool { !set.isDeleted && set.completedAt != nil }
   222	
   223	    var body: some View {
   224	        HStack(spacing: 8) {
   225	            setTypeButton
   226	
   227	            Text(previousLabel)
   228	                .font(.footnote)
   229	                .foregroundStyle(previousLabel == "—" ? .tertiary : .secondary)
   230	                .frame(maxWidth: .infinity, alignment: .leading)
   231	                .accessibilityIdentifier("setRow.previous")
   232	
   233	            HStack(spacing: 4) {
   234	                TextField("–", text: $weightText)
   235	                    .keyboardType(.decimalPad)
   236	                    .focused($focusedField, equals: .weight)
   237	                    .multilineTextAlignment(.center)
   238	                    .frame(width: 48)
   239	                    .padding(.vertical, 5)
   240	                    .background(Color(.tertiarySystemFill))
   241	                    .clipShape(RoundedRectangle(cornerRadius: 6))
   242	                    .accessibilityIdentifier("setRow.weight")
   243	
   244	                Button {
   245	                    toggleUnit()
   246	                } label: {
   247	                    UnitBadge(unit: set.isDeleted ? .kg : set.weightUnit)
   248	                }
   249	                .buttonStyle(.plain)
   250	                .accessibilityIdentifier("setRow.unit")
   251	            }
   252	            .frame(width: 88)
   253	
   254	            TextField("–", text: $repsText)
   255	                .keyboardType(.numberPad)
   256	                .focused($focusedField, equals: .reps)
   257	                .multilineTextAlignment(.center)
   258	                .frame(width: 48)
   259	                .padding(.vertical, 5)
   260	                .background(Color(.tertiarySystemFill))
   261	                .clipShape(RoundedRectangle(cornerRadius: 6))
   262	                .accessibilityIdentifier("setRow.reps")
   263	
   264	            completeButton
   265	                .frame(width: 30)
   266	        }
   267	        .font(.subheadline)
   268	        .opacity(isCompleted ? 0.75 : 1)
   269	        .contextMenu {
   270	            Button("Delete Set", systemImage: "trash", role: .destructive) {
   271	                onDelete()
   272	            }
   273	        }
   274	        .onChange(of: focusedField) { previous, _ in
   275	            // Field commit on end-editing (SPEC durability boundary).
   276	            switch previous {
   277	            case .weight: commitWeight()
   278	            case .reps: commitReps()
   279	            case nil: break
   280	            }
   281	        }
   282	        .onChange(of: weightText) { _, _ in
   283	            if focusedField == .weight { isDirty = true }
   284	        }
   285	        .onChange(of: repsText) { _, _ in
   286	            if focusedField == .reps { isDirty = true }
   287	        }
   288	        .task(id: prefillTaskID) {
   289	            loadPreviousAndPrefill()
   290	        }
   291	        // B3: decimalPad/numberPad have no return key, so the keyboard used
   292	        // to cover the lower rows with no way out. Only the focused row
   293	        // contributes a bar, or every row would stack one.
   294	        .toolbar {
   295	            if focusedField != nil {
   296	                ToolbarItemGroup(placement: .keyboard) {
   297	                    Spacer()
   298	                    // Clearing focus runs the same end-editing commit as
   299	                    // tapping away (ticket 07's durability boundary).
   300	                    Button("Done") { focusedField = nil }
   301	                        .accessibilityIdentifier("keyboardDone")
   302	                }
   303	            }
   304	        }
   305	    }
   306	
   307	    /// E5: the marker is a menu of named set types — the old control cycled
   308	    /// blindly through them and announced itself as "1". The compact W/#/F
   309	    /// visual is unchanged.
   310	    private var setTypeButton: some View {
   311	        Menu {
   312	            ForEach(SetType.allCases, id: \.self) { type in
   313	                Button {
   314	                    apply(type)
   315	                } label: {
   316	                    if !set.isDeleted, set.type == type {
   317	                        Label(Self.setTypeName(type), systemImage: "checkmark")
   318	                    } else {
   319	                        Text(Self.setTypeName(type))
   320	                    }
   321	                }
   322	            }
   323	        } label: {
   324	            Text(set.isDeleted ? "" : (set.type.marker ?? "\(index)"))
   325	                .font(.subheadline.weight(.semibold))
   326	                .foregroundStyle(markerColor)
   327	                .frame(width: 34, height: 28)
   328	                .background(Color(.tertiarySystemFill))
   329	                .clipShape(RoundedRectangle(cornerRadius: 6))
   330	        }
   331	        .accessibilityIdentifier("setRow.setType")
   332	        .accessibilityLabel(
   333	            "Set type: \(set.isDeleted ? "" : Self.setTypeName(set.type).lowercased())")
   334	    }
   335	
   336	    private static func setTypeName(_ type: SetType) -> String {
   337	        switch type {
   338	        case .warmup: "Warmup"
   339	        case .working: "Working"
   340	        case .failure: "Failure"
   341	        }
   342	    }
   343	
   344	    private var markerColor: Color {
   345	        guard !set.isDeleted else { return .primary }
   346	        switch set.type {
   347	        case .warmup: return .orange
   348	        case .working: return .primary
   349	        case .failure: return .red
   350	        }
   351	    }
   352	
   353	    /// A1: the checkmark is live only once the row says something true —
   354	    /// judged on what is *on screen*, since the fields commit on end-editing
   355	    /// and the tap itself is the commit. An already-completed row stays
   356	    /// tappable so it can always be un-completed.
   357	    private var canComplete: Bool {
   358	        isCompleted || WorkoutSession.isLoggable(
   359	            reps: Int(repsText.trimmingCharacters(in: .whitespaces)),
   360	            weightValue: Self.parseWeight(weightText),
   361	            loadType: loadType)
   362	    }
   363	
   364	    private static func parseWeight(_ text: String) -> Double? {
   365	        Double(text.trimmingCharacters(in: .whitespaces)
   366	            .replacingOccurrences(of: ",", with: "."))
   367	    }
   368	
   369	    private var completeButton: some View {
   370	        Button {
   371	            toggleCompletion()
   372	        } label: {
   373	            Image(systemName: isCompleted ? "checkmark.circle.fill" : "circle")
   374	                .font(.title3)
   375	                .foregroundStyle(completeTint)
   376	        }
   377	        .buttonStyle(.plain)
   378	        .disabled(!canComplete)
   379	        .accessibilityIdentifier("setRow.complete")
   380	        .accessibilityLabel("Complete set")
   381	        .accessibilityValue(isCompleted ? "Completed" : "Not completed")
   382	        .accessibilityHint(canComplete ? "" : incompleteHint)
   383	    }
   384	
   385	    private var completeTint: Color {
   386	        if isCompleted { return .green }
   387	        return canComplete ? .secondary : Color(.quaternaryLabel)
   388	    }
   389	
   390	    private var incompleteHint: String {
   391	        loadType == .bodyweight
   392	            ? "Enter reps to log this set"
   393	            : "Enter \(loadType == .assisted ? "assistance" : "weight") and reps to log this set"
   394	    }
   395	
   396	    // MARK: Commits
   397	
   398	    private func commitWeight() {
   399	        guard !set.isDeleted else { return }
   400	        do {
   401	            try session.commitWeight(weightText, for: set)
   402	        } catch {
   403	            assertionFailure("Failed to commit weight: \(error)")
   404	        }
   405	    }
   406	
   407	    private func commitReps() {
   408	        guard !set.isDeleted else { return }
   409	        do {
   410	            try session.commitReps(repsText, for: set)
   411	        } catch {
   412	            assertionFailure("Failed to commit reps: \(error)")
   413	        }
   414	    }
   415	
   416	    private func toggleUnit() {
   417	        guard !set.isDeleted else { return }
   418	        isDirty = true
   419	        do {
   420	            // Commit any in-progress weight text first so the toggle applies
   421	            // to what is on screen.
   422	            try session.commitWeight(weightText, for: set)
   423	            try session.toggleUnit(of: set)
   424	        } catch {
   425	            assertionFailure("Failed to toggle unit: \(error)")
   426	        }
   427	    }
   428	
   429	    private func apply(_ type: SetType) {
   430	        guard !set.isDeleted else { return }
   431	        do {
   432	            try session.setType(type, of: set)
   433	        } catch {
   434	            assertionFailure("Failed to set the set type: \(error)")
   435	        }
   436	    }
   437	
   438	    private func toggleCompletion() {
   439	        guard !set.isDeleted, canComplete else { return }
   440	        do {
   441	            // Completion is a commit boundary: on-screen values first.
   442	            try session.commitWeight(weightText, for: set)
   443	            try session.commitReps(repsText, for: set)
   444	            try session.toggleCompletion(of: set)
   445	        } catch WorkoutSessionError.setNotLoggable {
   446	            // A1: the button is disabled until the row is loggable, so this
   447	            // is unreachable — and silently ignoring it beats logging a set
   448	            // that says nothing.
   449	        } catch {
   450	            assertionFailure("Failed to toggle completion: \(error)")
   451	        }
   452	        let completed = set.completedAt != nil
   453	        if completed {
   454	            focusedField = nil
   455	        }
   456	        onCompletionChanged(completed)
   457	    }
   458	
   459	    /// Snapshot-keyed ticket-11 query. The label always shows the selected
   460	    /// historical row; values are applied only while this draft remains
   461	    /// untouched, so a delayed refresh can never clobber typing.
   462	    private func loadPreviousAndPrefill() {
   463	        guard !set.isDeleted else { return }
   464	        do {
   465	            let history = PerformanceHistory(context: modelContext)
   466	            guard let candidate = try history.prefill(for: set) else {
   467	                previousLabel = "—"
   468	                return
   469	            }
   470	            previousLabel = candidate.displayLabel
   471	            guard try history.applyPrefill(candidate, to: set, isDirty: isDirty) else {
   472	                return
   473	            }
   474	            weightText = candidate.weightValue.map(Format.weight) ?? ""
   475	            repsText = String(candidate.reps)
   476	        } catch {
   477	            assertionFailure("Failed to load previous performance: \(error)")
   478	        }
   479	    }
   480	
   481	    /// Changing equipment, set type, or type-relative order selects a new
   482	    /// candidate. A dirty row still refreshes its PREVIOUS reference label
   483	    /// but `loadPreviousAndPrefill` refuses to overwrite its inputs.
   484	    private var prefillTaskID: String {
   485	        let entry = set.entry
   486	        return [
   487	            set.id.uuidString,
   488	            String(set.order),
   489	            set.type.rawValue,
   490	            entry?.machine?.id.uuidString ?? "no-machine",
   491	            entry?.freeWeightTag?.rawValue ?? "no-tag",
   492	        ].joined(separator: "|")
   493	    }
   494	}

