    69	struct GymDetailView: View {
    70	    @Environment(\.modelContext) private var modelContext
    71	    @Environment(\.dismiss) private var dismiss
    72	    var gym: Gym
    73	    @State private var showingAddMachine = false
    74	    @State private var editingGym = false
    75	    @State private var editingMachine: MachineInstance?
    76	    @State private var correctingMachine: MachineInstance?
    77	    @State private var renamingModel: EquipmentModel?
    78	    @State private var modelManufacturer = ""
    79	    @State private var modelName = ""
    80	
    81	    var body: some View {
    82	        List {
    83	            // D2 (ticket 17): these used to be a dead end — read-only rows
    84	            // with only Rename/Archive in the menu, so a wrong unit meant
    85	            // archive-and-recreate. Editing is now one tap from where the
    86	            // wrong value is displayed.
    87	            Section {
    88	                HStack {
    89	                    Text("Default unit")
    90	                    Spacer()
    91	                    if let unit = gym.defaultUnit {
    92	                        UnitBadge(unit: unit)
    93	                    } else {
    94	                        Text("App preference")
    95	                            .foregroundStyle(.secondary)
    96	                    }
    97	                }
    98	                HStack {
    99	                    Text("City")
   100	                    Spacer()
   101	                    Text(gym.city ?? "—").foregroundStyle(.secondary)
   102	                }
   103	                Button("Edit Gym…", systemImage: "pencil") {
   104	                    editingGym = true
   105	                }
   106	                .accessibilityIdentifier("editGym")
   107	            }
   108	
   109	            Section {
   110	                ForEach(gym.activeMachines) { machine in
   111	                    HStack {
   112	                        VStack(alignment: .leading, spacing: 2) {
   113	                            Text(machine.label)
   114	                                .font(.body.weight(.medium))
   115	                            Text(machine.model?.displayName ?? "No model")
   116	                                .font(.caption)
   117	                                .foregroundStyle(.secondary)
   118	                        }
   119	                        Spacer()
   120	                        if let unit = machine.defaultUnit {
   121	                            UnitBadge(unit: unit)
   122	                        }
   123	                    }
   124	                    .padding(.vertical, 2)
   125	                    .contextMenu {
   126	                        // D2: label *and* default unit, not rename alone.
   127	                        Button("Edit Machine…") {
   128	                            editingMachine = machine
   129	                        }
   130	                        Button("Correct Model…") {
   131	                            correctingMachine = machine
   132	                        }
   133	                        if let model = machine.model, !model.isSeeded {
   134	                            Button("Rename Model…") {
   135	                                modelManufacturer = model.manufacturer
   136	                                modelName = model.modelName
   137	                                renamingModel = model
   138	                            }
   139	                        }
   140	                        Button("Archive Machine", role: .destructive) {
   141	                            archive(machine)
   142	                        }
   143	                    }
   144	                }
   145	                if gym.activeMachines.isEmpty {
   146	                    Text("No machines yet")
   147	                        .foregroundStyle(.secondary)
   148	                }
   149	                Button("Add Machine…", systemImage: "plus") {
   150	                    showingAddMachine = true
   151	                }
   152	                .accessibilityIdentifier("addMachine")
   153	            } header: {
   154	                Text("Machines")
   155	            } footer: {
   156	                // Model-less machines are allowed: when logging machine-first
   157	                // they open the full exercise picker instead of auto-filling.
   158	                Text("The model is optional — a machine without one asks for the exercise when you log with it.")
   159	            }
   160	        }
   161	        .navigationTitle(gym.name)
   162	        .navigationBarTitleDisplayMode(.inline)
   163	        .toolbar {
   164	            ToolbarItem(placement: .topBarTrailing) {
   165	                Menu {
   166	                    Button("Edit Gym…") { editingGym = true }
   167	                    Button("Archive Gym", role: .destructive) {
   168	                        archiveGym()
   169	                    }
   170	                } label: {
   171	                    Image(systemName: "ellipsis.circle")
   172	                }
   173	            }
   174	        }
   175	        .sheet(isPresented: $showingAddMachine) {
   176	            MachineEditorSheet(gym: gym)
   177	        }
   178	        .sheet(isPresented: $editingGym) {
   179	            GymEditorSheet(gym: gym)
   180	        }
   181	        .sheet(item: $editingMachine) { machine in
   182	            MachineEditorSheet(gym: gym, machine: machine)
   183	        }
   184	        .sheet(item: $correctingMachine) { machine in
   185	            MachineModelCorrectionSheet(machine: machine)
   186	        }
   187	        .alert(
   188	            "Rename Model",
   189	            isPresented: Binding(
   190	                get: { renamingModel != nil },
   191	                set: { if !$0 { renamingModel = nil } }
   192	            ),
   193	            presenting: renamingModel
   194	        ) { model in
   195	            TextField("Manufacturer", text: $modelManufacturer)
   196	            TextField("Model", text: $modelName)
   197	            Button("Save") { rename(model) }
   198	            Button("Cancel", role: .cancel) {}
   199	        } message: { _ in
   200	            Text("Only custom models can be renamed. Existing history keeps its captured model name.")
   201	        }
   202	    }
   203	
   204	    private var lifecycle: EquipmentLifecycle {
   205	        EquipmentLifecycle(context: modelContext)
   206	    }
   207	
   208	    private func rename(_ model: EquipmentModel) {
   209	        do {
   210	            try lifecycle.rename(
   211	                model, manufacturer: modelManufacturer, modelName: modelName)
   212	        } catch {
   213	            assertionFailure("Failed to rename model: \(error)")
   214	        }
   215	    }
   216	
   217	    private func archive(_ machine: MachineInstance) {
   218	        do { try lifecycle.archive(machine) }
   219	        catch { assertionFailure("Failed to archive machine: \(error)") }
   220	    }
   221	
   222	    private func archiveGym() {
   223	        do {
   224	            try lifecycle.archive(gym)
   225	            dismiss()
   226	        } catch {
   227	            assertionFailure("Failed to archive gym: \(error)")
   228	        }
   229	    }
   230	}
