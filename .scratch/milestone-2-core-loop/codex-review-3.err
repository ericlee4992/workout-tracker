   308	    /// After one completed set the equipment is frozen: switching machines
   309	    /// creates a NEW entry ordered right after; uncompleted draft rows move
   310	    /// over (values intact), completed sets and the old snapshot stay.
   311	    @Test func switchAfterCompletionSplitsEntryAndMovesDrafts() throws {
   312	        let url = makeStoreURL()
   313	        defer { removeStore(at: url) }
   314	
   315	        var workoutID = UUID()
   316	        var oldEntryID = UUID()
   317	        var newEntryID = UUID()
   318	        var fixture: Fixture!
   319	
   320	        try {
   321	            let container = try WorkoutTrackerStore.makeContainer(url: url)
   322	            let context = ModelContext(container)
   323	            fixture = try seedFixture(in: context)
   324	            let session = WorkoutSession(context: context)
   325	            let gym = try #require(try context.fetch(FetchDescriptor<Gym>()).first)
   326	            let exercise = try #require(try context.fetch(
   327	                FetchDescriptor<Exercise>(
   328	                    predicate: #Predicate { $0.isSeeded == false })).first)
   329	            let machine1ID = fixture.machine1ID
   330	            let machine2ID = fixture.machine2ID
   650	        let container = try WorkoutTrackerStore.makeContainer(url: url)
   651	        let context = ModelContext(container)
   652	        let workout = try fetchWorkout(workoutID, in: context)
   653	        #expect(workout.finishedAt == finishedAt)
   654	        let entries = WorkoutSession.orderedEntries(of: workout)
   655	        try #require(entries.count == 1)
   656	        #expect(entries[0].id == keptEntryID)
   657	        let sets = WorkoutSession.orderedSets(of: entries[0])
   658	        try #require(sets.count == 1)
   659	        #expect(sets[0].completedAt != nil)
   660	        // Nothing uncompleted reached history.
   661	        #expect(try context.fetch(FetchDescriptor<SetRecord>(
   662	            predicate: #Predicate { $0.completedAt == nil })).isEmpty)
   663	    }
   664	
   665	    /// A2 (ticket 17): Start → Finish with nothing logged must leave no
   666	    /// trace. Finishing an empty workout deletes it and reports
   667	    /// `.discardedEmpty` — an empty row in History is permanent litter, and
   668	    /// telling the user it was "saved" would be a lie.
   669	    @Test func finishingAnEmptyWorkoutDeletesItInsteadOfFinishing() throws {
   670	        let url = makeStoreURL()
   671	        defer { removeStore(at: url) }
   672	
   673	        try {
   674	            let container = try WorkoutTrackerStore.makeContainer(url: url)
   675	            let context = ModelContext(container)
   676	            _ = try seedFixture(in: context)
   677	            let session = WorkoutSession(context: context)
   678	            let gym = try #require(try context.fetch(FetchDescriptor<Gym>()).first)
   679	            let exercise = try #require(try context.fetch(
   680	                FetchDescriptor<Exercise>(
   681	                    predicate: #Predicate { $0.isSeeded == false })).first)
   682	
   683	            // Never touched at all.
   684	            let bare = try session.startWorkout(at: gym)
   685	            #expect(try session.finish(bare) == .discardedEmpty)
   686	
   687	            // Exercises added, sets typed into, but nothing ever completed —
   688	            // still nothing to keep.
   689	            let started = try session.startWorkout(at: gym)
   690	            let entry = try session.addEntry(for: exercise, to: started)
   691	            let set = try #require(WorkoutSession.orderedSets(of: entry).first)
   692	            try session.commitWeight("60", for: set)
   693	            try session.commitReps("10", for: set)
   694	            #expect(try session.finish(started) == .discardedEmpty)
   695	        }()
   696	
   697	        // Nothing at all survived the reopen — not the workouts, not their
   698	        // entries, not their draft sets.
   699	        let container = try WorkoutTrackerStore.makeContainer(url: url)
   700	        let context = ModelContext(container)
   701	        #expect(try context.fetchCount(FetchDescriptor<Workout>()) == 0)
   702	        #expect(try context.fetchCount(FetchDescriptor<ExerciseEntry>()) == 0)
   703	        #expect(try context.fetchCount(FetchDescriptor<SetRecord>()) == 0)
   704	        // The gym graph is untouched — discarding a workout is not a purge.
   705	        #expect(try context.fetchCount(FetchDescriptor<Gym>()) == 1)
   706	        #expect(try context.fetchCount(FetchDescriptor<MachineInstance>()) == 2)
   707	    }
   708	
   709	    /// A2's other half: one completed set is enough to be history. The
   710	    /// outcome says `.saved` and the workout survives a reopen.
   711	    @Test func finishingAWorkoutWithOneCompletedSetKeepsIt() throws {
   712	        let url = makeStoreURL()
   713	        defer { removeStore(at: url) }
   714	
   715	        var workoutID = UUID()
   716	        try {
   717	            let container = try WorkoutTrackerStore.makeContainer(url: url)
   718	            let context = ModelContext(container)
   719	            _ = try seedFixture(in: context)
   720	            let session = WorkoutSession(context: context)
   721	            let gym = try #require(try context.fetch(FetchDescriptor<Gym>()).first)
   722	            let exercise = try #require(try context.fetch(
   723	                FetchDescriptor<Exercise>(
   724	                    predicate: #Predicate { $0.isSeeded == false })).first)
   725	
   726	            let workout = try session.startWorkout(at: gym)
   727	            workoutID = workout.id
   728	            let entry = try session.addEntry(for: exercise, to: workout)
   729	            let set = try #require(WorkoutSession.orderedSets(of: entry).first)
   730	            try session.commitWeight("60", for: set)
   731	            try session.commitReps("10", for: set)
   732	            try session.toggleCompletion(of: set)
   733	            // A second, wholly empty entry must not rescue anything — nor
   734	            // sink the workout that does have a completed set.
   735	            _ = try session.addEntry(for: exercise, to: workout)
   736	            #expect(try session.finish(workout) == .saved)
   737	        }()
   738	
   739	        let container = try WorkoutTrackerStore.makeContainer(url: url)
   740	        let context = ModelContext(container)
   741	        let workout = try fetchWorkout(workoutID, in: context)
   742	        #expect(workout.finishedAt != nil)
   743	        #expect(WorkoutSession.orderedEntries(of: workout).count == 1)
   744	        #expect(workout.completedSets.count == 1)
   745	    }
