   153	    /// The guard only ever blocks the completing direction: an already
   154	    /// completed row — including one stored before the rule existed — can
   155	    /// always be un-completed.
   156	    @Test func alreadyCompletedSetsAreNeverInvalidatedByTheGuard() throws {
   157	        let rig = try makeRig()
   158	        let (_, entry, set) = try firstDraft(rig)
   159	        try rig.session.commitWeight("60", for: set)
   160	        try rig.session.commitReps("10", for: set)
   161	        try rig.session.toggleCompletion(of: set)
   162	        try rig.session.toggleCompletion(of: set) // undo, values intact
   163	        #expect(set.completedAt == nil)
   164	        #expect(set.weightValue == 60)
   165	        try rig.session.toggleCompletion(of: set) // and back again
   166	        #expect(set.completedAt != nil)
   167	
   168	        // Legacy row: completed with nothing logged. Un-completing it must
   169	        // not throw.
   170	        let legacy = SetRecord(
   171	            order: 9, completedAt: Date(timeIntervalSince1970: 1), entry: entry)
   172	        rig.context.insert(legacy)
   173	        try rig.context.save()
   174	        try rig.session.toggleCompletion(of: legacy)
   175	        #expect(legacy.completedAt == nil)
   176	    }
   177	
   178	    // MARK: - B1: within-session carry-forward
   179	
   180	    /// A new row inherits weight value, unit and reps from the last completed
   181	    /// set of the same entry — populated but uncompleted, so one tap logs it.
   182	    @Test func addSetCarriesForwardTheLastCompletedSet() throws {
   183	        let rig = try makeRig()
   184	        let (_, entry, first) = try firstDraft(rig)
   185	        try rig.session.commitWeight("60", for: first)
   186	        try rig.session.commitReps("10", for: first)
   187	        try rig.session.toggleUnit(of: first) // kg → lb, as entered
   188	        try rig.session.toggleCompletion(of: first)
   189	
   190	        let second = try rig.session.addSet(to: entry)
   191	        #expect(second.weightValue == 60)
   192	        #expect(second.weightUnit == .lb)
   193	        #expect(second.reps == 10)
   194	        #expect(second.normalizedKg == first.normalizedKg)
   195	        // Arrives as a draft: carry-forward proposes, it never logs.
   196	        #expect(second.completedAt == nil)
   197	
   198	        // One tap, no typing.
   199	        try rig.session.toggleCompletion(of: second)
   200	        #expect(second.completedAt != nil)
   201	
   202	        // A third row keeps following the newest completed set.
   203	        try rig.session.commitWeight("65", for: second)
   204	        let third = try rig.session.addSet(to: entry)
   205	        #expect(third.weightValue == 65)
   206	        #expect(third.reps == 10)
   207	    }
