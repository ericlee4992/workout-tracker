     4	// persisted models: no UI imports, unit-tested.
     5	
     6	/// Unit badge for a workout summary, derived from the units of the actual
     7	/// logged sets — never just the gym default (SPEC "Units").
     8	enum WorkoutUnitBadge: Equatable {
     9	    case single(WeightUnit)
    10	    case mixed
    11	
    12	    var label: String {
    13	        switch self {
    14	        case .single(let unit): unit.rawValue
    15	        case .mixed: "Mixed"
    16	        }
    17	    }
    18	
    19	    /// Badge over a list of set units: all one unit → that unit, otherwise
    20	    /// Mixed. nil when there are no units to derive from.
    21	    static func derive(fromUnits units: [WeightUnit]) -> WorkoutUnitBadge? {
    22	        guard let first = units.first else { return nil }
    23	        return units.allSatisfy { $0 == first } ? .single(first) : .mixed
    24	    }
    25	
    26	    /// Badge for a set list. Only completed sets count — drafts never reach
    27	    /// history (Finish deletes them), and they carry no logged weight.
    28	    static func derive(fromCompleted sets: [SetRecord]) -> WorkoutUnitBadge? {
    29	        derive(fromUnits: sets.filter { $0.completedAt != nil }.map(\.weightUnit))
    30	    }
    31	}
    32	
    33	extension ExerciseEntry {
    34	    /// History equipment label rendered from snapshot display strings ONLY
    35	    /// (D23) — never the live MachineInstance/EquipmentModel relationships,
    36	    /// so later renames, model corrections, or archival never rewrite what a
    37	    /// finished workout shows.
    38	    var snapshotEquipmentLabel: String {
    39	        if let machineLabel = snapshotMachineLabel {
    40	            return "\(machineLabel) · \(snapshotModelName ?? "unknown model")"
    41	        }
    42	        return snapshotFreeWeightTag?.label ?? "No equipment"
    43	    }
    44	}
    45	
    46	/// Ticket 17 E1–E3 — the words a history row is made of, kept here so they
    47	/// can be tested without a view. Rows used to be headlined by the gym (every
    48	/// workout at one gym indistinguishable), count "1 exercises", and flatten
    49	/// every sub-minute workout to "0 min".
    50	enum HistoryRendering {
    51	
    52	    /// Headline for a workout with nothing to name it after.
    53	    static let untitledWorkout = "Workout"
    54	
    55	    /// E1: what a workout is called in History. The template it started from
    56	    /// names it; otherwise the exercises performed do ("Chest Press +2"); a
    57	    /// workout with neither gets the neutral fallback. The gym is the
    58	    /// subtitle, never the title — it is what workouts have in common, not
    59	    /// what tells them apart.
    60	    ///
    61	    /// `exerciseNames` must come from entry SNAPSHOTS (D23), so a later
    62	    /// rename or model correction cannot retitle a finished workout.
    63	    static func title(templateName: String?, exerciseNames: [String]) -> String {
    64	        if let templateName {
    65	            let trimmed = templateName.trimmingCharacters(in: .whitespacesAndNewlines)
    66	            if !trimmed.isEmpty { return trimmed }
    67	        }
    68	        var seen = Set<String>()
    69	        let names = exerciseNames
    70	            .map { $0.trimmingCharacters(in: .whitespacesAndNewlines) }
    71	            .filter { !$0.isEmpty && seen.insert($0).inserted }
    72	        guard let first = names.first else { return untitledWorkout }
    73	        return names.count == 1 ? first : "\(first) +\(names.count - 1)"
    74	    }
    75	
    76	    /// E2: a count that agrees with its noun — never "1 exercises".
    77	    static func pluralized(_ count: Int, _ singular: String, _ plural: String) -> String {
    78	        "\(count) \(count == 1 ? singular : plural)"
    79	    }
    80	
    81	    /// E3: sub-minute workouts are not all "0 min" — a 14-second mistake and
    82	    /// a 45-second finisher have to be tellable apart. Minutes above a minute.
    83	    static func durationLabel(_ duration: TimeInterval) -> String {
    84	        let seconds = max(0, Int(duration))
    85	        return seconds < 60 ? "\(seconds)s" : "\(seconds / 60) min"
    86	    }
    87	
    88	    /// The stats line of a history row: exercises · sets · duration.
    89	    static func statsLine(
    90	        exerciseCount: Int,
    91	        setCount: Int,
    92	        duration: TimeInterval?
    93	    ) -> String {
    94	        var parts = [
    95	            pluralized(exerciseCount, "exercise", "exercises"),
    96	            pluralized(setCount, "set", "sets"),
    97	        ]
    98	        if let duration { parts.append(durationLabel(duration)) }
    99	        return parts.joined(separator: " · ")
   100	    }
   101	}
   102	
   103	extension Workout {
   104	    /// Elapsed time from start to finish; nil while the workout is active.
   105	    var duration: TimeInterval? {
   106	        finishedAt.map { max(0, $0.timeIntervalSince(startedAt)) }
   107	    }
   108	
   109	    /// Rendered duration (E3); nil while the workout is active.
   110	    var durationLabel: String? {
   111	        duration.map(HistoryRendering.durationLabel)
   112	    }
   113	
   114	    /// Completed sets across all entries (entry order, then set order).
   115	    var completedSets: [SetRecord] {
   116	        WorkoutSession.orderedEntries(of: self)
   117	            .flatMap { WorkoutSession.orderedSets(of: $0) }
   118	            .filter { $0.completedAt != nil }
   119	    }
   120	
   121	    /// Snapshot exercise names in entry order (D23) — the live `exercise`
   122	    /// relationship is deliberately not consulted.
   123	    var snapshotExerciseNames: [String] {
   124	        WorkoutSession.orderedEntries(of: self).map(\.snapshotExerciseName)
   125	    }
   126	
   127	    /// E1: the row headline. `templateName` is the name of the template
   128	    /// `sourceTemplateID` points at, or nil when there is none (or it has
   129	    /// since been deleted).
   130	    func historyTitle(templateName: String?) -> String {
   131	        HistoryRendering.title(
   132	            templateName: templateName, exerciseNames: snapshotExerciseNames)
   133	    }
   134	
   135	    /// Gym label for history: the name captured at log time (D23) when the
   136	    /// workout logged anything, falling back to the live gym for a workout
   137	    /// whose entries carry no snapshot.
   138	    var historyGymName: String? {
   139	        WorkoutSession.orderedEntries(of: self)
   140	            .compactMap(\.snapshotGymName).first ?? gym?.name
   141	    }
   142	}
     1	import SwiftData
     2	import SwiftUI
     3	
     4	struct HistoryView: View {
     5	    /// Only finished workouts are history; the active one (finishedAt nil)
     6	    /// never appears here.
     7	    @Query(
     8	        filter: #Predicate<Workout> { $0.finishedAt != nil },
     9	        sort: \Workout.startedAt, order: .reverse)
    10	    private var workouts: [Workout]
    11	    /// E1: a workout started from a template is titled by that template's
    12	    /// current name; a deleted template simply falls through to the
    13	    /// exercise-derived title.
    14	    @Query private var templates: [WorkoutTemplate]
    15	    @State private var path: [Workout] = []
    16	
    17	    private var templateNames: [UUID: String] {
    18	        Dictionary(templates.map { ($0.id, $0.name) }) { first, _ in first }
    19	    }
    20	
    21	    private var byMonth: [(month: String, workouts: [Workout])] {
    22	        let formatter = DateFormatter()
    23	        formatter.dateFormat = "MMMM yyyy"
    24	        var order: [String] = []
    25	        var groups: [String: [Workout]] = [:]
    26	        for workout in workouts {
    27	            let key = formatter.string(from: workout.startedAt)
    28	            if groups[key] == nil { order.append(key) }
    29	            groups[key, default: []].append(workout)
    30	        }
    31	        return order.map { ($0, groups[$0] ?? []) }
    32	    }
    33	
    34	    var body: some View {
    35	        NavigationStack(path: $path) {
    36	            Group {
    37	                if workouts.isEmpty {
    38	                    ContentUnavailableView(
    39	                        "No workouts yet",
    40	                        systemImage: "clock.arrow.circlepath",
    41	                        description: Text("Finished workouts show up here."))
    42	                } else {
    43	                    List {
    44	                        ForEach(byMonth, id: \.month) { group in
    45	                            Section(group.month) {
    46	                                ForEach(group.workouts) { workout in
    47	                                    NavigationLink(value: workout) {
    48	                                        WorkoutSummaryRow(
    49	                                            workout: workout,
    50	                                            templateName: workout.sourceTemplateID
    51	                                                .flatMap { templateNames[$0] })
    52	                                    }
    53	                                }
    54	                            }
    55	                        }
    56	                    }
    57	                }
    58	            }
    59	            .navigationTitle("History")
    60	            .navigationDestination(for: Workout.self) { workout in
    61	                WorkoutDetailView(workout: workout)
    62	            }
    63	        }
    64	    }
    65	}
    66	
    67	/// E1–E4 (ticket 17): titled by what was actually done, with the gym demoted
    68	/// to a subtitle and the unit badge sitting inline with the stats it
    69	/// qualifies — so every row has the same left edge whether or not it has one.
    70	private struct WorkoutSummaryRow: View {
    71	    var workout: Workout
    72	    var templateName: String?
    73	
    74	    var body: some View {
    75	        let completedSets = workout.completedSets
    76	        VStack(alignment: .leading, spacing: 3) {
    77	            HStack(alignment: .firstTextBaseline) {
    78	                Text(workout.historyTitle(templateName: templateName))
    79	                    .font(.headline)
    80	                    .lineLimit(1)
    81	                Spacer(minLength: 8)
    82	                Text(workout.startedAt, format: .dateTime.weekday(.abbreviated).day().month(.abbreviated))
    83	                    .font(.subheadline)
    84	                    .foregroundStyle(.secondary)
    85	            }
    86	            Label(workout.historyGymName ?? "No gym", systemImage: "mappin.and.ellipse")
    87	                .font(.caption)
    88	                .foregroundStyle(.secondary)
    89	            HStack(spacing: 6) {
    90	                Text(HistoryRendering.statsLine(
    91	                    exerciseCount: workout.entries?.count ?? 0,
    92	                    setCount: completedSets.count,
    93	                    duration: workout.duration))
    94	                    .font(.caption)
    95	                    .foregroundStyle(.tertiary)
    96	                // Derived from the actual logged sets — never just the gym
    97	                // default (SPEC "Units").
    98	                if let badge = WorkoutUnitBadge.derive(fromCompleted: completedSets) {
    99	                    WorkoutUnitBadgeView(badge: badge)
   100	                }
   101	                Spacer(minLength: 0)
   102	            }
   103	        }
   104	        .padding(.vertical, 2)
   105	    }
   106	}
   107	
   108	/// kg/lb reuse the standard unit badge; Mixed gets its own tint.
   109	struct WorkoutUnitBadgeView: View {
   110	    var badge: WorkoutUnitBadge
   111	
   112	    var body: some View {
   113	        switch badge {
   114	        case .single(let unit):
   115	            UnitBadge(unit: unit)
   116	        case .mixed:
   117	            Text(badge.label)
   118	                .font(.caption.weight(.semibold))
   119	                .padding(.horizontal, 8)
   120	                .padding(.vertical, 3)
   121	                .background(Color.purple.opacity(0.15))
   122	                .foregroundStyle(Color.purple)
   123	                .clipShape(Capsule())
   124	        }
   125	    }
   126	}
   127	
   128	#Preview {
   129	    let container = try! ModelContainer(
   130	        for: WorkoutTrackerStore.schema,
   131	        configurations: [ModelConfiguration(isStoredInMemoryOnly: true)])
   132	    return HistoryView()
   133	        .modelContainer(container)
   134	}
     1	import SwiftData
     2	import SwiftUI
     3	
     4	struct WorkoutDetailView: View {
     5	    var workout: Workout
     6	    /// Whole-view convert toggle (D9): nil shows every weight as entered;
     7	    /// a unit renders everything in that unit with conversions ≈-marked.
     8	    /// Display-only — storage is never touched.
     9	    @State private var displayUnit: WeightUnit?
    10	
    11	    var body: some View {
    12	        List {
    13	            Section {
    14	                HStack {
    15	                    Label(workout.historyGymName ?? "No gym", systemImage: "mappin.and.ellipse")
    16	                    Spacer()
    17	                    // E3 (ticket 17): seconds below a minute, here too.
    18	                    Text(workout.durationLabel ?? "—")
    19	                        .foregroundStyle(.secondary)
    20	                }
    21	                .font(.subheadline)
    22	            }
    23	
    24	            ForEach(WorkoutSession.orderedEntries(of: workout)) { entry in
    25	                Section {
    26	                    let sets = WorkoutSession.orderedSets(of: entry)
    27	                        .filter { $0.completedAt != nil }
    28	                    ForEach(Array(sets.enumerated()), id: \.element.id) { pair in
    29	                        setLine(index: pair.offset, set: pair.element)
    30	                    }
    31	                } header: {
    32	                    // Snapshot display strings ONLY (D23) — never the live
    33	                    // exercise/machine/model relationships.
    34	                    VStack(alignment: .leading, spacing: 2) {
    35	                        Text(entry.snapshotExerciseName)
    36	                        Text(entry.snapshotEquipmentLabel)
    37	                            .font(.caption2)
    38	                            .textCase(nil)
    39	                            .foregroundStyle(.secondary)
    40	                    }
    41	                }
    42	            }
    43	
    44	            Section {
    45	            } footer: {
    46	                Text(displayUnit == nil
    47	                    ? "Equipment shown as it was when this workout was logged. Weights display in the unit you entered."
    48	                    : "Converted values are approximate (≈). Your sets stay stored exactly as entered.")
    49	            }
    50	        }
    51	        .navigationTitle(workout.startedAt.formatted(date: .abbreviated, time: .omitted))
    52	        .navigationBarTitleDisplayMode(.inline)
    53	        .toolbar {
    54	            ToolbarItem(placement: .topBarTrailing) {
    55	                Menu {
    56	                    Picker("Units", selection: $displayUnit) {
    57	                        Text("As entered").tag(WeightUnit?.none)
    58	                        ForEach(WeightUnit.allCases) { unit in
    59	                            Text("Show in \(unit.rawValue)").tag(WeightUnit?.some(unit))
    60	                        }
    61	                    }
    62	                } label: {
    63	                    Label(displayUnit?.rawValue ?? "As entered", systemImage: "scalemass")
    64	                }
    65	            }
    66	        }
    67	    }
    68	
    69	    /// Weight text for a set under the current toggle: as entered by default,
    70	    /// ≈-marked when rendered in the other unit (WeightMath, D25).
    71	    private func weightLabel(for set: SetRecord) -> String {
    72	        guard let value = set.weightValue,
    73	              let stored = StoredWeight(value: value, unit: set.weightUnit) else {
    74	            return "—"
    75	        }
    76	        return WeightMath.displayLabel(for: stored, in: displayUnit ?? stored.unit)
    77	    }
    78	
    79	    private func setLine(index: Int, set: SetRecord) -> some View {
    80	        HStack(spacing: 10) {
    81	            Text(set.type.marker ?? "\(index + 1)")
    82	                .font(.subheadline.weight(.semibold))
    83	                .foregroundStyle(set.type == .warmup ? .orange : set.type == .failure ? .red : .primary)
    84	                .frame(width: 24)
    85	            Text("\(weightLabel(for: set)) × \(set.reps.map(String.init) ?? "—")")
    86	                .font(.body)
    87	            Spacer()
    88	        }
    89	    }
    90	}
    91	
    92	#Preview {
    93	    let container = try! ModelContainer(
    94	        for: WorkoutTrackerStore.schema,
    95	        configurations: [ModelConfiguration(isStoredInMemoryOnly: true)])
    96	    let workout = Workout(
    97	        startedAt: .now.addingTimeInterval(-3600), finishedAt: .now,
    98	        gym: Gym(name: "Gold's Gym Gangnam", city: "Seoul", defaultUnit: .kg))
    99	    container.mainContext.insert(workout)
   100	    let entry = ExerciseEntry(
   101	        order: 0, workout: workout,
   102	        snapshotCapturedAt: .now,
   103	        snapshotExerciseID: UUID(),
   104	        snapshotLoadType: .weighted,
   105	        snapshotExerciseName: "Seated Chest Press",
   106	        snapshotMachineLabel: "Chest Press #1",
   107	        snapshotModelName: "Life Fitness Insignia Chest Press")
   108	    container.mainContext.insert(entry)
   109	    container.mainContext.insert(SetRecord(
   110	        order: 0, type: .warmup, reps: 12, weightValue: 40,
   111	        normalizedKg: 40, completedAt: .now, entry: entry))
   112	    container.mainContext.insert(SetRecord(
   113	        order: 1, reps: 10, weightValue: 60,
   114	        normalizedKg: 60, completedAt: .now, entry: entry))
   115	    return NavigationStack {
   116	        WorkoutDetailView(workout: workout)
   117	    }
   118	    .modelContainer(container)
   119	}
diff --git a/WorkoutTracker/Domain/HistoryRendering.swift b/WorkoutTracker/Domain/HistoryRendering.swift
index f562cb8..823ef92 100644
--- a/WorkoutTracker/Domain/HistoryRendering.swift
+++ b/WorkoutTracker/Domain/HistoryRendering.swift
@@ -1,58 +1,142 @@
 import Foundation
 
 // Ticket 09 — history rendering domain logic. Pure derivations over the
 // persisted models: no UI imports, unit-tested.
 
 /// Unit badge for a workout summary, derived from the units of the actual
 /// logged sets — never just the gym default (SPEC "Units").
 enum WorkoutUnitBadge: Equatable {
     case single(WeightUnit)
     case mixed
 
     var label: String {
         switch self {
         case .single(let unit): unit.rawValue
         case .mixed: "Mixed"
         }
     }
 
     /// Badge over a list of set units: all one unit → that unit, otherwise
     /// Mixed. nil when there are no units to derive from.
     static func derive(fromUnits units: [WeightUnit]) -> WorkoutUnitBadge? {
         guard let first = units.first else { return nil }
         return units.allSatisfy { $0 == first } ? .single(first) : .mixed
     }
 
     /// Badge for a set list. Only completed sets count — drafts never reach
     /// history (Finish deletes them), and they carry no logged weight.
     static func derive(fromCompleted sets: [SetRecord]) -> WorkoutUnitBadge? {
         derive(fromUnits: sets.filter { $0.completedAt != nil }.map(\.weightUnit))
     }
 }
 
 extension ExerciseEntry {
     /// History equipment label rendered from snapshot display strings ONLY
     /// (D23) — never the live MachineInstance/EquipmentModel relationships,
     /// so later renames, model corrections, or archival never rewrite what a
     /// finished workout shows.
     var snapshotEquipmentLabel: String {
         if let machineLabel = snapshotMachineLabel {
             return "\(machineLabel) · \(snapshotModelName ?? "unknown model")"
         }
         return snapshotFreeWeightTag?.label ?? "No equipment"
     }
 }
 
+/// Ticket 17 E1–E3 — the words a history row is made of, kept here so they
+/// can be tested without a view. Rows used to be headlined by the gym (every
+/// workout at one gym indistinguishable), count "1 exercises", and flatten
+/// every sub-minute workout to "0 min".
+enum HistoryRendering {
+
+    /// Headline for a workout with nothing to name it after.
+    static let untitledWorkout = "Workout"
+
+    /// E1: what a workout is called in History. The template it started from
+    /// names it; otherwise the exercises performed do ("Chest Press +2"); a
+    /// workout with neither gets the neutral fallback. The gym is the
+    /// subtitle, never the title — it is what workouts have in common, not
+    /// what tells them apart.
+    ///
+    /// `exerciseNames` must come from entry SNAPSHOTS (D23), so a later
+    /// rename or model correction cannot retitle a finished workout.
+    static func title(templateName: String?, exerciseNames: [String]) -> String {
+        if let templateName {
+            let trimmed = templateName.trimmingCharacters(in: .whitespacesAndNewlines)
+            if !trimmed.isEmpty { return trimmed }
+        }
+        var seen = Set<String>()
+        let names = exerciseNames
+            .map { $0.trimmingCharacters(in: .whitespacesAndNewlines) }
+            .filter { !$0.isEmpty && seen.insert($0).inserted }
+        guard let first = names.first else { return untitledWorkout }
+        return names.count == 1 ? first : "\(first) +\(names.count - 1)"
+    }
+
+    /// E2: a count that agrees with its noun — never "1 exercises".
+    static func pluralized(_ count: Int, _ singular: String, _ plural: String) -> String {
+        "\(count) \(count == 1 ? singular : plural)"
+    }
+
+    /// E3: sub-minute workouts are not all "0 min" — a 14-second mistake and
+    /// a 45-second finisher have to be tellable apart. Minutes above a minute.
+    static func durationLabel(_ duration: TimeInterval) -> String {
+        let seconds = max(0, Int(duration))
+        return seconds < 60 ? "\(seconds)s" : "\(seconds / 60) min"
+    }
+
+    /// The stats line of a history row: exercises · sets · duration.
+    static func statsLine(
+        exerciseCount: Int,
+        setCount: Int,
+        duration: TimeInterval?
+    ) -> String {
+        var parts = [
+            pluralized(exerciseCount, "exercise", "exercises"),
+            pluralized(setCount, "set", "sets"),
+        ]
+        if let duration { parts.append(durationLabel(duration)) }
+        return parts.joined(separator: " · ")
+    }
+}
+
 extension Workout {
-    /// Whole minutes from start to finish; nil while the workout is active.
-    var durationMinutes: Int? {
-        finishedAt.map { max(0, Int($0.timeIntervalSince(startedAt)) / 60) }
+    /// Elapsed time from start to finish; nil while the workout is active.
+    var duration: TimeInterval? {
+        finishedAt.map { max(0, $0.timeIntervalSince(startedAt)) }
+    }
+
+    /// Rendered duration (E3); nil while the workout is active.
+    var durationLabel: String? {
+        duration.map(HistoryRendering.durationLabel)
     }
 
     /// Completed sets across all entries (entry order, then set order).
     var completedSets: [SetRecord] {
         WorkoutSession.orderedEntries(of: self)
             .flatMap { WorkoutSession.orderedSets(of: $0) }
             .filter { $0.completedAt != nil }
     }
+
+    /// Snapshot exercise names in entry order (D23) — the live `exercise`
+    /// relationship is deliberately not consulted.
+    var snapshotExerciseNames: [String] {
+        WorkoutSession.orderedEntries(of: self).map(\.snapshotExerciseName)
+    }
+
+    /// E1: the row headline. `templateName` is the name of the template
+    /// `sourceTemplateID` points at, or nil when there is none (or it has
+    /// since been deleted).
+    func historyTitle(templateName: String?) -> String {
+        HistoryRendering.title(
+            templateName: templateName, exerciseNames: snapshotExerciseNames)
+    }
+
+    /// Gym label for history: the name captured at log time (D23) when the
+    /// workout logged anything, falling back to the live gym for a workout
+    /// whose entries carry no snapshot.
+    var historyGymName: String? {
+        WorkoutSession.orderedEntries(of: self)
+            .compactMap(\.snapshotGymName).first ?? gym?.name
+    }
 }
diff --git a/WorkoutTracker/Domain/Models.swift b/WorkoutTracker/Domain/Models.swift
index ed867b8..bd89c87 100644
--- a/WorkoutTracker/Domain/Models.swift
+++ b/WorkoutTracker/Domain/Models.swift
@@ -323,201 +323,229 @@ final class SetRecord {
     var type: SetType = SetType.working
     /// Draft optionality: reps/weightValue/normalizedKg stay nil until completed.
     var reps: Int?
     var weightValue: Double?
     var weightUnit: WeightUnit = WeightUnit.kg
     /// Recomputed atomically from (weightValue, weightUnit) on any edit (D25).
     var normalizedKg: Double?
     /// nil = not completed; only completed sets feed records/volume/prefill.
     var completedAt: Date?
 
     var entry: ExerciseEntry?
 
     init(
         id: UUID = UUID(),
         order: Int,
         type: SetType = .working,
         reps: Int? = nil,
         weightValue: Double? = nil,
         weightUnit: WeightUnit = .kg,
         normalizedKg: Double? = nil,
         completedAt: Date? = nil,
         entry: ExerciseEntry? = nil
     ) {
         self.id = id
         self.order = order
         self.type = type
         self.reps = reps
         self.weightValue = weightValue
         self.weightUnit = weightUnit
         self.normalizedKg = normalizedKg
         self.completedAt = completedAt
         self.entry = entry
     }
 }
 
 // MARK: - Memory & preferences
 
 /// "Last machine used for this exercise at this gym". Scalar ids only —
 /// app-level upsert; duplicates resolved by latest `updatedAt` then `id`
 /// (no unique constraints allowed under CloudKit).
 @Model
 final class GymExerciseMemory {
     var id: UUID = UUID()
     var gymID: UUID = UUID()
     var exerciseID: UUID = UUID()
     /// nil when the exercise was last done without a machine (free weight).
     var machineID: UUID?
     var updatedAt: Date = Date()
 
     init(
         id: UUID = UUID(),
         gymID: UUID,
         exerciseID: UUID,
         machineID: UUID? = nil,
         updatedAt: Date = Date()
     ) {
         self.id = id
         self.gymID = gymID
         self.exerciseID = exerciseID
         self.machineID = machineID
         self.updatedAt = updatedAt
     }
 }
 
 /// App-level preferences, stored as a single row upserted app-side
 /// (duplicates resolved by latest `updatedAt` then `id` — no unique constraints).
 @Model
 final class AppPreferences {
     var id: UUID = UUID()
     /// nil until first launch resolves the default from the locale's measurement system.
     var unitPreference: WeightUnit?
     /// Suppresses the machine/gym drift prompt.
     var driftPromptSuppressed: Bool = false
     /// Global rest defaults (D22): 2:00 working (failure uses working), 1:00 warmup.
     var globalWorkingRestSeconds: Int = 120
     var globalWarmupRestSeconds: Int = 60
     /// Version of the seeded catalog last reconciled (D24).
     var seededCatalogVersion: Int = 0
     /// Whether notification permission has been requested (rest-timer alerts).
     var notificationPermissionRequested: Bool = false
+    /// Gym the Start screen is set to, remembered across launches (D1,
+    /// ticket 17). nil = "No gym", a real choice rather than a missing one.
+    /// Scalar id, never a relationship: an archived or deleted gym must
+    /// degrade to "No gym", not resurrect. Added by ticket 17 (noted in
+    /// ticket 02).
+    var selectedGymID: UUID?
     var updatedAt: Date = Date()
 
     init(
         id: UUID = UUID(),
         unitPreference: WeightUnit? = nil,
         driftPromptSuppressed: Bool = false,
         globalWorkingRestSeconds: Int = 120,
         globalWarmupRestSeconds: Int = 60,
         seededCatalogVersion: Int = 0,
         notificationPermissionRequested: Bool = false,
+        selectedGymID: UUID? = nil,
         updatedAt: Date = Date()
     ) {
         self.id = id
         self.unitPreference = unitPreference
         self.driftPromptSuppressed = driftPromptSuppressed
         self.globalWorkingRestSeconds = globalWorkingRestSeconds
         self.globalWarmupRestSeconds = globalWarmupRestSeconds
         self.seededCatalogVersion = seededCatalogVersion
         self.notificationPermissionRequested = notificationPermissionRequested
+        self.selectedGymID = selectedGymID
         self.updatedAt = updatedAt
     }
 }
 
 extension AppPreferences {
     /// Canonical row among duplicates: latest `updatedAt`, ties broken by
     /// `id` (app-side upsert — no unique constraints under CloudKit).
     static func canonical(of rows: [AppPreferences]) -> AppPreferences? {
         rows.canonical
     }
 
     /// Canonical AppPreferences row for `context`, inserting a fresh row when
     /// none exists yet (first launch).
     static func canonical(in context: ModelContext) throws -> AppPreferences {
         if let canonical = canonical(of: try context.fetch(FetchDescriptor<AppPreferences>())) {
             return canonical
         }
         let fresh = AppPreferences()
         context.insert(fresh)
         return fresh
     }
 
     /// First-launch unit-preference resolution: when unset, derive the default
     /// from the locale measurement system (US → lb, else kg) and persist it.
     /// Idempotent — an already-set preference is never overwritten.
     @discardableResult
     static func ensureUnitPreference(
         in context: ModelContext,
         measurementSystem: Locale.MeasurementSystem = Locale.current.measurementSystem
     ) throws -> AppPreferences {
         let preferences = try canonical(in: context)
         if preferences.unitPreference == nil {
             preferences.unitPreference = UnitPrecedence.firstLaunchDefault(for: measurementSystem)
             preferences.updatedAt = .now
         }
         if context.hasChanges {
             try context.save()
         }
         return preferences
     }
 }
 
 /// Per-exercise rest override (D22 precedence: override → global default).
 /// Scalar exercise id; app-level upsert like GymExerciseMemory.
 @Model
 final class ExerciseRestOverride {
     var id: UUID = UUID()
     var exerciseID: UUID = UUID()
     /// nil = fall through to the global default for that set type.
     var workingRestSeconds: Int?
     var warmupRestSeconds: Int?
     var updatedAt: Date = Date()
 
     init(
         id: UUID = UUID(),
         exerciseID: UUID,
         workingRestSeconds: Int? = nil,
         warmupRestSeconds: Int? = nil,
         updatedAt: Date = Date()
     ) {
         self.id = id
         self.exerciseID = exerciseID
         self.workingRestSeconds = workingRestSeconds
         self.warmupRestSeconds = warmupRestSeconds
         self.updatedAt = updatedAt
     }
 }
 
 // MARK: - Store
 
 enum WorkoutTrackerStore {
     /// Every model in the app schema — keep exhaustive.
     static let modelTypes: [any PersistentModel.Type] = [
         Exercise.self,
         EquipmentModel.self,
         Gym.self,
         MachineInstance.self,
         WorkoutTemplate.self,
         TemplateItem.self,
         Workout.self,
         ExerciseEntry.self,
         SetRecord.self,
         GymExerciseMemory.self,
         AppPreferences.self,
         ExerciseRestOverride.self,
     ]
 
     static var schema: Schema { Schema(modelTypes) }
 
     /// On-disk container. `url` overrides the store location (tests);
     /// nil uses the default application-support location.
     static func makeContainer(url: URL? = nil) throws -> ModelContainer {
         let schema = Self.schema
         let configuration: ModelConfiguration
         if let url {
             configuration = ModelConfiguration(schema: schema, url: url)
         } else {
             configuration = ModelConfiguration(schema: schema, isStoredInMemoryOnly: false)
         }
         return try ModelContainer(for: schema, configurations: [configuration])
     }
+
+    /// Launch argument that makes the app start from an empty store, so
+    /// XCUITest runs are deterministic (`WorkoutTrackerUITests`).
+    static let uiTestResetArgument = "-uiTestReset"
+
+    static var isUITestReset: Bool {
+        ProcessInfo.processInfo.arguments.contains(uiTestResetArgument)
+    }
+
+    /// Throwaway UI-test store: a dedicated on-disk location wiped on every
+    /// launch. On-disk (not in-memory) so the app exercises the real
+    /// SwiftData persistence path the tests are meant to drive.
+    static func makeUITestContainer() throws -> ModelContainer {
+        let directory = URL.cachesDirectory.appending(
+            path: "UITestStore", directoryHint: .isDirectory)
+        try? FileManager.default.removeItem(at: directory)
+        try FileManager.default.createDirectory(
+            at: directory, withIntermediateDirectories: true)
+        return try makeContainer(url: directory.appending(path: "UITestStore.store"))
+    }
 }
