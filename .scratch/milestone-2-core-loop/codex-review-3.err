    30	            .navigationDestination(for: UUID.self) { gymID in
    31	                if let gym = gyms.first(where: { $0.id == gymID }) {
    32	                    GymDetailView(gym: gym)
    33	                }
    34	            }
    35	            .sheet(isPresented: $showingAddGym) {
    36	                GymEditorSheet()
    37	            }
    38	        }
    39	    }
    40	}
