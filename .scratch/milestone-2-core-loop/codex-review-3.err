         VStack(alignment: .leading, spacing: 10) {
             titleRow
             machineRow
 
             if loadType == .assisted {
                 Label("Assisted: lower weight = harder. Records track least assistance.", systemImage: "arrow.down.right.circle")
                     .font(.caption)
                     .foregroundStyle(.secondary)
             }
 
