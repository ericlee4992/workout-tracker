   151	    /// Close out a template-sourced workout: apply the chosen resolution, then
   152	    /// finish the workout. The order matters — `apply` reads the workout's
   153	    /// completed structure and `finish` prunes the workout — so both drift
   154	    /// prompts (finishing, and replacing an active workout) share this one
   155	    /// sequence rather than each spelling it out.
   156	    func resolve(
   157	        _ resolution: TemplateDriftResolution,
   158	        workout: Workout,
   159	        to template: WorkoutTemplate
   160	    ) throws {
   161	        try apply(resolution, workout: workout, to: template)
   162	        try WorkoutSession(context: context).finish(workout)
   163	    }
   164	
   165	    func templateSnapshot(_ template: WorkoutTemplate) -> [TemplateDriftItem] {
   166	        snapshotRows(template).map(\.snapshot)
