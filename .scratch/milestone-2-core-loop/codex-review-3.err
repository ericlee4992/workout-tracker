   320	// MARK: - Machine editor (ticket 06 add-sheet, ticket 17 edit-sheet)
   321	
   322	// Internal (not private): the active-workout machine picker (ticket 07)
   323	// reuses it to add a machine mid-workout.
   324	struct MachineEditorSheet: View {
   325	    @Environment(\.modelContext) private var modelContext
   326	    @Environment(\.dismiss) private var dismiss
   327	    var gym: Gym
   328	    /// nil = create a new machine at `gym`; non-nil = edit that machine
   329	    /// (D2, ticket 17 — its default unit was previously set-once).
   330	    var machine: MachineInstance?
   331	    @State private var label = ""
   332	    @State private var model: EquipmentModel?
   333	    @State private var defaultUnit: WeightUnit?
   334	    @State private var loaded = false
   335	    /// D3: the label this sheet filled in from a picked model. Only a label
   336	    /// the sheet wrote itself may be overwritten by the next pick — anything
   337	    /// typed is the user's.
   338	    @State private var modelDerivedLabel: String?
   339	
   340	    var body: some View {
   341	        NavigationStack {
   342	            Form {
   343	                Section {
   344	                    TextField("Label (e.g. “Chest press by the window”)", text: $label)
   345	                        .accessibilityIdentifier("machineLabel")
   346	                } footer: {
   347	                    Text("How you'll recognize this machine at \(gym.name).")
   348	                }
   349	                if machine == nil {
   350	                    Section {
   351	                        NavigationLink {
   352	                            ModelPickerView(selection: $model)
   353	                        } label: {
   354	                            HStack {
   355	                                Text("Catalog model")
   356	                                Spacer()
   357	                                Text(model?.displayName ?? "None")
   358	                                    .foregroundStyle(.secondary)
   359	                            }
   360	                        }
   361	                        .accessibilityIdentifier("catalogModel")
   362	                    } footer: {
   363	                        Text("Optional — picking one names the machine for you. Without a model, logging on this machine opens the full exercise picker.")
   364	                    }
   365	                } else {
   366	                    Section {
   367	                        HStack {
   368	                            Text("Catalog model")
   369	                            Spacer()
   370	                            Text(machine?.model?.displayName ?? "None")
   371	                                .foregroundStyle(.secondary)
   372	                        }
   373	                    } footer: {
   374	                        // Changing an existing machine's model has past-vs-
   375	                        // future consequences (D10), so it keeps its own flow.
   376	                        Text("Use “Correct Model…” on the machine to change this — it asks whether to apply the correction to past workouts.")
   377	                    }
   378	                }
   379	                Section {
   380	                    Picker("Default unit", selection: $defaultUnit) {
   381	                        Text("Gym default").tag(WeightUnit?.none)
   382	                        ForEach(WeightUnit.allCases) { unit in
   383	                            Text(unit.rawValue).tag(WeightUnit?.some(unit))
   384	                        }
   385	                    }
   386	                    .accessibilityIdentifier("machineUnitPicker")
   387	                } footer: {
   388	                    Text("Leave on Gym default to fall through to the gym's unit (then the app preference).")
   389	                }
   390	            }
   391	            .navigationTitle(machine == nil ? "New Machine" : "Edit Machine")
   392	            .navigationBarTitleDisplayMode(.inline)
   393	            .toolbar {
   394	                ToolbarItem(placement: .cancellationAction) {
   395	                    Button("Cancel") { dismiss() }
   396	                }
   397	                ToolbarItem(placement: .confirmationAction) {
   398	                    Button(machine == nil ? "Add" : "Save") { save() }
   399	                        .disabled(trimmedLabel.isEmpty)
   400	                        .accessibilityIdentifier("saveMachine")
   401	                }
   402	            }
   403	            .onAppear(perform: load)
   404	            .onChange(of: model?.id) { _, _ in applyModelDefaultLabel() }
   405	        }
   406	    }
   407	
   408	    private var trimmedLabel: String {
   409	        label.trimmingCharacters(in: .whitespacesAndNewlines)
   410	    }
   411	
   412	    private func load() {
   413	        guard !loaded else { return }
   414	        loaded = true
   415	        guard let machine else { return }
   416	        label = machine.label
   417	        model = machine.model
   418	        defaultUnit = machine.defaultUnit
   419	    }
   420	
   421	    /// D3: picking a catalog model supplies the label, so Add is immediately
   422	    /// enabled instead of waiting for a name to be invented. Still editable,
   423	    /// and a machine with no model still needs one typed.
   424	    private func applyModelDefaultLabel() {
   425	        guard let model else { return }
   426	        guard trimmedLabel.isEmpty || trimmedLabel == modelDerivedLabel else { return }
   427	        label = model.modelName
   428	        modelDerivedLabel = model.modelName
   429	    }
   430	
   431	    private func save() {
   432	        do {
   433	            if let machine {
   434	                try EquipmentLifecycle(context: modelContext).update(
   435	                    machine, label: label, defaultUnit: defaultUnit)
   436	            } else {
   437	                modelContext.insert(MachineInstance(
   438	                    label: trimmedLabel,
   439	                    defaultUnit: defaultUnit,
   440	                    gym: gym,
   441	                    model: model))
   442	                try modelContext.save()
   443	            }
   444	        } catch {
   445	            assertionFailure("Failed to save machine: \(error)")
   446	        }
   447	        dismiss()
   448	    }
   449	}
