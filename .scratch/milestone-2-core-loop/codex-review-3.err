    53	    /// Starts a persisted empty workout at `gym` (or no gym). Enforces the
    54	    /// at-most-one-active invariant: any still-active workouts are finished
    55	    /// first (with finish cleanup) — the UI offers Resume before calling this.
    56	    @discardableResult
    57	    func startWorkout(at gym: Gym?, on date: Date = .now) throws -> Workout {
    58	        for stray in try activeWorkouts() {
    59	            try finishInPlace(stray, at: date)
    60	        }
    61	        let workout = Workout(startedAt: date, gym: gym)
    62	        context.insert(workout)
