    71	    func resumableWorkout(at date: Date = .now) throws -> Workout? {
    72	        let active = try activeWorkouts()
    73	        guard let newest = active.first else { return nil }
    74	        let strays = active.dropFirst()
    75	        guard !strays.isEmpty else { return newest }
    76	        for stray in strays {
