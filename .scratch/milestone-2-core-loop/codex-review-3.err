   402	    /// The load type a row is logged under: the live exercise while it can
   403	    /// still change, falling back to the entry's frozen snapshot (D23).
   404	    static func loadType(of set: SetRecord) -> LoadType {
   405	        guard !set.isDeleted, let entry = set.entry, !entry.isDeleted else {
