   427	    /// ever blocks the completing direction; an already-completed row can
   428	    /// always be un-completed.
   429	    func toggleCompletion(of set: SetRecord, at date: Date = .now) throws {
   430	        if set.completedAt == nil {
   431	            guard Self.isLoggable(set) else {
   432	                throw WorkoutSessionError.setNotLoggable
   433	            }
   434	            set.completedAt = date
   435	            if let entry = set.entry {
   436	                if entry.snapshotCapturedAt == nil {
   437	                    captureSnapshot(of: entry, at: date)
   438	                }
   439	                upsertMemory(for: entry, at: date)
   440	            }
   441	        } else {
   442	            set.completedAt = nil
   443	        }
   444	        try context.save()
   445	    }
