   358	    // MARK: - Element helpers
   359	
   360	    private func tab(_ name: String) -> XCUIElement {
   361	        app.tabBars.buttons[name]
   362	    }
   363	
   364	    /// Identifier lookup that does not care which element type SwiftUI chose
   365	    /// for a row, picker, or menu.
   366	    private func anyElement(_ identifier: String) -> XCUIElement {
   367	        app.descendants(matching: .any).matching(identifier: identifier).firstMatch
   368	    }
   369	
   370	    /// Taps an option by its visible label, whether it renders as a menu
   371	    /// item, a pushed list row, or a plain cell.
   372	    private func tapOption(_ label: String) {
   373	        let button = app.buttons[label]
   374	        if button.waitForExistence(timeout: 3) {
   375	            button.tap()
   376	            return
   377	        }
   378	        let text = app.staticTexts[label]
   379	        XCTAssertTrue(text.waitForExistence(timeout: 3), "No option labelled \(label)")
   380	        text.tap()
   381	    }
   382	
   383	    private func value(of element: XCUIElement) -> String? {
   384	        element.value as? String
   385	    }
   386	
   387	    private func completeValue(of element: XCUIElement) -> String? {
   388	        value(of: element)
   389	    }
   390	}

