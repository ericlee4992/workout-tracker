     1	import XCTest
     2	
     3	/// End-to-end walkthrough of the product's core claim: create a gym and a
     4	/// machine, log a set on it, finish, and prove the *second* workout on the
     5	/// same machine arrives prefilled and needs a single tap to log the repeat
     6	/// set (ticket 11 / SPEC "Speed bar").
     7	///
     8	/// The app is launched with `-uiTestReset` so every run starts from an empty
     9	/// store (only the seeded catalog is present).
    10	final class CoreLoopUITests: XCTestCase {
    11	    private var app: XCUIApplication!
    12	
    13	    private let gymName = "Gangnam Fitness"
    14	    private let machineLabel = "Chest Press 2"
    15	    private let modelName = "Life Fitness Insignia Series Chest Press"
    16	    private let exerciseName = "Seated Chest Press"
    17	
    18	    override func setUp() {
    19	        super.setUp()
    20	        continueAfterFailure = false
    21	        app = XCUIApplication()
    22	        app.launchArguments = ["-uiTestReset"]
    23	        app.launch()
    24	    }
    25	
    26	    // MARK: - The walkthrough
    27	
    28	    func testCoreLoopFromEmptyStoreToOneTapRepeatSet() {
    29	        createGym()
    30	        addMachine()
    31	
    32	        // --- First workout -------------------------------------------------
    33	        startEmptyWorkout()
    34	        addByMachine()
    35	
    36	        // D7: a single-exercise machine fills its exercise in with zero
    37	        // further prompts — the sheet closes straight onto the entry.
    38	        XCTAssertTrue(
    39	            app.staticTexts[exerciseName].waitForExistence(timeout: 5),
    40	            "Picking a single-exercise machine should auto-fill its exercise")
    41	
    42	        let weight = app.textFields["setRow.weight"].firstMatch
    43	        XCTAssertTrue(weight.waitForExistence(timeout: 5))
    44	        weight.tap()
    45	        weight.typeText("60")
    46	
    47	        let reps = app.textFields["setRow.reps"].firstMatch
    48	        reps.tap()
    49	        reps.typeText("10")
    50	
    51	        // Unit chip: the gym default is kg; one tap makes this set lb.
    52	        let unitChip = app.buttons["setRow.unit"].firstMatch
