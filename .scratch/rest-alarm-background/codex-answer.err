   128	    /// Mirrors the phone's rest timer onto the watch, if one is listening, and
   129	    /// arms the audible alarm for that rest.
   130	    func broadcastRest(endsAt: Date?) {
   131	        (monitor?.provider as? WatchRestBroadcasting)?.sendRest(endsAt: endsAt)
   132	        restEndsAt = endsAt
   133	        // A new rest re-arms. Without this the second rest of a workout would be
   134	        // silent, the gate still holding the first one's end.
   135	        if let endsAt, endsAt != lastSoundedRestEnd {
   136	            lastSoundedRestEnd = nil
   137	        }
   138	    }
