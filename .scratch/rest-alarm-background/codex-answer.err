    69	struct RestTimerState: Equatable {
    70	    var end: Date
    71	    var remaining: TimeInterval
    72	    /// The full duration this rest was started with, including any +15s
    73	    /// extensions. `remaining / total` is the progress-bar fraction; using
    74	    /// `remaining` as the denominator would show a restored timer as full.
    75	    var total: TimeInterval
    76	}
