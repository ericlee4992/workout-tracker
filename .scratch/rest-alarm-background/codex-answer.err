    99	                vitals: monitor.vitals,
   100	                activeEnergyKilocalories: monitor.activeEnergyKilocalories,
   101	                zonesEstimated: monitor.maxHeartRate?.isEstimated ?? false,
   102	                onto: workout)
   103	        }
