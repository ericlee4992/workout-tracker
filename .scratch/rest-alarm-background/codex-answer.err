    30	/// Production adapter. One stable identifier guarantees that every start,
    31	/// +time, or replacement leaves at most one pending rest notification.
    32	final class UserNotificationScheduler: RestNotificationScheduling {
    33	    static let shared = UserNotificationScheduler()
    34	    private let center: UNUserNotificationCenter
    35	    private let identifier = "workout-rest-timer"
    36	
    37	    init(center: UNUserNotificationCenter = .current()) {
    38	        self.center = center
    39	    }
    40	
    41	    func requestAuthorization() {
    42	        Task { _ = try? await center.requestAuthorization(options: [.alert, .sound]) }
    43	    }
    44	
    45	    func schedule(at date: Date) {
    46	        schedule(at: date, title: "Rest complete", body: "Time for your next set.")
    47	    }
    48	
    49	    func schedule(at date: Date, title: String, body: String) {
    50	        center.removePendingNotificationRequests(withIdentifiers: [identifier])
    51	        let content = UNMutableNotificationContent()
    52	        content.title = title
    53	        content.body = body
    54	        content.sound = .default
    55	        let interval = max(1, date.timeIntervalSinceNow)
    56	        let request = UNNotificationRequest(
    57	            identifier: identifier,
    58	            content: content,
    59	            trigger: UNTimeIntervalNotificationTrigger(
    60	                timeInterval: interval, repeats: false))
    61	        Task { try? await center.add(request) }
    62	    }
    63	
    64	    func cancel() {
    65	        center.removePendingNotificationRequests(withIdentifiers: [identifier])
    66	    }
    67	}
