    45	    private var heartRateType: HKQuantityType { .quantityType(forIdentifier: .heartRate)! }
    46	    private var activeEnergyType: HKQuantityType {
    47	        .quantityType(forIdentifier: .activeEnergyBurned)!
    48	    }
    49	
    50	    func start() async -> HeartRateFeedState {
    51	        guard HKHealthStore.isHealthDataAvailable() else { return .unavailable }
    52	
    53	        let share: Set<HKSampleType> = [HKObjectType.workoutType()]
    54	        let read: Set<HKObjectType> = [heartRateType, activeEnergyType]
    55	        do {
    56	            // Asked on first use of the feature, not at launch — the same rule
    57	            // the rest-timer notification permission follows.
    58	            try await store.requestAuthorization(toShare: share, read: read)
    59	        } catch {
    60	            return .denied
    61	        }
    62	
    63	        // Read permission is deliberately NOT probed with
    64	        // `authorizationStatus(for:)`: HealthKit refuses to disclose read
    65	        // denial, and treating "not determined" as denial would blank the UI
    66	        // for a user who actually granted it. The honest signal that reads are
    67	        // permitted is samples arriving — hence `.waitingForSensor` until one
    68	        // does.
    69	        let configuration = HKWorkoutConfiguration()
    70	        configuration.activityType = .traditionalStrengthTraining
    71	        configuration.locationType = .indoor
    72	
    73	        do {
    74	            let session = try HKWorkoutSession(
    75	                healthStore: store, configuration: configuration)
    76	            let builder = session.associatedWorkoutBuilder()
    77	            builder.dataSource = HKLiveWorkoutDataSource(
    78	                healthStore: store, workoutConfiguration: configuration)
    79	            builder.delegate = self
    80	            session.delegate = self
    81	
    82	            self.session = session
    83	            self.builder = builder
    84	
    85	            // `prepare()` before starting gives the sensor time to spin up —
    86	            // Apple's own guidance, and the reason their UI shows a countdown.
    87	            session.prepare()
    88	            let start = Date()
    89	            session.startActivity(with: start)
    90	            try await builder.beginCollection(at: start)
    91	            return .waitingForSensor
    92	        } catch {
    93	            self.session = nil
    94	            self.builder = nil
    95	            return .unavailable
    96	        }
    97	    }
    98	
    99	    func stop() async {
   100	        guard let session, let builder else { return }
   101	        let end = Date()
   102	        session.stopActivity(with: end)
   103	        session.end()
   104	        // Ending collection and finishing are best-effort: the workout is the
   105	        // user's record either way, and a failure here must not prevent the
   106	        // session from being torn down — a live session left behind keeps the
   107	        // sensor on.
   108	        try? await builder.endCollection(at: end)
   109	        _ = try? await builder.finishWorkout()
   110	        self.session = nil
   111	        self.builder = nil
   112	        continuation?.finish()
   113	    }
   114	}
