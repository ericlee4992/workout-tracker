   147	        }
   148	
   149	        // D43: a heart-rate rest runs to its CAP as far as the clock and the
   150	        // persisted timer are concerned. The threshold can only end it early,
   151	        // and only while a live reading is arriving — so the cap is what
   152	        // survives a relaunch, a backgrounded app, or a sensor that dies.
   153	        let plan = try restPlan(for: set)
   154	        let seconds = plan.seconds
   155	        let end = clock.now.addingTimeInterval(TimeInterval(seconds))
   156	        workout.restEndsAt = end
   157	        workout.restStartedAt = clock.now
   158	        workout.restStartedBySetID = set.id
   159	        try context.save()
   160	        switch plan.mode {
   161	        case .standard:
   162	            notifications.schedule(at: end)
   163	        case .heartRate:
   164	            notifications.schedule(
   165	                at: end,
   166	                title: "Rest complete",
   167	                body: "Time is up — your heart rate didn't reach the target.")
   168	        }
   169	        return RestTimerState(
   170	            end: end,
   171	            remaining: TimeInterval(seconds),
   172	            total: TimeInterval(seconds))
   173	    }
   174	
   175	    // MARK: - Heart-rate rest (D43)
   176	
   177	    /// How a rest for this set should run: standard durations (D22), or a
   178	    /// heart-rate threshold with its cap.
   179	    struct RestPlan: Equatable {
   180	        var mode: RestMode
   265	        try context.save()
   266	        // +1s rather than `now`: a UNTimeIntervalNotificationTrigger of zero is
   267	        // rejected, and the app may well be backgrounded — which is exactly the
   268	        // case this alarm exists for.
   269	        notifications.schedule(
   270	            at: clock.now.addingTimeInterval(1),
   271	            title: "Rest complete",
   272	            body: "Heart rate down to \(bpm) bpm — ready for your next set.")
   273	    }
   274	
   275	    /// Reconstruct or expire a persisted timer. Expired timers are cleared so
   276	    /// returning from suspension never shows stale UI.
   277	    func currentState(for workout: Workout) throws -> RestTimerState? {
   278	        guard let end = workout.restEndsAt else { return nil }
   279	        let remaining = end.timeIntervalSince(clock.now)
   280	        guard remaining > 0 else {
   281	            clear(workout)
   282	            try context.save()
   283	            notifications.cancel()
   284	            return nil
   285	        }
   286	        return RestTimerState(
   287	            end: end, remaining: remaining, total: total(of: workout, end: end))
   288	    }
   289	
   290	    @discardableResult
   291	    func add(seconds: Int, to workout: Workout) throws -> RestTimerState? {
   292	        guard let state = try currentState(for: workout) else { return nil }
   293	        let end = state.end.addingTimeInterval(TimeInterval(seconds))
   294	        workout.restEndsAt = end
   295	        try context.save()
   296	        notifications.schedule(at: end)
   297	        // `restStartedAt` is untouched, so the total grows with the extension
   298	        // and the bar keeps shrinking from wherever it was.
   299	        return RestTimerState(
   300	            end: end,
   301	            remaining: end.timeIntervalSince(clock.now),
   302	            total: total(of: workout, end: end))
   303	    }
   304	
   305	    /// Total = end − start. Timers persisted before `restStartedAt` existed
   306	    /// fall back to the remaining time (the old behaviour) rather than zero.
   307	    private func total(of workout: Workout, end: Date) -> TimeInterval {
   308	        guard let started = workout.restStartedAt else {
   309	            return max(0, end.timeIntervalSince(clock.now))
   310	        }
   311	        return max(0, end.timeIntervalSince(started))
   312	    }
   313	
   314	    func skip(_ workout: Workout) throws {
   315	        clear(workout)
   316	        try context.save()
   317	        notifications.cancel()
   318	    }
