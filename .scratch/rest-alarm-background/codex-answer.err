   118	extension HealthKitHeartRateProvider: HKLiveWorkoutBuilderDelegate {
   119	
   120	    nonisolated func workoutBuilder(
   121	        _ workoutBuilder: HKLiveWorkoutBuilder,
   122	        didCollectDataOf collectedTypes: Set<HKSampleType>
   123	    ) {
   124	        for type in collectedTypes {
   125	            guard let quantityType = type as? HKQuantityType,
   126	                  let statistics = workoutBuilder.statistics(for: quantityType)
   127	            else { continue }
   128	            let identifier = quantityType.identifier
   129	            Task { @MainActor [weak self] in
   130	                self?.apply(statistics: statistics, identifier: identifier)
   131	            }
   132	        }
   133	    }
   134	
   135	    nonisolated func workoutBuilderDidCollectEvent(_ workoutBuilder: HKLiveWorkoutBuilder) {}
   136	
   137	    @MainActor
   138	    private func apply(statistics: HKStatistics, identifier: String) {
   139	        switch identifier {
   140	        case HKQuantityTypeIdentifier.heartRate.rawValue:
   141	            let unit = HKUnit.count().unitDivided(by: .minute())
   142	            guard let quantity = statistics.mostRecentQuantity() else { return }
   143	            let bpm = Int(quantity.doubleValue(for: unit).rounded())
   144	            guard bpm > 0 else { return }
   145	            // Date from the statistic itself, not `.now`: staleness is measured
   146	            // against when the heart beat, not when we noticed.
   147	            let date = statistics.mostRecentQuantityDateInterval()?.end ?? Date()
   148	            continuation?.yield(
   149	                HeartRateSample(bpm: bpm, date: date, source: assumedSource))
   150	        case HKQuantityTypeIdentifier.activeEnergyBurned.rawValue:
   151	            // The system's own accumulation. We never add these up ourselves.
   152	            activeEnergyKilocalories = statistics
   153	                .sumQuantity()?
   154	                .doubleValue(for: .kilocalorie())
   155	        default:
   156	            break
   157	        }
   158	    }
   159	}
