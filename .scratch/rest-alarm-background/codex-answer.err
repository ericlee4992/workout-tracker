   140	    /// The heart rate came down, so this rest ended early (D43). Sounds the
   141	    /// "recovered" pattern and disarms, so the cap cannot also fire.
   142	    func soundRecovered() {
   143	        alarm.sound(.recovered)
   144	        restEndsAt = nil
   145	        lastSoundedRestEnd = nil
   146	    }
   147	
   148	    /// Sounds the cap pattern once, when a rest runs its full length.
   149	    ///
   150	    /// Evaluated on every sample — roughly once a second — so the gate is what
   151	    /// keeps a face-down phone from beeping every second.
   152	    private func soundRestAlarmIfDue(now: Date = .now) {
   153	        guard RestAlarmDecision.shouldSound(
   154	            restEndsAt: restEndsAt, lastSounded: lastSoundedRestEnd, now: now)
   155	        else { return }
   156	        lastSoundedRestEnd = restEndsAt
   157	        restAlarmLog.notice("cap alarm due, sounding")
   158	        alarm.sound(.cap)
   159	    }
